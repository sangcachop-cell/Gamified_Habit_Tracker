@model HabitTracker.Models.ViewModels.StableViewModel
@using HabitTracker.Constants
@using HabitTracker.Models.ViewModels
@{
    ViewData["Title"] = "Stable";
    var u = Model.User;

    var ownedPetKeys = System.Text.Json.JsonSerializer.Serialize(
        Model.OwnedPets.Select(p => p.PetKey).Concat(Model.OwnedMounts.Select(p => p.PetKey)).ToList());

    var eggAnimalMap = System.Text.Json.JsonSerializer.Serialize(
        Model.EggsInInventory
             .Where(i => i.GameItem?.AnimalKey != null)
             .ToDictionary(i => i.GameItemId, i => i.GameItem!.AnimalKey!));

    var questEggIds = System.Text.Json.JsonSerializer.Serialize(
        Model.EggsInInventory
             .Where(i => i.GameItem?.IsDroppable == false)
             .Select(i => i.GameItemId)
             .ToHashSet());

    var dropPotionIds = System.Text.Json.JsonSerializer.Serialize(
        Model.PotionsInInventory
             .Where(i => i.GameItem?.IsDroppable == true)
             .Select(i => i.GameItemId)
             .ToHashSet());

    var petDataMap = System.Text.Json.JsonSerializer.Serialize(
        Model.OwnedPets.ToDictionary(
            p => p.PetKey,
            p => new { feedingPoints = p.FeedingPoints, isActive = p.PetKey == u.ActivePetKey, colorName = p.ColorName }));

    string CategoryLabel(PetCategory cat) => cat switch {
        PetCategory.Drop    => "standard",
        PetCategory.Premium => "premium",
        PetCategory.Quest   => "quest",
        PetCategory.Wacky   => "wacky",
        PetCategory.Special => "special",
        _ => ""
    };
    string BadgeColor(PetCategory cat) => cat switch {
        PetCategory.Drop    => "bg-primary",
        PetCategory.Premium => "bg-warning text-dark",
        PetCategory.Quest   => "bg-success",
        PetCategory.Wacky   => "bg-danger",
        PetCategory.Special => "bg-secondary",
        _ => "bg-secondary"
    };
}

<style>
    .feed-targeting .pet-slot.slot-owned:not(.slot-is-mount) {
        cursor: crosshair;
        outline: 2px dashed #fd7e14;
        outline-offset: 2px;
    }
    .feed-targeting .pet-slot.slot-owned:not(.slot-is-mount):hover {
        outline-color: #e55a00;
        background: rgba(253,126,20,.12);
    }
    .food-select-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4px 6px;
        min-width: 52px;
        line-height: 1.2;
    }
    .food-select-btn.active {
        background: #fd7e14;
        border-color: #fd7e14;
        color: #fff;
    }
    .owned-pet-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px;
        border: 2px solid #6c757d;
        border-radius: 8px;
        background: rgba(255,255,255,.9);
        cursor: pointer;
        width: 80px;
        text-align: center;
        position: relative;
    }
    .owned-pet-card:hover { border-color: #0d6efd; background: rgba(13,110,253,.06); }
    .owned-pet-card.is-active { border-color: #198754 !important; box-shadow: 0 0 0 2px rgba(25,135,84,.35); }
    .owned-pet-card .card-progress {
        width: 100%;
        height: 4px;
        background: #dee2e6;
        border-radius: 2px;
        margin-top: 4px;
    }
    .owned-pet-card .card-progress > div {
        height: 100%;
        background: #ffc107;
        border-radius: 2px;
        transition: width .3s;
    }
    .owned-pet-card .card-label {
        font-size: .6rem;
        color: #6c757d;
        margin-top: 2px;
        word-break: break-all;
        line-height: 1.2;
    }
    .owned-mount-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px;
        border: 2px solid #6c757d;
        border-radius: 8px;
        background: rgba(255,255,255,.9);
        cursor: pointer;
        width: 80px;
        text-align: center;
        position: relative;
    }
    .owned-mount-card:hover { border-color: #fd7e14; background: rgba(253,126,20,.06); }
    .owned-mount-card.is-active { border-color: #198754 !important; box-shadow: 0 0 0 2px rgba(25,135,84,.35); }
    .owned-mount-card .card-label {
        font-size: .6rem;
        color: #6c757d;
        margin-top: 4px;
        word-break: break-all;
        line-height: 1.2;
    }
</style>

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<div class="container-fluid py-4" style="max-width:1200px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">🐾 Stable</h2>
        <div class="text-muted small">
            @Model.CollectedPetsCount / @Model.TotalPetsInCatalog pets &nbsp;·&nbsp;
            @Model.OwnedMounts.Count / @Model.TotalMountsInCatalog mounts
        </div>
    </div>

    <ul class="nav nav-tabs mb-4" id="stableTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-my-pets" type="button">
                🐾 My Pets <span class="badge bg-secondary ms-1">@Model.OwnedPets.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-my-mounts" type="button">
                🐴 My Mounts <span class="badge bg-secondary ms-1">@Model.OwnedMounts.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pet-collection" type="button">
                📖 Pet Collection <span class="badge bg-secondary ms-1">@Model.CollectedPetsCount / @Model.TotalPetsInCatalog</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mount-collection" type="button">
                📖 Mount Collection <span class="badge bg-secondary ms-1">@Model.OwnedMounts.Count / @Model.TotalMountsInCatalog</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-hatch" type="button">
                🥚 Hatch
            </button>
        </li>
    </ul>

    <div class="tab-content" id="stableTabContent">

        <!-- ═══════════════════════════════════════════ MY PETS TAB -->
        <div class="tab-pane fade show active" id="tab-my-pets" role="tabpanel">

            <!-- Food bar -->
            <div id="food-bar" class="mb-3 p-2 rounded" style="background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.08);">
                <div class="d-flex align-items-center gap-1 flex-wrap" id="food-bar-inner">
                    <span class="text-muted small fw-semibold me-1" style="white-space:nowrap;">🍖 Feed:</span>
                    @if (Model.FoodInInventory.Any())
                    {
                        @foreach (var f in Model.FoodInInventory)
                        {
                            <button type="button"
                                    class="food-select-btn btn btn-sm btn-outline-secondary"
                                    data-food-id="@f.GameItemId"
                                    data-food-color="@(f.GameItem?.Target ?? "")"
                                    onclick="selectFood(this)"
                                    title="@(f.GameItem?.Name) ×@f.Quantity">
                                <img src="@f.GameItem?.ImagePath" width="28" height="28"
                                     style="image-rendering:pixelated;" onerror="this.style.opacity='.3'" />
                                <span style="font-size:.65rem;">×<span class="food-qty">@f.Quantity</span></span>
                            </button>
                        }
                    }
                    else
                    {
                        <span class="text-muted small" id="no-food-msg">No food — complete tasks to earn drops</span>
                    }
                    <button id="cancel-feed-btn" class="btn btn-sm btn-outline-danger ms-auto"
                            style="display:none;" onclick="cancelFeed()">✕ Cancel</button>
                </div>
                <div id="feed-hint" class="text-warning small mt-1" style="display:none;">
                    Click a pet below to feed it
                </div>
            </div>

            <!-- Active pet banner -->
            @if (!string.IsNullOrEmpty(u.ActivePetKey))
            {
                <div class="d-flex align-items-center gap-3 p-2 mb-3 rounded" style="background:rgba(74,144,217,.12);border:1px solid rgba(74,144,217,.3);">
                    <img src="/images/habitica/stable/pets/Pet-@(u.ActivePetKey).png" width="36" height="36" style="image-rendering:pixelated;" onerror="this.style.display='none'" />
                    <div class="flex-grow-1 small">
                        <span class="fw-semibold">Active pet:</span> @u.ActivePetKey
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" onclick="setActivePet('')">✕ Unequip</button>
                </div>
            }

            <div class="text-muted small mb-3">Select food above → click pet to feed. Click pet without food → make active/unequip.</div>

            @if (!Model.OwnedPets.Any())
            {
                <div class="text-muted text-center py-5">
                    <div style="font-size:3rem;">🐾</div>
                    <p class="mt-2">No pets yet. Hatch eggs or complete quests!</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2" id="owned-pets-grid">
                    @foreach (var pet in Model.OwnedPets.OrderBy(p => p.PetKey))
                    {
                        bool isActive = pet.PetKey == u.ActivePetKey;
                        int pct = pet.FeedingPoints * 2;
                        <div class="owned-pet-card @(isActive ? "is-active" : "")"
                             data-petkey="@pet.PetKey"
                             title="@pet.PetKey (@pet.FeedingPoints/50)@(isActive ? " ★ active" : "")">
                            @if (isActive) { <div style="position:absolute;top:2px;right:4px;font-size:.65rem;">★</div> }
                            <img src="/images/habitica/stable/pets/Pet-@(pet.PetKey).png"
                                 width="48" height="48"
                                 style="image-rendering:pixelated;"
                                 onerror="this.style.opacity='.2'" />
                            <div class="card-progress"><div style="width:@pct%"></div></div>
                            <div class="card-label">@pet.FeedingPoints/50</div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════ MY MOUNTS TAB -->
        <div class="tab-pane fade" id="tab-my-mounts" role="tabpanel">

            @if (!string.IsNullOrEmpty(u.ActiveMountKey))
            {
                <div class="d-flex align-items-center gap-3 p-2 mb-3 rounded" style="background:rgba(74,144,217,.12);border:1px solid rgba(74,144,217,.3);">
                    <img src="/images/habitica/stable/mounts/icon/Mount_Icon_@(u.ActiveMountKey).png" width="36" height="36" style="image-rendering:pixelated;" onerror="this.style.display='none'" />
                    <div class="flex-grow-1 small">
                        <span class="fw-semibold">Currently riding:</span> @u.ActiveMountKey
                    </div>
                    <button class="btn btn-outline-warning btn-sm" onclick="setActiveMount('')">🏠 Dismount</button>
                </div>
            }

            <div class="text-muted small mb-3">Click mount to ride. Click active mount to dismount.</div>

            @if (!Model.OwnedMounts.Any())
            {
                <div class="text-muted text-center py-5">
                    <div style="font-size:3rem;">🐴</div>
                    <p class="mt-2">No mounts yet. Feed a pet to 50 pts to evolve it!</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2" id="owned-mounts-grid">
                    @foreach (var mount in Model.OwnedMounts.OrderBy(p => p.PetKey))
                    {
                        bool isActive = mount.PetKey == u.ActiveMountKey;
                        string iconPath = $"/images/habitica/stable/mounts/icon/Mount_Icon_{mount.PetKey}.png";
                        string fallbackPath = $"/images/habitica/stable/pets/Pet-{mount.PetKey}.png";
                        <div class="owned-mount-card @(isActive ? "is-active" : "")"
                             data-mountkey="@mount.PetKey"
                             title="@mount.PetKey@(isActive ? " ★ riding" : "")">
                            @if (isActive) { <div style="position:absolute;top:2px;right:4px;font-size:.65rem;">★</div> }
                            <img src="@iconPath" width="48" height="48"
                                 style="image-rendering:pixelated;"
                                 onerror="this.src='@fallbackPath';this.onerror=null;" />
                            <div class="card-label">@mount.PetKey.Split('-')[0]</div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════ PET COLLECTION TAB -->
        <div class="tab-pane fade" id="tab-pet-collection" role="tabpanel">
            <div class="text-muted small mb-3">Full pet catalog — @Model.CollectedPetsCount / @Model.TotalPetsInCatalog collected.</div>
            @foreach (var group in Model.PetsGrid)
            {
                int ownedCount = group.Slots.Count(s => s.IsOwned);
                string eggImgPath = $"/images/habitica/stable/eggs/Pet_Egg_{group.AnimalKey}.png";
                <div class="animal-section mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <img src="@eggImgPath" width="24" height="24" style="image-rendering:pixelated;" onerror="this.style.display='none'" />
                        <span class="fw-semibold small">@group.DisplayName</span>
                        <span class="badge @BadgeColor(group.Category)" style="font-size:.6rem;">@CategoryLabel(group.Category)</span>
                        <span class="text-muted" style="font-size:.65rem;">@ownedCount / @group.Slots.Count</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var slot in group.Slots)
                        {
                            string slotClass = slot.IsMount   ? "slot-is-mount" :
                                               slot.IsOwned   ? "slot-owned"    : "slot-unowned";
                            string activeClass = slot.IsActivePet ? "slot-active-pet" : "";
                            int progressPct = slot.FeedingPoints * 2;
                            <div class="pet-slot @slotClass @activeClass"
                                 data-petkey="@slot.PetKey"
                                 title="@slot.ColorDisplayName@(slot.IsOwned && !slot.IsMount ? $" ({slot.FeedingPoints}/50)" : "")">
                                <img src="@slot.PetImagePath" width="48" height="48"
                                     style="image-rendering:pixelated;" onerror="this.style.opacity='.1'" />
                                @if (slot.IsOwned && !slot.IsMount)
                                {
                                    <div class="slot-progress"><div style="width:@progressPct%"></div></div>
                                }
                                @if (slot.IsActivePet) { <div class="slot-badge">★</div> }
                                @if (slot.IsMount) { <div class="slot-badge mount-badge" title="Evolved to mount">🐴</div> }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════ MOUNT COLLECTION TAB -->
        <div class="tab-pane fade" id="tab-mount-collection" role="tabpanel">
            <div class="text-muted small mb-3">Full mount catalog — @Model.OwnedMounts.Count / @Model.TotalMountsInCatalog collected.</div>
            @foreach (var group in Model.MountsGrid)
            {
                int ownedCount = group.Slots.Count(s => s.IsOwned);
                <div class="animal-section mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fw-semibold small">@group.DisplayName</span>
                        <span class="text-muted" style="font-size:.65rem;">@ownedCount / @group.Slots.Count</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var slot in group.Slots)
                        {
                            string slotClass = slot.IsOwned ? "slot-owned" : "slot-unowned";
                            string activeClass = slot.IsActiveMount ? "slot-active-mount" : "";
                            string imgSrc = slot.MountIconPath ?? slot.PetImagePath;
                            <div class="pet-slot @slotClass @activeClass"
                                 data-mountkey="@slot.PetKey"
                                 title="@slot.ColorDisplayName">
                                <img src="@imgSrc" width="48" height="48"
                                     style="image-rendering:pixelated;"
                                     onerror="this.src='@slot.PetImagePath';this.onerror=null;" />
                                @if (slot.IsActiveMount) { <div class="slot-badge">★</div> }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════ HATCH TAB -->
        <div class="tab-pane fade" id="tab-hatch" role="tabpanel">
            @if (!Model.EggsInInventory.Any() || !Model.PotionsInInventory.Any())
            {
                <div class="text-muted text-center py-5">
                    <div style="font-size:3rem;">🧪</div>
                    @if (!Model.EggsInInventory.Any() && !Model.PotionsInInventory.Any())
                    { <p>No eggs or potions in inventory. Complete tasks to earn drops!</p> }
                    else if (!Model.EggsInInventory.Any())
                    { <p>No eggs in inventory.</p> }
                    else
                    { <p>No potions in inventory.</p> }
                </div>
            }
            else
            {
                <div class="row justify-content-center">
                    <div class="col-md-9 col-lg-7">
                        <div class="card p-4">
                            <h5 class="mb-3">🥚 Hatch a Pet</h5>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Select Egg</label>
                                <div class="d-flex flex-wrap gap-2" id="egg-grid">
                                    @foreach (var inv in Model.EggsInInventory)
                                    {
                                        bool isQuest = inv.GameItem?.IsDroppable == false;
                                        <button type="button"
                                                class="btn btn-outline-secondary hatch-egg-btn"
                                                data-id="@inv.GameItemId"
                                                data-animal="@inv.GameItem?.AnimalKey"
                                                data-isquest="@(isQuest ? "true" : "false")"
                                                onclick="selectEgg(this)"
                                                title="@inv.GameItem?.Name ×@inv.Quantity@(isQuest ? " (quest)" : "")">
                                            <img src="@inv.GameItem?.ImagePath" width="40" height="40" style="image-rendering:pixelated;" /><br/>
                                            <span style="font-size:.65rem;">×@inv.Quantity</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Select Potion
                                    <span id="potion-hint" class="text-warning ms-2" style="font-size:.7rem;display:none;">Quest eggs use standard potions only</span>
                                </label>
                                <div class="d-flex flex-wrap gap-2" id="potion-grid">
                                    @foreach (var inv in Model.PotionsInInventory)
                                    {
                                        bool isDrop = inv.GameItem?.IsDroppable == true;
                                        <button type="button"
                                                class="btn btn-outline-secondary hatch-potion-btn"
                                                data-id="@inv.GameItemId"
                                                data-color="@inv.GameItem?.PotionColorKey"
                                                data-isdrop="@(isDrop ? "true" : "false")"
                                                onclick="selectPotion(this)"
                                                title="@inv.GameItem?.Name ×@inv.Quantity">
                                            <img src="@inv.GameItem?.ImagePath" width="40" height="40"
                                                 style="image-rendering:pixelated;" onerror="this.style.opacity='.3'" /><br/>
                                            <span style="font-size:.65rem;">×@inv.Quantity</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="text-center mb-3" id="hatch-preview" style="min-height:80px;">
                                <span class="text-muted small">Select egg + potion to preview</span>
                            </div>
                            <button id="hatch-btn" class="btn btn-primary w-100" disabled onclick="doHatch()">
                                🥚 Hatch!
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
<script>
    const csrf = () => document.querySelector('#csrf-form input[name="__RequestVerificationToken"]').value;
    const ownedPetKeys  = @Html.Raw(ownedPetKeys);
    const eggAnimalMap  = @Html.Raw(eggAnimalMap);
    const questEggIds   = @Html.Raw(questEggIds);
    const dropPotionIds = @Html.Raw(dropPotionIds);
    const petDataMap    = @Html.Raw(petDataMap);

    let selectedEggId       = null;
    let selectedPotionId    = null;
    let selectedEggAnimal   = null;
    let selectedPotionColor = null;
    let selectedFoodId      = null;
    let selectedFoodColor   = null;

    // ── Food selection ────────────────────────────────────────────────────

    function selectFood(btn) {
        var foodId = parseInt(btn.dataset.foodId);
        if (selectedFoodId === foodId) { cancelFeed(); return; }
        document.querySelectorAll('.food-select-btn').forEach(b => {
            b.classList.remove('active', 'btn-warning');
            b.classList.add('btn-outline-secondary');
        });
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('active', 'btn-warning');
        selectedFoodId    = foodId;
        selectedFoodColor = btn.dataset.foodColor;
        document.getElementById('cancel-feed-btn').style.display = '';
        document.getElementById('feed-hint').style.display = '';
        document.getElementById('tab-my-pets').classList.add('feed-targeting');
    }

    function cancelFeed() {
        selectedFoodId = null; selectedFoodColor = null;
        document.querySelectorAll('.food-select-btn').forEach(b => {
            b.classList.remove('active', 'btn-warning');
            b.classList.add('btn-outline-secondary');
        });
        document.getElementById('cancel-feed-btn').style.display = 'none';
        document.getElementById('feed-hint').style.display = 'none';
        document.getElementById('tab-my-pets').classList.remove('feed-targeting');
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape' && selectedFoodId !== null) cancelFeed(); });

    // ── My Pets click delegation ──────────────────────────────────────────

    document.getElementById('tab-my-pets').addEventListener('click', function(e) {
        var card = e.target.closest('.owned-pet-card');
        if (!card) return;
        var petKey = card.dataset.petkey;
        if (!petKey) return;
        if (selectedFoodId !== null) {
            doFeed(petKey, selectedFoodId);
        } else {
            var data = petDataMap[petKey];
            setActivePet((data && data.isActive) ? '' : petKey);
        }
    });

    // ── My Mounts click delegation ────────────────────────────────────────

    document.getElementById('tab-my-mounts').addEventListener('click', function(e) {
        var card = e.target.closest('.owned-mount-card');
        if (!card) return;
        var mountKey = card.dataset.mountkey;
        if (!mountKey) return;
        setActiveMount(card.classList.contains('is-active') ? '' : mountKey);
    });

    // ── Feed ──────────────────────────────────────────────────────────────

    function doFeed(petKey, foodId) {
        fetch('/Stable/Feed', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'petKey=' + encodeURIComponent(petKey) + '&foodGameItemId=' + foodId + '&__RequestVerificationToken=' + encodeURIComponent(csrf())
        })
        .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(d => {
            if (!d.success) { showToast('❌', 'Feed Failed', d.error || 'Unknown error', 'toast-hp', 3000); return; }
            if (d.evolved) {
                var imgHtml = d.mountIconPath
                    ? '<img src="' + d.mountIconPath + '" style="width:36px;height:36px;image-rendering:pixelated;" onerror="this.replaceWith(document.createTextNode(\'🐴\'))">'
                    : '🐴';
                showToast(imgHtml, 'Mount Raised!', petKey + ' evolved!', 'toast-level', 5000);
                setTimeout(() => location.reload(), 1800);
            } else {
                showToast('🍖', 'Fed!', petKey + ': ' + d.newFeedingPoints + '/50 pts', 'toast-xp', 2500);

                // Update card progress bar and label
                var card = document.querySelector('.owned-pet-card[data-petkey="' + petKey + '"]');
                if (card) {
                    var bar = card.querySelector('.card-progress > div');
                    if (bar) bar.style.width = (d.newFeedingPoints * 2) + '%';
                    var lbl = card.querySelector('.card-label');
                    if (lbl) lbl.textContent = d.newFeedingPoints + '/50';
                    card.title = card.title.replace(/\d+\/50/, d.newFeedingPoints + '/50');
                }
                // Update petDataMap
                if (petDataMap[petKey]) petDataMap[petKey].feedingPoints = d.newFeedingPoints;
                updateFoodQtyBar(foodId, d.newFoodQuantity);
            }
        })
        .catch(function(err) { showToast('❌', 'Feed Error', err.message || 'Unknown error', 'toast-hp', 3000); });
    }

    function updateFoodQtyBar(foodId, newQty) {
        var btn = document.querySelector('.food-select-btn[data-food-id="' + foodId + '"]');
        if (!btn) return;
        if (newQty <= 0) {
            btn.remove();
            cancelFeed();
            if (document.querySelectorAll('.food-select-btn').length === 0) {
                var msg = document.createElement('span');
                msg.className = 'text-muted small'; msg.id = 'no-food-msg';
                msg.textContent = 'No food — complete tasks to earn drops';
                document.getElementById('food-bar-inner').appendChild(msg);
            }
        } else {
            btn.querySelector('.food-qty').textContent = newQty;
        }
    }

    // ── Active pet / mount ────────────────────────────────────────────────

    function setActivePet(petKey) {
        fetch('/Stable/SetActivePet', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'petKey=' + encodeURIComponent(petKey) + '&__RequestVerificationToken=' + encodeURIComponent(csrf())
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                showToast('🐾', 'Active Pet', petKey ? (petKey + ' is your companion!') : 'Pet unequipped.', 'toast-xp', 2500);
                setTimeout(() => location.reload(), 800);
            } else { showToast('❌', 'Error', d.error || 'Unknown error', 'toast-hp', 3000); }
        });
    }

    function setActiveMount(mountKey) {
        fetch('/Stable/SetActiveMount', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'mountKey=' + encodeURIComponent(mountKey) + '&__RequestVerificationToken=' + encodeURIComponent(csrf())
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                showToast('🐴', 'Mount', mountKey ? ('Now riding ' + mountKey + '!') : 'Dismounted.', 'toast-xp', 2500);
                setTimeout(() => location.reload(), 800);
            } else { showToast('❌', 'Error', d.error || 'Unknown error', 'toast-hp', 3000); }
        });
    }

    // ── Hatch tab ─────────────────────────────────────────────────────────

    function selectEgg(btn) {
        document.querySelectorAll('.hatch-egg-btn').forEach(b => { b.classList.remove('btn-primary','active'); b.classList.add('btn-outline-secondary'); });
        btn.classList.remove('btn-outline-secondary'); btn.classList.add('btn-primary','active');
        selectedEggId = parseInt(btn.dataset.id); selectedEggAnimal = btn.dataset.animal;
        var isQuest = btn.dataset.isquest === 'true';
        document.getElementById('potion-hint').style.display = isQuest ? 'inline' : 'none';
        document.querySelectorAll('.hatch-potion-btn').forEach(b => {
            var ok = !isQuest || b.dataset.isdrop === 'true';
            b.disabled = !ok; b.classList.toggle('opacity-50', !ok);
            if (!ok && b.classList.contains('active')) {
                b.classList.remove('btn-primary','active'); b.classList.add('btn-outline-secondary');
                selectedPotionId = null; selectedPotionColor = null;
            }
        });
        updateHatchPreview();
    }

    function selectPotion(btn) {
        if (btn.disabled) return;
        document.querySelectorAll('.hatch-potion-btn').forEach(b => { b.classList.remove('btn-primary','active'); b.classList.add('btn-outline-secondary'); });
        btn.classList.remove('btn-outline-secondary'); btn.classList.add('btn-primary','active');
        selectedPotionId = parseInt(btn.dataset.id); selectedPotionColor = btn.dataset.color;
        updateHatchPreview();
    }

    function updateHatchPreview() {
        var preview = document.getElementById('hatch-preview');
        var hatchBtn = document.getElementById('hatch-btn');
        if (!selectedEggAnimal || !selectedPotionColor) {
            preview.innerHTML = '<span class="text-muted small">Select egg + potion to preview</span>';
            hatchBtn.disabled = true; return;
        }
        var petKey = selectedEggAnimal + '-' + selectedPotionColor;
        var alreadyOwned = ownedPetKeys.includes(petKey);
        preview.innerHTML =
            '<img src="/images/habitica/stable/pets/Pet-' + petKey + '.png" width="64" height="64" style="image-rendering:pixelated;" onerror="this.style.opacity=\'.2\'" />' +
            '<div class="small mt-1">' + selectedEggAnimal + ' (' + selectedPotionColor + ')</div>' +
            (alreadyOwned ? '<div class="badge bg-secondary mt-1">Already hatched</div>' : '');
        hatchBtn.disabled = alreadyOwned;
    }

    function doHatch() {
        if (!selectedEggId || !selectedPotionId) return;
        var btn = document.getElementById('hatch-btn');
        btn.disabled = true; btn.textContent = 'Hatching…';
        fetch('/Stable/Hatch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'eggGameItemId=' + selectedEggId + '&potionGameItemId=' + selectedPotionId + '&__RequestVerificationToken=' + encodeURIComponent(csrf())
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                var imgHtml = '<img src="' + d.petImagePath + '" style="width:36px;height:36px;image-rendering:pixelated;" onerror="this.replaceWith(document.createTextNode(\'🥚\'))">';
                showToast(imgHtml, 'Pet Hatched!', d.petName + ' is now yours!', 'toast-drop', 5000);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast('❌', 'Hatch Failed', d.error || 'Unknown error', 'toast-hp', 3000);
                btn.disabled = false; btn.textContent = '🥚 Hatch!';
            }
        });
    }
</script>
}
