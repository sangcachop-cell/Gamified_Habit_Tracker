@model HabitTracker.Models.ViewModels.StableViewModel
@using HabitTracker.Constants
@using HabitTracker.Models.ViewModels
@{
    ViewData["Title"] = "Stable";
    var u = Model.User;

    var ownedPetKeys = System.Text.Json.JsonSerializer.Serialize(
        Model.OwnedPets.Select(p => p.PetKey).Concat(Model.OwnedMounts.Select(p => p.PetKey)).ToList());

    var eggAnimalMap = System.Text.Json.JsonSerializer.Serialize(
        Model.EggsInInventory
             .Where(i => i.GameItem?.AnimalKey != null)
             .ToDictionary(i => i.GameItemId, i => i.GameItem!.AnimalKey!));

    var potionColorMap = System.Text.Json.JsonSerializer.Serialize(
        Model.PotionsInInventory
             .Where(i => i.GameItem?.PotionColorKey != null)
             .ToDictionary(i => i.GameItemId, i => i.GameItem!.PotionColorKey!));

    // Quest egg IDs for hatch-tab potion gating
    var questEggIds = System.Text.Json.JsonSerializer.Serialize(
        Model.EggsInInventory
             .Where(i => i.GameItem?.IsDroppable == false)
             .Select(i => i.GameItemId)
             .ToHashSet());

    // Drop potion IDs for hatch-tab potion gating
    var dropPotionIds = System.Text.Json.JsonSerializer.Serialize(
        Model.PotionsInInventory
             .Where(i => i.GameItem?.IsDroppable == true)
             .Select(i => i.GameItemId)
             .ToHashSet());

    // Pet data map for offcanvas panel
    var petDataMap = System.Text.Json.JsonSerializer.Serialize(
        Model.OwnedPets.ToDictionary(
            p => p.PetKey,
            p => new { feedingPoints = p.FeedingPoints, isActive = p.PetKey == u.ActivePetKey, colorName = p.ColorName }));

    // Food inventory for offcanvas panel
    var foodItems = System.Text.Json.JsonSerializer.Serialize(
        Model.FoodInInventory.Select(f => new
        {
            id = f.GameItemId,
            name = f.GameItem?.Name ?? "",
            icon = f.GameItem?.Icon ?? "",
            qty = f.Quantity,
            target = f.GameItem?.Target ?? ""
        }).ToList());
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<!-- Pet action offcanvas panel -->
<div class="offcanvas offcanvas-bottom" tabindex="-1" id="petOffcanvas" style="height:auto;max-height:50vh;">
    <div class="offcanvas-header py-2">
        <h6 class="offcanvas-title mb-0" id="petOffcanvasLabel">Pet</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body pt-0 pb-3">
        <div class="d-flex gap-3 align-items-start flex-wrap">
            <img id="oc-pet-img" src="" width="64" height="64" style="image-rendering:pixelated;border-radius:6px;background:rgba(0,0,0,.04);" />
            <div class="flex-grow-1" style="min-width:200px;">
                <div class="fw-semibold" id="oc-pet-name"></div>
                <div class="text-muted small mb-1" id="oc-pet-color"></div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="progress flex-grow-1" style="height:8px;">
                        <div class="progress-bar bg-warning" id="oc-progress-bar" style="width:0%"></div>
                    </div>
                    <span class="small text-muted" id="oc-progress-label">0/50</span>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <select class="form-select form-select-sm" style="max-width:180px;font-size:.75rem;" id="oc-food-sel"></select>
                    <button class="btn btn-warning btn-sm" onclick="feedFromPanel()">🍖 Feed</button>
                    <button class="btn btn-outline-success btn-sm" id="oc-active-btn" onclick="toggleActivePetFromPanel()"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-4" style="max-width:1200px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">🐾 Stable</h2>
        <div class="text-muted small">
            @Model.OwnedPets.Count / @Model.TotalPetsInCatalog pets &nbsp;·&nbsp;
            @Model.OwnedMounts.Count / @Model.TotalMountsInCatalog mounts
        </div>
    </div>

    <ul class="nav nav-tabs mb-4" id="stableTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-pets-btn" data-bs-toggle="tab" data-bs-target="#tab-pets" type="button">
                🐾 Pets <span class="badge bg-secondary ms-1">@Model.OwnedPets.Count / @Model.TotalPetsInCatalog</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-mounts-btn" data-bs-toggle="tab" data-bs-target="#tab-mounts" type="button">
                🐴 Mounts <span class="badge bg-secondary ms-1">@Model.OwnedMounts.Count / @Model.TotalMountsInCatalog</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-hatch-btn" data-bs-toggle="tab" data-bs-target="#tab-hatch" type="button">
                🥚 Hatch
            </button>
        </li>
    </ul>

    <div class="tab-content" id="stableTabContent">

        <!-- ═══════════════════════════════════════════════════════════ PETS TAB -->
        <div class="tab-pane fade show active" id="tab-pets" role="tabpanel">
            @{
                string CategoryLabel(PetCategory cat) => cat switch
                {
                    PetCategory.Drop => "standard",
                    PetCategory.Premium => "premium",
                    PetCategory.Quest => "quest",
                    PetCategory.Wacky => "wacky",
                    PetCategory.Special => "special",
                    _ => ""
                };
                string BadgeColor(PetCategory cat) => cat switch
                {
                    PetCategory.Drop => "bg-primary",
                    PetCategory.Premium => "bg-warning text-dark",
                    PetCategory.Quest => "bg-success",
                    PetCategory.Wacky => "bg-danger",
                    PetCategory.Special => "bg-secondary",
                    _ => "bg-secondary"
                };
            }

            @foreach (var group in Model.PetsGrid)
            {
                int ownedCount = group.Slots.Count(s => s.IsOwned);
                string eggImgPath = group.Category == PetCategory.Special
                ? ""
                : $"/fe/stable/eggs/Pet_Egg_{group.AnimalKey}.png";

                <div class="animal-section mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        @if (!string.IsNullOrEmpty(eggImgPath))
                        {
                            <img src="@eggImgPath" width="24" height="24"
                                 style="image-rendering:pixelated;"
                                 onerror="this.style.display='none'" />
                        }
                        <span class="fw-semibold small">@group.DisplayName</span>
                        <span class="badge @BadgeColor(group.Category)" style="font-size:.6rem;">@CategoryLabel(group.Category)</span>
                        <span class="text-muted" style="font-size:.65rem;">@ownedCount / @group.Slots.Count</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var slot in group.Slots)
                        {
                            string slotClass = slot.IsMount ? "slot-is-mount" :
                            slot.IsOwned ? "slot-owned" : "slot-unowned";
                            string activeClass = slot.IsActivePet ? "slot-active-pet" : "";
                            int progressPct = slot.FeedingPoints * 2;

                            <div class="pet-slot @slotClass @activeClass"
                                 data-petkey="@slot.PetKey"
                                 title="@slot.ColorDisplayName@(slot.IsOwned ? $" ({slot.FeedingPoints}/50)" : "")"
                                 @(slot.IsOwned && !slot.IsMount ? $"onclick=\"openPetPanel('{slot.PetKey}')\"" : "")>
                                <img src="@slot.PetImagePath" width="48" height="48"
                                     style="image-rendering:pixelated;"
                                     onerror="this.style.opacity='.1'" />
                                @if (slot.IsOwned && !slot.IsMount)
                                {
                                    <div class="slot-progress"><div style="width:@progressPct%"></div></div>
                                }
                                @if (slot.IsActivePet)
                                {
                                    <div class="slot-badge">★</div>
                                }
                                @if (slot.IsMount)
                                {
                                    <div class="slot-badge mount-badge" title="Evolved to mount">🐴</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════ MOUNTS TAB -->
        <div class="tab-pane fade" id="tab-mounts" role="tabpanel">
            @foreach (var group in Model.MountsGrid)
            {
                int ownedCount = group.Slots.Count(s => s.IsOwned);

                <div class="animal-section mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fw-semibold small">@group.DisplayName</span>
                        <span class="text-muted" style="font-size:.65rem;">@ownedCount / @group.Slots.Count</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var slot in group.Slots)
                        {
                            string slotClass = slot.IsOwned ? "slot-owned" : "slot-unowned";
                            string activeClass = slot.IsActiveMount ? "slot-active-mount" : "";
                            string imgSrc = slot.MountIconPath ?? slot.PetImagePath;

                            <div class="pet-slot @slotClass @activeClass"
                                 data-mountkey="@slot.PetKey"
                                 title="@slot.ColorDisplayName"
                                 @(slot.IsOwned ? $"onclick=\"setActiveMount('{slot.PetKey}', this)\"" : "")>
                                <img src="@imgSrc" width="48" height="48"
                                     style="image-rendering:pixelated;"
                                     onerror="this.src='@slot.PetImagePath';this.onerror=null;" />
                                @if (slot.IsActiveMount)
                                {
                                    <div class="slot-badge">★</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            @if (!Model.OwnedMounts.Any())
            {
                <div class="text-muted text-center py-4">
                    <div style="font-size:2rem;">🐴</div>
                    <p class="mt-2 small">No mounts yet. Feed a pet to 50 pts to evolve it!</p>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════ HATCH TAB -->
        <div class="tab-pane fade" id="tab-hatch" role="tabpanel">
            @if (!Model.EggsInInventory.Any() || !Model.PotionsInInventory.Any())
            {
                <div class="text-muted text-center py-5">
                    <div style="font-size:3rem;">🧪</div>
                    @if (!Model.EggsInInventory.Any() && !Model.PotionsInInventory.Any())
                    {
                        <p>No eggs or potions in inventory. Complete tasks to earn drops!</p>
                    }
                    else if (!Model.EggsInInventory.Any())
                    {
                        <p>No eggs in inventory.</p>
                    }
                    else
                    {
                        <p>No potions in inventory.</p>
                    }
                </div>
            }
            else
            {
                <div class="row justify-content-center">
                    <div class="col-md-9 col-lg-7">
                        <div class="card p-4">
                            <h5 class="mb-3">🥚 Hatch a Pet</h5>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Select Egg</label>
                                <div class="d-flex flex-wrap gap-2" id="egg-grid">
                                    @foreach (var inv in Model.EggsInInventory)
                                    {
                                        bool isQuest = inv.GameItem?.IsDroppable == false;
                                        <button type="button"
                                                class="btn btn-outline-secondary hatch-egg-btn"
                                                data-id="@inv.GameItemId"
                                                data-animal="@inv.GameItem?.AnimalKey"
                                                data-isquest="@(isQuest ? "true" : "false")"
                                                onclick="selectEgg(this)"
                                                title="@inv.GameItem?.Name ×@inv.Quantity@(isQuest ? " (quest)" : "")">
                                            <img src="@inv.GameItem?.ImagePath" width="40" height="40"
                                                 style="image-rendering:pixelated;" /><br />
                                            <span style="font-size:.65rem;">×@inv.Quantity</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">
                                    Select Potion
                                    <span id="potion-hint" class="text-warning ms-2" style="font-size:.7rem;display:none;">
                                        Quest eggs use standard potions only
                                    </span>
                                </label>
                                <div class="d-flex flex-wrap gap-2" id="potion-grid">
                                    @foreach (var inv in Model.PotionsInInventory)
                                    {
                                        bool isDrop = inv.GameItem?.IsDroppable == true;
                                        <button type="button"
                                                class="btn btn-outline-secondary hatch-potion-btn"
                                                data-id="@inv.GameItemId"
                                                data-color="@inv.GameItem?.PotionColorKey"
                                                data-isdrop="@(isDrop ? "true" : "false")"
                                                onclick="selectPotion(this)"
                                                title="@inv.GameItem?.Name ×@inv.Quantity">
                                            <img src="@inv.GameItem?.ImagePath" width="40" height="40"
                                                 style="image-rendering:pixelated;"
                                                 onerror="this.style.opacity='.3'" /><br />
                                            <span style="font-size:.65rem;">×@inv.Quantity</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="text-center mb-3" id="hatch-preview" style="min-height:80px;">
                                <span class="text-muted small">Select egg + potion to preview</span>
                            </div>

                            <button id="hatch-btn" class="btn btn-primary w-100" disabled onclick="doHatch()">
                                🥚 Hatch!
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const csrf = () => document.querySelector('#csrf-form input[name="__RequestVerificationToken"]').value;
        const ownedPetKeys  = @Html.Raw(ownedPetKeys);
        const eggAnimalMap  = @Html.Raw(eggAnimalMap);
        const questEggIds   = @Html.Raw(questEggIds);
        const dropPotionIds = @Html.Raw(dropPotionIds);
        const petDataMap    = @Html.Raw(petDataMap);
        const foodItems     = @Html.Raw(foodItems);

        let selectedEggId      = null;
        let selectedPotionId   = null;
        let selectedEggAnimal  = null;
        let selectedPotionColor = null;
        let currentPanelPetKey = null;

        // ── Hatch tab ──────────────────────────────────────────────────────────

        function selectEgg(btn) {
            document.querySelectorAll('.hatch-egg-btn').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-primary', 'active');
            selectedEggId    = parseInt(btn.dataset.id);
            selectedEggAnimal = btn.dataset.animal;

            // Gate non-drop potions when quest egg selected
            const isQuest = btn.dataset.isquest === 'true';
            document.getElementById('potion-hint').style.display = isQuest ? 'inline' : 'none';
            document.querySelectorAll('.hatch-potion-btn').forEach(b => {
                const isAllowed = !isQuest || b.dataset.isdrop === 'true';
                b.disabled = !isAllowed;
                b.classList.toggle('opacity-50', !isAllowed);
                // Deselect if now disabled
                if (!isAllowed && b.classList.contains('active')) {
                    b.classList.remove('btn-primary', 'active');
                    b.classList.add('btn-outline-secondary');
                    selectedPotionId    = null;
                    selectedPotionColor = null;
                }
            });

            updateHatchPreview();
        }

        function selectPotion(btn) {
            if (btn.disabled) return;
            document.querySelectorAll('.hatch-potion-btn').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-primary', 'active');
            selectedPotionId    = parseInt(btn.dataset.id);
            selectedPotionColor = btn.dataset.color;
            updateHatchPreview();
        }

        function updateHatchPreview() {
            const preview  = document.getElementById('hatch-preview');
            const hatchBtn = document.getElementById('hatch-btn');
            if (!selectedEggAnimal || !selectedPotionColor) {
                preview.innerHTML = '<span class="text-muted small">Select egg + potion to preview</span>';
                hatchBtn.disabled = true;
                return;
            }
            const petKey  = `${selectedEggAnimal}-${selectedPotionColor}`;
            const imgPath = `/fe/stable/pets/Pet-${petKey}.png`;
            const alreadyOwned = ownedPetKeys.includes(petKey);

            preview.innerHTML = `
                <img src="${imgPath}" width="64" height="64" style="image-rendering:pixelated;"
                     onerror="this.style.opacity='.2'" />
                <div class="small mt-1">${selectedEggAnimal} (${selectedPotionColor})</div>
                ${alreadyOwned ? '<div class="badge bg-secondary mt-1">Already hatched</div>' : ''}
            `;
            hatchBtn.disabled = alreadyOwned;
        }

        async function doHatch() {
            if (!selectedEggId || !selectedPotionId) return;
            const btn = document.getElementById('hatch-btn');
            btn.disabled = true;
            btn.textContent = 'Hatching…';

            const r = await fetch('/Stable/Hatch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `eggGameItemId=${selectedEggId}&potionGameItemId=${selectedPotionId}&__RequestVerificationToken=${encodeURIComponent(csrf())}`
            });
            const d = await r.json();
            if (d.success) {
                const imgHtml = `<img src="${d.petImagePath}" style="width:36px;height:36px;image-rendering:pixelated;" onerror="this.replaceWith(document.createTextNode('🥚'))">`;
                showToast(imgHtml, 'Pet Hatched!', `${d.petName} is now yours!`, 'toast-drop', 5000);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast('❌', 'Hatch Failed', d.error || 'Unknown error', 'toast-hp', 3000);
                btn.disabled = false;
                btn.textContent = '🥚 Hatch!';
            }
        }

        // ── Pet offcanvas panel ────────────────────────────────────────────────

        function openPetPanel(petKey) {
            currentPanelPetKey = petKey;
            const data = petDataMap[petKey];
            if (!data) return;

            document.getElementById('petOffcanvasLabel').textContent = petKey;
            document.getElementById('oc-pet-img').src = `/fe/stable/pets/Pet-${petKey}.png`;
            document.getElementById('oc-pet-name').textContent = petKey.split('-')[0];
            document.getElementById('oc-pet-color').textContent = petKey.split('-').slice(1).join(' ');

            const pts = data.feedingPoints;
            document.getElementById('oc-progress-bar').style.width = `${pts * 2}%`;
            document.getElementById('oc-progress-label').textContent = `${pts}/50`;

            // Populate food select
            const sel = document.getElementById('oc-food-sel');
            sel.innerHTML = '';
            if (foodItems.length === 0) {
                sel.innerHTML = '<option disabled>No food</option>';
            } else {
                foodItems.forEach(f => {
                    const preferred = f.target === data.colorName;
                    const opt = document.createElement('option');
                    opt.value = f.id;
                    opt.textContent = `${f.icon} ${f.name} ×${f.qty}${preferred ? ' ★' : ''}`;
                    sel.appendChild(opt);
                });
            }

            const activeBtn = document.getElementById('oc-active-btn');
            if (data.isActive) {
                activeBtn.textContent = '★ Unequip';
                activeBtn.className = 'btn btn-outline-secondary btn-sm';
            } else {
                activeBtn.textContent = '☆ Make Active';
                activeBtn.className = 'btn btn-outline-success btn-sm';
            }

            const oc = bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('petOffcanvas'));
            oc.show();
        }

        function feedFromPanel() {
            if (!currentPanelPetKey) return;
            const foodId = parseInt(document.getElementById('oc-food-sel').value);
            if (isNaN(foodId)) return;

            fetch('/Stable/Feed', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `petKey=${encodeURIComponent(currentPanelPetKey)}&foodGameItemId=${foodId}&__RequestVerificationToken=${encodeURIComponent(csrf())}`
            })
            .then(r => r.json())
            .then(d => {
                if (!d.success) {
                    showToast('❌', 'Feed Failed', d.error || 'Unknown error', 'toast-hp', 3000);
                    return;
                }
                if (d.evolved) {
                    const imgHtml = d.mountIconPath
                        ? `<img src="${d.mountIconPath}" style="width:36px;height:36px;image-rendering:pixelated;" onerror="this.replaceWith(document.createTextNode('🐴'))">`
                        : '🐴';
                    showToast(imgHtml, 'Mount Raised!', `${currentPanelPetKey} evolved!`, 'toast-level', 5000);
                    setTimeout(() => location.reload(), 1800);
                } else {
                    showToast('🍖', 'Fed!', `${currentPanelPetKey}: ${d.newFeedingPoints}/50 pts`, 'toast-xp', 2500);

                    // Update progress bar in offcanvas
                    document.getElementById('oc-progress-bar').style.width = `${d.newFeedingPoints * 2}%`;
                    document.getElementById('oc-progress-label').textContent = `${d.newFeedingPoints}/50`;

                    // Update progress bar on the grid slot
                    const slot = document.querySelector(`.pet-slot[data-petkey="${currentPanelPetKey}"] .slot-progress > div`);
                    if (slot) slot.style.width = `${d.newFeedingPoints * 2}%`;

                    // Update petDataMap in memory
                    if (petDataMap[currentPanelPetKey]) petDataMap[currentPanelPetKey].feedingPoints = d.newFeedingPoints;

                    // Update food quantities
                    updateFoodQty(d.foodGameItemId, d.newFoodQuantity);
                }
            });
        }

        function updateFoodQty(foodId, newQty) {
            const idx = foodItems.findIndex(f => f.id === foodId);
            if (idx < 0) return;
            if (newQty <= 0) {
                foodItems.splice(idx, 1);
            } else {
                foodItems[idx] = { ...foodItems[idx], qty: newQty };
            }
            // Refresh offcanvas select if it's showing this food
            const sel = document.getElementById('oc-food-sel');
            const opt = sel.querySelector(`option[value="${foodId}"]`);
            if (!opt) return;
            if (newQty <= 0) {
                opt.remove();
            } else {
                opt.textContent = opt.textContent.replace(/×\d+/, `×${newQty}`);
            }
        }

        function toggleActivePetFromPanel() {
            if (!currentPanelPetKey) return;
            const data = petDataMap[currentPanelPetKey];
            const newKey = data?.isActive ? '' : currentPanelPetKey;
            setActivePet(newKey);
        }

        // ── Active pet / mount ────────────────────────────────────────────────

        function setActivePet(petKey) {
            fetch('/Stable/SetActivePet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `petKey=${encodeURIComponent(petKey)}&__RequestVerificationToken=${encodeURIComponent(csrf())}`
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    const label = petKey ? `${petKey} is your companion!` : 'Pet unequipped.';
                    showToast('🐾', 'Active Pet', label, 'toast-xp', 2500);
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast('❌', 'Error', d.error || 'Unknown error', 'toast-hp', 3000);
                }
            });
        }

        function setActiveMount(mountKey, slotEl) {
            // If clicking active mount, dismount
            const isActive = slotEl && slotEl.classList.contains('slot-active-mount');
            const newKey = isActive ? '' : mountKey;

            fetch('/Stable/SetActiveMount', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `mountKey=${encodeURIComponent(newKey)}&__RequestVerificationToken=${encodeURIComponent(csrf())}`
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    const label = newKey ? `Now riding ${newKey}!` : 'Dismounted.';
                    showToast('🐴', 'Mount', label, 'toast-xp', 2500);
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast('❌', 'Error', d.error || 'Unknown error', 'toast-hp', 3000);
                }
            });
        }
    </script>
}
