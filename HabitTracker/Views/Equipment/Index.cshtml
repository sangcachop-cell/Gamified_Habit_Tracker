@model HabitTracker.Models.ViewModels.EquipmentViewModel
@{
    ViewData["Title"] = "Equipment";
    var u = Model.User;
    var es = Model.Stats;

    var primarySlots = new[] { "weapon", "armor", "head", "shield" };

    string SlotIcon(string slot) => slot switch
    {
        "weapon" => "⚔️",
        "armor" => "🛡️",
        "head" => "🪖",
        "shield" => "🔰",
        "back" => "🌊",
        "eyewear" => "👓",
        "headAccessory" => "🎀",
        "body" => "👘",
        _ => "📦"
    };

    var equippedGear = new Dictionary<string, HabitTracker.Models.GearItem?>();
    foreach (var slot in primarySlots)
    {
        string? key = Model.EquippedKeys.GetValueOrDefault(slot);
        if (key != null && Model.OwnedBySlot.TryGetValue(slot, out var items))
            equippedGear[slot] = items.FirstOrDefault(g => g.Key == key);
        else
            equippedGear[slot] = null;
    }

    var armorGear = equippedGear.GetValueOrDefault("armor");
    var headGear = equippedGear.GetValueOrDefault("head");
    var shieldGear = equippedGear.GetValueOrDefault("shield");
    var weaponGear = equippedGear.GetValueOrDefault("weapon");
    bool weaponIs2H = weaponGear?.TwoHanded ?? false;
    string bodyType = u.BodyType ?? "broad";
    bool isMounted = !string.IsNullOrEmpty(u.ActiveMountKey);
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<style>
    .equipment-page {
        max-width: 1320px;
        margin: 18px auto;
        padding: 0 14px;
    }

    .equipment-shell {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 26px;
        padding: 22px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
    }

    .equipment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 18px;
    }

    .equipment-title-wrap {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .equipment-title {
        margin: 0;
        font-size: 32px;
        font-weight: 900;
        color: #111827;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .back-btn {
        border: 1px solid #d1d5db;
        color: #475569;
        background: #fff;
        border-radius: 10px;
        padding: 8px 14px;
        text-decoration: none;
        font-weight: 700;
    }

        .back-btn:hover {
            background: #f8fafc;
            color: #111827;
        }

    .mode-box {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-weight: 700;
    }

    .equipment-layout {
        display: grid;
        grid-template-columns: 420px 1fr 440px;
        gap: 20px;
        align-items: stretch;
    }

    .equip-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: #fff;
        overflow: hidden;
        margin-bottom: 14px;
    }

    .equip-card-header {
        padding: 14px 18px;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 900;
        color: #475569;
        letter-spacing: .04em;
        font-size: 14px;
        background: #fafafa;
    }

    .equipped-row {
        display: grid;
        grid-template-columns: 54px 1fr 42px;
        gap: 12px;
        align-items: center;
        padding: 14px 18px;
        border-bottom: 1px solid #eef2f7;
    }

        .equipped-row:last-child {
            border-bottom: none;
        }

    .gear-img-box {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .gear-img-box img {
            image-rendering: pixelated;
            max-width: 36px;
            max-height: 36px;
        }

    .gear-name {
        font-weight: 800;
        color: #111827;
        line-height: 1.15;
    }

    .gear-stats {
        font-size: 13px;
        color: #64748b;
        font-weight: 700;
    }

    .unequip-btn {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        padding: 0;
        font-weight: 900;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        text-align: center;
        border-bottom: 1px solid #e5e7eb;
    }

    .stat-mini {
        padding: 16px 8px;
        border-right: 1px solid #e5e7eb;
    }

        .stat-mini:last-child {
            border-right: none;
        }

        .stat-mini .icon {
            font-size: 22px;
            margin-bottom: 4px;
        }

        .stat-mini .label {
            font-size: 13px;
            color: #64748b;
            font-weight: 800;
        }

        .stat-mini .value {
            font-size: 22px;
            font-weight: 900;
            color: #111827;
        }

    .sub-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        padding: 14px;
    }

    .sub-stat-box {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 12px;
        text-align: center;
        background: #fff;
    }

        .sub-stat-box .value {
            font-size: 20px;
            font-weight: 900;
        }

    .preview-card {
        height: 100%;
        min-height: 560px;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        background: linear-gradient(180deg, #ffffff, #faf5ff);
        padding: 22px 16px;
        text-align: center;
        position: relative;
    }

    .preview-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        color: #7c3aed;
        font-weight: 900;
        margin-bottom: 26px;
        letter-spacing: .06em;
    }

        .preview-title::before,
        .preview-title::after {
            content: "";
            width: 80px;
            height: 2px;
            background: #ddd6fe;
        }

    .preview-stage {
        position: relative;
        width: 330px;
        height: 350px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .preview-stage::before {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            border-radius: 999px;
            border: 16px solid rgba(167, 139, 250, .18);
        }

        .preview-stage::after {
            content: "";
            position: absolute;
            bottom: 78px;
            width: 190px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(180deg, #bbf7d0, #86efac);
            border: 4px solid #6366f1;
            box-shadow: 0 10px 20px rgba(15, 23, 42, .16);
        }

    #avatar-preview {
        position: relative;
        z-index: 2;
        transform: scale(1.6);
        image-rendering: pixelated;
    }

    .gear-slot-orbit {
        position: absolute;
        width: 54px;
        height: 54px;
        border-radius: 14px;
        border: 2px solid #c4b5fd;
        background: rgba(255,255,255,.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        box-shadow: 0 8px 20px rgba(15,23,42,.08);
    }

        .gear-slot-orbit img {
            image-rendering: pixelated;
            max-width: 38px;
            max-height: 38px;
        }

    .orbit-head {
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
    }

    .orbit-weapon {
        left: 22px;
        top: 140px;
    }

    .orbit-armor {
        right: 22px;
        top: 140px;
    }

    .orbit-shield {
        left: 44px;
        bottom: 90px;
        opacity: .75;
    }

    .orbit-extra {
        right: 44px;
        bottom: 90px;
        opacity: .55;
    }

    .bonus-card {
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #fff;
        padding: 18px;
        margin-top: 12px;
    }

    .bonus-title {
        color: #7c3aed;
        font-weight: 900;
        margin-bottom: 12px;
        text-align: center;
    }

    .bonus-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        text-align: center;
    }

        .bonus-grid > div {
            border-right: 1px solid #e5e7eb;
        }

            .bonus-grid > div:last-child {
                border-right: none;
            }

    .bonus-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 800;
    }

    .bonus-value {
        font-size: 20px;
        font-weight: 900;
        color: #7c3aed;
    }

    .inventory-card {
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        background: #fff;
        overflow: hidden;
        height: 100%;
    }

    .equip-tabs {
        display: flex;
        border-bottom: 1px solid #e5e7eb;
        padding: 0 16px;
    }

        .equip-tabs .nav-link {
            border: 0;
            color: #64748b;
            font-weight: 900;
            padding: 16px 24px;
            border-radius: 16px 16px 0 0;
        }

            .equip-tabs .nav-link.active {
                color: #7c3aed;
                background: #f5f3ff;
                border-bottom: 3px solid #a78bfa;
            }

    .inventory-scroll {
        max-height: 610px;
        overflow-y: auto;
        padding: 16px;
    }

    .slot-section-title {
        font-size: 13px;
        font-weight: 900;
        color: #64748b;
        margin: 10px 0 8px;
        text-transform: uppercase;
    }

    .item-row {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 11px 12px;
        border: 1px solid transparent;
        border-radius: 14px;
        margin-bottom: 8px;
        transition: .15s ease;
    }

        .item-row:hover {
            background: #f8fafc;
        }

        .item-row.equipped {
            background: #f5f3ff;
            border-color: #a78bfa;
        }

        .item-row img {
            image-rendering: pixelated;
            max-width: 36px;
            max-height: 36px;
        }

    .item-name {
        font-weight: 800;
        color: #111827;
        line-height: 1.15;
    }

    .item-stat {
        font-size: 13px;
        color: #64748b;
        font-weight: 700;
    }

    .tip-bar {
        margin-top: 16px;
        padding: 13px 18px;
        border: 1px solid #bae6fd;
        background: linear-gradient(90deg, #e0f2fe, #eff6ff);
        border-radius: 14px;
        color: #075985;
        font-weight: 700;
    }

    @@media (max-width: 1200px) {
        .equipment-layout {
            grid-template-columns: 1fr;
        }

        .preview-card {
            min-height: auto;
        }

        .inventory-scroll {
            max-height: 520px;
        }
    }
</style>

<div class="equipment-page">
    <div class="equipment-shell">

        <div class="equipment-header">
            <div class="equipment-title-wrap">
                <a href="/Character" class="back-btn">← Back to Character</a>
                <h2 class="equipment-title">
                    <span>⚔️</span>
                    <span>Equipment</span>
                </h2>
            </div>

            <div class="mode-box">
                <span>Mode:</span>
                <button id="btn-toggle-costume" class="btn btn-sm @(u.CostumeModeEnabled ? "btn-warning" : "btn-outline-secondary")"
                        title="@(u.CostumeModeEnabled ? "Costume mode ON — stats from Battle Gear" : "Battle Gear mode")">
                    @(u.CostumeModeEnabled ? "🎭 Costume" : "⚔️ Battle Gear")
                </button>
            </div>
        </div>

        <div class="equipment-layout">

            <div>
                <div class="equip-card">
                    <div class="equip-card-header">EQUIPPED GEAR</div>

                    @foreach (var slot in primarySlots)
                    {
                        var eqKey = Model.EquippedKeys.GetValueOrDefault(slot);
                        var eqItem = equippedGear.GetValueOrDefault(slot);

                        <div class="equipped-row slot-row" data-slot="@slot" id="slot-@slot">
                            <div class="gear-img-box">
                                @if (eqItem != null)
                                {
                                    <img src="@eqItem.ShopImagePath" onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <span style="font-size:22px;">@SlotIcon(slot)</span>
                                    <img src="" style="display:none;" id="slot-img-@slot" />
                                }
                            </div>

                            @if (eqItem != null)
                            {
                                <div>
                                    <div class="gear-name" id="slot-name-@slot">@eqItem.Name</div>
                                    <div class="gear-stats" id="slot-stats-@slot">
                                        @(eqItem.STR > 0 ? $"STR +{eqItem.STR} " : "")@(eqItem.CON > 0 ? $"CON +{eqItem.CON} " : "")@(eqItem.INT > 0 ? $"INT +{eqItem.INT} " : "")@(eqItem.PER > 0 ? $"PER +{eqItem.PER}" : "")
                                    </div>
                                </div>

                                <button class="btn btn-outline-danger btn-sm unequip-btn" onclick="unequipSlot('@slot')">
                                    ✕
                                </button>
                            }
                            else
                            {
                                <div>
                                    <div class="gear-name text-muted fst-italic" id="slot-name-@slot">Empty</div>
                                    <div class="gear-stats" id="slot-stats-@slot"></div>
                                </div>

                                <button class="btn btn-outline-danger btn-sm unequip-btn"
                                        style="display:none;"
                                        id="slot-unequip-@slot"
                                        onclick="unequipSlot('@slot')">
                                    ✕
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="equip-card">
                    <div class="equip-card-header">EFFECTIVE STATS</div>

                    <div class="stats-grid">
                        <div class="stat-mini">
                            <div class="icon">⚔️</div>
                            <div class="label">STR</div>
                            <div class="value" id="stat-STR">@es.STR</div>
                        </div>

                        <div class="stat-mini">
                            <div class="icon">🛡️</div>
                            <div class="label">CON</div>
                            <div class="value" id="stat-CON">@es.CON</div>
                        </div>

                        <div class="stat-mini">
                            <div class="icon">✨</div>
                            <div class="label">INT</div>
                            <div class="value" id="stat-INT">@es.INT</div>
                        </div>

                        <div class="stat-mini">
                            <div class="icon">👁️</div>
                            <div class="label">PER</div>
                            <div class="value" id="stat-PER">@es.PER</div>
                        </div>
                    </div>

                    <div class="sub-stats">
                        <div class="sub-stat-box">
                            <div class="gear-stats">💙 Max Mana</div>
                            <div class="value" id="stat-MaxMana">@es.MaxMana</div>
                        </div>

                        <div class="sub-stat-box">
                            <div class="gear-stats">❤️ Max HP</div>
                            <div class="value">@es.MaxHP</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="preview-card">
                <div class="preview-title">PREVIEW</div>

                <div class="preview-stage">

                    @if (headGear != null)
                    {
                        <div class="gear-slot-orbit orbit-head">
                            <img src="@headGear.ShopImagePath" onerror="this.style.display='none'" />
                        </div>
                    }

                    @if (weaponGear != null)
                    {
                        <div class="gear-slot-orbit orbit-weapon">
                            <img src="@weaponGear.ShopImagePath" onerror="this.style.display='none'" />
                        </div>
                    }

                    @if (armorGear != null)
                    {
                        <div class="gear-slot-orbit orbit-armor">
                            <img src="@armorGear.ShopImagePath" onerror="this.style.display='none'" />
                        </div>
                    }

                    @if (shieldGear != null)
                    {
                        <div class="gear-slot-orbit orbit-shield">
                            <img src="@shieldGear.ShopImagePath" onerror="this.style.display='none'" />
                        </div>
                    }

                    <div class="gear-slot-orbit orbit-extra">
                        <span>💍</span>
                    </div>

                    <div id="avatar-preview"
                         style="position:relative; width:141px; height:147px; box-sizing:border-box; padding-top:@(isMounted ? "0" : "24")px; overflow:visible;">
                        <div style="position:relative; margin-left:24px; width:90px; height:90px;">
                            @if (isMounted)
                            {
                                <img src="/fe/stable/mounts/body/Mount_Body_@(u.ActiveMountKey).png"
                                     style="position:absolute;top:0;left:0;image-rendering:pixelated;" />
                            }

                            <img id="layer-skin"
                                 src="/fe/customize/skin/skin_@(u.SkinColor ?? "915533").png"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />

                            <img id="layer-shirt"
                                 src="/fe/customize/shirts/@(bodyType)_shirt_@(u.ShirtStyle ?? "black").png"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />

                            <img id="layer-armor"
                                 src="@(armorGear != null ? armorGear.GetWornImagePath(bodyType) : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(armorGear == null ? "display:none;" : "")" />

                            <img id="layer-bangs"
                                 src="@(u.HairBangs > 0 ? $"/fe/customize/hair/hair_bangs_{u.HairBangs}_{u.HairColor}.png" : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(u.HairBangs == 0 ? "display:none;" : "")" />

                            <img id="layer-hair"
                                 src="/fe/customize/hair/hair_base_@(u.HairStyle > 0 ? u.HairStyle : 1)_@(u.HairColor ?? "black").png"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />

                            <img id="layer-mustache"
                                 src="@(u.HairMustache > 0 ? $"/fe/customize/beards/hair_mustache_{u.HairMustache}_{u.HairColor}.png" : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(u.HairMustache == 0 ? "display:none;" : "")" />

                            <img id="layer-beard"
                                 src="@(u.HairBeard > 0 ? $"/fe/customize/beards/hair_beard_{u.HairBeard}_{u.HairColor}.png" : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(u.HairBeard == 0 ? "display:none;" : "")" />

                            <img id="layer-head"
                                 src="@(headGear != null ? headGear.GetWornImagePath(bodyType) : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(headGear == null ? "display:none;" : "")" />

                            <img id="layer-shield"
                                 src="@(shieldGear != null && !weaponIs2H ? shieldGear.GetWornImagePath(bodyType) : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(shieldGear == null || weaponIs2H ? "display:none;" : "")" />

                            <img id="layer-weapon"
                                 src="@(weaponGear != null ? weaponGear.GetWornImagePath(bodyType) : "")"
                                 style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(weaponGear == null ? "display:none;" : "")" />

                            @if (isMounted)
                            {
                                <img src="/fe/stable/mounts/head/Mount_Head_@(u.ActiveMountKey).png"
                                     style="position:absolute;top:0;left:0;image-rendering:pixelated;" />
                            }

                            @if (!string.IsNullOrEmpty(u.ActivePetKey) && !isMounted)
                            {
                                <img src="/fe/stable/pets/Pet-@(u.ActivePetKey).png"
                                     style="position:absolute;bottom:0;left:0;image-rendering:pixelated;" />
                            }
                        </div>
                    </div>
                </div>

                @if (u.CostumeModeEnabled)
                {
                    <div class="small text-warning mt-2 text-center">
                        🎭 Costume mode<br>
                        <span class="text-muted" style="font-size:0.7rem;">Stats come from battle gear</span>
                    </div>
                }

                <div class="bonus-card">
                    <div class="bonus-title">TOTAL BONUS</div>
                    <div class="bonus-grid">
                        <div>
                            <div class="bonus-label">STR</div>
                            <div class="bonus-value">+@((weaponGear?.STR ?? 0) + (armorGear?.STR ?? 0) + (headGear?.STR ?? 0) + (shieldGear?.STR ?? 0))</div>
                        </div>
                        <div>
                            <div class="bonus-label">CON</div>
                            <div class="bonus-value">+@((weaponGear?.CON ?? 0) + (armorGear?.CON ?? 0) + (headGear?.CON ?? 0) + (shieldGear?.CON ?? 0))</div>
                        </div>
                        <div>
                            <div class="bonus-label">INT</div>
                            <div class="bonus-value">+@((weaponGear?.INT ?? 0) + (armorGear?.INT ?? 0) + (headGear?.INT ?? 0) + (shieldGear?.INT ?? 0))</div>
                        </div>
                        <div>
                            <div class="bonus-label">PER</div>
                            <div class="bonus-value">+@((weaponGear?.PER ?? 0) + (armorGear?.PER ?? 0) + (headGear?.PER ?? 0) + (shieldGear?.PER ?? 0))</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="inventory-card">
                <ul class="nav equip-tabs" id="equipTabs">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-inventory">
                            📦 Inventory
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-shop">
                            🛒 Shop
                        </button>
                    </li>
                </ul>

                <div class="tab-content inventory-scroll">
                    <div class="tab-pane fade show active" id="tab-inventory">
                        @if (!Model.OwnedBySlot.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <div class="fs-1">📦</div>
                                <div>No gear yet — visit the Shop tab!</div>
                                @if (string.IsNullOrEmpty(u.Class))
                                {
                                    <div class="mt-2 small text-warning">Choose a class first to see class gear.</div>
                                }
                            </div>
                        }
                        else
                        {
                            foreach (var slot in primarySlots)
                            {
                                if (!Model.OwnedBySlot.TryGetValue(slot, out var items) || !items.Any())
                                    continue;

                                <div class="slot-section-title">@SlotIcon(slot) @slot</div>

                                foreach (var item in items)
                                {
                                    bool isEquipped = Model.EquippedKeys.GetValueOrDefault(slot) == item.Key;

                                    <div class="item-row @(isEquipped ? "equipped" : "")">
                                        <div class="gear-img-box">
                                            <img src="@item.ShopImagePath" onerror="this.style.display='none'" />
                                        </div>

                                        <div>
                                            <div class="item-name">@item.Name</div>
                                            <div class="item-stat">
                                                @(item.STR > 0 ? $"STR +{item.STR} " : "")@(item.CON > 0 ? $"CON +{item.CON} " : "")@(item.INT > 0 ? $"INT +{item.INT} " : "")@(item.PER > 0 ? $"PER +{item.PER}" : "")
                                                @if (item.TwoHanded)
                                                {
                                                    <span class="badge bg-secondary ms-1" style="font-size:0.6rem;">2H</span>
                                                }
                                            </div>
                                        </div>

                                        @if (isEquipped)
                                        {
                                            <span class="badge bg-primary">Equipped</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" onclick="equipItem('@item.Key')">
                                                Equip
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>

                    <div class="tab-pane fade" id="tab-shop">
                        @if (!Model.ShopBySlot.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <div class="fs-1">🛒</div>
                                @if (string.IsNullOrEmpty(u.Class))
                                {
                                    <div>Choose a class first to unlock your class shop.</div>
                                    <a href="/Character/SelectClass" class="btn btn-warning btn-sm mt-2">Choose Class</a>
                                }
                                else
                                {
                                    <div>No items available.</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted mb-2">
                                💰 You have <strong id="gold-display">@u.Gold.ToString("F0") GP</strong>
                            </div>

                            foreach (var slot in primarySlots)
                            {
                                if (!Model.ShopBySlot.TryGetValue(slot, out var items) || !items.Any())
                                    continue;

                                <div class="slot-section-title">@SlotIcon(slot) @slot</div>

                                foreach (var item in items)
                                {
                                    bool owned = Model.OwnedKeys.Contains(item.Key);
                                    bool canAfford = u.Gold >= item.GoldCost;

                                    <div class="item-row" style="opacity:@(owned ? "0.6" : "1");">
                                        <div class="gear-img-box">
                                            <img src="@item.ShopImagePath" onerror="this.style.display='none'" />
                                        </div>

                                        <div>
                                            <div class="item-name">@item.Name</div>
                                            <div class="item-stat">
                                                @(item.STR > 0 ? $"STR +{item.STR} " : "")@(item.CON > 0 ? $"CON +{item.CON} " : "")@(item.INT > 0 ? $"INT +{item.INT} " : "")@(item.PER > 0 ? $"PER +{item.PER}" : "")
                                                @if (item.TwoHanded)
                                                {
                                                    <span class="badge bg-secondary ms-1" style="font-size:0.6rem;">2H</span>
                                                }
                                            </div>
                                        </div>

                                        @if (owned)
                                        {
                                            <span class="badge bg-success">Owned</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm @(canAfford ? "btn-outline-warning" : "btn-outline-secondary")"
                                                    onclick="buyItem('@item.Key', this)"
                                                    @(!canAfford ? "disabled" : "")
                                                    title="@item.GoldCost GP">
                                                🪙 @item.GoldCost
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

        </div>

        <div class="tip-bar">
            ✨ Equip the best gear to increase your stats and become stronger!
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const token = () => $('input[name="__RequestVerificationToken"]').first().val();

            function updateAvatarLayer(slot, imgPath, twoHanded) {
                var layerId = '#layer-' + slot;
                if (!imgPath) {
                    $(layerId).hide().attr('src', '');
                } else {
                    $(layerId).attr('src', imgPath).show();
                }
                if (slot === 'weapon' && twoHanded) {
                    $('#layer-shield').hide();
                }
                if (slot === 'weapon' && !twoHanded) {
                    var shieldSrc = $('#layer-shield').attr('src');
                    if (shieldSrc) $('#layer-shield').show();
                }
            }

            function updateStats(s) {
                if (!s) return;
                $('#stat-STR').text(s.str !== undefined ? s.str : s.STR);
                $('#stat-CON').text(s.con !== undefined ? s.con : s.CON);
                $('#stat-INT').text(s.int !== undefined ? s.int : s.INT);
                $('#stat-PER').text(s.per !== undefined ? s.per : s.PER);
                $('#stat-MaxMana').text(s.maxMana !== undefined ? s.maxMana : s.MaxMana);
            }

            window.equipItem = function (key) {
                $.ajax({
                    url: '/Equipment/Equip?key=' + encodeURIComponent(key),
                    method: 'POST',
                    data: { __RequestVerificationToken: token() },
                    success: function (r) {
                        if (!r.success) {
                            showToast('❌', 'Error', r.error, 'toast-death', 3500);
                            return;
                        }
                        updateAvatarLayer(r.slot, r.wornImgPath, r.twoHanded);
                        updateStats(r.newStats);
                        refreshHud();
                        showToast('⚔️', 'Equipped!', r.itemName + ' equipped.', 'toast-xp', 2000);
                        location.reload();
                    },
                    error: function () {
                        showToast('❌', 'Error', 'Request failed.', 'toast-death', 3000);
                    }
                });
            };

            window.unequipSlot = function (slot) {
                $.ajax({
                    url: '/Equipment/Unequip?slot=' + slot,
                    method: 'POST',
                    data: { __RequestVerificationToken: token() },
                    success: function (r) {
                        if (!r.success) {
                            showToast('❌', 'Error', r.error, 'toast-death', 3500);
                            return;
                        }
                        updateAvatarLayer(slot, null, false);
                        updateStats(r.newStats);
                        refreshHud();
                        showToast('📦', 'Unequipped', slot + ' slot cleared.', 'toast-gold', 2000);
                        location.reload();
                    },
                    error: function () {
                        showToast('❌', 'Error', 'Request failed.', 'toast-death', 3000);
                    }
                });
            };

            window.buyItem = function (key, btn) {
                $(btn).prop('disabled', true);
                $.ajax({
                    url: '/Equipment/Buy?key=' + encodeURIComponent(key),
                    method: 'POST',
                    data: { __RequestVerificationToken: token() },
                    success: function (r) {
                        if (!r.success) {
                            showToast('❌', 'Error', r.error, 'toast-death', 3500);
                            $(btn).prop('disabled', false);
                            return;
                        }
                        refreshHud();
                        $('#gold-display').text(Math.round(r.newGold) + ' GP');
                        showToast('🛒', 'Purchased!', r.itemName + ' added to inventory.', 'toast-gold', 2500);
                        location.reload();
                    },
                    error: function () {
                        showToast('❌', 'Error', 'Request failed.', 'toast-death', 3000);
                        $(btn).prop('disabled', false);
                    }
                });
            };

            $('#btn-toggle-costume').on('click', function () {
                $.ajax({
                    url: '/Equipment/ToggleCostume',
                    method: 'POST',
                    data: { __RequestVerificationToken: token() },
                    success: function (r) {
                        if (!r.success) return;
                        location.reload();
                    }
                });
            });

        })();
    </script>
}