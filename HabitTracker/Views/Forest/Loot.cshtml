@using HabitTracker.Models
@using HabitTracker.Constants
@using HabitTracker.Controllers
@{
    ViewData["Title"] = "Loot";
    Layout = null;

    var session = ViewBag.Session as ForestSession;

    int bodyCols = ViewBag.BodyCols ?? 4;
    int bodyRows = ViewBag.BodyRows ?? 2;

    var pocketItems = ViewBag.PocketItems as List<PlacedItem> ?? new();
    var backpackItems = ViewBag.BackpackItems as List<PlacedItem> ?? new();
    var rigItems = ViewBag.RigItems as List<PlacedItem> ?? new();

    bool hasBackpack = ViewBag.HasBackpack ?? false;
    bool hasRig = ViewBag.HasRig ?? false;

    const int CELL = 64;

    var (pCols, pRows) = ItemCatalogue.ContainerSize(ItemCatalogue.BACKPACK);
    var (bpCols, bpRows) = ItemCatalogue.ContainerSize(ItemCatalogue.EQUIPPED_BACKPACK);
    var (rCols, rRows) = ItemCatalogue.ContainerSize(ItemCatalogue.EQUIPPED_RIG);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chiến lợi phẩm</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #061007;
            --panel: rgba(5, 25, 8, .82);
            --panel2: rgba(8, 35, 12, .72);
            --green: #3adb64;
            --gold: #ffd166;
            --orange: #d6911f;
            --red: #e74c3c;
            --text: #ffffff;
            --muted: rgba(255,255,255,.58);
            --border: rgba(255,255,255,.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: "Be Vietnam Pro", sans-serif;
            color: var(--text);
            background:
                linear-gradient(rgba(2,8,3,.86), rgba(2,8,3,.92)),
                url('/fe/loot/forest-hero.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background:
                radial-gradient(circle at 20% 20%, rgba(58,219,100,.12), transparent 28%),
                radial-gradient(circle at 80% 0%, rgba(124,77,255,.14), transparent 30%),
                radial-gradient(circle at 50% 100%, rgba(255,209,102,.08), transparent 34%);
            z-index: -1;
        }

        .loot-wrap {
            max-width: 1380px;
            margin: 42px auto;
            padding: 34px 38px;
            border-radius: 30px;
            background:
                linear-gradient(135deg, rgba(9,45,13,.9), rgba(6,28,10,.86)),
                radial-gradient(circle at top, rgba(58,219,100,.15), transparent 40%);
            border: 1px solid rgba(58,219,100,.22);
            box-shadow:
                0 24px 80px rgba(0,0,0,.55),
                inset 0 0 90px rgba(0,0,0,.25);
        }

        .loot-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .loot-title {
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 800;
            color: var(--gold);
            letter-spacing: -1px;
            text-shadow: 0 0 25px rgba(255,209,102,.18);
        }

        .loot-sub {
            color: var(--muted);
            font-size: .9rem;
            margin-top: 8px;
        }

        .layout {
            display: grid;
            grid-template-columns: 390px 1fr;
            gap: 28px;
            align-items: start;
        }

        .panel {
            background: rgba(0,0,0,.28);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 22px;
            padding: 18px 20px;
            box-shadow: inset 0 0 40px rgba(0,0,0,.18);
        }

        .panel.body {
            border-color: rgba(231,76,60,.38);
            background:
                linear-gradient(135deg, rgba(80,12,18,.28), rgba(0,0,0,.22));
        }

        .panel.inv {
            border-color: rgba(58,219,100,.24);
        }

        .panel-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            color: rgba(255,255,255,.68);
            font-size: .82rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .pt-meta {
            color: rgba(255,255,255,.38);
            font-size: .72rem;
            letter-spacing: .04em;
            white-space: nowrap;
        }

        .grid-box {
            position: relative;
            margin: 0 auto;
            background-color: rgba(0,0,0,.76);
            background-image:
                linear-gradient(rgba(58,219,100,.78) 2px, transparent 2px),
                linear-gradient(90deg, rgba(58,219,100,.78) 2px, transparent 2px);
            background-size: 64px 64px;
            background-position: 0 0;
            border: 2px solid rgba(58,219,100,.75);
            border-radius: 8px;
            box-shadow:
                inset 0 0 0 2px rgba(0,0,0,.75),
                0 0 24px rgba(58,219,100,.08);
            box-sizing: content-box;
        }

        .panel.body .grid-box {
            border-color: rgba(231,76,60,.9);
        }

        .grid-box.drop-active {
            border-color: var(--gold) !important;
            box-shadow:
                inset 0 0 0 2px rgba(255,209,102,.34),
                0 0 28px rgba(255,209,102,.22);
        }

        .stack {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .item {
            position: absolute;
            cursor: grab;
            border-radius: 10px;
            box-sizing: border-box;
            border: 2px solid rgba(255,255,255,.18);
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
            overflow: hidden;
            background: rgba(0,0,0,.4);
            transition: box-shadow .12s, transform .12s, opacity .12s;
        }

        .item:hover {
            transform: translateY(-1px);
            box-shadow:
                0 0 0 2px rgba(255,255,255,.26) inset,
                0 0 18px rgba(255,209,102,.12);
        }

        .item.dragging {
            opacity: .35;
        }

        .item-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            pointer-events: none;
            border-radius: 6px;
        }

        .item-icon-img {
            width: 76%;
            height: 76%;
            object-fit: contain;
            pointer-events: none;
            filter: drop-shadow(0 6px 10px rgba(0,0,0,.45));
        }

        .item-emoji {
            pointer-events: none;
            font-size: 1.85rem;
            line-height: 1;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,.45));
        }

        .item-qty {
            position: absolute;
            right: 5px;
            bottom: 3px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            background: rgba(0,0,0,.72);
            color: white;
            display: grid;
            place-items: center;
            font-size: .68rem;
            font-weight: 800;
            border: 1px solid rgba(255,255,255,.18);
        }

        .trash-zone {
            background: rgba(231,76,60,.1);
            border: 2px dashed rgba(231,76,60,.42);
            border-radius: 16px;
            padding: 18px;
            margin-top: 10px;
            text-align: center;
            font-size: .86rem;
            color: rgba(255,130,115,.9);
            font-weight: 800;
        }

        .trash-zone.drop-active {
            background: rgba(231,76,60,.28);
            color: white;
        }

        .empty-msg {
            color: var(--muted);
            text-align: center;
            padding: 24px 10px;
            font-size: .86rem;
            line-height: 1.7;
        }

        .empty-msg a {
            color: var(--gold);
            text-decoration: none;
            font-weight: 800;
        }

        .actions-row {
            display: flex;
            justify-content: center;
            gap: 14px;
            margin-top: 28px;
            flex-wrap: wrap;
        }

        .btn-loot {
            border: none;
            border-radius: 16px;
            color: white;
            font-weight: 800;
            font-size: .95rem;
            padding: 15px 28px;
            cursor: pointer;
            transition: .2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-done {
            background: linear-gradient(135deg, #2e7d32, #43a047);
            box-shadow: 0 14px 34px rgba(67,160,71,.28);
        }

        .btn-inv {
            background: linear-gradient(135deg, #b7791f, #d6911f);
            box-shadow: 0 14px 34px rgba(214,145,31,.24);
        }

        .btn-loot:hover {
            color: white;
            transform: translateY(-2px);
        }

        .hint {
            text-align: center;
            color: rgba(255,255,255,.46);
            font-size: .78rem;
            margin-top: 20px;
            line-height: 1.7;
        }

        .rot-indicator {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(0,0,0,.88);
            color: var(--gold);
            border: 1.5px solid rgba(255,209,102,.4);
            border-radius: 12px;
            padding: 10px 18px;
            font-weight: 800;
            font-size: .95rem;
            display: none;
            z-index: 9999;
            pointer-events: none;
        }

        @@media(max-width: 1100px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .loot-wrap {
                margin: 20px;
            }
        }

        @@media(max-width: 700px) {
            .loot-wrap {
                padding: 24px 18px;
                margin: 12px;
            }

            .grid-box {
                transform: scale(.86);
                transform-origin: top center;
                margin-bottom: -20px;
            }

            .actions-row {
                flex-direction: column;
            }

            .btn-loot {
                justify-content: center;
                width: 100%;
            }
        }
    

        /* ===== FULLSCREEN 1-SCREEN PATCH ===== */
        html, body {
            width: 100%;
            height: 100%;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
        }

        body {
            min-height: 100vh !important;
            background-attachment: fixed;
        }

        .loot-wrap {
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 14px 44px !important;
            border-radius: 0 !important;
            overflow: hidden !important;
            display: grid !important;
            grid-template-rows: auto minmax(0, 1fr) auto auto !important;
            gap: 10px !important;
        }

        .loot-header {
            margin-bottom: 0 !important;
        }

        .loot-title {
            font-size: clamp(1.9rem, 3vw, 3rem) !important;
            line-height: 1.05 !important;
        }

        .loot-sub {
            margin-top: 4px !important;
            font-size: .84rem !important;
        }

        .layout {
            min-height: 0 !important;
            height: 100% !important;
            grid-template-columns: 360px minmax(0, 1fr) !important;
            gap: 20px !important;
            overflow: hidden !important;
        }

        .panel {
            padding: 14px 16px !important;
            border-radius: 20px !important;
        }

        .panel-title {
            margin-bottom: 10px !important;
            font-size: .76rem !important;
        }

        .stack {
            min-height: 0 !important;
            max-height: 100% !important;
            overflow-y: auto !important;
            padding-right: 8px !important;
            gap: 12px !important;
        }

        .actions-row {
            margin-top: 0 !important;
        }

        .btn-loot {
            padding: 11px 22px !important;
            border-radius: 14px !important;
            font-size: .9rem !important;
        }

        .hint {
            margin-top: 0 !important;
            font-size: .72rem !important;
            line-height: 1.45 !important;
        }

        .trash-zone {
            padding: 12px !important;
            margin-top: 4px !important;
        }

        @@media(max-height: 820px) {
            .loot-wrap { padding: 10px 32px !important; }
            .loot-title { font-size: 2rem !important; }
            .loot-sub { display: none !important; }
            .panel { padding: 12px 14px !important; }
            .stack { gap: 10px !important; }
            .actions-row { gap: 10px !important; }
            .hint { display: none !important; }
        }

        @@media(max-width: 1100px) {
            html, body { overflow: auto !important; }
            .loot-wrap {
                height: auto !important;
                min-height: 100vh !important;
                overflow: visible !important;
                padding: 20px !important;
                display: block !important;
            }
            .layout {
                height: auto !important;
                grid-template-columns: 1fr !important;
                overflow: visible !important;
            }
            .stack {
                max-height: none !important;
                overflow: visible !important;
            }
        }

    </style>
</head>

<body>
    <div class="rot-indicator" id="rot-indicator">↻ ?×?</div>

    <main class="loot-wrap">
        <div class="loot-header">
            <div class="loot-title">💰 Chiến Lợi Phẩm</div>
            <div class="loot-sub">
                Kéo vật phẩm từ xác quái vào túi, ba lô hoặc rig. Đồ bỏ lại sẽ mất.
            </div>
        </div>

        <div class="layout">
            <div class="panel body">
                <div class="panel-title">
                    <span>🩸 Xác Quái Vật</span>
                    <span class="pt-meta">@bodyCols×@bodyRows</span>
                </div>

                <div id="grid-body"
                     class="grid-box"
                     data-side="body"
                     data-container="body"
                     data-cols="@bodyCols"
                     data-rows="@bodyRows"
                     style="width:@(bodyCols * CELL)px; height:@(bodyRows * CELL)px;">
                </div>
            </div>

            <div class="stack">
                <div class="panel inv">
                    <div class="panel-title">
                        <span>🪙 Túi</span>
                        <span class="pt-meta">@pCols×@pRows · ô 1×1</span>
                    </div>

                    <div id="grid-pocket"
                         class="grid-box drop-target"
                         data-side="player"
                         data-container="@ItemCatalogue.BACKPACK"
                         data-cols="@pCols"
                         data-rows="@pRows"
                         style="width:@(pCols * CELL)px; height:@(pRows * CELL)px;">
                    </div>
                </div>

                @if (hasBackpack)
                {
                    <div class="panel inv">
                        <div class="panel-title">
                            <span>🎒 Ba Lô Trang Bị</span>
                            <span class="pt-meta">@bpCols×@bpRows · @(bpCols * bpRows) ô</span>
                        </div>

                        <div id="grid-backpack"
                             class="grid-box drop-target"
                             data-side="player"
                             data-container="@ItemCatalogue.EQUIPPED_BACKPACK"
                             data-cols="@bpCols"
                             data-rows="@bpRows"
                             style="width:@(bpCols * CELL)px; height:@(bpRows * CELL)px;">
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel inv">
                        <div class="panel-title">
                            <span>🎒 Ba Lô Trang Bị</span>
                            <span class="pt-meta">trống</span>
                        </div>

                        <div class="empty-msg">
                            Chưa trang bị ba lô — trang bị trong
                            <a href="/Inventory" target="_blank">kho đồ</a>.
                        </div>
                    </div>
                }

                @if (hasRig)
                {
                    <div class="panel inv">
                        <div class="panel-title">
                            <span>🦺 Rig Trang Bị</span>
                            <span class="pt-meta">@rCols×@rRows · ô 1×2</span>
                        </div>

                        <div id="grid-rig"
                             class="grid-box drop-target"
                             data-side="player"
                             data-container="@ItemCatalogue.EQUIPPED_RIG"
                             data-cols="@rCols"
                             data-rows="@rRows"
                             style="width:@(rCols * CELL)px; height:@(rRows * CELL)px;">
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel inv">
                        <div class="panel-title">
                            <span>🦺 Rig Trang Bị</span>
                            <span class="pt-meta">trống</span>
                        </div>

                        <div class="empty-msg">
                            Chưa trang bị rig.
                        </div>
                    </div>
                }

                <div class="panel inv">
                    <div class="panel-title">
                        <span>🗑️ Bỏ Đồ</span>
                        <span class="pt-meta">thả vào để xóa</span>
                    </div>

                    <div id="loot-trash" class="trash-zone">
                        Thả đồ trong túi vào đây để bỏ vĩnh viễn
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="LootClose" asp-controller="Forest" method="post" class="actions-row">
            @Html.AntiForgeryToken()

            <a href="/Inventory" target="_blank" class="btn-loot btn-inv">
                🎒 Mở Kho Đồ Đầy Đủ
            </a>

            <button type="submit" class="btn-loot btn-done">
                ✅ Xong — Quay Lại Bản Đồ
            </button>
        </form>

        <div class="hint">
            ⚠️ Đồ đã nhặt được chỉ lưu vĩnh viễn khi bạn đến điểm Rút Lui và thoát thành công.
            Chuột phải hoặc rê chuột vào item rồi nhấn <b>R</b> để xoay.
        </div>
    </main>

    <script>
        const CELL = @CELL;

        const CATALOGUE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ItemCatalogue.Items.ToDictionary(kv => kv.Key, kv => new {
                name = kv.Value.Name,
                icon = kv.Value.Icon,
                w = kv.Value.Width,
                h = kv.Value.Height,
                color = kv.Value.TileColor
            })
        ));

        let bodyItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(session?.MonsterBody ?? new List<LootItem>()));

        const playerContainers = {
            '@ItemCatalogue.BACKPACK': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pocketItems)),
            '@ItemCatalogue.EQUIPPED_BACKPACK': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(backpackItems)),
            '@ItemCatalogue.EQUIPPED_RIG': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rigItems))
        };

        function get(o, k) {
            return o[k] ?? o[k.charAt(0).toLowerCase() + k.slice(1)];
        }

        function isImageIcon(icon) {
            if (!icon) return false;

            return icon.includes("/") ||
                icon.endsWith(".png") ||
                icon.endsWith(".jpg") ||
                icon.endsWith(".jpeg") ||
                icon.endsWith(".webp") ||
                icon.endsWith(".gif") ||
                icon.startsWith("http");
        }

        function monsterBodyImage(w, h) {
            const size = w * h;

            if (size === 1) return "/fe/loot/1o.png";
            if (size === 6) return "/fe/loot/6o.png";
            if (size === 4) return "/fe/loot/8o.png";
            if (size === 8) return "/fe/loot/8o.png";

            if (w === 1 && h >= 2 && h <= 5) {
                return `/fe/loot/${h}doc.png`;
            }

            if (h === 1 && w >= 2 && w <= 5) {
                return `/fe/loot/${w}ngang.png`;
            }

            return "/fe/loot/1o.png";
        }

        function renderMonsterImage(w, h, name) {
            const img = monsterBodyImage(w, h);

            return `
                <img src="${img}"
                     class="item-img"
                     title="${name}"
                     alt="${name}" />
            `;
        }

        function renderPlayerIcon(icon, name) {
            if (isImageIcon(icon)) {
                return `
                    <img src="${icon}"
                         class="item-icon-img"
                         title="${name}"
                         alt="${name}" />
                `;
            }

            return `
                <span class="item-emoji" title="${name}">
                    ${icon || "❓"}
                </span>
            `;
        }

        function isMonsterCorpseItem(name) {
            const n = (name || "").toLowerCase();

            return n.includes("xác") ||
                n.includes("quái") ||
                n.includes("monster") ||
                n.includes("corpse");
        }

        function renderItemContent(d, item) {
            if (isMonsterCorpseItem(d.name)) {
                return renderMonsterImage(d.w, d.h, d.name) + renderQty(item);
            }

            return renderPlayerIcon(d.icon, d.name) + renderQty(item);
        }

        function getQty(o) {
            return get(o, "Quantity") ??
                get(o, "Qty") ??
                get(o, "Stack") ??
                get(o, "Amount") ??
                1;
        }

        function renderQty(o) {
            const q = getQty(o);

            if (!q || q <= 1) return "";

            return `<span class="item-qty">${q}</span>`;
        }

        function bodyDims(loot) {
            const itemId = get(loot, "ItemId");

            const def = CATALOGUE[itemId] || {
                w: 1,
                h: 1,
                name: "Xác quái vật",
                icon: "❓",
                color: "#444"
            };

            const rotated = !!get(loot, "Rotated");

            return {
                w: rotated ? def.h : def.w,
                h: rotated ? def.w : def.h,
                name: def.name || "Xác quái vật",
                icon: def.icon || "❓",
                color: def.color || "#444"
            };
        }

        function placedDims(p) {
            return {
                w: get(p, "W"),
                h: get(p, "H"),
                name: get(p, "Name"),
                icon: get(p, "Icon"),
                color: get(p, "TileColor") || "#444"
            };
        }

        let dragData = null;
        let playerDrag = null;
        let busy = false;

        function renderBody() {
            const grid = document.getElementById("grid-body");

            grid.innerHTML = "";

            bodyItems.forEach((loot, idx) => {
                const d = bodyDims(loot);
                const x = get(loot, "GridX");
                const y = get(loot, "GridY");

                const el = document.createElement("div");

                el.className = "item";
                el.style.left = (x * CELL) + "px";
                el.style.top = (y * CELL) + "px";
                el.style.width = (d.w * CELL - 4) + "px";
                el.style.height = (d.h * CELL - 4) + "px";
                el.style.background = `linear-gradient(135deg, ${d.color}cc, ${d.color}55)`;
                el.draggable = true;
                el.dataset.idx = idx;
                el.innerHTML = renderMonsterImage(d.w, d.h, d.name) + renderQty(loot);

                el.addEventListener("dragstart", e => {
                    dragData = {
                        idx,
                        rotated: !!get(loot, "Rotated"),
                        w: d.w,
                        h: d.h,
                        offX: Math.floor((e.clientX - el.getBoundingClientRect().left) / CELL),
                        offY: Math.floor((e.clientY - el.getBoundingClientRect().top) / CELL)
                    };

                    el.classList.add("dragging");
                    e.dataTransfer.effectAllowed = "move";
                });

                el.addEventListener("dragend", () => {
                    el.classList.remove("dragging");
                    dragData = null;
                });

                const rawDef = CATALOGUE[get(loot, "ItemId")];
                const canRot = rawDef && rawDef.w !== rawDef.h;

                el.addEventListener("contextmenu", e => {
                    e.preventDefault();

                    if (!canRot || busy) return;

                    busy = true;

                    fetch(`/Forest/Loot/RotateBody?index=${idx}`, {
                        method: "POST"
                    })
                        .then(r => r.json())
                        .then(r => {
                            if (r.ok) {
                                location.reload();
                            } else {
                                alert(r.error || "Không thể xoay");
                                busy = false;
                            }
                        });
                });

                grid.appendChild(el);
            });
        }

        function renderPlayer(containerId, gridId) {
            const grid = document.getElementById(gridId);

            if (!grid) return;

            grid.innerHTML = "";

            (playerContainers[containerId] || []).forEach(p => {
                const d = placedDims(p);
                const id = get(p, "Id");
                const isPouch = id === 0 || id === "0";
                const srcX = get(p, "GridX");
                const srcY = get(p, "GridY");

                const el = document.createElement("div");

                el.className = "item";
                el.style.left = (srcX * CELL) + "px";
                el.style.top = (srcY * CELL) + "px";
                el.style.width = (d.w * CELL - 4) + "px";
                el.style.height = (d.h * CELL - 4) + "px";
                el.style.background = `linear-gradient(135deg, ${d.color}cc, ${d.color}55)`;
                el.draggable = true;
                el.dataset.id = id;

                el.innerHTML = renderMonsterImage(d.w, d.h, d.name || "Xác quái vật") + renderQty(p);

                if (isPouch) {
                    el.style.outline = "1.5px dashed rgba(255,209,102,.65)";
                }

                el.addEventListener("dragstart", e => {
                    playerDrag = {
                        id,
                        w: d.w,
                        h: d.h,
                        isPouch,
                        srcContainer: containerId,
                        srcX,
                        srcY
                    };

                    el.classList.add("dragging");
                    e.dataTransfer.effectAllowed = "move";
                });

                el.addEventListener("dragend", () => {
                    el.classList.remove("dragging");
                    playerDrag = null;
                });

                el.addEventListener("contextmenu", async e => {
                    e.preventDefault();

                    if (busy) return;

                    busy = true;

                    if (isPouch) {
                        const res = await fetch("/Forest/Loot/RotatePouch", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                Container: containerId,
                                GridX: srcX,
                                GridY: srcY
                            })
                        });

                        const r = await res.json();

                        if (r.ok) {
                            location.reload();
                        } else {
                            alert(r.error || "Không thể xoay");
                            busy = false;
                        }
                    } else {
                        const res = await fetch(`/Inventory/RotateAjax/${id}`, {
                            method: "POST"
                        });

                        const r = await res.json();

                        if (r.success) {
                            location.reload();
                        } else {
                            alert(r.error || "Không thể xoay");
                            busy = false;
                        }
                    }
                });

                grid.appendChild(el);
            });
        }

        document.querySelectorAll(".drop-target").forEach(grid => {
            grid.addEventListener("dragenter", () => {
                if (dragData || playerDrag) {
                    grid.classList.add("drop-active");
                }
            });

            grid.addEventListener("dragleave", () => {
                grid.classList.remove("drop-active");
            });

            grid.addEventListener("dragover", e => {
                e.preventDefault();
                e.dataTransfer.dropEffect = "move";
            });

            grid.addEventListener("drop", async e => {
                e.preventDefault();
                e.stopPropagation();

                grid.classList.remove("drop-active");

                if (busy) return;

                if (playerDrag) {
                    const captured = playerDrag;

                    playerDrag = null;
                    busy = true;

                    const rect = grid.getBoundingClientRect();
                    const bw2 = 2;

                    const pcx = Math.max(0, Math.floor((e.clientX - rect.left - bw2) / CELL));
                    const pcy = Math.max(0, Math.floor((e.clientY - rect.top - bw2) / CELL));

                    const target = grid.dataset.container;

                    if (captured.isPouch) {
                        const res = await fetch("/Forest/Loot/MovePouch", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                SrcContainer: captured.srcContainer,
                                SrcX: captured.srcX,
                                SrcY: captured.srcY,
                                TargetContainer: target,
                                TargetX: pcx,
                                TargetY: pcy
                            })
                        });

                        const r = await res.json();

                        if (r.ok) {
                            location.reload();
                        } else {
                            alert(r.error || "Không thể đặt");
                            busy = false;
                        }
                    } else {
                        const fd = new FormData();

                        fd.append("itemId", captured.id);
                        fd.append("targetContainer", target);
                        fd.append("targetX", pcx);
                        fd.append("targetY", pcy);

                        const res = await fetch("/Inventory/Move", {
                            method: "POST",
                            body: fd
                        });

                        const r = await res.json();

                        if (r.success) {
                            location.reload();
                        } else {
                            alert(r.error || "Không thể đặt");
                            busy = false;
                        }
                    }

                    return;
                }

                if (!dragData) return;

                const captured = dragData;

                dragData = null;
                busy = true;

                const rect = grid.getBoundingClientRect();
                const bw = 2;

                const cx = Math.max(0, Math.floor((e.clientX - rect.left - bw) / CELL) - (captured.offX ?? 0));
                const cy = Math.max(0, Math.floor((e.clientY - rect.top - bw) / CELL) - (captured.offY ?? 0));

                const targetContainer = grid.dataset.container;

                try {
                    const res = await fetch("/Forest/Loot/Pickup", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            Index: captured.idx,
                            To: targetContainer,
                            GridX: cx,
                            GridY: cy,
                            Rotated: captured.rotated
                        })
                    });

                    const data = await res.json();

                    if (!data.ok) {
                        alert("Không thể đặt: " + (data.error || "unknown"));
                        busy = false;
                        return;
                    }

                    window.location.reload();
                } catch (err) {
                    console.error(err);
                    alert("Lỗi mạng: " + err);
                    busy = false;
                }
            });
        });

        const trash = document.getElementById("loot-trash");

        if (trash) {
            trash.addEventListener("dragover", e => {
                e.preventDefault();

                if (playerDrag || dragData) {
                    trash.classList.add("drop-active");
                }
            });

            trash.addEventListener("dragleave", () => {
                trash.classList.remove("drop-active");
            });

            trash.addEventListener("drop", async e => {
                e.preventDefault();
                e.stopPropagation();

                trash.classList.remove("drop-active");

                if (busy) return;

                if (!playerDrag) {
                    alert("Chỉ kéo đồ trong túi/kho của bạn vào đây để bỏ. Đồ trên xác quái sẽ bị bỏ lại khi bấm Xong.");
                    return;
                }

                const captured = playerDrag;

                playerDrag = null;

                if (!confirm("Bỏ vật phẩm này vĩnh viễn?")) return;

                busy = true;

                const res = await fetch(`/Inventory/Discard/${captured.id}`, {
                    method: "POST"
                });

                const r = await res.json();

                if (r.success) {
                    location.reload();
                } else {
                    alert(r.error || "Không thể bỏ đồ");
                    busy = false;
                }
            });
        }

        renderBody();
        renderPlayer("@ItemCatalogue.BACKPACK", "grid-pocket");
        renderPlayer("@ItemCatalogue.EQUIPPED_BACKPACK", "grid-backpack");
        renderPlayer("@ItemCatalogue.EQUIPPED_RIG", "grid-rig");

        const rotEl = document.getElementById("rot-indicator");

        let rotTimer = null;

        function showRot(dims) {
            rotEl.textContent = "↻ " + dims;
            rotEl.style.display = "block";

            clearTimeout(rotTimer);

            rotTimer = setTimeout(() => {
                rotEl.style.display = "none";
            }, 1200);
        }

        let hovItem = null;

        const bodyGrid = document.getElementById("grid-body");

        if (bodyGrid) {
            const bodyObs = new MutationObserver(() => {
                bodyGrid.querySelectorAll(".item").forEach(el => {
                    if (el._lootHov) return;

                    el._lootHov = true;

                    el.addEventListener("mouseover", ev => {
                        hovItem = {
                            type: "body",
                            idx: parseInt(el.dataset.idx)
                        };

                        ev.stopPropagation();
                    });

                    el.addEventListener("mouseout", () => {
                        hovItem = null;
                    });
                });
            });

            bodyObs.observe(bodyGrid, {
                childList: true
            });
        }

        document.querySelectorAll(".drop-target").forEach(g => {
            new MutationObserver(() => {
                g.querySelectorAll(".item").forEach(el => {
                    if (el._lootHov) return;

                    el._lootHov = true;

                    const id = parseInt(el.dataset.id);
                    const isp = id === 0 || el.dataset.id === "0";

                    el.addEventListener("mouseover", ev => {
                        hovItem = {
                            type: "player",
                            isPouch: isp,
                            id,
                            srcContainer: g.dataset.container,
                            srcX: Math.round(parseInt(el.style.left) / CELL),
                            srcY: Math.round(parseInt(el.style.top) / CELL)
                        };

                        ev.stopPropagation();
                    });

                    el.addEventListener("mouseout", () => {
                        hovItem = null;
                    });
                });
            }).observe(g, {
                childList: true
            });
        });

        document.addEventListener("keydown", async function (e) {
            if (e.code !== "KeyR" || !hovItem || busy) return;

            busy = true;

            if (hovItem.type === "body") {
                const loot = bodyItems[hovItem.idx];

                if (!loot) {
                    busy = false;
                    return;
                }

                const def = CATALOGUE[get(loot, "ItemId")];

                if (!def || def.w === def.h) {
                    busy = false;
                    return;
                }

                const res = await fetch(`/Forest/Loot/RotateBody?index=${hovItem.idx}`, {
                    method: "POST"
                });

                const r = await res.json();

                busy = false;

                if (r.ok) {
                    location.reload();
                } else {
                    alert(r.error || "Không thể xoay");
                }
            }

            else if (hovItem.isPouch) {
                const res = await fetch("/Forest/Loot/RotatePouch", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        Container: hovItem.srcContainer,
                        GridX: hovItem.srcX,
                        GridY: hovItem.srcY
                    })
                });

                const r = await res.json();

                busy = false;

                if (r.ok) {
                    location.reload();
                } else {
                    alert(r.error || "Không thể xoay");
                }
            }

            else {
                const res = await fetch(`/Inventory/RotateAjax/${hovItem.id}`, {
                    method: "POST"
                });

                const r = await res.json();

                busy = false;

                if (r.success) {
                    location.reload();
                } else {
                    alert(r.error || "Không thể xoay");
                }
            }
        });
    </script>
</body>
</html>