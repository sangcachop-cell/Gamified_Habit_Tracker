@model HabitTracker.Models.ViewModels.PartyViewModel
@{
    ViewData["Title"] = Model.Party != null ? Model.Party.Name : "Party";
    var currentUserId = Context.Session.GetInt32("UserId") ?? 0;
    var isLeader = Model.IsLeader;
    var inParty = Model.Party != null;
}

<style>
    :root {
        --party-bg: #f5f3ef;
        --party-card: #ffffff;
        --party-text: #1f2937;
        --party-muted: #6b7280;
        --party-border: #e5e7eb;
        --party-soft: #f8fafc;
        --party-primary: #5c3dde;
        --party-primary-hover: #4c32bf;
        --party-primary-soft: #edeaf5;
        --party-green: #00a884;
        --party-red: #e8436a;
        --party-yellow: #f0b429;
        --party-shadow: 0 14px 34px rgba(15, 23, 42, .08);
        --party-radius: 20px;
    }

    body {
        background: var(--party-bg);
        color: var(--party-text);
        font-family: Inter, "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .party-page {
        padding: 16px 0 34px;
    }

    .party-shell {
        height: calc(100vh - 92px);
        min-height: 650px;
        border: 1px solid var(--party-border);
        border-radius: var(--party-radius);
        overflow: hidden;
        background: var(--party-card);
        box-shadow: var(--party-shadow);
    }

    .party-title-font {
        font-family: "Syne", Inter, system-ui, sans-serif;
        letter-spacing: -.03em;
    }

    .party-btn {
        border: 0;
        border-radius: 12px;
        padding: 8px 14px;
        font-size: .84rem;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: transform .12s ease, background .15s ease, border-color .15s ease, color .15s ease;
    }

        .party-btn:hover {
            transform: translateY(-1px);
        }

    .party-btn-primary {
        background: var(--party-primary);
        color: #fff;
    }

        .party-btn-primary:hover {
            background: var(--party-primary-hover);
            color: #fff;
        }

    .party-btn-soft {
        background: var(--party-soft);
        color: var(--party-text);
        border: 1px solid var(--party-border);
    }

        .party-btn-soft:hover {
            color: var(--party-primary);
            border-color: rgba(92, 61, 222, .25);
            background: var(--party-primary-soft);
        }

    .party-btn-danger {
        background: #fff1f4;
        color: var(--party-red);
        border: 1px solid #ffd6df;
    }

        .party-btn-danger:hover {
            background: #ffe4eb;
            color: var(--party-red);
        }

    .party-btn-success {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .party-btn-warning {
        background: #fff7d6;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .party-empty-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 22px 0 44px;
    }

    .party-invite-card,
    .party-create-card,
    .party-empty-hero {
        background: var(--party-card);
        border: 1px solid var(--party-border);
        border-radius: var(--party-radius);
        box-shadow: var(--party-shadow);
    }

    .party-invite-card {
        padding: 18px;
        margin-bottom: 18px;
    }

    .party-invite-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-radius: 14px;
        background: var(--party-soft);
        border: 1px solid var(--party-border);
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .party-empty-hero {
        text-align: center;
        padding: 42px 28px;
        margin-bottom: 18px;
    }

    .party-empty-icon {
        width: 86px;
        height: 86px;
        border-radius: 26px;
        background: var(--party-primary-soft);
        color: var(--party-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        margin-bottom: 16px;
    }

    .party-create-card {
        padding: 20px;
    }

    .party-input,
    .party-textarea,
    .form-control.party-input,
    .form-control.party-textarea,
    .form-select.party-input {
        border: 1px solid var(--party-border);
        border-radius: 13px;
        background: #fff;
        color: var(--party-text);
        box-shadow: none !important;
    }

        .party-input:focus,
        .party-textarea:focus,
        .form-control.party-input:focus,
        .form-control.party-textarea:focus,
        .form-select.party-input:focus {
            border-color: rgba(92, 61, 222, .45);
            box-shadow: 0 0 0 4px rgba(92, 61, 222, .10) !important;
        }

    .party-sidebar {
        background: #fbfbfd;
        border-right: 1px solid var(--party-border);
        min-height: 0;
        position: relative;
    }

    .party-sidebar-header {
        padding: 18px;
        border-bottom: 1px solid var(--party-border);
        background: #fff;
    }

    .party-name-line {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .party-name {
        margin: 0;
        color: var(--party-text);
        font-size: 1.1rem;
        font-weight: 900;
        line-height: 1.2;
    }

    .party-meta {
        margin-top: 5px;
        color: var(--party-muted);
        font-size: .78rem;
        font-weight: 650;
    }

    .invite-box {
        padding: 14px 18px;
        border-bottom: 1px solid var(--party-border);
        background: #fff;
    }

    .invite-label {
        color: var(--party-muted);
        font-size: .76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 8px;
    }

    .invite-selected-card {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        border: 1px solid var(--party-border);
        border-radius: 14px;
        background: var(--party-soft);
    }

    .invite-results {
        z-index: 100;
        max-height: 220px;
        overflow-y: auto;
        top: calc(100% + 6px);
        border-radius: 14px;
        border: 1px solid var(--party-border);
        overflow: hidden;
    }

    .member-list {
        min-height: 0;
        padding: 10px;
    }

    .member-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-radius: 15px;
        margin-bottom: 6px;
        background: transparent;
        transition: background .15s ease;
    }

        .member-row:hover {
            background: #fff;
        }

    .member-avatar,
    .chat-avatar {
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .08);
    }

    .member-name {
        color: var(--party-text);
        font-size: .87rem;
        font-weight: 850;
        text-decoration: none;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .member-name:hover {
            color: var(--party-primary);
        }

    .member-sub {
        color: var(--party-muted);
        font-size: .72rem;
    }

    .role-badge {
        border-radius: 999px;
        padding: 4px 7px;
        font-size: .62rem;
        font-weight: 900;
        border: 1px solid var(--party-border);
        background: #f3f4f6;
        color: var(--party-muted);
    }

        .role-badge.leader {
            background: #fff7d6;
            color: #92400e;
            border-color: #fde68a;
        }

    .kick-btn {
        border: 0;
        background: transparent;
        color: var(--party-red);
        font-size: .72rem;
        font-weight: 800;
        padding: 0;
    }

    .quest-panel {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 2;
        max-height: 65%;
        overflow-y: auto;
        background: #fff;
        border-top: 1px solid var(--party-border);
        box-shadow: 0 -10px 25px rgba(15, 23, 42, .05);
    }

    .quest-inner {
        padding: 14px;
    }

    .quest-title {
        color: var(--party-text);
        font-size: .86rem;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .quest-muted {
        color: var(--party-muted);
        font-size: .78rem;
    }

    .quest-img {
        max-width: 100%;
        max-height: 112px;
        object-fit: contain;
        filter: drop-shadow(0 8px 12px rgba(15, 23, 42, .10));
    }

    .progress {
        border-radius: 999px;
        background: #eef2f7;
        overflow: hidden;
    }

    .party-chat {
        min-height: 0;
        background: #fff;
    }

    .chat-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--party-border);
        background: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .chat-title {
        font-size: 1rem;
        font-weight: 900;
        margin: 0;
    }

    .chat-subtitle {
        color: var(--party-muted);
        font-size: .78rem;
        margin-top: 2px;
    }

    .chat-area {
        background: radial-gradient(circle at 10% 10%, rgba(92,61,222,.04), transparent 24%), radial-gradient(circle at 90% 90%, rgba(0,168,132,.04), transparent 22%), #fbfbfd;
        padding: 18px;
    }

    .system-message {
        text-align: center;
        color: var(--party-muted);
        margin-bottom: 12px;
        font-size: .76rem;
    }

        .system-message span {
            display: inline-block;
            background: #fff;
            border: 1px solid var(--party-border);
            border-radius: 999px;
            padding: 6px 14px;
            font-weight: 650;
        }

    .chat-msg {
        display: flex;
        gap: 10px;
        margin-bottom: 16px;
    }

        .chat-msg.own {
            flex-direction: row-reverse;
        }

    .chat-bubble-wrap {
        max-width: 70%;
    }

    .chat-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 5px;
    }

    .chat-msg.own .chat-meta {
        flex-direction: row-reverse;
    }

    .chat-author {
        color: var(--party-text);
        font-size: .78rem;
        font-weight: 850;
        text-decoration: none;
    }

        .chat-author:hover {
            color: var(--party-primary);
        }

    .chat-time {
        color: var(--party-muted);
        font-size: .68rem;
    }

    .chat-bubble {
        border: 1px solid var(--party-border);
        background: #fff;
        color: var(--party-text);
        border-radius: 18px 18px 18px 6px;
        padding: 10px 13px;
        font-size: .9rem;
        line-height: 1.45;
        word-break: break-word;
        box-shadow: 0 8px 18px rgba(15, 23, 42, .04);
    }

    .chat-msg.own .chat-bubble {
        background: var(--party-primary);
        border-color: var(--party-primary);
        color: #fff;
        border-radius: 18px 18px 6px 18px;
    }

    .chat-actions {
        display: flex;
        gap: 10px;
        margin-top: 5px;
    }

    .chat-msg.own .chat-actions {
        flex-direction: row-reverse;
    }

    .chat-icon-btn {
        border: 0;
        background: transparent;
        padding: 0;
        font-size: .76rem;
        color: var(--party-muted);
        line-height: 1;
    }

    .chat-compose {
        padding: 16px;
        border-top: 1px solid var(--party-border);
        background: #fff;
    }

    .compose-wrap {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        background: var(--party-soft);
        border: 1px solid var(--party-border);
        border-radius: 18px;
        padding: 8px;
    }

        .compose-wrap textarea {
            border: 0;
            background: transparent;
            resize: none;
            box-shadow: none !important;
            min-height: 42px;
            max-height: 130px;
        }

            .compose-wrap textarea:focus {
                box-shadow: none !important;
            }

    .load-more-btn {
        border: 1px solid var(--party-border);
        background: #fff;
        color: var(--party-muted);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: .8rem;
        font-weight: 800;
    }

    @@media (max-width: 767px) {
        .party-shell {
            height: auto;
            min-height: auto;
        }

        .party-sidebar {
            min-height: 430px;
            border-right: 0;
            border-bottom: 1px solid var(--party-border);
        }

        .party-chat {
            min-height: 560px;
        }

        .chat-bubble-wrap {
            max-width: 82%;
        }

        .quest-panel {
            position: relative;
            max-height: none;
        }

        #membersList {
            padding-bottom: 10px !important;
        }
    }
</style>

@if (!inParty)
{
    @* ── NO PARTY: create form + pending invites ───────────────────────── *@
    <div class="container party-page">
        <div class="party-empty-wrap">

            @if (Model.PendingInvites.Any())
            {
                <div class="party-invite-card">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div style="font-size:1.5rem;">🛡️</div>
                        <div>
                            <div class="party-title-font fw-bold">Party Invitations</div>
                            <div class="text-muted small">Chọn lời mời bạn muốn tham gia.</div>
                        </div>
                    </div>

                    @foreach (var inv in Model.PendingInvites)
                    {
                        <div class="party-invite-row">
                            <span class="flex-grow-1">
                                <strong>@inv.Party?.Name</strong> — invited by
                                <strong>@inv.Inviter?.Username</strong>
                            </span>
                            <form asp-action="AcceptInvite" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="inviteId" value="@inv.Id" />
                                <button type="submit" class="party-btn party-btn-success">Accept</button>
                            </form>
                            <form asp-action="DeclineInvite" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="inviteId" value="@inv.Id" />
                                <button type="submit" class="party-btn party-btn-soft">Decline</button>
                            </form>
                        </div>
                    }
                </div>
            }

            <div class="party-empty-hero">
                <div class="party-empty-icon">🛡️</div>
                <h4 class="party-title-font fw-bold mb-2">You're not in a party</h4>
                <p class="text-muted mb-0">Create one or wait for an invitation.</p>
            </div>

            <div class="party-create-card">
                <h6 class="party-title-font fw-bold mb-3">Create a Party</h6>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input type="text" name="name" class="form-control party-input"
                               maxlength="100" placeholder="Party name..." required />
                        <button type="submit" class="party-btn party-btn-primary">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else
{
    @* ── IN PARTY ──────────────────────────────────────────────────────── *@
    <form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

    <div class="container-fluid party-page px-3">
        <div class="row h-100 g-0 party-shell">

            @* ── LEFT: Party info + members ─────────────────────────────── *@
            <div class="col-12 col-md-4 col-lg-3 d-flex flex-column party-sidebar">

                @* Header *@
                <div class="party-sidebar-header">
                    <div class="party-name-line">
                        <div class="min-w-0">
                            <h5 class="party-title-font party-name">🛡️ @Model.Party!.Name</h5>
                            <div class="party-meta">
                                @Model.Members.Count member@(Model.Members.Count != 1 ? "s" : "")
                                @(isLeader ? " · You are leader" : "")
                            </div>
                        </div>
                        <button class="party-btn party-btn-danger flex-shrink-0" onclick="leaveParty()">Leave</button>
                    </div>
                </div>

                @* Invite (leader only) *@
                @if (isLeader)
                {
                    <div class="invite-box">
                        <div class="invite-label">➕ Invite Member</div>
                        <div class="position-relative">
                            <input type="text" id="inviteSearch" class="form-control form-control-sm party-input"
                                   placeholder="Search by username or email" autocomplete="off"
                                   oninput="debouncePartyInviteSearch()" />
                            <div id="inviteResults" class="list-group position-absolute w-100 shadow-sm invite-results"></div>
                        </div>
                        <div id="inviteSelected" class="d-none mt-2">
                            <div class="invite-selected-card">
                                <img id="inviteSelAvatar" src="" width="30" height="30"
                                     class="rounded-circle flex-shrink-0" style="object-fit:cover;"
                                     onerror="this.src='/images/default.png'" />
                                <span id="inviteSelName" class="small fw-bold flex-grow-1"></span>
                                <button class="party-btn party-btn-soft py-1 px-2" onclick="clearPartyInviteSelection()">✕</button>
                                <button class="party-btn party-btn-primary py-1 px-2" id="inviteSendBtn" onclick="sendPartyInvite()">Invite</button>
                            </div>
                        </div>
                    </div>
                }

                @* Members list *@
                <div class="overflow-auto flex-grow-1 member-list" id="membersList">
                    @foreach (var entry in Model.Members)
                    {
                        var avatarSrc = string.IsNullOrEmpty(entry.User.Avatar) || entry.User.Avatar == "default.png"
                        ? "/images/default.png" : "/uploads/" + entry.User.Avatar;
                        <div class="member-row">
                            <img src="@avatarSrc" class="member-avatar flex-shrink-0"
                                 width="38" height="38"
                                 onerror="this.src='/images/default.png'" />
                            <div class="flex-grow-1 overflow-hidden">
                                <a href="/Friend/ViewProfile/@entry.User.Id" class="member-name">
                                    @entry.User.Username
                                </a>
                                <div class="member-sub">
                                    Lv @entry.User.Level
                                    @if (!string.IsNullOrEmpty(entry.User.Class))
                                    {
                                        <span>• @entry.User.Class</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                <span class="role-badge @(entry.Member.Role == "Leader" ? "leader" : "")">@entry.Member.Role</span>
                                @if (isLeader && entry.User.Id != currentUserId)
                                {
                                    <button class="kick-btn" onclick="kickMember(@entry.User.Id)">Kick</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* ── QUEST PANEL + PENDING INVITES — absolutely pinned to bottom *@
                <div id="questPanel" class="quest-panel">

                    @if (isLeader && Model.PendingInvites.Any())
                    {
                        <div class="px-3 py-2 border-bottom">
                            <div class="quest-muted fw-bold mb-1">Pending Invites (@Model.PendingInvites.Count)</div>
                            @foreach (var inv in Model.PendingInvites)
                            {
                                <div class="small text-muted px-1">⏳ @inv.Invitee?.Username</div>
                            }
                        </div>
                    }

                    <div class="quest-inner">
                        @{
                            var qs = Model.QuestStatus;
                            bool hasActiveQuest = qs is not null && qs.Status != "None";
                        }

                        @if (!hasActiveQuest)
                        {
                            @if (isLeader)
                            {
                                @* Leader: show start button if owns scrolls *@
                                @if (Model.OwnedScrolls.Any())
                                {
                                    <div class="quest-title">⚔️ Start a Quest</div>
                                    <select id="questScrollSelect" class="form-select form-select-sm party-input mb-2">
                                        @foreach (var scroll in Model.OwnedScrolls.DistinctBy(s => s.Key))
                                        {
                                            var questKey = scroll.Key.Replace("quest_", "");
                                            <option value="@questKey">@scroll.Name</option>
                                        }
                                    </select>
                                    <button class="party-btn party-btn-warning w-100" onclick="inviteToQuest()">Invite Party</button>
                                }
                                else
                                {
                                    <div class="quest-muted text-center py-2">
                                        No quest scrolls owned.<br>
                                        <a href="/QuestShop" class="small">Visit Quest Shop →</a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="quest-muted text-center py-2">
                                    Only the party leader can start a quest.
                                </div>
                            }
                        }
                        else if (qs!.Status == "Pending")
                        {
                            @if (qs.QuestKey is not null)
                            {
                                var scrollImg = $"/images/habitica/quests/scrolls/inventory_quest_scroll_{qs.QuestKey}.png";
                                <div class="text-center mb-2">
                                    <img src="@scrollImg"
                                         onerror="this.src='/images/habitica/quests/scrolls/inventory_quest_scroll_armadillo.png'"
                                         style="max-width:80px;max-height:80px;object-fit:contain;" />
                                </div>
                            }
                            <div class="quest-title">⏳ @qs.QuestName</div>
                            <div class="d-flex flex-column gap-1 mb-2" style="font-size:.78rem;">
                                @foreach (var m in qs.Members)
                                {
                                    string icon = m.Response == "accepted" ? "✅" : m.Response == "rejected" ? "❌" : "❓";
                                    <div>@icon @m.UserName</div>
                                }
                            </div>
                            @if (currentUserId != qs.LeaderUserId)
                            {
                                <div class="d-flex gap-2">
                                    <button class="party-btn party-btn-success flex-grow-1" onclick="questAction('/PartyQuest/Accept')">Accept</button>
                                    <button class="party-btn party-btn-danger flex-grow-1" onclick="questAction('/PartyQuest/Reject')">Reject</button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <button class="party-btn party-btn-primary flex-grow-1" onclick="questAction('/PartyQuest/ForceStart')">Force Start</button>
                                    <button class="party-btn party-btn-danger flex-grow-1" onclick="questAction('/PartyQuest/Cancel')">Cancel</button>
                                </div>
                            }
                        }
                        else if (qs!.Status == "Active")
                        {
                            @* Boss / scroll avatar *@
                            @if (qs.QuestKey is not null)
                            {
                                var bossImg = $"/images/habitica/quests/bosses/quest_{qs.QuestKey}.png";
                                var scrollImg = $"/images/habitica/quests/scrolls/inventory_quest_scroll_{qs.QuestKey}.png";
                                var fallback = qs.IsBossQuest ? "/images/habitica/quests/bosses/quest_TEMPLATE_FOR_MISSING_IMAGE.png"
                                : "/images/habitica/quests/scrolls/inventory_quest_scroll_armadillo.png";
                                var displaySrc = qs.IsBossQuest ? bossImg : scrollImg;
                                <div class="text-center mb-2">
                                    <img src="@displaySrc"
                                         onerror="this.src='@fallback'"
                                         class="quest-img" />
                                </div>
                            }

                            <div class="quest-title">⚔️ @qs.QuestName</div>
                            <div class="quest-muted mb-2">by @qs.LeaderName</div>

                            @if (qs.IsBossQuest && qs.BossHpMax.HasValue)
                            {
                                double hpPct = qs.BossHpMax > 0 ? Math.Max(0, qs.BossHpRemaining!.Value / qs.BossHpMax.Value * 100) : 0;
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between quest-muted">
                                        <span>HP</span><span>@((int)qs.BossHpRemaining!.Value) / @((int)qs.BossHpMax.Value)</span>
                                    </div>
                                    <div class="progress" style="height:8px;">
                                        <div class="progress-bar bg-danger" style="width:@hpPct.ToString("0.#")%;"></div>
                                    </div>
                                </div>
                                @if (qs.RageMax.HasValue)
                                {
                                    double ragePct = qs.RageMax > 0 ? Math.Min(100, qs.RageCurrent!.Value / qs.RageMax.Value * 100) : 0;
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between quest-muted">
                                            <span>⚠️ Rage</span><span>@qs.RageCurrent!.Value.ToString("0") / @qs.RageMax.Value.ToString("0")</span>
                                        </div>
                                        <div class="progress" style="height:8px;">
                                            <div class="progress-bar bg-warning" style="width:@ragePct.ToString("0.#")%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (!qs.IsBossQuest && qs.CollectRequired is not null)
                            {
                                @foreach (var kv in qs.CollectRequired)
                                {
                                    int got = qs.CollectProgress?.GetValueOrDefault(kv.Key, 0) ?? 0;
                                    double pct = kv.Value > 0 ? Math.Min(100.0, got * 100.0 / kv.Value) : 0;
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between quest-muted">
                                            <span>@kv.Key</span><span>@got / @kv.Value</span>
                                        </div>
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar bg-success" style="width:@pct.ToString("0.#")%;"></div>
                                        </div>
                                    </div>
                                }
                            }

                            @if (currentUserId == qs.LeaderUserId)
                            {
                                <button class="party-btn party-btn-danger w-100 mt-1" onclick="questAction('/PartyQuest/Abort')">Abort Quest</button>
                            }
                        }
                    </div>@* /inner *@
                </div>@* /questPanel *@
            </div>

            @* ── RIGHT: Party chat ────────────────────────────────────── *@
            <div class="col-12 col-md-8 col-lg-9 d-flex flex-column party-chat">

                <div class="chat-header">
                    <div>
                        <h5 class="party-title-font chat-title">Party Chat</h5>
                        <div class="chat-subtitle">Chat, mention teammates, and follow quest updates.</div>
                    </div>
                    <span class="role-badge @(isLeader ? "leader" : "")">@(isLeader ? "Leader" : "Member")</span>
                </div>

                <div class="overflow-auto flex-grow-1 chat-area" id="chatArea">
                    @if (Model.HasMore)
                    {
                        <div class="text-center mb-3">
                            <button class="load-more-btn" onclick="loadMore()">
                                Load older messages
                            </button>
                        </div>
                    }

                    @foreach (var entry in Model.Messages)
                    {
                        if (entry.IsSystem)
                        {
                            <div class="system-message" id="msg-@entry.Message.Id">
                                <span>@Html.Raw(entry.RenderedBody)</span>
                            </div>
                        }
                        else
                        {
                            var avatarSrc = string.IsNullOrEmpty(entry.Message.Author?.Avatar) || entry.Message.Author.Avatar == "default.png"
                            ? "/images/default.png" : "/uploads/" + entry.Message.Author.Avatar;
                            var isOwn = entry.Message.AuthorId == currentUserId;
                            <div class="chat-msg @(isOwn ? "own" : "")" id="msg-@entry.Message.Id">
                                <img src="@avatarSrc" class="chat-avatar flex-shrink-0"
                                     width="34" height="34"
                                     onerror="this.src='/images/default.png'" />
                                <div class="chat-bubble-wrap">
                                    <div class="chat-meta">
                                        <a href="/Friend/ViewProfile/@entry.Message.AuthorId" class="chat-author">
                                            @entry.Message.Author?.Username
                                        </a>
                                        <span class="chat-time">@entry.Message.SentAt.ToLocalTime().ToString("g")</span>
                                    </div>
                                    <div class="chat-bubble">
                                        @Html.Raw(entry.RenderedBody)
                                    </div>
                                    <div class="chat-actions">
                                        <button class="chat-icon-btn like-btn"
                                                onclick="likeMsg(@entry.Message.Id, this)"
                                                style="color: @(entry.LikedByMe ? "#dc3545" : "#6c757d")">
                                            ❤️ <span class="like-count">@entry.LikeCount</span>
                                        </button>
                                        @if (isOwn || isLeader)
                                        {
                                            <button class="chat-icon-btn"
                                                    onclick="deleteMsg(@entry.Message.Id)">
                                                🗑️
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (!Model.Messages.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <div style="font-size:2.4rem;">🛡️</div>
                            <p class="small mt-2 mb-0">No messages yet. Say something!</p>
                        </div>
                    }
                </div>

                <div class="chat-compose">
                    <div class="compose-wrap">
                        <textarea id="msgInput" class="form-control" rows="1"
                              placeholder="Message party... (type @@username to mention)"
                              maxlength="2000"
                              onkeydown="handleKey(event)"></textarea>
                        <button class="party-btn party-btn-primary" onclick="sendMsg()">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const CURRENT_USER_ID = @currentUserId;
        const IS_LEADER = @(isLeader ? "true" : "false");
        const IN_PARTY  = @(inParty ? "true" : "false");
        const _token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';

        let currentPage = @(Model.Page);

        if (IN_PARTY) scrollToBottom();

        function scrollToBottom() {
            const area = document.getElementById('chatArea');
            if (area) area.scrollTop = area.scrollHeight;
        }

        function handleKey(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMsg(); }
        }

        async function sendMsg() {
            const input = document.getElementById('msgInput');
            const body = input.value.trim();
            if (!body) return;
            input.value = '';

            const fd = new FormData();
            fd.append('__RequestVerificationToken', _token);
            fd.append('body', body);
            const res = await fetch('/Party/SendMessage', { method: 'POST', body: fd });
            const data = await res.json();
            if (!data.success) { showToast('❌', 'Error', data.error ?? 'Failed.', 'danger'); return; }
            appendMessage(data, true);
            scrollToBottom();
        }

        function appendMessage(d, isOwn) {
            const area = document.getElementById('chatArea');
            const div = document.createElement('div');
            div.id = `msg-${d.messageId}`;
            div.className = `chat-msg ${isOwn ? 'own' : ''}`;
            div.innerHTML = `
                <img src="${d.authorAvatar}" class="chat-avatar flex-shrink-0" width="34" height="34"
                     onerror="this.src='/images/default.png'" />
                <div class="chat-bubble-wrap">
                    <div class="chat-meta">
                        <span class="chat-author">${d.authorName}</span>
                        <span class="chat-time">${d.sentAt}</span>
                    </div>
                    <div class="chat-bubble">${d.body}</div>
                    <div class="chat-actions">
                        <button class="chat-icon-btn like-btn"
                                onclick="likeMsg(${d.messageId}, this)"
                                style="color:#6c757d;">❤️ <span class="like-count">0</span></button>
                        ${isOwn || IS_LEADER ? `<button class="chat-icon-btn"
                                onclick="deleteMsg(${d.messageId})">🗑️</button>` : ''}
                    </div>
                </div>`;
            area.appendChild(div);
        }

        async function likeMsg(msgId, btn) {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', _token);
            const res = await fetch(`/Party/LikeMessage/${msgId}`, { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                btn.style.color = data.liked ? '#dc3545' : '#6c757d';
                btn.querySelector('.like-count').textContent = data.count;
            }
        }

        async function deleteMsg(msgId) {
            if (!confirm('Delete this message?')) return;
            const fd = new FormData();
            fd.append('__RequestVerificationToken', _token);
            const res = await fetch(`/Party/DeleteMessage/${msgId}`, { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                const el = document.getElementById(`msg-${msgId}`);
                if (el) el.remove();
            } else {
                showToast('❌', 'Error', data.error ?? 'Failed.', 'danger');
            }
        }

        function adjustMembersListPadding() {
            const panel = document.getElementById('questPanel');
            const list  = document.getElementById('membersList');
            if (panel && list && window.innerWidth >= 768) list.style.paddingBottom = (panel.offsetHeight + 4) + 'px';
            if (panel && list && window.innerWidth < 768) list.style.paddingBottom = '10px';
        }
        window.addEventListener('load', adjustMembersListPadding);
        window.addEventListener('resize', adjustMembersListPadding);

        async function leaveParty() {
            if (!confirm('Leave this party?')) return;
            const fd = new FormData();
            fd.append('__RequestVerificationToken', _token);
            const res = await fetch('/Party/Leave', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                showToast('👋', 'Left', 'You left the party.', 'info');
                setTimeout(() => location.reload(), 800);
            } else {
                showToast('❌', 'Error', data.error ?? 'Failed.', 'danger');
            }
        }

        let _partyInviteUserId = null;
        let _partyInviteTimer = null;

        function debouncePartyInviteSearch() {
            clearTimeout(_partyInviteTimer);
            _partyInviteTimer = setTimeout(runPartyInviteSearch, 300);
        }

        async function runPartyInviteSearch() {
            const q = document.getElementById('inviteSearch').value.trim();
            const results = document.getElementById('inviteResults');
            if (q.length < 2) { results.innerHTML = ''; return; }
            const res = await fetch(`/Party/SearchInvitable?q=${encodeURIComponent(q)}`);
            const users = await res.json();
            results.innerHTML = '';
            if (!users.length) {
                results.innerHTML = '<div class="list-group-item text-muted small">No users found</div>';
                return;
            }
            users.forEach(u => {
                const avatar = u.avatar && u.avatar !== 'default.png' ? `/uploads/${u.avatar}` : '/images/default.png';
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-2';
                item.innerHTML = `<img src="${avatar}" width="28" height="28" class="rounded-circle flex-shrink-0"
                    style="object-fit:cover;" onerror="this.src='/images/default.png'" />
                    <span class="small fw-semibold">${u.username} <span class="text-muted">Lv ${u.level}</span></span>`;
                item.onclick = () => selectPartyInviteUser(u);
                results.appendChild(item);
            });
        }

        function selectPartyInviteUser(u) {
            _partyInviteUserId = u.id;
            document.getElementById('inviteResults').innerHTML = '';
            document.getElementById('inviteSearch').value = '';
            const avatar = u.avatar && u.avatar !== 'default.png' ? `/uploads/${u.avatar}` : '/images/default.png';
            document.getElementById('inviteSelAvatar').src = avatar;
            document.getElementById('inviteSelName').textContent = u.username + ' (Lv ' + u.level + ')';
            document.getElementById('inviteSelected').classList.remove('d-none');
        }

        function clearPartyInviteSelection() {
            _partyInviteUserId = null;
            document.getElementById('inviteSelected').classList.add('d-none');
        }

        async function sendPartyInvite() {
            if (!_partyInviteUserId) return;
            const fd = new FormData();
            fd.append('__RequestVerificationToken', _token);
            fd.append('targetUserId', _partyInviteUserId);
            const res = await fetch('/Party/Invite', { method: 'POST', body: fd });
            const data = await res.json();
            const name = document.getElementById('inviteSelName').textContent;
            showToast(data.success ? '🛡️' : '❌', data.success ? 'Invited!' : 'Error',
                      data.success ? ('Invite sent to ' + name + '.') : (data.error ?? 'Failed.'),
                      data.success ? 'success' : 'danger');
            if (data.success) clearPartyInviteSelection();
        }

        async function kickMember(memberId) {
            if (!confirm('Kick this member?')) return;
            const fd = new FormData();
            fd.append('__RequestVerificationToken', _token);
            const res = await fetch(`/Party/Kick/${memberId}`, { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                showToast('👢', 'Kicked', 'Member removed.', 'warning');
                setTimeout(() => location.reload(), 600);
            } else {
                showToast('❌', 'Error', data.error ?? 'Failed.', 'danger');
            }
        }

        async function loadMore() {
            currentPage++;
            const res = await fetch(`/Party/Messages?page=${currentPage}`);
            const data = await res.json();
            if (!data.success) return;
            const area = document.getElementById('chatArea');
            const oldScrollHeight = area.scrollHeight;
            const frag = document.createDocumentFragment();
            data.messages.reverse().forEach(d => {
                const div = document.createElement('div');
                div.id = `msg-${d.id}`;
                if (d.isSystem) {
                    div.className = 'system-message';
                    div.innerHTML = `<span>${d.body}</span>`;
                    frag.appendChild(div);
                    return;
                }
                const isOwn = d.authorId === CURRENT_USER_ID;
                div.className = `chat-msg ${isOwn ? 'own' : ''}`;
                div.innerHTML = `
                    <img src="${d.authorAvatar}" class="chat-avatar flex-shrink-0" width="34" height="34"
                         onerror="this.src='/images/default.png'" />
                    <div class="chat-bubble-wrap">
                        <div class="chat-meta">
                            <span class="chat-author">${d.authorName}</span>
                            <span class="chat-time">${d.sentAt}</span>
                        </div>
                        <div class="chat-bubble">${d.body}</div>
                        <div class="chat-actions">
                            <button class="chat-icon-btn like-btn"
                                    onclick="likeMsg(${d.id}, this)"
                                    style="color:${d.likedByMe ? '#dc3545' : '#6c757d'};">
                                ❤️ <span class="like-count">${d.likeCount}</span></button>
                            ${isOwn || IS_LEADER ? `<button class="chat-icon-btn"
                                onclick="deleteMsg(${d.id})">🗑️</button>` : ''}
                        </div>
                    </div>`;
                frag.appendChild(div);
            });
            const firstMsg = area.querySelector('[id^="msg-"]');
            if (firstMsg) area.insertBefore(frag, firstMsg);
            else area.appendChild(frag);
            area.scrollTop = area.scrollHeight - oldScrollHeight;
            if (!data.hasMore) {
                const loadBtn = area.querySelector('button[onclick="loadMore()"]');
                if (loadBtn) loadBtn.closest('div')?.remove();
            }
        }

        // ── Quest functions ──────────────────────────────────────────────────────────

        async function inviteToQuest() {
            const sel = document.getElementById('questScrollSelect');
            if (!sel) return;
            const key = sel.value;
            if (!confirm(`Start quest with scroll: ${sel.options[sel.selectedIndex].text}?`)) return;
            const res  = await fetch('/PartyQuest/Invite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ questKey: key })
            });
            const data = await res.json();
            if (data.success) location.reload();
            else showToast('❌', 'Error', data.error ?? 'Failed.', 'danger');
        }

        async function questAction(url) {
            const res  = await fetch(url, { method: 'POST' });
            const data = await res.json();
            if (data.success) location.reload();
            else showToast('❌', 'Error', data.error ?? 'Failed.', 'danger');
        }

        // Poll quest status every 30s when tab is visible
        let questPollTimer = null;
        function startQuestPoll() {
            questPollTimer = setInterval(async () => {
                if (document.hidden) return;
                try {
                    const res  = await fetch('/PartyQuest/Status');
                    const data = await res.json();
                    if (data && data.status !== 'None') {
                        // Simple approach: reload if quest data changed
                        // (full AJAX panel update would require DiffDOM — skip for now)
                    }
                } catch {}
            }, 30000);
        }
        if (IN_PARTY) startQuestPoll();
    </script>
}