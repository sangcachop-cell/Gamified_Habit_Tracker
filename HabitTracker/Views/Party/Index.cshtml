let questPollTimer = null;
function startQuestPoll() {
    questPollTimer = setInterval(async () => {
        if (document.hidden) return;
        try {
            const res  = await fetch('/PartyQuest/Status');
            const data = await res.json();
            if (data && data.status !== 'None') {
                // Simple approach: reload if quest data changed
                // (full AJAX panel update would require DiffDOM — skip for now)
            }
        } catch {}
    }, 30000);
}
if (IN_PARTY) startQuestPoll();
