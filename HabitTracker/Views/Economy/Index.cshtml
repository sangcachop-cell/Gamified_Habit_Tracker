@{
    ViewData["Title"] = "Economy";
    var user      = (HabitTracker.Models.User)ViewBag.User;
    var inventory = (List<HabitTracker.Models.UserInventoryItem>)ViewBag.Inventory;
    int maxMana   = user.INT * 2 + 30;
    bool isDead   = user.HP <= 0;
    bool canPotion = !isDead && user.HP < HabitTracker.Constants.AppConstants.MAX_HP
                             && user.Gold >= HabitTracker.Constants.AppConstants.HEALTH_POTION_COST;
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<div class="container mt-4">

    @if (isDead)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between mb-4" role="alert">
            <div>
                <strong>💀 You have died!</strong>
                Penalty: level −1, all gold lost, XP reset.
            </div>
            <button id="btn-revive" class="btn btn-danger btn-sm">Revive</button>
        </div>
    }

    @if (user.IsSleeping)
    {
        <div class="alert alert-warning mb-4" role="alert">
            🌙 <strong>Rest mode active</strong> — cron will not deal HP damage while you sleep.
        </div>
    }

    <!-- Stats row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card text-center p-3">
                <div class="mb-1">❤️ <strong>HP</strong></div>
                <div class="progress mb-1" style="height:12px;">
                    <div class="progress-bar bg-danger"
                         style="width:@(Math.Round(user.HP / HabitTracker.Constants.AppConstants.MAX_HP * 100))%"></div>
                </div>
                <small>@Math.Round(user.HP, 1) / @((int)HabitTracker.Constants.AppConstants.MAX_HP)</small>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card text-center p-3">
                <div class="mb-1">💙 <strong>Mana</strong></div>
                <div class="progress mb-1" style="height:12px;">
                    <div class="progress-bar bg-primary"
                         style="width:@(maxMana > 0 ? Math.Round(user.Mana / maxMana * 100) : 0)%"></div>
                </div>
                <small>@Math.Round(user.Mana, 1) / @maxMana</small>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card text-center p-3">
                <div class="mb-1">🪙 <strong>Gold</strong></div>
                <div style="font-size:1.4rem;font-weight:700;color:#f0b429;">@Math.Round(user.Gold, 1)</div>
                <small class="text-muted">Level @user.Level</small>
            </div>
        </div>
    </div>

    <!-- Shop actions -->
    <div class="card mb-4">
        <div class="card-header fw-bold">🏪 Shop</div>
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            <!-- Health Potion -->
            <div class="d-flex align-items-center gap-2">
                <button id="btn-potion" class="btn btn-sm @(canPotion ? "btn-success" : "btn-secondary")"
                        @(canPotion ? "" : "disabled")
                        title="@(isDead ? "Revive first" : user.HP >= HabitTracker.Constants.AppConstants.MAX_HP ? "HP is full" : user.Gold < HabitTracker.Constants.AppConstants.HEALTH_POTION_COST ? $"Need {HabitTracker.Constants.AppConstants.HEALTH_POTION_COST} GP" : "")">
                    🧪 Health Potion <span class="badge bg-warning text-dark ms-1">@((int)HabitTracker.Constants.AppConstants.HEALTH_POTION_COST) GP</span>
                </button>
                <small class="text-muted">+@((int)HabitTracker.Constants.AppConstants.HEALTH_POTION_HEAL) HP</small>
            </div>

            <!-- Sleep toggle -->
            <button id="btn-sleep" class="btn btn-sm @(user.IsSleeping ? "btn-warning" : "btn-outline-secondary")">
                @(user.IsSleeping ? "☀️ Wake Up" : "🌙 Enter Rest Mode")
            </button>
        </div>
    </div>

    <!-- Inventory -->
    <div class="card">
        <div class="card-header fw-bold">🎒 Inventory (@inventory.Count items)</div>
        <div class="card-body">
            @if (!inventory.Any())
            {
                <p class="text-muted mb-0">No items yet — score tasks to find drops!</p>
            }
            else
            {
                var grouped = inventory.GroupBy(i => i.GameItem!.Type).OrderBy(g => g.Key);
                foreach (var group in grouped)
                {
                    <h6 class="mt-3 mb-2 text-uppercase text-muted" style="font-size:.75rem;letter-spacing:.05em;">
                        @(group.Key == HabitTracker.Constants.ItemType.Food ? "🍖 Food"
                          : group.Key == HabitTracker.Constants.ItemType.Egg ? "🥚 Eggs"
                          : "🧪 Hatching Potions")
                    </h6>
                    <div class="row g-2 mb-2">
                        @foreach (var inv in group)
                        {
                            string rarityClass = inv.GameItem!.Rarity switch
                            {
                                HabitTracker.Constants.ItemRarity.Uncommon => "border-success",
                                HabitTracker.Constants.ItemRarity.Rare     => "border-primary",
                                HabitTracker.Constants.ItemRarity.VeryRare => "border-warning",
                                _                                           => "border-secondary"
                            };
                            string rarityLabel = inv.GameItem.Rarity switch
                            {
                                HabitTracker.Constants.ItemRarity.Uncommon => "Uncommon",
                                HabitTracker.Constants.ItemRarity.Rare     => "Rare",
                                HabitTracker.Constants.ItemRarity.VeryRare => "Very Rare",
                                _                                           => "Common"
                            };
                            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                <div class="card h-100 text-center p-2 border @rarityClass">
                                    <div style="font-size:1.8rem;">@inv.GameItem.Icon</div>
                                    <div style="font-size:.8rem;font-weight:600;">@inv.GameItem.Name</div>
                                    <div><span class="badge bg-secondary" style="font-size:.65rem;">×@inv.Quantity</span></div>
                                    <div><small class="text-muted" style="font-size:.65rem;">@rarityLabel</small></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    const antiForgery = $('input[name="__RequestVerificationToken"]').first().val();

    function postAction(url, callback) {
        $.ajax({
            url: url,
            method: 'POST',
            data: { __RequestVerificationToken: antiForgery },
            success: callback,
            error: function() { alert('Request failed. Please try again.'); }
        });
    }

    // Health Potion
    document.getElementById('btn-potion')?.addEventListener('click', function() {
        postAction('/Economy/BuyPotion', function(r) {
            if (r.success) {
                showToast('🧪', 'Potion Used!', '+@((int)HabitTracker.Constants.AppConstants.HEALTH_POTION_HEAL) HP restored', 'toast-xp', 3000);
                if (typeof refreshHud === 'function') refreshHud();
                setTimeout(() => location.reload(), 1200);
            } else {
                showToast('🚫', 'Cannot Use', r.error, 'toast-hp', 3000);
            }
        });
    });

    // Sleep toggle
    document.getElementById('btn-sleep')?.addEventListener('click', function() {
        postAction('/Economy/ToggleSleep', function(r) {
            if (r.success) {
                if (typeof refreshHud === 'function') refreshHud();
                setTimeout(() => location.reload(), 400);
            }
        });
    });

    // Revive
    document.getElementById('btn-revive')?.addEventListener('click', function() {
        if (!confirm('Revive? You will lose: 1 level, all gold, all XP.')) return;
        postAction('/Economy/Revive', function(r) {
            if (r.success) {
                showToast('✨', 'Revived!', 'HP restored. Level ' + r.newLevel, 'toast-xp', 4000);
                if (typeof refreshHud === 'function') refreshHud();
                setTimeout(() => location.reload(), 1200);
            }
        });
    });
</script>
}
