@{
    ViewData["Title"] = "Economy";
    var user = (HabitTracker.Models.User)ViewBag.User;
    var inventory = (List<HabitTracker.Models.UserInventoryItem>)ViewBag.Inventory;
    int maxMana = user.INT * 2 + 30;
    bool isDead = user.HP <= 0;
    bool canPotion = !isDead && user.HP < HabitTracker.Constants.AppConstants.MAX_HP
                             && user.Gold >= HabitTracker.Constants.AppConstants.HEALTH_POTION_COST;
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<style>
    .economy-page {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .eco-alert {
        border: none;
        border-radius: 16px;
        padding: 14px 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
    }

    .resource-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .resource-card,
    .panel-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
    }

    .resource-card {
        padding: 20px;
        min-height: 118px;
    }

    .resource-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .resource-icon {
        font-size: 2rem;
    }

    .resource-label {
        color: #374151;
        font-weight: 900;
        font-size: 1rem;
    }

    .resource-value {
        font-size: 1.35rem;
        font-weight: 900;
        color: #111827;
        margin-left: 46px;
    }

    .resource-sub {
        margin-left: 46px;
        color: #6b7280;
        font-weight: 700;
        font-size: .82rem;
    }

    .resource-bar {
        height: 7px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 14px;
    }

        .resource-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
        }

    .bar-red {
        background: #f43f5e;
    }

    .bar-blue {
        background: #2563eb;
    }

    .gold-value {
        color: #f59e0b;
    }

    .shop-card {
        overflow: hidden;
    }

    .shop-header {
        background: linear-gradient(90deg, #2e1065, #6d28d9);
        color: #fff;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .shop-header span {
            font-size: 1.45rem;
        }

        .shop-header h2 {
            font-size: 1.15rem;
            font-weight: 900;
            margin: 0;
        }

    .shop-body {
        padding: 18px;
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 16px;
        align-items: center;
    }

    .shop-item {
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 92px;
    }

    .shop-item-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    .shop-item h3 {
        font-size: .98rem;
        font-weight: 900;
        color: #111827;
        margin-bottom: 4px;
    }

    .price-pill {
        background: #fde68a;
        color: #92400e;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 900;
        margin-left: 6px;
    }

    .shop-item p {
        color: #6b7280;
        font-weight: 700;
        margin: 0;
        font-size: .9rem;
    }

    .potion-btn {
        border: none;
        border-radius: 999px;
        padding: 7px 13px;
        font-weight: 900;
        color: #fff;
        background: #22c55e;
        font-size: .82rem;
    }

        .potion-btn:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }

    .sleep-btn {
        height: 70px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(90deg, #6d28d9, #9333ea);
        color: #fff;
        font-weight: 900;
        font-size: .95rem;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 20px;
        box-shadow: 0 10px 24px rgba(109, 40, 217, .18);
    }

        .sleep-btn.warning {
            background: linear-gradient(90deg, #f59e0b, #f97316);
        }

        .sleep-btn span {
            font-size: 1.45rem;
        }

        .sleep-btn b {
            margin-left: auto;
            font-size: 1.8rem;
            font-weight: 400;
        }

    .panel-card {
        padding: 20px;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
        font-weight: 900;
        color: #111827;
        margin-bottom: 18px;
    }

        .panel-title span {
            color: #6d28d9;
        }

    .group-title {
        color: #6b7280;
        font-size: .85rem;
        font-weight: 900;
        margin: 18px 0 10px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .item-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 150px));
        gap: 14px;
    }

    .item-card {
        width: 150px;
        min-height: 168px;
        padding: 12px;
        border-radius: 14px;
        text-align: center;
        background: #fff;
        transition: .2s ease;
    }

        .item-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 26px rgba(15, 23, 42, .08);
        }

    .item-icon {
        font-size: 2rem;
        margin-bottom: 8px;
    }

    .item-name {
        font-size: 14px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 6px;
        line-height: 1.25;
    }

    .qty-bubble {
        display: inline-block;
        background: #6b7280;
        color: #fff;
        border-radius: 7px;
        padding: 3px 8px;
        font-size: .72rem;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .rarity-text {
        color: #6b7280;
        font-weight: 700;
        font-size: .78rem;
    }

    .empty-box {
        text-align: center;
        color: #9ca3af;
        padding: 34px 10px;
        font-weight: 700;
        border: 1px dashed #d1d5db;
        border-radius: 16px;
    }

    @@media(max-width: 992px) {
        .resource-grid,
        .shop-body {
            grid-template-columns: 1fr;
        }

        .item-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 140px));
        }

        .item-card {
            width: 140px;
        }
    }
</style>

<div class="economy-page">

    @if (isDead)
    {
        <div class="alert alert-danger eco-alert d-flex align-items-center justify-content-between" role="alert">
            <div>
                <strong>💀 You have died!</strong>
                Penalty: level −1, all gold lost, XP reset.
            </div>
            <button id="btn-revive" class="btn btn-danger btn-sm">Revive</button>
        </div>
    }

    @if (user.IsSleeping)
    {
        <div class="alert alert-warning eco-alert" role="alert">
            🌙 <strong>Rest mode active</strong> — cron will not deal HP damage while you sleep.
        </div>
    }

    <section class="resource-grid">
        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">❤️</span>
                <span class="resource-label">HP</span>
            </div>

            <div class="resource-value">
                @Math.Round(user.HP, 1) / @((int)HabitTracker.Constants.AppConstants.MAX_HP)
            </div>

            <div class="resource-bar">
                <span class="bar-red" style="width:@(Math.Round(user.HP / HabitTracker.Constants.AppConstants.MAX_HP * 100))%"></span>
            </div>
        </div>

        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">💧</span>
                <span class="resource-label">Mana</span>
            </div>

            <div class="resource-value">
                @Math.Round(user.Mana, 1) / @maxMana
            </div>

            <div class="resource-bar">
                <span class="bar-blue" style="width:@(maxMana > 0 ? Math.Round(user.Mana / maxMana * 100) : 0)%"></span>
            </div>
        </div>

        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">🪙</span>
                <span class="resource-label">Gold</span>
            </div>

            <div class="resource-value gold-value">@Math.Round(user.Gold, 1)</div>
            <div class="resource-sub">Level @user.Level</div>
        </div>
    </section>

    <section class="panel-card shop-card">
        <div class="shop-header">
            <span>🏪</span>
            <h2>Shop</h2>
        </div>

        <div class="shop-body">
            <div class="shop-item">
                <div class="shop-item-icon">🧪</div>

                <div>
                    <h3>
                        Health Potion
                        <span class="price-pill">@((int)HabitTracker.Constants.AppConstants.HEALTH_POTION_COST) GP</span>
                    </h3>

                    <p>+@((int)HabitTracker.Constants.AppConstants.HEALTH_POTION_HEAL) HP</p>

                    <button id="btn-potion"
                            class="potion-btn mt-2"
                            @(canPotion ? "" : "disabled")
                            title="@(isDead ? "Revive first" : user.HP >= HabitTracker.Constants.AppConstants.MAX_HP ? "HP is full" : user.Gold < HabitTracker.Constants.AppConstants.HEALTH_POTION_COST ? $"Need {HabitTracker.Constants.AppConstants.HEALTH_POTION_COST} GP" : "")">
                        Use Potion
                    </button>
                </div>
            </div>

            <button id="btn-sleep" class="sleep-btn @(user.IsSleeping ? "warning" : "")">
                <span>@(user.IsSleeping ? "☀️" : "🌙")</span>
                @(user.IsSleeping ? "Wake Up" : "Enter Rest Mode")
                <b>›</b>
            </button>
        </div>
    </section>

    <section class="panel-card">
        <div class="panel-title">
            <span>🎒</span>
            Inventory (@inventory.Count items)
        </div>

        @if (!inventory.Any())
        {
            <div class="empty-box">
                No items yet — score tasks to find drops!
            </div>
        }
        else
        {
            var grouped = inventory.GroupBy(i => i.GameItem!.Type).OrderBy(g => g.Key);

            foreach (var group in grouped)
            {
                <h6 class="group-title">
                    @(group.Key == HabitTracker.Constants.ItemType.Food ? "🍖 Food"
                                : group.Key == HabitTracker.Constants.ItemType.Egg ? "🥚 Eggs"
                                : "🧪 Hatching Potions")
        </h6>

                <div class="item-grid mb-3">
            @foreach (var inv in group)
                    {
                        string rarityClass = inv.GameItem!.Rarity switch
                        {
                            HabitTracker.Constants.ItemRarity.Uncommon => "border-success",
                            HabitTracker.Constants.ItemRarity.Rare => "border-primary",
                            HabitTracker.Constants.ItemRarity.VeryRare => "border-warning",
                            _ => "border-secondary"
                        };

                        string rarityLabel = inv.GameItem.Rarity switch
                        {
                            HabitTracker.Constants.ItemRarity.Uncommon => "Uncommon",
                            HabitTracker.Constants.ItemRarity.Rare => "Rare",
                            HabitTracker.Constants.ItemRarity.VeryRare => "Very Rare",
                            _ => "Common"
                        };

                        <div class="item-card border @rarityClass">
                            <div class="item-icon">@inv.GameItem.Icon</div>
                            <div class="item-name">@inv.GameItem.Name</div>
                            <div class="qty-bubble">×@inv.Quantity</div>
                            <div class="rarity-text">@rarityLabel</div>
                        </div>
                    }
                </div>
            }
        }
    </section>
</div>

@section Scripts {
    <script>
        const antiForgery = $('input[name="__RequestVerificationToken"]').first().val();

        function postAction(url, callback) {
            $.ajax({
                url: url,
                method: 'POST',
                data: { __RequestVerificationToken: antiForgery },
                success: callback,
                error: function () { alert('Request failed. Please try again.'); }
            });
        }

        document.getElementById('btn-potion')?.addEventListener('click', function () {
            postAction('/Economy/BuyPotion', function (r) {
                if (r.success) {
                    showToast('🧪', 'Potion Used!', '+@((int)HabitTracker.Constants.AppConstants.HEALTH_POTION_HEAL) HP restored', 'toast-xp', 3000);
                    if (typeof refreshHud === 'function') refreshHud();
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showToast('🚫', 'Cannot Use', r.error, 'toast-hp', 3000);
                }
            });
        });

        document.getElementById('btn-sleep')?.addEventListener('click', function () {
            postAction('/Economy/ToggleSleep', function (r) {
                if (r.success) {
                    if (typeof refreshHud === 'function') refreshHud();
                    setTimeout(() => location.reload(), 400);
                }
            });
        });

        document.getElementById('btn-revive')?.addEventListener('click', function () {
            if (!confirm('Revive? You will lose: 1 level, all gold, all XP.')) return;
            postAction('/Economy/Revive', function (r) {
                if (r.success) {
                    showToast('✨', 'Revived!', 'HP restored. Level ' + r.newLevel, 'toast-xp', 4000);
                    if (typeof refreshHud === 'function') refreshHud();
                    setTimeout(() => location.reload(), 1200);
                }
            });
        });
    </script>
}