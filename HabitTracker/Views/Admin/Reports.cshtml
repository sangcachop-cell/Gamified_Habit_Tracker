@model List<HabitTracker.Models.Report>
@{
    ViewData["Title"] = "User Reports";
    var showResolved = (bool)(ViewBag.ShowResolved ?? false);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">@(showResolved ? "Resolved Reports" : "Open Reports")</h4>
        <a href="/Admin/Reports?showResolved=@(!showResolved)"
           class="btn btn-sm btn-outline-secondary">
            @(showResolved ? "View Open" : "View Resolved")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">No @(showResolved ? "resolved" : "open") reports.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Reporter</th>
                        <th>Reported User</th>
                        <th>Type</th>
                        <th>Reason</th>
                        <th>Message</th>
                        <th>Date</th>
                        @if (!showResolved)
                        {
                            <th>Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted small">@r.Id</td>
                            <td>
                                <a href="/Friend/ViewProfile/@r.ReporterId" class="text-decoration-none">
                                    @r.Reporter?.Username
                                </a>
                            </td>
                            <td>
                                <a href="/Friend/ViewProfile/@r.ReportedUserId" class="text-decoration-none fw-bold text-danger">
                                    @r.ReportedUser?.Username
                                </a>
                            </td>
                            <td>
                                @if (r.ReportedMessageId.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">Message</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">User</span>
                                }
                            </td>
                            <td class="small" style="max-width:200px;">@r.Reason</td>
                            <td class="small text-muted" style="max-width:200px;">
                                @if (r.ReportedMessage != null)
                                {
                                    <span class="text-truncate d-inline-block" style="max-width:180px;"
                                          title="@r.ReportedMessage.Body">
                                        "@(r.ReportedMessage.Body.Length > 60 ? r.ReportedMessage.Body[..60] + "…" : r.ReportedMessage.Body)"
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="small text-muted">@r.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            @if (!showResolved)
                            {
                                <td>
                                    <form method="post" action="/Admin/ResolveReport/@r.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success"
                                                onclick="return confirm('Mark this report as resolved?')">
                                            Resolve
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
