@using HabitTracker.Models
@{
    ViewData["Title"] = "Admin — Groups";
    var guilds  = (List<Guild>)ViewBag.Guilds;
    var parties = (List<Party>)ViewBag.Parties;
}
<style>
    body { background:#f5f3ef; font-family:"DM Sans",sans-serif }
    .admin-hero { background:#0a0a12; border-radius:20px; padding:28px 36px; color:white; margin-bottom:24px; position:relative; overflow:hidden }
    .admin-hero::before { content:""; position:absolute; inset:0; background:radial-gradient(ellipse at 10% 60%,rgba(232,67,106,.35),transparent 50%),radial-gradient(ellipse at 90% 30%,rgba(92,61,222,.3),transparent 55%); pointer-events:none }
    .admin-hero h2 { font-size:1.5rem; font-weight:800; letter-spacing:-1px; position:relative; z-index:2; margin:0 }
    .admin-hero p { color:rgba(255,255,255,.55); font-size:.85rem; margin:4px 0 0; position:relative; z-index:2 }
    .glass-card { background:white; border-radius:16px; border:1.5px solid rgba(0,0,0,.07); overflow:hidden; margin-bottom:24px; box-shadow:0 4px 16px rgba(0,0,0,.04) }
    .card-head { padding:14px 22px; border-bottom:1px solid #f0f0f0; display:flex; align-items:center; justify-content:space-between }
    .card-head h4 { font-size:.9rem; font-weight:700; margin:0 }
    .count-chip { background:#edeaf5; color:#5c3dde; padding:3px 10px; border-radius:50px; font-size:.73rem; font-weight:700 }
    table { width:100%; border-collapse:collapse }
    th { padding:10px 16px; text-align:left; font-size:.73rem; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#aaa; background:#fafafa; border-bottom:1px solid #f0f0f0 }
    td { padding:11px 16px; border-bottom:1px solid #f8f8f8; font-size:.86rem; vertical-align:middle }
    tr:last-child td { border:none }
    .privacy-pill { display:inline-block; padding:2px 9px; border-radius:50px; font-size:.7rem; font-weight:700 }
    .pp-public { background:#e2f5e2; color:#2e7d2e }
    .pp-private { background:#fde8ed; color:#e8436a }
    .section-empty { padding:24px; text-align:center; color:#aaa; font-size:.86rem }
    .nav-pills-admin { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px }
    .nav-pills-admin a { padding:8px 18px; border-radius:50px; font-size:.82rem; font-weight:700; text-decoration:none; background:#edeaf5; color:#5c3dde }
    .nav-pills-admin a.active { background:#5c3dde; color:white }
</style>

<div style="padding:8px 0 48px">
    <div class="admin-hero">
        <h2>🏰 Group Management</h2>
        <p>Overview of all guilds and parties in the system</p>
    </div>

    <div class="nav-pills-admin">
        <a asp-action="Index">📋 Quests</a>
        <a asp-action="Users">👤 Users</a>
        <a asp-action="Groups" class="active">🏰 Groups</a>
        <a asp-action="Blocklist">🚫 Blocklist</a>
        <a asp-action="Reports">📣 Reports</a>
        <a asp-action="Stats">📊 Stats</a>
    </div>

    <!-- Guilds -->
    <div class="glass-card">
        <div class="card-head">
            <h4>🏛️ Guilds</h4>
            <span class="count-chip">@guilds.Count</span>
        </div>
        @if (guilds.Any())
        {
            <table>
                <thead>
                    <tr><th>ID</th><th>Name</th><th>Privacy</th><th>Members</th><th>Leader</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in guilds)
                    {
                        <tr>
                            <td style="color:#aaa;font-size:.8rem">#@g.Id</td>
                            <td style="font-weight:700">@g.Name</td>
                            <td><span class="privacy-pill pp-@g.Privacy">@g.Privacy</span></td>
                            <td>@g.Members.Count</td>
                            <td style="color:#aaa">@(g.Leader?.Username ?? $"#{g.LeaderId}")</td>
                            <td style="color:#aaa;font-size:.8rem">@g.CreatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="section-empty">No guilds yet.</div> }
    </div>

    <!-- Parties -->
    <div class="glass-card">
        <div class="card-head">
            <h4>⚔️ Parties</h4>
            <span class="count-chip">@parties.Count</span>
        </div>
        @if (parties.Any())
        {
            <table>
                <thead>
                    <tr><th>ID</th><th>Name</th><th>Members</th><th>Leader</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in parties)
                    {
                        <tr>
                            <td style="color:#aaa;font-size:.8rem">#@p.Id</td>
                            <td style="font-weight:700">@p.Name</td>
                            <td>@p.Members.Count</td>
                            <td style="color:#aaa">@(p.Leader?.Username ?? $"#{p.LeaderId}")</td>
                            <td style="color:#aaa;font-size:.8rem">@p.CreatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="section-empty">No parties yet.</div> }
    </div>
</div>
