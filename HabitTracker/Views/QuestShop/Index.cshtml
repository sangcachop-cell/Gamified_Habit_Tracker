@model HabitTracker.Models.ViewModels.QuestShopViewModel
@using HabitTracker.Models
@{
    ViewData["Title"] = "Quest Shop";

    var tabs = new (string Key, string Label)[]
    {
        ("pet",             "Pet Quests"),
        ("hatchingPotion",  "Potion Quests"),
        ("unlockable",      "Series"),
        ("gold",            "Masterclasser"),
        ("seasonal",        "Seasonal"),
        ("timeTravelers",   "Time Travel"),
    };

    bool IsLocked(BossQuest q) =>
        Model.UserLevel < q.LevelRequired ||
        (q.PrerequisiteQuestKey is not null && !Model.CompletedQuestKeys.Contains(q.PrerequisiteQuestKey));

    string RarityBadge(BossQuest q) => q.GoldCost switch
    {
        0 => "<span class=\"badge bg-purple\">Time Travel</span>",
        >= 200 => "<span class=\"badge bg-warning text-dark\">Masterclasser</span>",
        _ => ""
    };
}

<style>
    :root {
        --qs-bg: #f6f7fb;
        --qs-card: #ffffff;
        --qs-text: #1f2937;
        --qs-muted: #6b7280;
        --qs-border: #e5e7eb;
        --qs-soft: #f1f5f9;
        --qs-primary: #2563eb;
        --qs-primary-hover: #1d4ed8;
        --qs-info: #06b6d4;
        --qs-gold: #f59e0b;
        --qs-green: #16a34a;
        --qs-red: #dc2626;
        --qs-purple: #7c3aed;
        --qs-shadow: 0 14px 32px rgba(15, 23, 42, .07);
    }

    body {
        background: var(--qs-bg);
        color: var(--qs-text);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .quest-shop-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px 12px 48px;
    }

    .quest-hero {
        background: var(--qs-card);
        border: 1px solid var(--qs-border);
        border-radius: 24px;
        box-shadow: var(--qs-shadow);
        padding: 22px 24px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
    }

        .quest-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 8% 15%, rgba(37, 99, 235, .10), transparent 34%), radial-gradient(circle at 88% 10%, rgba(245, 158, 11, .12), transparent 28%);
            pointer-events: none;
        }

        .quest-hero > * {
            position: relative;
            z-index: 1;
        }

    .quest-title {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 950;
        letter-spacing: -.04em;
        color: var(--qs-text);
    }

    .quest-subtitle {
        margin: 6px 0 0;
        color: var(--qs-muted);
        font-size: .92rem;
    }

    .quest-wallet {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .wallet-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 8px 13px;
        font-weight: 900;
        font-size: .86rem;
        border: 1px solid var(--qs-border);
        background: #fff;
        color: var(--qs-text);
        white-space: nowrap;
    }

    .wallet-gems {
        background: #ecfeff;
        border-color: #a5f3fc;
        color: #0e7490;
    }

    .wallet-gold {
        background: #fffbeb;
        border-color: #fde68a;
        color: #92400e;
    }

    .btn-market {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        padding: 9px 13px;
        border: 1px solid var(--qs-border);
        background: var(--qs-soft);
        color: var(--qs-text);
        font-size: .84rem;
        font-weight: 850;
        text-decoration: none;
        white-space: nowrap;
        transition: background .15s ease, transform .12s ease;
    }

        .btn-market:hover {
            background: #e5e7eb;
            color: var(--qs-text);
            transform: translateY(-1px);
            text-decoration: none;
        }

    .quest-info {
        background: #eff6ff;
        border: 1px solid rgba(37, 99, 235, .14);
        color: #1e3a8a;
        border-radius: 18px;
        padding: 12px 15px;
        margin-bottom: 18px;
        font-size: .88rem;
    }

        .quest-info a {
            color: var(--qs-primary);
            font-weight: 900;
            text-decoration: none;
        }

    .quest-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        border: 0;
        background: var(--qs-card);
        border: 1px solid var(--qs-border);
        border-radius: 18px;
        padding: 7px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
        margin-bottom: 20px;
    }

        .quest-tabs .nav-item {
            margin: 0;
        }

        .quest-tabs .nav-link {
            border: 0;
            border-radius: 13px;
            color: var(--qs-muted);
            font-weight: 900;
            font-size: .86rem;
            padding: 10px 13px;
            transition: background .15s ease, color .15s ease;
        }

            .quest-tabs .nav-link:hover {
                background: var(--qs-soft);
                color: var(--qs-text);
            }

            .quest-tabs .nav-link.active {
                background: var(--qs-primary);
                color: #fff;
            }

    .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 20px;
        border-radius: 999px;
        background: rgba(255,255,255,.22);
        color: inherit;
        font-size: .72rem;
        margin-left: 5px;
        padding: 0 6px;
    }

    .quest-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 14px;
    }

    .quest-card {
        height: 100%;
        background: var(--qs-card);
        border: 1px solid var(--qs-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
        transition: transform .12s ease, box-shadow .15s ease, border-color .15s ease;
    }

        .quest-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--qs-shadow);
            border-color: #cfd8e3;
        }

        .quest-card.is-locked {
            opacity: .58;
        }

    .quest-art {
        min-height: 92px;
        background: linear-gradient(180deg, #eff6ff, #f8fafc);
        border-bottom: 1px solid var(--qs-border);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px 10px 10px;
    }

        .quest-art img {
            max-height: 76px;
            max-width: 100%;
            object-fit: contain;
            image-rendering: pixelated;
        }

    .quest-body {
        padding: 12px;
        display: flex;
        flex-direction: column;
        min-height: 206px;
    }

    .quest-name {
        color: var(--qs-text);
        font-size: .82rem;
        font-weight: 950;
        line-height: 1.25;
        text-align: center;
        min-height: 38px;
    }

    .quest-meta {
        text-align: center;
        margin-top: 6px;
        color: var(--qs-muted);
        font-size: .68rem;
        line-height: 1.35;
    }

    .quest-drop {
        background: #f0fdfa;
        border: 1px solid #ccfbf1;
        color: #0f766e;
        border-radius: 12px;
        padding: 7px;
        text-align: center;
        font-size: .68rem;
        line-height: 1.3;
        margin-top: 8px;
        min-height: 45px;
    }

    .quest-badges {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 8px;
        min-height: 22px;
    }

    .badge-level {
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .66rem;
        font-weight: 900;
    }

        .badge-level.ok {
            background: #dcfce7;
            color: #166534;
        }

        .badge-level.locked {
            background: #fee2e2;
            color: #991b1b;
        }

    .badge-owned {
        background: #dcfce7;
        color: #166534;
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .66rem;
        font-weight: 900;
    }

    .badge-prereq {
        background: #fef3c7;
        color: #92400e;
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .66rem;
        font-weight: 900;
    }

    .scroll-thumb {
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 8px 0;
    }

        .scroll-thumb img {
            height: 34px;
            object-fit: contain;
            image-rendering: pixelated;
        }

    .quest-actions {
        margin-top: auto;
    }

    .btn-scroll {
        width: 100%;
        border: 0;
        border-radius: 13px;
        padding: 9px 8px;
        font-size: .74rem;
        font-weight: 950;
        line-height: 1.25;
        white-space: normal;
        transition: transform .12s ease, background .15s ease;
    }

        .btn-scroll:hover:not(:disabled) {
            transform: translateY(-1px);
        }

    .btn-buy-scroll {
        background: #ecfeff;
        color: #0e7490;
        border: 1px solid #a5f3fc;
    }

        .btn-buy-scroll:hover {
            background: #cffafe;
            color: #0e7490;
        }

    .btn-scroll-disabled {
        background: var(--qs-soft);
        color: var(--qs-muted);
        border: 1px solid var(--qs-border);
    }

    .bg-purple {
        background: var(--qs-purple) !important;
        color: #fff !important;
    }

    @@media (max-width: 1200px) {
        .quest-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .quest-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 640px) {
        .quest-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .quest-title {
            font-size: 1.45rem;
        }

        .quest-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

            .quest-tabs .nav-link {
                width: 100%;
            }
    }

    @@media (max-width: 420px) {
        .quest-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="quest-shop-page">
    <div class="quest-hero">
        <div>
            <h2 class="quest-title">⚔️ Quest Shop</h2>
            <p class="quest-subtitle">Mua scroll nhiệm vụ để bắt đầu quest cùng Party của bạn.</p>
        </div>

        <div class="quest-wallet">
            <span class="wallet-pill wallet-gems" id="gems-badge">💎 @Model.UserGems</span>
            <span class="wallet-pill wallet-gold" id="gold-badge">
                <img src="/images/habitica/stable/ui/Gold_Coin.png" width="18" onerror="this.style.display='none'"> @Model.UserGold GP
            </span>
            <a href="/Market" class="btn-market">← Market</a>
        </div>
    </div>

    <div class="quest-info">
        Sau khi mua scroll, vào <a href="/Party">Party page</a> để bắt đầu quest. Chỉ party leader mới có thể mở quest.
    </div>

    <ul class="nav quest-tabs" id="questTabs">
        @foreach (var (key, label) in tabs)
        {
            var quests = Model.Quests.Where(q => q.Category == key).ToList();
            if (quests.Count == 0) continue;
            <li class="nav-item">
                <button class="nav-link @(key == "pet" ? "active" : "")"
                        data-bs-toggle="tab" data-bs-target="#tab-@key">
                    @label <span class="tab-count">@quests.Count</span>
                </button>
            </li>
        }
        @{
            var otherKeys = tabs.Select(t => t.Key).ToHashSet();
            var otherQuests = Model.Quests.Where(q => !otherKeys.Contains(q.Category)).ToList();
        }
        @if (otherQuests.Count > 0)
        {
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-other">
                    Other <span class="tab-count">@otherQuests.Count</span>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content" id="questTabsContent">
        @foreach (var (key, label) in tabs)
        {
            var quests = Model.Quests.Where(q => q.Category == key).ToList();
            if (quests.Count == 0) continue;

            var groups = quests
            .GroupBy(q => q.Group ?? q.Key)
            .OrderBy(g => g.Min(q => q.LevelRequired))
            .ThenBy(g => g.First().Text)
            .ToList();

            <div class="tab-pane fade @(key == "pet" ? "show active" : "")" id="tab-@key">
                <div class="quest-grid">
                    @foreach (var group in groups)
                    {
                        foreach (var quest in group.OrderBy(q => q.LevelRequired).ThenBy(q => q.Text))
                        {
                            bool locked = IsLocked(quest);
                            bool owned = Model.OwnedScrolls.TryGetValue(quest.Key, out int qty) && qty > 0;
                            bool canAffordGem = Model.UserGems >= quest.GemCost;
                            bool canAffordGold = quest.GoldCost == 0 || Model.UserGold >= quest.GoldCost;
                            bool tooExpensive = quest.GemCost > 0 && !locked && !(canAffordGem && canAffordGold);

                            <div>
                                <div class="quest-card @(locked ? "is-locked" : "")">
                                    <div class="quest-art">
                                        <img src="@quest.BossImagePath"
                                             onerror="this.src='/images/habitica/quests/bosses/quest_armadillo.png'; this.onerror=null;"
                                             alt="@quest.Text">
                                    </div>

                                    <div class="quest-body">
                                        <div class="quest-name">@quest.Text</div>

                                        @if (quest.IsBossQuest && quest.BossHp.HasValue)
                                        {
                                            <div class="quest-meta">
                                                HP @((int)quest.BossHp) · STR @quest.BossStr.ToString("0.#")
                                                @if (quest.RageValue.HasValue)
                                                {
                                                    <span> · ⚠️ @((int)quest.RageValue)</span>
                                                }
                                            </div>
                                        }
                                        else if (!quest.IsBossQuest)
                                        {
                                            <div class="quest-meta">Collection Quest</div>
                                        }

                                        <div class="quest-drop">🎁 @quest.DropDescription</div>

                                        <div class="quest-badges">
                                            @if (quest.LevelRequired > 0)
                                            {
                                                <span class="badge-level @(Model.UserLevel >= quest.LevelRequired ? "ok" : "locked")">
                                                    Lv @quest.LevelRequired
                                                </span>
                                            }

                                            @if (quest.PrerequisiteQuestKey is not null && !Model.CompletedQuestKeys.Contains(quest.PrerequisiteQuestKey))
                                            {
                                                <span class="badge-prereq">🔒 Prereq</span>
                                            }

                                            @if (owned)
                                            {
                                                <span class="badge-owned">Owned ×@qty</span>
                                            }
                                        </div>

                                        <div class="scroll-thumb">
                                            <img src="@(locked? quest.ScrollLockedImagePath: quest.ScrollImagePath)"
                                                 onerror="this.style.display='none'"
                                                 alt="scroll">
                                        </div>

                                        <div class="quest-actions">
                                            @if (quest.GemCost <= 0)
                                            {
                                                <button class="btn-scroll btn-scroll-disabled" disabled>Time Travel</button>
                                            }
                                            else if (locked)
                                            {
                                                <button class="btn-scroll btn-scroll-disabled" disabled>🔒 Locked</button>
                                            }
                                            else
                                            {
                                                <button class="btn-scroll @(tooExpensive ? "btn-scroll-disabled" : "btn-buy-scroll") buy-scroll-btn"
                                                        data-quest-key="@quest.Key"
                                                        data-gem-cost="@quest.GemCost"
                                                        data-gold-cost="@quest.GoldCost"
                                                        @(tooExpensive ? "disabled" : "")>
                                                    💎 @quest.GemCost@(quest.GoldCost > 0 ? $" + {quest.GoldCost} GP" : "")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (otherQuests.Count > 0)
        {
            <div class="tab-pane fade" id="tab-other">
                <div class="quest-grid">
                    @foreach (var quest in otherQuests)
                    {
                        bool locked = IsLocked(quest);
                        bool owned = Model.OwnedScrolls.TryGetValue(quest.Key, out int qty2) && qty2 > 0;
                        bool tooExpensive2 = quest.GemCost > 0 && !locked &&
                        (Model.UserGems < quest.GemCost || (quest.GoldCost > 0 && Model.UserGold < quest.GoldCost));

                        <div>
                            <div class="quest-card @(locked ? "is-locked" : "")">
                                <div class="quest-art">
                                    <img src="@quest.BossImagePath"
                                         onerror="this.style.display='none'"
                                         alt="@quest.Text">
                                </div>

                                <div class="quest-body">
                                    <div class="quest-name">@quest.Text</div>
                                    <div class="quest-drop">🎁 @quest.DropDescription</div>

                                    <div class="quest-badges">
                                        @if (owned)
                                        {
                                            <span class="badge-owned">Owned ×@qty2</span>
                                        }
                                    </div>

                                    <div class="quest-actions">
                                        @if (quest.GemCost <= 0 || locked)
                                        {
                                            <button class="btn-scroll btn-scroll-disabled" disabled>@(locked ? "🔒 Locked" : "N/A")</button>
                                        }
                                        else
                                        {
                                            <button class="btn-scroll @(tooExpensive2 ? "btn-scroll-disabled" : "btn-buy-scroll") buy-scroll-btn"
                                                    data-quest-key="@quest.Key"
                                                    data-gem-cost="@quest.GemCost"
                                                    data-gold-cost="@quest.GoldCost"
                                                    @(tooExpensive2 ? "disabled" : "")>
                                                💎 @quest.GemCost@(quest.GoldCost > 0 ? $" + {quest.GoldCost} GP" : "")
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.buy-scroll-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const key      = this.dataset.questKey;
                const gemCost  = parseInt(this.dataset.gemCost);
                const goldCost = parseInt(this.dataset.goldCost) || 0;
                const costLabel = goldCost > 0 ? `💎 ${gemCost} + ${goldCost} GP` : `💎 ${gemCost}`;
                if (!confirm(`Buy scroll for ${costLabel}?`)) return;

                this.disabled = true;
                this.textContent = '...';

                const res = await fetch('/QuestShop/Buy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ questKey: key })
                });
                const data = await res.json();

                if (data.success) {
                    const gemsBadge = document.getElementById('gems-badge');
                    if (gemsBadge) gemsBadge.textContent = '💎 ' + data.newGems;
                    const goldBadge = document.getElementById('gold-badge');
                    if (goldBadge && goldCost > 0) goldBadge.textContent = data.newGold + ' GP';
                    showToast('⚔️', 'Scroll Purchased!',
                        'Go to your <a href="/Party" class="text-white fw-semibold">Party page</a> to start the quest.',
                        'success', 5000);
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast('❌', 'Purchase Failed', data.error || 'Purchase failed.', 'danger');
                    this.disabled = false;
                    this.textContent = costLabel;
                }
            });
        });
    </script>
}
