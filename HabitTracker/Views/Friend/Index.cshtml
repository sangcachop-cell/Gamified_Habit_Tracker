@{
    ViewData["Title"] = "Bạn bè";
    var friends = ViewBag.Friends as List<HabitTracker.Models.Friendship> ?? new();
    var pendingReceived = ViewBag.PendingReceived as List<HabitTracker.Models.Friendship> ?? new();
    var pendingSent = ViewBag.PendingSent as List<HabitTracker.Models.Friendship> ?? new();
    var searchResults = ViewBag.SearchResults as List<HabitTracker.Models.User> ?? new();
    var friendIds = ViewBag.FriendIds as HashSet<int> ?? new();
    var pendingIds = ViewBag.PendingIds as HashSet<int> ?? new();
    int me = (int)(ViewBag.CurrentUserId ?? 0);
}

<style>
    :root {
        --bg: #f6f4ef;
        --card: #ffffff;
        --text: #1f2937;
        --muted: #6b7280;
        --line: #e7e2d8;
        --main: #355c7d;
        --main-dark: #243f58;
        --accent: #f4a261;
        --green: #2a9d8f;
        --red: #e76f51;
        --soft-blue: #eaf2f8;
        --soft-orange: #fff3e6;
        --soft-green: #e8f6f3;
        --soft-red: #fdecea;
        --shadow: 0 10px 24px rgba(31, 41, 55, .08);
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", "Segoe UI", Arial, sans-serif;
    }

    .friend-page {
        padding: 10px 0 50px;
    }

    .friend-hero {
        background: linear-gradient(135deg, #ffffff 0%, #f9f4eb 100%);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 24px;
        box-shadow: var(--shadow);
        margin-bottom: 20px;
    }

    .hero-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero-title-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .hero-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: var(--main);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 8px 18px rgba(53, 92, 125, .22);
    }

    .friend-hero h2 {
        margin: 0;
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -.4px;
        color: var(--text);
    }

    .friend-hero p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: .92rem;
    }

    .search-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 6px;
        min-width: min(100%, 390px);
    }

    .search-input {
        border: none;
        outline: none;
        background: transparent;
        padding: 10px 12px;
        font-size: .92rem;
        flex: 1;
        min-width: 150px;
        color: var(--text);
    }

    .btn-search {
        border: none;
        background: var(--main);
        color: #fff;
        border-radius: 999px;
        padding: 10px 18px;
        font-weight: 700;
        font-size: .88rem;
        cursor: pointer;
        transition: .18s ease;
        white-space: nowrap;
    }

        .btn-search:hover {
            background: var(--main-dark);
        }

    .quick-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 20px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 14px 16px;
    }

    .stat-label {
        color: var(--muted);
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .stat-value {
        margin-top: 5px;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--main);
    }

    .alert-s {
        background: var(--soft-green);
        color: #16675d;
        border: 1px solid #bfe8df;
        padding: 12px 16px;
        border-radius: 14px;
        margin-bottom: 16px;
        font-weight: 600;
        font-size: .9rem;
    }

    .friend-layout {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 20px;
        align-items: start;
    }

    .section-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 20px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .section-head {
        padding: 18px 20px;
        border-bottom: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        background: #fffdf9;
    }

    .section-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .badge-count {
        min-width: 26px;
        height: 26px;
        padding: 0 9px;
        border-radius: 999px;
        background: var(--soft-blue);
        color: var(--main);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 800;
    }

    .section-body {
        padding: 10px 16px 16px;
    }

    .user-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 4px;
        border-bottom: 1px solid #f1eee8;
    }

        .user-row:last-child {
            border-bottom: none;
        }

    .u-av {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1rem;
        flex-shrink: 0;
        text-decoration: none;
        color: var(--main-dark);
        border: 1px solid rgba(53, 92, 125, .12);
    }

    .u-info {
        min-width: 0;
        flex: 1;
    }

    .u-name {
        font-weight: 800;
        font-size: .95rem;
        color: var(--text);
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .u-name a {
            color: var(--text);
            text-decoration: none;
        }

            .u-name a:hover {
                color: var(--main);
            }

    .u-sub {
        color: var(--muted);
        font-size: .78rem;
    }

    .u-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-view,
    .btn-add,
    .btn-accept,
    .btn-reject,
    .btn-unfriend,
    .btn-pending {
        border: none;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: .78rem;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: .18s ease;
        white-space: nowrap;
    }

    .btn-view {
        background: var(--soft-blue);
        color: var(--main);
    }

        .btn-view:hover {
            background: #dbeaf4;
            color: var(--main-dark);
        }

    .btn-add {
        background: var(--main);
        color: #fff;
    }

        .btn-add:hover {
            background: var(--main-dark);
        }

    .btn-accept {
        background: var(--green);
        color: #fff;
    }

        .btn-accept:hover {
            background: #21867a;
        }

    .btn-reject {
        background: #f0eee9;
        color: #5f6368;
    }

        .btn-reject:hover {
            background: #e6e1d9;
        }

    .btn-unfriend {
        background: var(--soft-red);
        color: var(--red);
    }

        .btn-unfriend:hover {
            background: #fbd3cc;
        }

    .btn-pending {
        background: var(--soft-orange);
        color: #b56b16;
        cursor: default;
    }

    .search-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 20px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .search-head {
        padding: 17px 20px;
        background: #fffdf9;
        border-bottom: 1px solid var(--line);
        font-weight: 800;
        color: var(--text);
    }

    .search-query {
        color: var(--main);
    }

    .empty {
        text-align: center;
        padding: 38px 18px;
        color: var(--muted);
        font-size: .9rem;
    }

    .empty-emoji {
        display: block;
        font-size: 2.2rem;
        margin-bottom: 10px;
    }

    .empty strong {
        display: block;
        color: var(--text);
        margin-bottom: 4px;
    }

    @@media (max-width: 900px) {
        .friend-layout {
            grid-template-columns: 1fr;
        }

        .quick-stats {
            grid-template-columns: 1fr;
        }

        .search-wrap {
            width: 100%;
        }
    }

    @@media (max-width: 600px) {
        .friend-hero {
            padding: 18px;
            border-radius: 18px;
        }

        .hero-title-wrap {
            align-items: flex-start;
        }

        .hero-icon {
            width: 48px;
            height: 48px;
            border-radius: 15px;
            font-size: 1.3rem;
        }

        .friend-hero h2 {
            font-size: 1.35rem;
        }

        .search-wrap {
            border-radius: 18px;
            align-items: stretch;
            flex-direction: column;
            padding: 10px;
        }

        .btn-search {
            width: 100%;
        }

        .user-row {
            align-items: flex-start;
        }

        .u-actions {
            width: 100%;
            justify-content: flex-start;
            margin-top: 8px;
        }

        .user-row {
            flex-wrap: wrap;
        }
    }
</style>

<div class="friend-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert-s">@TempData["Success"]</div>
    }

    <div class="friend-hero">
        <div class="hero-top">
            <div class="hero-title-wrap">
                <div class="hero-icon">👥</div>
                <div>
                    <h2>Bạn bè</h2>
                    <p>Quản lý bạn bè, lời mời và tìm kiếm người dùng trong hệ thống.</p>
                </div>
            </div>

            <form method="get" class="search-wrap">
                <input type="text" name="q" class="search-input"
                       placeholder="Tìm tên hoặc email..."
                       value="@ViewBag.SearchQuery" />
                <button type="submit" class="btn-search">Tìm kiếm</button>
            </form>
        </div>

        <div class="quick-stats">
            <div class="stat-card">
                <div class="stat-label">Bạn bè</div>
                <div class="stat-value">@friends.Count</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Lời mời nhận</div>
                <div class="stat-value">@pendingReceived.Count</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Đã gửi</div>
                <div class="stat-value">@pendingSent.Count</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string))
    {
        <div class="search-card">
            <div class="search-head">
                Kết quả tìm kiếm cho <span class="search-query">"@ViewBag.SearchQuery"</span>
            </div>
            <div class="section-body">
                @if (searchResults.Count > 0)
                {
                    foreach (var u in searchResults)
                    {
                        var isFriend = friendIds.Contains(u.Id);
                        var isPending = pendingIds.Contains(u.Id);
                        var avBg = new[] { "#fff3e6", "#eaf2f8", "#e8f6f3", "#fdecea", "#f4f0ff" };
                        var bg = avBg[Math.Abs(u.Id) % avBg.Length];
                        <div class="user-row">
                            <a href="/Friend/ViewProfile/@u.Id" class="u-av" style="background:@bg">
                                @u.Username.Substring(0, 1).ToUpper()
                            </a>
                            <div class="u-info">
                                <div class="u-name">
                                    <a href="/Friend/ViewProfile/@u.Id">@u.Username</a>
                                </div>
                                <div class="u-sub">Level @u.Level · @u.XP XP</div>
                            </div>
                            <div class="u-actions">
                                <a href="/Friend/ViewProfile/@u.Id" class="btn-view">Xem profile</a>
                                @if (isFriend)
                                {
                                    <span class="btn-pending">✓ Bạn bè</span>
                                }
                                else if (isPending)
                                {
                                    <span class="btn-pending">⏳ Đang chờ</span>
                                }
                                else
                                {
                                    <button class="btn-add" onclick="sendRequest(@u.Id, this)">+ Kết bạn</button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty">
                        <span class="empty-emoji">🔍</span>
                        <strong>Không tìm thấy người dùng</strong>
                        Thử nhập tên hoặc email khác.
                    </div>
                }
            </div>
        </div>
    }

    <div class="friend-layout">
        <div>
            <div class="section-card">
                <div class="section-head">
                    <h3 class="section-title">🔔 Lời mời kết bạn</h3>
                    <span class="badge-count">@pendingReceived.Count</span>
                </div>
                <div class="section-body">
                    @if (pendingReceived.Count > 0)
                    {
                        foreach (var f in pendingReceived)
                        {
                            var u = f.Requester!;
                            var bg = new[] { "#fff3e6", "#eaf2f8", "#e8f6f3", "#fdecea", "#f4f0ff" }[Math.Abs(u.Id) % 5];
                            <div class="user-row">
                                <a href="/Friend/ViewProfile/@u.Id" class="u-av" style="background:@bg">@u.Username.Substring(0, 1).ToUpper()</a>
                                <div class="u-info">
                                    <div class="u-name"><a href="/Friend/ViewProfile/@u.Id">@u.Username</a></div>
                                    <div class="u-sub">Level @u.Level · @u.XP XP</div>
                                </div>
                                <div class="u-actions">
                                    <form method="post" action="/Friend/Accept" style="display:inline">
                                        <input type="hidden" name="friendshipId" value="@f.Id" />
                                        <button type="submit" class="btn-accept">Chấp nhận</button>
                                    </form>
                                    <form method="post" action="/Friend/Reject" style="display:inline">
                                        <input type="hidden" name="friendshipId" value="@f.Id" />
                                        <button type="submit" class="btn-reject">Từ chối</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">
                            <span class="empty-emoji">📭</span>
                            <strong>Không có lời mời mới</strong>
                            Khi có người gửi lời mời, chúng sẽ hiện ở đây.
                        </div>
                    }
                </div>
            </div>

            <div class="section-card">
                <div class="section-head">
                    <h3 class="section-title">⏳ Lời mời đã gửi</h3>
                    <span class="badge-count">@pendingSent.Count</span>
                </div>
                <div class="section-body">
                    @if (pendingSent.Count > 0)
                    {
                        foreach (var f in pendingSent)
                        {
                            var u = f.Receiver!;
                            var bg = new[] { "#fff3e6", "#eaf2f8", "#e8f6f3", "#fdecea", "#f4f0ff" }[Math.Abs(u.Id) % 5];
                            <div class="user-row">
                                <a href="/Friend/ViewProfile/@u.Id" class="u-av" style="background:@bg">@u.Username.Substring(0, 1).ToUpper()</a>
                                <div class="u-info">
                                    <div class="u-name"><a href="/Friend/ViewProfile/@u.Id">@u.Username</a></div>
                                    <div class="u-sub">Level @u.Level</div>
                                </div>
                                <div class="u-actions">
                                    <form method="post" action="/Friend/Reject" style="display:inline">
                                        <input type="hidden" name="friendshipId" value="@f.Id" />
                                        <button type="submit" class="btn-reject">Huỷ</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">
                            <span class="empty-emoji">✅</span>
                            <strong>Chưa gửi lời mời nào</strong>
                            Tìm người dùng ở ô tìm kiếm phía trên để kết bạn.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div>
            <div class="section-card">
                <div class="section-head">
                    <h3 class="section-title">👥 Danh sách bạn bè</h3>
                    <span class="badge-count">@friends.Count</span>
                </div>
                <div class="section-body">
                    @if (friends.Count > 0)
                    {
                        foreach (var f in friends)
                        {
                            var u = f.RequesterId == me ? f.Receiver! : f.Requester!;
                            var bg = new[] { "#fff3e6", "#eaf2f8", "#e8f6f3", "#fdecea", "#f4f0ff" }[Math.Abs(u.Id) % 5];
                            <div class="user-row">
                                <a href="/Friend/ViewProfile/@u.Id" class="u-av" style="background:@bg">@u.Username.Substring(0, 1).ToUpper()</a>
                                <div class="u-info">
                                    <div class="u-name"><a href="/Friend/ViewProfile/@u.Id">@u.Username</a></div>
                                    <div class="u-sub">Level @u.Level · @u.XP XP · 🔥 @u.CurrentStreak</div>
                                </div>
                                <div class="u-actions">
                                    <a href="/Friend/ViewProfile/@u.Id" class="btn-view">Xem</a>
                                    <form method="post" action="/Friend/Unfriend" style="display:inline">
                                        <input type="hidden" name="friendshipId" value="@f.Id" />
                                        <button type="submit" class="btn-unfriend">Huỷ bạn</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">
                            <span class="empty-emoji">👋</span>
                            <strong>Chưa có bạn bè</strong>
                            Hãy tìm kiếm người dùng và gửi lời mời kết bạn.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function sendRequest(uid, btn) {
            btn.disabled = true;
            btn.textContent = 'Đang gửi...';

            const form = new FormData();
            form.append('receiverId', uid);

            const r = await fetch('/Friend/SendRequest', {
                method: 'POST',
                body: form,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name=__RequestVerificationToken]')?.value ?? ''
                }
            });

            const d = await r.json();
            btn.textContent = d.ok ? '⏳ Đã gửi' : '❌ Lỗi';
            if (!d.ok) {
                btn.disabled = false;
            }
        }
    </script>
}
