@model HabitTracker.Models.ViewModels.InboxViewModel
@{
    ViewData["Title"] = "Messages";
    var currentUserId = Context.Session.GetInt32("UserId") ?? 0;
    var active = Model.ActiveConversation;
    var antiforgery = Html.AntiForgeryToken();
}

<style>
    :root {
        --msg-bg: #f5f3ef;
        --msg-card: #ffffff;
        --msg-text: #1f2937;
        --msg-muted: #6b7280;
        --msg-border: #e5e7eb;
        --msg-soft: #f7f5f0;
        --msg-primary: #5c3dde;
        --msg-primary-dark: #4a2fc0;
        --msg-primary-soft: #edeaf5;
        --msg-danger: #e8436a;
        --msg-warning: #f0b429;
        --msg-shadow: 0 14px 34px rgba(15, 23, 42, .08);
    }

    body {
        background: var(--msg-bg);
        color: var(--msg-text);
        font-family: Inter, "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .message-page {
        height: calc(100vh - 92px);
        min-height: 620px;
        padding: 12px 0 24px;
    }

    .message-shell {
        height: 100%;
        display: grid;
        grid-template-columns: 340px minmax(0, 1fr);
        background: var(--msg-card);
        border: 1px solid var(--msg-border);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--msg-shadow);
    }

    .conversation-sidebar {
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: #fbfaf8;
        border-right: 1px solid var(--msg-border);
    }

    .sidebar-head {
        padding: 18px;
        border-bottom: 1px solid var(--msg-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .sidebar-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 900;
        letter-spacing: -.02em;
        color: var(--msg-text);
    }

    .sidebar-subtitle {
        margin: 3px 0 0;
        font-size: .78rem;
        color: var(--msg-muted);
        font-weight: 600;
    }

    .btn-compose {
        width: 40px;
        height: 40px;
        border: 0;
        border-radius: 14px;
        background: var(--msg-primary);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 18px rgba(92, 61, 222, .22);
        transition: transform .15s ease, background .15s ease;
    }

        .btn-compose:hover {
            background: var(--msg-primary-dark);
            transform: translateY(-1px);
        }

    .conversation-list {
        min-height: 0;
        flex: 1;
        overflow: auto;
        padding: 10px;
    }

    .conversation-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px;
        border-radius: 16px;
        color: var(--msg-text);
        text-decoration: none;
        border: 1px solid transparent;
        margin-bottom: 6px;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

        .conversation-item:hover {
            background: #fff;
            border-color: var(--msg-border);
            transform: translateY(-1px);
            color: var(--msg-text);
        }

        .conversation-item.active {
            background: var(--msg-primary-soft);
            border-color: rgba(92, 61, 222, .22);
        }

    .avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .avatar-lg,
    .avatar-md,
    .avatar-sm {
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
        background: #f3f4f6;
    }

    .avatar-lg {
        width: 44px;
        height: 44px;
    }

    .avatar-md {
        width: 40px;
        height: 40px;
    }

    .avatar-sm {
        width: 30px;
        height: 30px;
    }

    .unread-badge {
        position: absolute;
        top: -4px;
        right: -5px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: var(--msg-danger);
        color: white;
        font-size: .66rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

    .conv-main {
        min-width: 0;
        flex: 1;
    }

    .conv-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .conv-name {
        font-size: .9rem;
        font-weight: 900;
        color: var(--msg-text);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .conv-date {
        color: var(--msg-muted);
        font-size: .7rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .conv-last {
        margin-top: 3px;
        max-width: 205px;
        color: var(--msg-muted);
        font-size: .78rem;
        line-height: 1.35;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .empty-sidebar {
        padding: 46px 16px;
        text-align: center;
        color: var(--msg-muted);
        font-size: .88rem;
    }

    .chat-panel {
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .empty-chat {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--msg-muted);
        padding: 30px;
        background: radial-gradient(circle at top right, rgba(92, 61, 222, .08), transparent 35%), #fff;
    }

    .empty-chat-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 16px;
        border-radius: 26px;
        background: var(--msg-primary-soft);
        color: var(--msg-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.1rem;
    }

    .empty-chat h3 {
        color: var(--msg-text);
        font-weight: 900;
        font-size: 1.25rem;
        margin-bottom: 6px;
    }

    .chat-head {
        padding: 16px 18px;
        border-bottom: 1px solid var(--msg-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        background: rgba(255,255,255,.92);
    }

    .chat-user {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .chat-name {
        color: var(--msg-text);
        font-weight: 900;
        text-decoration: none;
        display: block;
        line-height: 1.1;
    }

        .chat-name:hover {
            color: var(--msg-primary);
        }

    .chat-meta {
        margin-top: 3px;
        color: var(--msg-muted);
        font-size: .78rem;
        font-weight: 650;
    }

    .chat-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .msg-btn {
        border: 1px solid var(--msg-border);
        border-radius: 999px;
        background: #fff;
        color: var(--msg-muted);
        padding: 7px 12px;
        font-size: .78rem;
        font-weight: 800;
        text-decoration: none;
        transition: background .15s ease, color .15s ease, border-color .15s ease;
    }

        .msg-btn:hover {
            background: var(--msg-soft);
            color: var(--msg-text);
        }

        .msg-btn.danger {
            color: var(--msg-danger);
            border-color: rgba(232, 67, 106, .22);
        }

        .msg-btn.warning {
            background: #fff7df;
            color: #8a5b00;
            border-color: rgba(240, 180, 41, .35);
        }

    .message-list {
        min-height: 0;
        flex: 1;
        overflow: auto;
        padding: 20px 22px;
        background: linear-gradient(180deg, #fff 0%, #fbfaf8 100%);
    }

    .load-older {
        text-align: center;
        margin-bottom: 16px;
    }

    .message-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
        align-items: flex-end;
    }

        .message-row.mine {
            flex-direction: row-reverse;
        }

    .message-content {
        max-width: min(68%, 680px);
    }

    .bubble {
        border-radius: 18px;
        padding: 10px 13px;
        font-size: .92rem;
        line-height: 1.45;
        word-wrap: break-word;
        white-space: pre-wrap;
        box-shadow: 0 6px 14px rgba(15, 23, 42, .05);
    }

    .message-row.mine .bubble {
        background: var(--msg-primary);
        color: #fff;
        border-bottom-right-radius: 6px;
    }

    .message-row.their .bubble {
        background: #fff;
        color: var(--msg-text);
        border: 1px solid var(--msg-border);
        border-bottom-left-radius: 6px;
    }

    .message-tools {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 5px;
        color: var(--msg-muted);
        font-size: .72rem;
    }

    .message-row.mine .message-tools {
        justify-content: flex-end;
    }

    .link-action {
        border: 0;
        background: transparent;
        padding: 0;
        color: var(--msg-muted);
        font-size: .72rem;
        font-weight: 700;
        text-decoration: none;
    }

        .link-action:hover {
            color: var(--msg-primary);
        }

        .link-action.delete:hover,
        .link-action.flag:hover {
            color: var(--msg-danger);
        }

    .compose-area {
        padding: 14px 18px;
        border-top: 1px solid var(--msg-border);
        background: #fff;
    }

    .compose-form {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        background: #f8f7f4;
        border: 1px solid var(--msg-border);
        border-radius: 18px;
        padding: 8px;
    }

    .compose-input {
        resize: none;
        max-height: 120px;
        min-height: 42px;
        border: 0;
        background: transparent;
        box-shadow: none !important;
        color: var(--msg-text);
        font-size: .92rem;
        padding: 9px 10px;
    }

        .compose-input:focus {
            background: transparent;
            outline: none;
        }

    .send-btn {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 14px;
        background: var(--msg-primary);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background .15s ease, transform .15s ease;
    }

        .send-btn:hover {
            background: var(--msg-primary-dark);
            transform: translateY(-1px);
        }

    .blocked-note {
        padding: 16px 18px;
        border-top: 1px solid var(--msg-border);
        color: var(--msg-muted);
        text-align: center;
        font-size: .88rem;
        font-weight: 700;
        background: #fbfaf8;
    }

    .modal-content {
        border: 0;
        border-radius: 20px;
        box-shadow: var(--msg-shadow);
    }

    .modal-header,
    .modal-footer {
        border-color: var(--msg-border);
    }

    .modal-title {
        font-weight: 900;
    }

    .form-control {
        border-radius: 12px;
        border-color: var(--msg-border);
    }

        .form-control:focus {
            border-color: rgba(92, 61, 222, .45);
            box-shadow: 0 0 0 .2rem rgba(92, 61, 222, .12);
        }

    .btn-primary {
        background: var(--msg-primary);
        border-color: var(--msg-primary);
        font-weight: 800;
    }

        .btn-primary:hover {
            background: var(--msg-primary-dark);
            border-color: var(--msg-primary-dark);
        }

    @@media (max-width: 900px) {
        .message-page {
            height: auto;
            min-height: 0;
        }

        .message-shell {
            grid-template-columns: 1fr;
            min-height: 760px;
        }

        .conversation-sidebar {
            max-height: 290px;
            border-right: 0;
            border-bottom: 1px solid var(--msg-border);
        }

        .message-content {
            max-width: 78%;
        }
    }

    @@media (max-width: 576px) {
        .message-list {
            padding: 16px 12px;
        }

        .chat-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .chat-actions {
            justify-content: flex-start;
        }

        .message-content {
            max-width: 84%;
        }
    }
</style>

<div class="container-fluid px-3 message-page">
    <div class="message-shell">

        @* ── LEFT: Conversation list ─────────────────────────────── *@
        <aside class="conversation-sidebar">
            <div class="sidebar-head">
                <div>
                    <h6 class="sidebar-title">💬 Messages</h6>
                    <p class="sidebar-subtitle">@(Model.Conversations.Count()) conversation@(Model.Conversations.Count() != 1 ? "s" : "")</p>
                </div>
                <button class="btn-compose" data-bs-toggle="modal" data-bs-target="#newMsgModal" title="New Message">
                    <i class="bi bi-pencil-square"></i>
                </button>
            </div>

            <div class="conversation-list">
                @if (!Model.Conversations.Any())
                {
                    <div class="empty-sidebar">
                        <div style="font-size:2rem;margin-bottom:8px;">✉️</div>
                        No conversations yet.
                    </div>
                }
                @foreach (var conv in Model.Conversations)
                {
                    var isActive = Model.ActiveConversationUserId == conv.OtherUser.Id;
                    var avatarSrc = string.IsNullOrEmpty(conv.OtherUser.Avatar) || conv.OtherUser.Avatar == "default.png"
                    ? "/images/default.png"
                    : "/uploads/" + conv.OtherUser.Avatar;
                    <a href="/Message?otherId=@conv.OtherUser.Id"
                       class="conversation-item @(isActive ? "active" : "")">
                        <div class="avatar-wrap">
                            <img src="@avatarSrc" class="avatar-lg" onerror="this.src='/images/default.png'" />
                            @if (conv.UnreadCount > 0)
                            {
                                <span class="unread-badge">@conv.UnreadCount</span>
                            }
                        </div>
                        <div class="conv-main">
                            <div class="conv-top">
                                <div class="conv-name">@conv.OtherUser.Username</div>
                                <div class="conv-date">@conv.LastMessage.SentAt.ToLocalTime().ToString("MM/dd")</div>
                            </div>
                            <div class="conv-last">
                                @(conv.LastMessage.Body.Length > 42 ? conv.LastMessage.Body[..42] + "…" : conv.LastMessage.Body)
                            </div>
                        </div>
                    </a>
                }
            </div>
        </aside>

        @* ── RIGHT: Message thread ───────────────────────────────── *@
        <main class="chat-panel">
            @if (active == null)
            {
                <div class="empty-chat">
                    <div>
                        <div class="empty-chat-icon">✉️</div>
                        <h3>Chọn một cuộc trò chuyện</h3>
                        <p class="mb-3">Chọn người ở bên trái hoặc bắt đầu nhắn tin mới.</p>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newMsgModal">
                            New Message
                        </button>
                    </div>
                </div>
            }
            else
            {
                var other = active.OtherUser;
                var otherAvatar = string.IsNullOrEmpty(other.Avatar) || other.Avatar == "default.png"
                ? "/images/default.png"
                : "/uploads/" + other.Avatar;

                @* Header *@
                <div class="chat-head">
                    <div class="chat-user">
                        <img src="@otherAvatar" class="avatar-md" onerror="this.src='/images/default.png'" />
                        <div>
                            <a href="/Friend/ViewProfile/@other.Id" class="chat-name">
                                @other.Username
                            </a>
                            <div class="chat-meta">Lv @other.Level • @other.Class?.ToUpper()</div>
                        </div>
                    </div>
                    <div class="chat-actions">
                        <a href="/Friend/ViewProfile/@other.Id" class="msg-btn">View Profile</a>
                        <button class="msg-btn @(active.IsBlocked ? "warning" : "")"
                                id="blockBtn" onclick="toggleBlock(@other.Id)">
                            @(active.IsBlocked ? "Unblock" : "Block")
                        </button>
                        <button class="msg-btn danger" data-bs-toggle="modal" data-bs-target="#reportModal">
                            Report
                        </button>
                    </div>
                </div>

                @* Messages *@
                <div class="message-list" id="msgList">
                    @if (active.Page > 0 || active.HasMore)
                    {
                        <div class="load-older">
                            @if (active.HasMore)
                            {
                                <a href="/Message?otherId=@other.Id&page=@(active.Page + 1)" class="msg-btn">
                                    Load older
                                </a>
                            }
                        </div>
                    }

                    @if (!active.Messages.Any())
                    {
                        <p class="text-muted text-center small">No messages yet. Say hello!</p>
                    }

                    @foreach (var entry in active.Messages)
                    {
                        var msg = entry.Message;
                        var isMine = msg.SenderId == currentUserId;
                        <div class="message-row @(isMine ? "mine" : "their")" id="msg-@msg.Id">
                            <div class="flex-shrink-0">
                                <img src="@(isMine ? ("/uploads/" + (Context.Session.GetString("Avatar") ?? "default.png")) : otherAvatar)"
                                     class="avatar-sm" onerror="this.src='/images/default.png'" />
                            </div>
                            <div class="message-content">
                                <div class="bubble">@msg.Body</div>
                                <div class="message-tools">
                                    <span>@msg.SentAt.ToLocalTime().ToString("g")</span>
                                    <button class="link-action like-btn"
                                            data-msg-id="@msg.Id"
                                            onclick="toggleLike(@msg.Id, this)">
                                        @(entry.LikedByMe ? "❤️" : "🤍") <span class="like-count">@entry.LikeCount</span>
                                    </button>
                                    @if (!isMine)
                                    {
                                        <button class="link-action flag"
                                                onclick="reportMessage(@msg.Id, @other.Id)">
                                            Flag
                                        </button>
                                    }
                                    @if (isMine)
                                    {
                                        <button class="link-action delete"
                                                onclick="deleteMessage(@msg.Id)">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Compose (disabled if blocked) *@
                @if (active.IsBlockedBy)
                {
                    <div class="blocked-note">
                        This user has blocked you. You cannot send messages.
                    </div>
                }
                else if (active.IsBlocked)
                {
                    <div class="blocked-note">
                        You have blocked this user. Unblock to send messages.
                    </div>
                }
                else
                {
                    <div class="compose-area">
                        <form id="sendForm" class="compose-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="receiverId" value="@other.Id">
                            <textarea class="form-control compose-input" name="body" id="msgBody" rows="1"
                              placeholder="Write a message… (Shift+Enter for new line)" required></textarea>
                            <button type="submit" class="send-btn" title="Send">
                                <i class="bi bi-send"></i>
                            </button>
                        </form>
                    </div>
                }

                @* Report modal *@
                <div class="modal fade" id="reportModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Report @other.Username</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                @Html.AntiForgeryToken()
                                <textarea class="form-control" id="reportReason" rows="4"
                                      placeholder="Describe the issue…" maxlength="500"></textarea>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button class="btn btn-danger" onclick="submitReport(@other.Id, null)">Submit Report</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </main>
    </div>
</div>

@* New message modal *@
<div class="modal fade" id="newMsgModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" id="newMsgUsername" placeholder="Enter username">
                </div>
                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea class="form-control" id="newMsgBody" rows="4" placeholder="Write your message…"></textarea>
                </div>
                <div id="newMsgError" class="text-danger small d-none"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="sendNewMessage()">Send</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll thread to bottom on load
        document.addEventListener('DOMContentLoaded', function () {
            const list = document.getElementById('msgList');
            if (list) list.scrollTop = list.scrollHeight;
        });

        // ── Send message via AJAX ──
        document.getElementById('sendForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            const body    = document.getElementById('msgBody').value.trim();
            if (!body) return;
            const token   = this.querySelector('[name=__RequestVerificationToken]').value;
            const receiver = this.querySelector('[name=receiverId]').value;

            const res  = await fetch('/Message/Send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `receiverId=${receiver}&body=${encodeURIComponent(body)}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });
            const data = await res.json();
            if (!data.success) { alert(data.error); return; }

            document.getElementById('msgBody').value = '';
            appendMessage(data, true);
        });

        // Auto-grow textarea
        document.getElementById('msgBody')?.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });

        function appendMessage(data, isMine) {
            const list = document.getElementById('msgList');
            const div  = document.createElement('div');
            div.id = 'msg-' + data.messageId;
            div.className = 'message-row ' + (isMine ? 'mine' : 'their');
            div.innerHTML = `
                <div class="flex-shrink-0">
                    <img src="${isMine ? document.querySelector('#msgList img:last-of-type')?.src ?? '' : ''}"
                         class="avatar-sm" style="object-fit:cover;">
                </div>
                <div class="message-content">
                    <div class="bubble">${escHtml(data.body)}</div>
                    <div class="message-tools ${isMine ? 'justify-content-end' : ''}">
                        <span>${data.sentAt}</span>
                        <button class="link-action like-btn" onclick="toggleLike(${data.messageId}, this)">🤍 <span class="like-count">0</span></button>
                        ${isMine ? `<button class="link-action delete" onclick="deleteMessage(${data.messageId})">Delete</button>` : ''}
                    </div>
                </div>`;
            list.appendChild(div);
            list.scrollTop = list.scrollHeight;
        }

        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ── Toggle like ──
        async function toggleLike(msgId, btn) {
            const token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
            const res   = await fetch('/Message/Like/' + msgId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            });
            const data  = await res.json();
            if (!data.success) return;
            btn.innerHTML = (data.liked ? '❤️' : '🤍') + ' <span class="like-count">' + data.count + '</span>';
        }

        // ── Delete message ──
        async function deleteMessage(msgId) {
            if (!confirm('Delete this message?')) return;
            const token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
            const res   = await fetch('/Message/Delete/' + msgId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            });
            const data  = await res.json();
            if (data.success) document.getElementById('msg-' + msgId)?.remove();
            else alert(data.error);
        }

        // ── Block/Unblock ──
        async function toggleBlock(userId) {
            const token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
            const res   = await fetch('/Message/Block/' + userId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            });
            const data  = await res.json();
            if (data.success) {
                document.getElementById('blockBtn').textContent = data.blocked ? 'Unblock' : 'Block';
                document.getElementById('blockBtn').className = data.blocked
                    ? 'msg-btn warning' : 'msg-btn';
            }
        }

        // ── Report user ──
        async function submitReport(userId, messageId) {
            const reason = document.getElementById('reportReason').value.trim();
            if (!reason) { alert('Please enter a reason.'); return; }
            const token  = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
            const body   = `reportedUserId=${userId}&reason=${encodeURIComponent(reason)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                         + (messageId ? `&reportedMessageId=${messageId}` : '');
            const res    = await fetch('/Message/Report', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body
            });
            const data   = await res.json();
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('reportModal'))?.hide();
                alert('Report submitted. Thank you.');
            } else alert(data.error);
        }

        function reportMessage(msgId, userId) {
            document.getElementById('reportReason').value = '';
            const modal = new bootstrap.Modal(document.getElementById('reportModal'));
            document.querySelector('#reportModal .btn-danger').onclick = () => submitReport(userId, msgId);
            modal.show();
        }

        // ── New message to user by username ──
        async function sendNewMessage() {
            const username = document.getElementById('newMsgUsername').value.trim();
            const body     = document.getElementById('newMsgBody').value.trim();
            const err      = document.getElementById('newMsgError');
            err.classList.add('d-none');
            if (!username || !body) { err.textContent = 'Both fields required.'; err.classList.remove('d-none'); return; }

            // Lookup user by username then send
            const lookup = await fetch('/Friend/FindByUsername?username=' + encodeURIComponent(username));
            if (!lookup.ok) { err.textContent = 'User not found.'; err.classList.remove('d-none'); return; }
            const user = await lookup.json();
            if (!user.id) { err.textContent = 'User not found.'; err.classList.remove('d-none'); return; }

            const token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
            const res   = await fetch('/Message/Send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `receiverId=${user.id}&body=${encodeURIComponent(body)}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });
            const data  = await res.json();
            if (data.success) {
                window.location.href = '/Message?otherId=' + user.id;
            } else {
                err.textContent = data.error;
                err.classList.remove('d-none');
            }
        }
    </script>
}
