@model HabitTracker.Models.ViewModels.CharacterViewModel
@using HabitTracker.Constants
@{
    ViewData["Title"] = "Character";
    var u  = Model.User;
    var es = Model.EffectiveStats;
    bool hasPoints = u.StatPoints > 0;
    double xpPct = Model.XpToNextLevel > 0
        ? Math.Min(100, Math.Round((double)Model.XpWithinLevel / Model.XpToNextLevel * 100, 1))
        : 100;

    string ClassLabel(string? cls) => cls switch
    {
        CharacterClass.Warrior => "⚔️ Warrior",
        CharacterClass.Mage    => "🔮 Mage",
        CharacterClass.Rogue   => "🗡️ Rogue",
        CharacterClass.Healer  => "💚 Healer",
        _                      => "No Class"
    };

    // Resolve equipped gear for avatar layers
    string? eqArmorKey   = u.EquippedArmor;
    string? eqHeadKey    = u.EquippedHead;
    string? eqShieldKey  = u.EquippedShield;
    string? eqWeaponKey  = u.EquippedWeapon;
    string bodyType      = u.BodyType ?? "broad";

    HabitTracker.Models.GearItem? FindGear(string? key) =>
        key == null ? null : u.OwnedGear?.Select(ug => ug.GearItem)
            .FirstOrDefault(g => g?.Key == key);

    var armorGear  = FindGear(eqArmorKey);
    var headGear   = FindGear(eqHeadKey);
    var shieldGear = FindGear(eqShieldKey);
    var weaponGear = FindGear(eqWeaponKey);
    bool wep2H     = weaponGear?.TwoHanded ?? false;
    bool isMounted = !string.IsNullOrEmpty(u.ActiveMountKey);
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<div class="container mt-4" style="max-width:860px;">

    <!-- Header row -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">⚔️ Character Sheet</h2>
        <div class="d-flex gap-2">
            <a href="/Character/Customize" class="btn btn-outline-info btn-sm">
                🎨 Customize
            </a>
            @if (Model.CanSelectClass)
            {
                <a href="/Character/SelectClass" class="btn btn-warning btn-sm">
                    🌟 Select Your Class
                </a>
            }
            @if (!string.IsNullOrEmpty(u.Class) && u.Level >= 11)
            {
                <a href="/Character/Spells" class="btn btn-primary btn-sm">
                    ✨ Cast Spells
                </a>
            }
            @if (u.Level >= 10)
            {
                <a href="/Character/Rebirth" class="btn btn-outline-danger btn-sm">
                    🔁 Rebirth
                </a>
            }
        </div>
    </div>

    <!-- Avatar + Class/Level row -->
    <div class="d-flex gap-4 mb-4 align-items-center">

        <!-- Avatar (layer stack) -->
        <div style="position:relative; width:141px; height:147px; box-sizing:border-box; padding-top:@(isMounted ? "0" : "24")px; flex-shrink:0; background:rgba(255,255,255,0.04); border-radius:8px; overflow:visible;">
            <div style="position:relative; margin-left:24px; width:90px; height:90px;">
                @if (isMounted)
                {
                    <img src="/images/habitica/stable/mounts/body/Mount_Body_@(u.ActiveMountKey).png"
                         style="position:absolute;top:0;left:0;image-rendering:pixelated;" />
                }
                <img src="/images/habitica/customize/skin/skin_@(u.SkinColor ?? "915533").png"
                     style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                <img src="/images/habitica/customize/shirts/@(bodyType)_shirt_@(u.ShirtStyle ?? "black").png"
                     style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                @if (armorGear != null)
                {
                    <img src="@armorGear.GetWornImagePath(bodyType)"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                @if (u.HairBangs > 0)
                {
                    <img src="/images/habitica/customize/hair/hair_bangs_@(u.HairBangs)_@(u.HairColor).png"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                <img src="/images/habitica/customize/hair/hair_base_@(u.HairStyle > 0 ? u.HairStyle : 1)_@(u.HairColor ?? "black").png"
                     style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                @if (u.HairMustache > 0)
                {
                    <img src="/images/habitica/customize/beards/hair_mustache_@(u.HairMustache)_@(u.HairColor).png"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                @if (u.HairBeard > 0)
                {
                    <img src="/images/habitica/customize/beards/hair_beard_@(u.HairBeard)_@(u.HairColor).png"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                @if (headGear != null)
                {
                    <img src="@headGear.GetWornImagePath(bodyType)"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                @if (shieldGear != null && !wep2H)
                {
                    <img src="@shieldGear.GetWornImagePath(bodyType)"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                @if (weaponGear != null)
                {
                    <img src="@weaponGear.GetWornImagePath(bodyType)"
                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                }
                @if (isMounted)
                {
                    <img src="/images/habitica/stable/mounts/head/Mount_Head_@(u.ActiveMountKey).png"
                         style="position:absolute;top:0;left:0;image-rendering:pixelated;" />
                }
                @if (!string.IsNullOrEmpty(u.ActivePetKey) && !isMounted)
                {
                    <img src="/images/habitica/stable/pets/Pet-@(u.ActivePetKey).png"
                         style="position:absolute;bottom:0;left:0;image-rendering:pixelated;" />
                }
            </div>
        </div>

        <!-- Class + Level card -->
        <div class="flex-grow-1">
    <div class="card p-3">
        <div class="row align-items-center">
            <div class="col-auto">
                <span class="badge fs-6 @(string.IsNullOrEmpty(u.Class) ? "bg-secondary" : "bg-primary") px-3 py-2">
                    @ClassLabel(u.Class)
                </span>
            </div>
            <div class="col">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">Level @u.Level</small>
                    <small class="text-muted">@Model.XpWithinLevel / @Model.XpToNextLevel XP</small>
                </div>
                <div class="progress" style="height:10px;" title="XP Progress">
                    <div class="progress-bar bg-warning"
                         style="width:@xpPct%;"
                         aria-valuenow="@Model.XpWithinLevel"
                         aria-valuemin="0"
                         aria-valuemax="@Model.XpToNextLevel">
                    </div>
                </div>
            </div>
        </div>
    </div>
        </div><!-- /flex-grow-1 -->
    </div><!-- /d-flex avatar+level row -->

    <!-- Stat Points banner -->
    @if (u.StatPoints > 0)
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between mb-4" role="alert">
            <span>✨ You have <strong id="stat-points-count">@u.StatPoints</strong> unallocated stat point@(u.StatPoints != 1 ? "s" : "")!</span>
            <small class="text-muted">Click <strong>+</strong> on any stat below to allocate.</small>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-4">
            <small class="text-muted">Stat points: <span id="stat-points-count">0</span> (earn 1 per level-up)</small>
        </div>
    }

    <!-- Stat cards grid -->
    <div class="row g-3 mb-4">

        @* STR *@
        <div class="col-sm-6 col-lg-3">
            @await Html.PartialAsync("_StatCard", new HabitTracker.Models.ViewModels.StatCardModel(
                "STR", "⚔️", "Strength",
                "Boosts XP and melee damage",
                u.STR, es.GearSTR, es.ClassBonusSTR, es.LevelBonus, es.BuffSTR, es.STR,
                hasPoints))
        </div>

        @* CON *@
        <div class="col-sm-6 col-lg-3">
            @await Html.PartialAsync("_StatCard", new HabitTracker.Models.ViewModels.StatCardModel(
                "CON", "🛡️", "Constitution",
                "Reduces HP damage taken from missed dailies",
                u.CON, es.GearCON, es.ClassBonusCON, es.LevelBonus, es.BuffCON, es.CON,
                hasPoints))
        </div>

        @* INT *@
        <div class="col-sm-6 col-lg-3">
            @await Html.PartialAsync("_StatCard", new HabitTracker.Models.ViewModels.StatCardModel(
                "INT", "🔮", "Intelligence",
                "Boosts mana pool and XP gained",
                u.INT, es.GearINT, es.ClassBonusINT, es.LevelBonus, es.BuffINT, es.INT,
                hasPoints))
        </div>

        @* PER *@
        <div class="col-sm-6 col-lg-3">
            @await Html.PartialAsync("_StatCard", new HabitTracker.Models.ViewModels.StatCardModel(
                "PER", "👁️", "Perception",
                "Boosts gold earned and critical hit chance",
                u.PER, es.GearPER, es.ClassBonusPER, es.LevelBonus, es.BuffPER, es.PER,
                hasPoints))
        </div>

    </div>

    <!-- Derived stats -->
    <div class="card p-3 mb-4">
        <h6 class="text-muted mb-3">Derived Stats</h6>
        <div class="row text-center">
            <div class="col-4">
                <div class="fw-bold">❤️ Max HP</div>
                <div>@es.MaxHP</div>
                <small class="text-muted">flat (CON reduces dmg)</small>
            </div>
            <div class="col-4">
                <div class="fw-bold">💙 Max Mana</div>
                <div>@es.MaxMana</div>
                <small class="text-muted">INT × 2 + 30</small>
            </div>
            <div class="col-4">
                <div class="fw-bold">📐 Level Bonus</div>
                <div>+@es.LevelBonus to all stats</div>
                <small class="text-muted">floor(level / 2)</small>
            </div>
        </div>
    </div>

    <!-- Active buffs -->
    @if (u.BuffExpiry.HasValue && u.BuffExpiry.Value > DateTime.UtcNow)
    {
        <div class="alert alert-info mb-4">
            ✨ <strong>Active Buff</strong> — expires @u.BuffExpiry.Value.ToLocalTime().ToString("g")
            <br/>
            STR +@u.BuffSTR &nbsp; CON +@u.BuffCON &nbsp; INT +@u.BuffINT &nbsp; PER +@u.BuffPER
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    'use strict';

    const token = () => $('input[name="__RequestVerificationToken"]').first().val();

    // Stat allocate buttons
    $(document).on('click', '.btn-allocate', function () {
        const stat = $(this).data('stat');
        const btn  = $(this);
        btn.prop('disabled', true);

        $.ajax({
            url: '/Character/AllocateStat?stat=' + stat,
            method: 'POST',
            data: { __RequestVerificationToken: token() },
            success: function (r) {
                if (!r.success) {
                    showToast('❌', 'Error', r.error || 'Could not allocate.', 'toast-death', 3500);
                    btn.prop('disabled', false);
                    return;
                }

                // Update displayed values
                const statLow = stat.toLowerCase();
                $('#base-' + statLow).text(r['new' + stat]);
                $('#total-' + statLow).text(r['new' + stat]
                    + parseInt($('#gear-' + statLow).text() || '0')
                    + parseInt($('#classbns-' + statLow).text() || '0')
                    + parseInt($('#lvlbns-' + statLow).text() || '0')
                    + parseInt($('#buff-' + statLow).text() || '0'));

                const pts = r.newStatPoints;
                $('#stat-points-count').text(pts);

                // Disable all "+" buttons if points exhausted
                if (pts <= 0) {
                    $('.btn-allocate').prop('disabled', true);
                    $('.stat-points-alert').hide();
                } else {
                    btn.prop('disabled', false);
                }

                showToast('✨', stat + ' increased!',
                    stat + ' is now ' + r['new' + stat] + '. (' + pts + ' points left)',
                    'toast-xp', 2500);

                refreshHud();
            },
            error: function () {
                showToast('❌', 'Error', 'Request failed.', 'toast-death', 3500);
                btn.prop('disabled', false);
            }
        });
    });
})();
</script>
}
