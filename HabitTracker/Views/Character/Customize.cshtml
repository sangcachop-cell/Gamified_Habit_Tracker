@model HabitTracker.Models.ViewModels.CustomizeViewModel
@{
    ViewData["Title"] = "Customize Avatar";
    var u = Model.User;

    // Resolve equipped gear for preview layers (static — gear doesn't change on this page)
    string bodyType = u.BodyType ?? "broad";
    HabitTracker.Models.GearItem? FindGear(string? key) =>
        key == null ? null : u.OwnedGear?.Select(ug => ug.GearItem)
            .FirstOrDefault(g => g?.Key == key);

    var armorGear = FindGear(u.EquippedArmor);
    var headGear = FindGear(u.EquippedHead);
    var shieldGear = FindGear(u.EquippedShield);
    var weaponGear = FindGear(u.EquippedWeapon);
    var backGear = FindGear(u.EquippedBack);
    var eyewearGear = FindGear(u.EquippedEyewear);
    var headAccessoryGear = FindGear(u.EquippedHeadAccessory);
    bool wep2H = weaponGear?.TwoHanded ?? false;
    bool isMounted = !string.IsNullOrEmpty(u.ActiveMountKey);
}


<style>
    :root {
        --custom-bg: #f6f7fb;
        --custom-card: #ffffff;
        --custom-text: #1f2937;
        --custom-muted: #6b7280;
        --custom-border: #e5e7eb;
        --custom-soft: #f1f5f9;
        --custom-primary: #2563eb;
        --custom-primary-hover: #1d4ed8;
        --custom-success: #16a34a;
        --custom-shadow: 0 14px 34px rgba(15, 23, 42, .08);
        --custom-radius: 20px;
    }

    body {
        background: var(--custom-bg);
        color: var(--custom-text);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .customize-page {
        max-width: 1180px;
        padding-top: 22px !important;
        padding-bottom: 46px !important;
    }

        .customize-page h2 {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 850;
            letter-spacing: -.03em;
            color: var(--custom-text);
        }

        .customize-page .btn {
            border-radius: 12px;
            font-weight: 750;
            transition: transform .12s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;
        }

            .customize-page .btn:hover {
                transform: translateY(-1px);
            }

        .customize-page .btn-primary,
        .customize-page .btn-success {
            border: 0;
            background: var(--custom-primary);
            color: #fff;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .16);
        }

            .customize-page .btn-primary:hover,
            .customize-page .btn-success:hover {
                background: var(--custom-primary-hover);
                color: #fff;
            }

        .customize-page .btn-outline-secondary {
            background: #fff;
            border-color: var(--custom-border);
            color: var(--custom-muted);
        }

            .customize-page .btn-outline-secondary:hover {
                background: var(--custom-soft);
                border-color: #cbd5e1;
                color: var(--custom-text);
            }

        .customize-page .alert {
            border: 1px solid #bbf7d0;
            background: #f0fdf4;
            color: #166534;
            border-radius: 14px;
            font-weight: 650;
        }

    .customize-toolbar {
        background: var(--custom-card);
        border: 1px solid var(--custom-border);
        border-radius: var(--custom-radius);
        padding: 18px 20px;
        box-shadow: var(--custom-shadow);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .customize-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .customize-back-btn {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: var(--custom-soft);
        border: 1px solid var(--custom-border);
        color: var(--custom-text);
        text-decoration: none;
        font-weight: 900;
    }

    .customize-subtitle {
        margin: 4px 0 0;
        color: var(--custom-muted);
        font-size: .9rem;
    }

    .customize-page .nav-tabs {
        background: var(--custom-card);
        border: 1px solid var(--custom-border);
        border-radius: 16px;
        padding: 6px;
        box-shadow: var(--custom-shadow);
        gap: 6px;
    }

        .customize-page .nav-tabs .nav-item {
            flex: 1;
        }

        .customize-page .nav-tabs .nav-link {
            width: 100%;
            border: 0;
            border-radius: 12px;
            color: var(--custom-muted);
            font-weight: 800;
            padding: 11px 12px;
            background: transparent;
        }

            .customize-page .nav-tabs .nav-link:hover {
                background: var(--custom-soft);
                color: var(--custom-text);
            }

            .customize-page .nav-tabs .nav-link.active {
                background: var(--custom-primary);
                color: #fff;
            }

    .customize-page .card {
        border: 1px solid var(--custom-border) !important;
        border-radius: var(--custom-radius);
        background: var(--custom-card) !important;
        color: var(--custom-text);
        box-shadow: var(--custom-shadow);
        overflow: hidden;
    }

        .customize-page .card.bg-dark,
        .customize-page .bg-dark {
            background: var(--custom-card) !important;
        }

    .customize-page .card-body {
        padding: 18px 20px;
    }

    .customize-page .small.fw-semibold.text-muted {
        color: var(--custom-muted) !important;
        font-size: .74rem;
        font-weight: 900 !important;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 12px !important;
    }

    .customize-swatch,
    .customize-page .bg-opt {
        background: #fff;
        border-radius: 12px !important;
        border: 2px solid transparent !important;
        box-shadow: 0 0 0 1px var(--custom-border);
        padding: 2px;
        transition: transform .12s ease, box-shadow .15s ease, border-color .15s ease;
    }

        .customize-swatch:hover,
        .customize-page .bg-opt:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(15, 23, 42, .12);
        }

        .customize-swatch[style*="#4a90d9"],
        .customize-page .bg-opt[style*="#4a90d9"] {
            border-color: var(--custom-primary) !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .14);
        }

    .customize-page .btn-sm {
        padding: 8px 13px;
        font-size: .84rem;
    }

    #avatar-preview {
        background-color: #eef2ff !important;
        border: 1px solid var(--custom-border);
        border-radius: 18px !important;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .65), 0 12px 28px rgba(15, 23, 42, .08);
    }

    .preview-card {
        position: sticky;
        top: 84px;
    }

    .save-note {
        color: var(--custom-muted);
        font-size: .82rem;
        line-height: 1.45;
    }

    .customize-page .text-muted {
        color: var(--custom-muted) !important;
    }

    .customize-page .tab-content {
        margin-top: 16px;
    }

    .option-help {
        color: var(--custom-muted);
        font-size: .8rem;
        margin-top: -4px;
        margin-bottom: 12px;
    }

    .customize-page .bg-thumb-wrap > div {
        border-radius: 12px !important;
        background: var(--custom-soft) !important;
        box-shadow: 0 0 0 1px var(--custom-border);
        color: var(--custom-muted);
    }

    @@media (max-width: 767px) {
        .customize-page {
            padding-top: 12px !important;
        }

        .customize-toolbar {
            align-items: flex-start;
        }

        .preview-card {
            position: static;
        }

        .customize-page h2 {
            font-size: 1.32rem;
        }

        .customize-page .nav-tabs {
            overflow-x: auto;
            flex-wrap: nowrap;
        }

            .customize-page .nav-tabs .nav-item {
                min-width: 150px;
            }
    }
</style>

<!-- Hidden form — submitted by Save button -->
<form id="customize-form" method="post" action="/Character/SaveAppearance">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bodyType" id="val-bodyType" value="@u.BodyType" />
    <input type="hidden" name="skinColor" id="val-skinColor" value="@u.SkinColor" />
    <input type="hidden" name="hairStyle" id="val-hairStyle" value="@u.HairStyle" />
    <input type="hidden" name="hairColor" id="val-hairColor" value="@u.HairColor" />
    <input type="hidden" name="hairBangs" id="val-hairBangs" value="@u.HairBangs" />
    <input type="hidden" name="hairBeard" id="val-hairBeard" value="@u.HairBeard" />
    <input type="hidden" name="hairMustache" id="val-hairMustache" value="@u.HairMustache" />
    <input type="hidden" name="shirtStyle" id="val-shirtStyle" value="@u.ShirtStyle" />
</form>

<div class="customize-page container-fluid py-4">
    <div class="customize-toolbar">
        <div class="customize-title-wrap">
            <a href="/Character" class="customize-back-btn" title="Back to Character">←</a>
            <div>
                <h2>✨ Customize Avatar</h2>
                <p class="customize-subtitle">Chỉnh ngoại hình nhân vật và xem trước ngay trước khi lưu.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- ===== LEFT: Controls ===== -->
        <div class="col-md-8">

            @if (!string.IsNullOrEmpty(TempData["ToastLevel"]?.ToString()))
            {
                <div class="alert alert-success py-2 small mb-3">✅ @TempData["ToastLevel"]</div>
            }

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-3" id="customizeTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-appearance" type="button">🎨 Appearance</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-hair" type="button">💇 Hair</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-background" type="button">🌄 Background</button>
                </li>
            </ul>

            <div class="tab-content">

                <!-- ===== APPEARANCE TAB ===== -->
                <div class="tab-pane fade show active" id="tab-appearance">

                    <!-- Body Type -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">BODY TYPE</div>
                            <div class="d-flex gap-2">
                                <button type="button" id="btn-broad"
                                        class="btn btn-sm @(u.BodyType == "broad" ? "btn-primary" : "btn-outline-secondary") bodytype-btn"
                                        data-value="broad" onclick="selectBodyType('broad')">
                                    Broad
                                </button>
                                <button type="button" id="btn-slim"
                                        class="btn btn-sm @(u.BodyType == "slim" ? "btn-primary" : "btn-outline-secondary") bodytype-btn"
                                        data-value="slim" onclick="selectBodyType('slim')">
                                    Slim
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Skin Color -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">SKIN COLOR</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var color in Model.SkinColors)
                                {
                                    <img src="/images/habitica/customize/skin/skin_@(color).png"
                                         width="40" height="40"
                                         class="skin-opt customize-swatch"
                                         data-color="@color"
                                         title="@color"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.SkinColor == color ? "#4a90d9" : "transparent");"
                                         onclick="selectSkin('@color')" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Shirt -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">SHIRT</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var shirt in Model.ShirtStyles)
                                {
                                    <img src="/images/habitica/customize/shirts/@(u.BodyType)_shirt_@(shirt).png"
                                         width="40" height="40"
                                         class="shirt-opt customize-swatch"
                                         data-style="@shirt"
                                         title="@shirt"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.ShirtStyle == shirt ? "#4a90d9" : "transparent");"
                                         onclick="selectShirt('@shirt')" />
                                }
                            </div>
                        </div>
                    </div>

                </div><!-- /tab-appearance -->
                <!-- ===== HAIR TAB ===== -->
                <div class="tab-pane fade" id="tab-hair">

                    <!-- Hair Style -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">HAIR STYLE</div>
                            <div class="d-flex flex-wrap gap-1">
                                @for (int i = 1; i <= Model.HairStyleCount; i++)
                                {
                                    <img src="/images/habitica/customize/hair/hair_base_@(i)_@(u.HairColor).png"
                                         width="40" height="40"
                                         class="hairstyle-opt customize-swatch"
                                         data-style="@i"
                                         title="Style @i"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.HairStyle == i ? "#4a90d9" : "transparent");"
                                         onclick="selectHairStyle(@i)" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Hair Color -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">HAIR COLOR</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var color in Model.HairColors)
                                {
                                    <img src="/images/habitica/customize/hair/hair_base_1_@(color).png"
                                         width="40" height="40"
                                         class="haircolor-opt customize-swatch"
                                         data-color="@color"
                                         title="@color"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.HairColor == color ? "#4a90d9" : "transparent");"
                                         onclick="selectHairColor('@color')" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Bangs -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">BANGS</div>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                <button type="button" id="bangs-none-btn"
                                        class="btn btn-sm @(u.HairBangs == 0 ? "btn-primary" : "btn-outline-secondary")"
                                        onclick="selectBangs(0)">
                                    None
                                </button>
                                @for (int i = 1; i <= Model.HairBangsCount; i++)
                                {
                                    <img src="/images/habitica/customize/hair/hair_bangs_@(i)_@(u.HairColor).png"
                                         width="40" height="40"
                                         class="bangs-opt customize-swatch"
                                         data-style="@i"
                                         title="Bangs @i"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.HairBangs == i ? "#4a90d9" : "transparent");"
                                         onclick="selectBangs(@i)" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Beard -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">BEARD</div>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                <button type="button" id="beard-none-btn"
                                        class="btn btn-sm @(u.HairBeard == 0 ? "btn-primary" : "btn-outline-secondary")"
                                        onclick="selectBeard(0)">
                                    None
                                </button>
                                @for (int i = 1; i <= Model.HairBeardCount; i++)
                                {
                                    <img src="/images/habitica/customize/beards/hair_beard_@(i)_@(u.HairColor).png"
                                         width="40" height="40"
                                         class="beard-opt customize-swatch"
                                         data-style="@i"
                                         title="Beard @i"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.HairBeard == i ? "#4a90d9" : "transparent");"
                                         onclick="selectBeard(@i)" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Mustache -->
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">MUSTACHE</div>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                <button type="button" id="mustache-none-btn"
                                        class="btn btn-sm @(u.HairMustache == 0 ? "btn-primary" : "btn-outline-secondary")"
                                        onclick="selectMustache(0)">
                                    None
                                </button>
                                @for (int i = 1; i <= Model.HairMustacheCount; i++)
                                {
                                    <img src="/images/habitica/customize/beards/hair_mustache_@(i)_@(u.HairColor).png"
                                         width="40" height="40"
                                         class="mustache-opt customize-swatch"
                                         data-style="@i"
                                         title="Mustache @i"
                                         style="image-rendering:pixelated; cursor:pointer; border-radius:4px; border:2px solid @(u.HairMustache == i ? "#4a90d9" : "transparent");"
                                         onclick="selectMustache(@i)" />
                                }
                            </div>
                        </div>
                    </div>

                </div><!-- /tab-hair -->
                <!-- ===== BACKGROUND TAB ===== -->
                <div class="tab-pane fade" id="tab-background">
                    <div class="card border-0 bg-dark mb-3" style="background:#1e1e2e!important;">
                        <div class="card-body py-3">
                            <div class="small fw-semibold text-muted mb-2">BACKGROUND</div>
                            <div class="d-flex flex-wrap gap-1">
                                <div class="bg-thumb-wrap" style="cursor:pointer;" onclick="setBackground('')">
                                    <div style="width:60px;height:40px;border-radius:4px;background:#1e1e2e;border:2px solid @(string.IsNullOrEmpty(u.Background) ? "#4a90d9" : "transparent");display:flex;align-items:center;justify-content:center;">
                                        <span class="text-muted small">None</span>
                                    </div>
                                </div>
                                @foreach (var bg in Model.Backgrounds)
                                {
                                    <img src="/images/habitica/backgrounds/background_@(bg).png"
                                         width="60" height="40"
                                         class="bg-opt"
                                         data-key="@bg"
                                         title="@bg.Replace("_", " ")"
                                         style="object-fit:cover;cursor:pointer;border-radius:4px;border:2px solid @(u.Background == bg ? "#4a90d9" : "transparent");"
                                         onclick="setBackground('@bg')" />
                                }
                            </div>
                        </div>
                    </div>
                </div><!-- /tab-background -->

            </div><!-- /tab-content -->
        </div><!-- /col-md-8 -->
        <!-- ===== RIGHT: Preview + Save ===== -->
        <div class="col-md-4">
            <div class="preview-card">
                <div class="card border-0 bg-dark text-center" style="background:#1e1e2e!important;">
                    <div class="card-body py-4">
                        <div class="small fw-semibold text-muted mb-3">PREVIEW</div>

                        <!-- Avatar Stack -->
                        <div class="d-flex justify-content-center mb-4">
                            <div id="avatar-preview"
                                 style="position:relative; width:141px; height:147px; box-sizing:border-box; padding-top:@(isMounted ? "0" : "24")px; background:rgba(255,255,255,0.04); border-radius:8px; overflow:visible; @(!string.IsNullOrEmpty(u.Background) ? $"background-image:url('/images/habitica/backgrounds/background_{u.Background}.png');background-size:cover;background-position:center top;" : "")">
                                <!-- Layer order: mount-body → back → skin → shirt → bangs → base → mustache → beard → eyewear → gear → headAccessory → mount-head / pet -->
                                <div style="position:relative; margin-left:24px; width:90px; height:90px;">
                                    @if (isMounted)
                                    {
                                        <img src="/images/habitica/stable/mounts/body/Mount_Body_@(u.ActiveMountKey).png"
                                             style="position:absolute;top:0;left:0;image-rendering:pixelated;" />
                                    }
                                    <img id="layer-back-gear"
                                         src="@(backGear != null ? backGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(backGear == null ? "display:none;" : "")"
                                         onerror="if(!this.src.endsWith('.gif')){this.src=this.src.replace('.png','.gif');}else{this.onerror=null;this.style.display='none';}" />
                                    <img id="layer-skin"
                                         src="/images/habitica/customize/skin/skin_@(u.SkinColor).png"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                                    <img id="layer-shirt"
                                         src="/images/habitica/customize/shirts/@(u.BodyType)_shirt_@(u.ShirtStyle).png"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                                    <img id="layer-bangs"
                                         src="@(u.HairBangs > 0 ? $"/images/habitica/customize/hair/hair_bangs_{u.HairBangs}_{u.HairColor}.png" : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(u.HairBangs == 0 ? "display:none;" : "")" />
                                    <img id="layer-hair"
                                         src="/images/habitica/customize/hair/hair_base_@(u.HairStyle)_@(u.HairColor).png"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;" />
                                    <img id="layer-mustache"
                                         src="@(u.HairMustache > 0 ? $"/images/habitica/customize/beards/hair_mustache_{u.HairMustache}_{u.HairColor}.png" : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(u.HairMustache == 0 ? "display:none;" : "")" />
                                    <img id="layer-beard"
                                         src="@(u.HairBeard > 0 ? $"/images/habitica/customize/beards/hair_beard_{u.HairBeard}_{u.HairColor}.png" : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(u.HairBeard == 0 ? "display:none;" : "")" />
                                    <img id="layer-eyewear-gear"
                                         src="@(eyewearGear != null ? eyewearGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(eyewearGear == null ? "display:none;" : "")"
                                         onerror="if(!this.src.endsWith('.gif')){this.src=this.src.replace('.png','.gif');}else{this.onerror=null;this.style.display='none';}" />
                                    <img id="layer-armor-gear"
                                         src="@(armorGear != null ? armorGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(armorGear == null ? "display:none;" : "")" />
                                    <img id="layer-head-gear"
                                         src="@(headGear != null ? headGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(headGear == null ? "display:none;" : "")" />
                                    <img id="layer-headaccessory-gear"
                                         src="@(headAccessoryGear != null ? headAccessoryGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(headAccessoryGear == null ? "display:none;" : "")"
                                         onerror="if(!this.src.endsWith('.gif')){this.src=this.src.replace('.png','.gif');}else{this.onerror=null;this.style.display='none';}" />
                                    <img id="layer-shield-gear"
                                         src="@(shieldGear != null && !wep2H ? shieldGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(shieldGear == null || wep2H ? "display:none;" : "")" />
                                    <img id="layer-weapon-gear"
                                         src="@(weaponGear != null ? weaponGear.GetWornImagePath(bodyType) : "")"
                                         style="position:absolute;top:0;left:0;width:90px;height:90px;image-rendering:pixelated;@(weaponGear == null ? "display:none;" : "")" />
                                    @if (isMounted)
                                    {
                                        <img src="/images/habitica/stable/mounts/head/Mount_Head_@(u.ActiveMountKey).png"
                                             style="position:absolute;top:0;left:0;image-rendering:pixelated;" />
                                    }
                                    @if (!string.IsNullOrEmpty(u.ActivePetKey) && !isMounted)
                                    {
                                        <img src="/images/habitica/stable/pets/Pet-@(u.ActivePetKey).png"
                                             style="position:absolute;bottom:-10px;left:-14px;image-rendering:pixelated;" />
                                    }
                                </div>
                            </div>
                        </div>

                        <button type="submit" form="customize-form" class="btn btn-success w-100 mb-2">
                            💾 Save Appearance
                        </button>
                        <div class="small text-muted">Changes preview instantly — save to keep.</div>
                    </div>
                </div>
            </div>
        </div><!-- /col-md-4 -->

    </div><!-- /row -->
</div><!-- /container -->
@section Scripts {
    <script>
        (function () {
            // Current selections (JS state)
            var cur = {
                bodyType:    '@u.BodyType',
                skinColor:   '@u.SkinColor',
                hairStyle:   @u.HairStyle,
                hairColor:   '@u.HairColor',
                hairBangs:   @u.HairBangs,
                hairBeard:   @u.HairBeard,
                hairMustache: @u.HairMustache,
                shirtStyle:  '@u.ShirtStyle'
            };

            // ===== UPDATE FUNCTIONS =====

            function updatePreview() {
                // Update layer images — order: skin → shirt → bangs → base → mustache → beard
                $('#layer-skin').attr('src', '/images/habitica/customize/skin/skin_' + cur.skinColor + '.png');
                $('#layer-shirt').attr('src', '/images/habitica/customize/shirts/' + cur.bodyType + '_shirt_' + cur.shirtStyle + '.png');

                if (cur.hairBangs > 0) {
                    $('#layer-bangs').attr('src', '/images/habitica/customize/hair/hair_bangs_' + cur.hairBangs + '_' + cur.hairColor + '.png').show();
                } else { $('#layer-bangs').hide(); }

                $('#layer-hair').attr('src', '/images/habitica/customize/hair/hair_base_' + cur.hairStyle + '_' + cur.hairColor + '.png');

                if (cur.hairMustache > 0) {
                    $('#layer-mustache').attr('src', '/images/habitica/customize/beards/hair_mustache_' + cur.hairMustache + '_' + cur.hairColor + '.png').show();
                } else { $('#layer-mustache').hide(); }

                if (cur.hairBeard > 0) {
                    $('#layer-beard').attr('src', '/images/habitica/customize/beards/hair_beard_' + cur.hairBeard + '_' + cur.hairColor + '.png').show();
                } else { $('#layer-beard').hide(); }

                // Re-src thumbnails that depend on mutable props
                updateHairThumbs();
                updateShirtThumbs();

                // Sync hidden form inputs
                $('#val-bodyType').val(cur.bodyType);
                $('#val-skinColor').val(cur.skinColor);
                $('#val-hairStyle').val(cur.hairStyle);
                $('#val-hairColor').val(cur.hairColor);
                $('#val-hairBangs').val(cur.hairBangs);
                $('#val-hairBeard').val(cur.hairBeard);
                $('#val-hairMustache').val(cur.hairMustache);
                $('#val-shirtStyle').val(cur.shirtStyle);
            }

            function updateHairThumbs() {
                var col = cur.hairColor;
                $('.hairstyle-opt').each(function () {
                    var s = $(this).data('style');
                    $(this).attr('src', '/images/habitica/customize/hair/hair_base_' + s + '_' + col + '.png');
                });
                $('.bangs-opt').each(function () {
                    var s = $(this).data('style');
                    $(this).attr('src', '/images/habitica/customize/hair/hair_bangs_' + s + '_' + col + '.png');
                });
                $('.beard-opt').each(function () {
                    var s = $(this).data('style');
                    $(this).attr('src', '/images/habitica/customize/beards/hair_beard_' + s + '_' + col + '.png');
                });
                $('.mustache-opt').each(function () {
                    var s = $(this).data('style');
                    $(this).attr('src', '/images/habitica/customize/beards/hair_mustache_' + s + '_' + col + '.png');
                });
            }

            function updateShirtThumbs() {
                var bt = cur.bodyType;
                $('.shirt-opt').each(function () {
                    var s = $(this).data('style');
                    $(this).attr('src', '/images/habitica/customize/shirts/' + bt + '_shirt_' + s + '.png');
                });
            }

            // ===== HIGHLIGHT HELPERS =====

            function highlightSwatch(selector, activeVal, attr) {
                $(selector).each(function () {
                    var v = $(this).data(attr);
                    $(this).css('border-color', String(v) === String(activeVal) ? '#4a90d9' : 'transparent');
                });
            }

            function highlightBtn(selector, activeVal) {
                $(selector).each(function () {
                    var v = $(this).data('value');
                    if (String(v) === String(activeVal)) {
                        $(this).removeClass('btn-outline-secondary').addClass('btn-primary');
                    } else {
                        $(this).removeClass('btn-primary').addClass('btn-outline-secondary');
                    }
                });
            }

            // ===== PUBLIC SELECTION HANDLERS =====

            window.selectBodyType = function (val) {
                cur.bodyType = val;
                highlightBtn('.bodytype-btn', val);
                updatePreview();
            };

            window.selectSkin = function (color) {
                cur.skinColor = color;
                highlightSwatch('.skin-opt', color, 'color');
                updatePreview();
            };

            window.selectShirt = function (style) {
                cur.shirtStyle = style;
                highlightSwatch('.shirt-opt', style, 'style');
                updatePreview();
            };

            window.selectHairStyle = function (style) {
                cur.hairStyle = style;
                highlightSwatch('.hairstyle-opt', style, 'style');
                updatePreview();
            };

            window.selectHairColor = function (color) {
                cur.hairColor = color;
                highlightSwatch('.haircolor-opt', color, 'color');
                updatePreview();
            };

            window.selectBangs = function (style) {
                cur.hairBangs = style;
                if (style === 0) {
                    $('#bangs-none-btn').removeClass('btn-outline-secondary').addClass('btn-primary');
                } else {
                    $('#bangs-none-btn').removeClass('btn-primary').addClass('btn-outline-secondary');
                }
                highlightSwatch('.bangs-opt', style, 'style');
                updatePreview();
            };

            window.selectBeard = function (style) {
                cur.hairBeard = style;
                if (style === 0) {
                    $('#beard-none-btn').removeClass('btn-outline-secondary').addClass('btn-primary');
                } else {
                    $('#beard-none-btn').removeClass('btn-primary').addClass('btn-outline-secondary');
                }
                highlightSwatch('.beard-opt', style, 'style');
                updatePreview();
            };

            window.selectMustache = function (style) {
                cur.hairMustache = style;
                if (style === 0) {
                    $('#mustache-none-btn').removeClass('btn-outline-secondary').addClass('btn-primary');
                } else {
                    $('#mustache-none-btn').removeClass('btn-primary').addClass('btn-outline-secondary');
                }
                highlightSwatch('.mustache-opt', style, 'style');
                updatePreview();
            };

            window.setBackground = function (key) {
                var el = document.getElementById('avatar-preview');
                if (key) {
                    el.style.backgroundImage = "url('/images/habitica/backgrounds/background_" + key + ".png')";
                    el.style.backgroundSize = 'cover';
                    el.style.backgroundPosition = 'center top';
                } else {
                    el.style.backgroundImage = '';
                }
                $('.bg-opt').css('border-color', 'transparent');
                if (key) {
                    $('.bg-opt[data-key="' + key + '"]').css('border-color', '#4a90d9');
                }
                var csrf = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
                fetch('/Character/SetBackground', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'key=' + encodeURIComponent(key || '') + '&__RequestVerificationToken=' + encodeURIComponent(csrf)
                });
            };

        })();
    </script>
}