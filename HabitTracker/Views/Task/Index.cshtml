@model HabitTracker.Models.ViewModels.TaskBoardViewModel
@using HabitTracker.Constants
@{
    ViewData["Title"] = "My Tasks";
}

<style>
    :root {
        --page-bg: #f5f3ef;
        --surface: #ffffff;
        --surface-2: #faf9f6;
        --ink: #1f2937;
        --muted: #6b7280;
        --line: #e7e2d8;
        --primary: #5c3dde;
        --primary-dark: #4328bd;
        --primary-soft: #edeaf5;
        --green: #00a884;
        --red: #e8436a;
        --yellow: #f0b429;
        --orange: #f97316;
        --blue: #3b82f6;
        --shadow: 0 12px 30px rgba(31, 41, 55, .07);
        --radius: 18px;
        /* giữ tương thích với code cũ */
        --violet: var(--primary);
    }

    body {
        background: radial-gradient(circle at top left, rgba(92, 61, 222, .08), transparent 32%), radial-gradient(circle at top right, rgba(240, 180, 41, .12), transparent 28%), var(--page-bg);
        color: var(--ink);
        font-family: Inter, "DM Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .task-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 10px 0 36px;
    }

    .task-hero {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 22px 24px;
        margin-bottom: 16px;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
    }

        .task-hero::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 999px;
            background: rgba(92, 61, 222, .08);
            right: -70px;
            top: -80px;
        }

    .hero-content,
    .board-stats {
        position: relative;
        z-index: 1;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--line);
        background: var(--surface-2);
        color: var(--muted);
        border-radius: 999px;
        padding: 6px 10px;
        font-size: .78rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .task-title {
        margin: 0;
        font-family: "Syne", Inter, sans-serif;
        font-size: 1.65rem;
        font-weight: 850;
        letter-spacing: -.04em;
        color: var(--ink);
    }

    .task-subtitle {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: .92rem;
        line-height: 1.45;
    }

    .board-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(126px, 1fr));
        gap: 10px;
        min-width: 280px;
    }

    .stat-pill {
        border: 1px solid var(--line);
        background: var(--surface-2);
        border-radius: 16px;
        padding: 10px 12px;
        color: var(--muted);
        font-size: .78rem;
        font-weight: 800;
    }

        .stat-pill strong {
            display: block;
            margin-top: 2px;
            color: var(--ink);
            font-family: "Syne", Inter, sans-serif;
            font-size: 1.02rem;
        }

    .skills-bar {
        background: rgba(255, 255, 255, .92);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 16px;
        margin-bottom: 16px;
        box-shadow: var(--shadow);
    }

    .skill-btn {
        min-width: 88px;
        cursor: pointer;
        user-select: none;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 10px 10px;
        background: var(--surface-2);
        text-align: center;
        transition: border-color .15s ease, background .15s ease, box-shadow .15s ease, transform .12s ease;
    }

        .skill-btn:hover:not(.skill-disabled) {
            border-color: rgba(92, 61, 222, .45);
            background: #f3f0ff;
            transform: translateY(-1px);
        }

        .skill-btn.skill-active {
            border-color: var(--primary);
            background: #f3f0ff;
            box-shadow: 0 0 0 4px rgba(92, 61, 222, .12);
        }

        .skill-btn.skill-casting {
            opacity: .6;
            pointer-events: none;
        }

        .skill-btn.skill-disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .skill-name {
        margin-top: 6px;
        color: var(--ink);
        font-size: .73rem;
        font-weight: 850;
        line-height: 1.2;
    }

    .skill-cost {
        margin-top: 2px;
        color: var(--muted);
        font-size: .7rem;
        font-weight: 750;
    }

    #skillManaBar {
        background: var(--primary) !important;
    }

    .task-board {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        align-items: start;
    }

    .board-col {
        background: rgba(255, 255, 255, .95);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 14px;
        min-height: 280px;
        box-shadow: var(--shadow);
    }

    .col-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 4px 4px 13px;
        margin-bottom: 12px;
        border-bottom: 1px solid var(--line);
    }

    .col-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--ink);
        font-family: "Syne", Inter, sans-serif;
        font-size: .98rem;
        font-weight: 850;
        letter-spacing: -.02em;
    }

    .col-icon {
        width: 34px;
        height: 34px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-soft);
        font-size: 1rem;
        flex-shrink: 0;
    }

    .col-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 26px;
        height: 24px;
        padding: 0 8px;
        border-radius: 999px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        color: var(--muted);
        font-size: .73rem;
        font-weight: 850;
        font-family: Inter, sans-serif;
    }

        .col-count.urgent {
            background: #fff1f2;
            border-color: #ffd6dd;
            color: var(--red);
        }

    .btn-add-task {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 7px 13px;
        border: 0;
        border-radius: 12px;
        background: var(--ink);
        color: white;
        font-size: .8rem;
        font-weight: 850;
        text-decoration: none;
        transition: background .15s ease, transform .12s ease;
        white-space: nowrap;
    }

        .btn-add-task:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-1px);
        }

    .empty-state {
        margin: 8px 0 2px;
        border: 1px dashed #d7d0c4;
        border-radius: 18px;
        background: var(--surface-2);
        color: var(--muted);
        text-align: center;
        padding: 30px 12px;
        font-size: .9rem;
    }

        .empty-state small {
            color: #9ca3af;
        }

    .task-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-left: 5px solid var(--green);
        border-radius: 18px;
        padding: 13px;
        margin-bottom: 11px;
        transition: border-color .15s ease, box-shadow .15s ease, transform .12s ease;
    }

        .task-card:hover {
            border-color: #d7d0c4;
            box-shadow: 0 12px 24px rgba(31, 41, 55, .08);
            transform: translateY(-1px);
        }

    .val-blue {
        border-left-color: var(--blue);
    }

    .val-green {
        border-left-color: var(--green);
    }

    .val-yellow {
        border-left-color: var(--yellow);
    }

    .val-orange {
        border-left-color: var(--orange);
    }

    .val-red {
        border-left-color: var(--red);
    }

    .task-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .task-text {
        flex: 1;
        color: var(--ink);
        font-size: .94rem;
        font-weight: 780;
        line-height: 1.4;
        word-break: break-word;
    }

        .task-text.done {
            color: #9ca3af;
            text-decoration: line-through;
        }

    .task-actions {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
    }

    .btn-task-icon {
        width: 29px;
        height: 29px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 10px;
        background: transparent;
        color: var(--muted);
        font-size: .8rem;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
    }

        .btn-task-icon:hover {
            background: var(--surface-2);
            border-color: var(--line);
            color: var(--ink);
        }

    .priority-badge {
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .68rem;
        font-weight: 850;
        letter-spacing: .02em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .priority-trivial {
        background: #f3f4f6;
        color: #6b7280;
    }

    .priority-easy {
        background: #dcfce7;
        color: #15803d;
    }

    .priority-medium {
        background: #fef3c7;
        color: #a16207;
    }

    .priority-hard {
        background: #fee2e2;
        color: #b91c1c;
    }

    .habit-controls,
    .daily-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 9px;
    }

    .btn-score {
        border: 0;
        border-radius: 12px;
        padding: 7px 12px;
        min-height: 35px;
        font-weight: 900;
        font-size: .95rem;
        cursor: pointer;
        transition: opacity .15s ease, transform .1s ease;
    }

        .btn-score:hover {
            opacity: .88;
        }

        .btn-score:active {
            transform: scale(.96);
        }

        .btn-score:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .btn-score-up {
        background: #dcfce7;
        color: #15803d;
    }

    .btn-score-down {
        background: #fee2e2;
        color: #b91c1c;
    }

    .btn-claim {
        background: #fef3c7;
        color: #92400e;
        padding: 7px 14px;
    }

    .habit-counter {
        flex: 1;
        min-width: 52px;
        border-radius: 12px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        color: var(--muted);
        padding: 7px 8px;
        text-align: center;
        font-size: .82rem;
        font-weight: 850;
    }

    .daily-check-label {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: var(--muted);
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
    }

        .daily-check-label input[type=checkbox],
        .checklist-item input[type=checkbox] {
            width: 17px;
            height: 17px;
            accent-color: var(--primary);
            cursor: pointer;
        }

        .daily-check-label input:disabled {
            cursor: default;
            opacity: .55;
        }

    .streak-badge,
    .due-badge,
    .gold-cost {
        border-radius: 999px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        color: var(--muted);
        padding: 5px 8px;
        font-size: .75rem;
        font-weight: 850;
        white-space: nowrap;
    }

        .due-badge.overdue {
            background: #fff1f2;
            border-color: #ffd6dd;
            color: var(--red);
        }

    .gold-cost {
        background: #fef3c7;
        border-color: #fde68a;
        color: #92400e;
    }

    .checklist-section {
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid var(--line);
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
        color: var(--muted);
        font-size: .84rem;
    }

        .checklist-item.done span {
            color: #a1a1aa;
            text-decoration: line-through;
        }

    .reward-note {
        font-size: .72rem;
        color: var(--muted);
    }

    .clear-todos-link {
        display: block;
        margin-top: 8px;
        padding: 9px 10px;
        border-radius: 13px;
        color: var(--muted);
        background: var(--surface-2);
        border: 1px solid var(--line);
        font-size: .8rem;
        font-weight: 800;
        text-align: center;
        text-decoration: none;
    }

        .clear-todos-link:hover {
            color: var(--red);
            background: #fff1f2;
            border-color: #ffd6dd;
        }

    .skill-targeting .task-card {
        cursor: crosshair !important;
        outline: 2px dashed var(--primary);
        outline-offset: 2px;
    }

        .skill-targeting .task-card * {
            pointer-events: none;
        }

    @@media (max-width: 1200px) {
        .task-board {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .task-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .board-stats {
            width: 100%;
            min-width: 0;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .task-board {
            grid-template-columns: 1fr;
        }

        .task-title {
            font-size: 1.4rem;
        }
    }

    @@media (max-width: 420px) {
        .board-stats {
            grid-template-columns: 1fr;
        }

        .col-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-add-task {
            width: 100%;
        }
    }
</style>

<div class="task-page">

    <div class="task-hero">
        <div class="hero-content">
            <div class="hero-eyebrow">📌 Task Board</div>
            <h1 class="task-title">Quản lý nhiệm vụ</h1>
            <p class="task-subtitle">Theo dõi thói quen, việc hằng ngày, to-do và phần thưởng trong một màn hình dễ sử dụng.</p>
        </div>

        <div class="board-stats">
            <span class="stat-pill">Habits <strong>🔄 @Model.Habits.Count</strong></span>
            <span class="stat-pill">Dailies đến hạn <strong>☀️ @Model.DueDailiesCount</strong></span>
            <span class="stat-pill">To-dos <strong>✅ @Model.PendingTodosCount</strong></span>
            <span class="stat-pill">Rewards <strong>🎁 @Model.Rewards.Count</strong></span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Hidden CSRF token for AJAX posts -->
    <form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

    @if (Model.CanUseSkills && Model.Skills.Any())
    {
        var userMana = (int)(Model.User!.Mana);
        var maxMana = Model.EffectiveStats!.MaxMana;
        var manaPct = maxMana > 0 ? Math.Min(100, userMana * 100 / maxMana) : 0;
        <div class="skills-bar" id="skillsBar">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <div class="fw-semibold" style="font-size:.88rem;color:var(--primary);">✨ Skills</div>
                <div class="d-flex align-items-center gap-2">
                    <span class="mana-text text-muted small">💧 @userMana / @maxMana MP</span>
                    <div class="progress" style="width:90px;height:6px;" title="Mana">
                        <div class="progress-bar" id="skillManaBar"
                             style="width:@manaPct%;background:var(--primary);"></div>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var skill in Model.Skills)
                {
                    bool canCast = Model.User!.Mana >= skill.ManaCost;
                    <div class="skill-btn @(!canCast ? "skill-disabled" : "")"
                         id="skill-@skill.Key"
                         data-key="@skill.Key"
                         data-targets-task="@skill.TargetsTask.ToString().ToLower()"
                         data-mana="@skill.ManaCost"
                         data-name="@skill.Name"
                         onclick="activateSkill(this)"
                         title="@skill.Description&#10;Cost: @skill.ManaCost MP">
                        <img src="/images/habitica/skills/shop_@(skill.Key).png" width="40" height="40"
                             onerror="this.src='/images/habitica/skills/shop_special_fall2015Healer.png'"
                             alt="@skill.Name" />
                        <div class="skill-name">@skill.Name</div>
                        <div class="skill-cost">💧@skill.ManaCost</div>
                    </div>
                }
            </div>
            <div id="skillTargetHint" class="d-none mt-2 small">
                <span class="text-primary fw-semibold">🎯 Click any task to apply the spell</span>
                <button class="btn btn-sm btn-link p-0 ms-2 text-muted" style="font-size:.8rem;" onclick="deactivateSkill()">Cancel (ESC)</button>
            </div>
        </div>
    }

    <div class="task-board">

        <!-- HABITS -->
        <div class="board-col">
            <div class="col-header">
                <div class="col-title"><span class="col-icon">🔄</span> Habits <span class="col-count">@Model.Habits.Count</span></div>
                <a href="/Task/Create?type=habit" class="btn-add-task">+ Add</a>
            </div>
            @if (!Model.Habits.Any())
            {
                <div class="empty-state">No habits yet.<br /><small>Track recurring behaviors.</small></div>
            }
            @foreach (var task in Model.Habits)
            {
                <partial name="_TaskCard" model="task" />
            }
        </div>

        <!-- DAILIES -->
        <div class="board-col">
            <div class="col-header">
                <div class="col-title">
                    <span class="col-icon">☀️</span> Dailies
                    @if (Model.DueDailiesCount > 0)
                    {
                        <span class="col-count urgent">@Model.DueDailiesCount due</span>
                    }
                    else
                    {
                        <span class="col-count">@Model.Dailies.Count</span>
                    }
                </div>
                <a href="/Task/Create?type=daily" class="btn-add-task">+ Add</a>
            </div>
            @if (!Model.Dailies.Any())
            {
                <div class="empty-state">No dailies yet.<br /><small>Build daily routines.</small></div>
            }
            @foreach (var task in Model.Dailies)
            {
                <partial name="_TaskCard" model="task" />
            }
        </div>

        <!-- TO-DOS -->
        <div class="board-col">
            <div class="col-header">
                <div class="col-title"><span class="col-icon">✅</span> To-Dos <span class="col-count">@Model.PendingTodosCount</span></div>
                <a href="/Task/Create?type=todo" class="btn-add-task">+ Add</a>
            </div>
            @if (!Model.Todos.Any())
            {
                <div class="empty-state">No to-dos yet.<br /><small>One-time tasks.</small></div>
            }
            @foreach (var task in Model.Todos)
            {
                <partial name="_TaskCard" model="task" />
            }
            @if (Model.Todos.Any())
            {
                <a href="/Task/ClearCompleted" class="clear-todos-link">🗑 Clear completed</a>
            }
        </div>

        <!-- REWARDS -->
        <div class="board-col">
            <div class="col-header">
                <div class="col-title"><span class="col-icon">🎁</span> Rewards <span class="col-count">@Model.Rewards.Count</span></div>
                <a href="/Task/Create?type=reward" class="btn-add-task">+ Add</a>
            </div>
            @if (!Model.Rewards.Any())
            {
                <div class="empty-state">No rewards yet.<br /><small>Treat yourself!</small></div>
            }
            @foreach (var task in Model.Rewards)
            {
                <partial name="_TaskCard" model="task" />
            }
        </div>

    </div>

</div>

@section Scripts {
    <script>
            var token = $('input[name="__RequestVerificationToken"]').first().val();

            function handleEconomyToasts(r) {
                if (r.notEnoughGold) {
                    showToast('🚫', 'Not Enough Gold', 'Need more GP to claim this reward.', 'toast-hp', 3500);
                    return;
                }
                if (r.goldGained > 0)
                    showToast('🪙', 'Gold!', '+' + r.goldGained.toFixed(1) + ' GP', 'toast-gold', 2500);
                if (r.isCrit)
                    setTimeout(function(){ showToast('⚡', 'Critical Hit!', '1.5× bonus!', 'toast-crit', 3000); }, 300);
                if (r.droppedItemName)
                    setTimeout(function(){ showToast(r.droppedItemIcon || '📦', 'Item Drop!', r.droppedItemName, 'toast-drop', 5000); }, 700);
                if (r.died)
                    setTimeout(function(){
                        showToast('💀', 'You Died!', 'Visit Economy to revive.', 'toast-death', 8000);
                    }, 1000);
                if (typeof refreshHud === 'function') refreshHud();
            }

            function valueColor(v) {
                if (v > 5)   return 'val-blue';
                if (v > 0)   return 'val-green';
                if (v > -5)  return 'val-yellow';
                if (v > -15) return 'val-orange';
                return 'val-red';
            }

            function updateCardColor(taskId, newValue) {
                var $card = $('#task-' + taskId);
                $card.removeClass('val-blue val-green val-yellow val-orange val-red').addClass(valueColor(newValue));
            }

            // Habit +/- score
            $(document).on('click', '.btn-score', function (e) {
                e.preventDefault();
                var $btn      = $(this);
                var taskId    = $btn.data('id');
                var direction = $btn.data('direction');
                $btn.prop('disabled', true);

                $.ajax({
                    url:  '/Task/Score/' + taskId + '?direction=' + direction,
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function (r) {
                        if (!r.success && !r.notEnoughGold) return;
                        handleEconomyToasts(r);
                        if (!r.success) return;
                        updateCardColor(taskId, r.newValue);
                        var $card = $('#task-' + taskId);
                        $card.find('.counter-up').text(r.counterUp);
                        $card.find('.counter-down').text(r.counterDown);
                        if (r.isCompleted) {
                            $card.find('.daily-check-input').prop('checked', true).prop('disabled', true);
                            $card.find('.task-text').addClass('done');
                        }
                        if (r.xpGained > 0) showToast('⚡', 'XP Gained!', '+' + r.xpGained + ' XP', 'toast-xp', 3000);
                        if (r.leveledUp)    setTimeout(function(){ showToast('⬆️', 'Level Up!', 'Now Level ' + r.newLevel, 'toast-level', 5000); }, 400);
                        if (r.newBadges && r.newBadges.length) setTimeout(function(){ showToast('🏅', 'New Badge!', r.newBadges.join(', '), 'toast-badge', 5000); }, 900);
                        if (r.died) setTimeout(function(){ window.location.href = '/Economy'; }, 2500);
                    },
                    complete: function () { $btn.prop('disabled', false); }
                });
            });

            // Daily checkbox
            $(document).on('change', '.daily-check-input', function () {
                var $cb    = $(this);
                var taskId = $cb.data('id');
                if (!$cb.is(':checked')) return;
                $cb.prop('disabled', true);

                $.ajax({
                    url:  '/Task/Score/' + taskId + '?direction=up',
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function (r) {
                        if (r.success) {
                            updateCardColor(taskId, r.newValue);
                            var $card = $('#task-' + taskId);
                            $card.find('.task-text').addClass('done');
                            $card.find('.streak-badge').text('🔥 ' + r.newStreak);
                            if (r.xpGained > 0) showToast('⚡', 'Daily done!', '+' + r.xpGained + ' XP', 'toast-xp', 3000);
                            if (r.leveledUp)    setTimeout(function(){ showToast('⬆️', 'Level Up!', 'Now Level ' + r.newLevel, 'toast-level', 5000); }, 400);
                            handleEconomyToasts(r);
                            if (r.died) setTimeout(function(){ window.location.href = '/Economy'; }, 2500);
                        } else {
                            $cb.prop('checked', false).prop('disabled', false);
                        }
                    },
                    error: function () { $cb.prop('checked', false).prop('disabled', false); }
                });
            });

            // Todo checkbox
            $(document).on('change', '.todo-check-input', function () {
                var $cb    = $(this);
                var taskId = $cb.data('id');
                if (!$cb.is(':checked')) return;
                $cb.prop('disabled', true);

                $.ajax({
                    url:  '/Task/Score/' + taskId + '?direction=up',
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function (r) {
                        if (r.success) {
                            var $card = $('#task-' + taskId);
                            $card.find('.task-text').addClass('done');
                            if (r.xpGained > 0) showToast('⚡', 'To-Do done!', '+' + r.xpGained + ' XP', 'toast-xp', 3000);
                            handleEconomyToasts(r);
                            setTimeout(function() { $card.fadeOut(400, function(){ $(this).remove(); }); }, 1200);
                        } else {
                            $cb.prop('checked', false).prop('disabled', false);
                        }
                    },
                    error: function () { $cb.prop('checked', false).prop('disabled', false); }
                });
            });

            // Checklist toggle
            $(document).on('change', '.checklist-check', function () {
                var itemId = $(this).data('item-id');
                var $row   = $(this).closest('.checklist-item');
                $.ajax({
                    url:  '/Task/ChecklistToggle/' + itemId,
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function (r) {
                        if (r.isCompleted) $row.addClass('done');
                        else               $row.removeClass('done');
                    }
                });
            });

            // ── SKILLS ──────────────────────────────────────────────────────────────

            var activeSkill  = null;
        @if (Model.CanUseSkills && Model.Skills.Any())
        {
                    <text>
                    var currentMana  = @((int)(Model.User!.Mana));
                    var maxManaVal   = @(Model.EffectiveStats!.MaxMana);
                    </text>
        }
        else
        {
                    <text>
                    var currentMana  = 0;
                    var maxManaVal   = 30;
                    </text>
        }

            function activateSkill(el) {
                if (el.classList.contains('skill-disabled') || el.classList.contains('skill-casting')) return;
                var key = el.dataset.key;
                if (activeSkill === key) { deactivateSkill(); return; }

                document.querySelectorAll('.skill-btn').forEach(function(b) { b.classList.remove('skill-active'); });
                el.classList.add('skill-active');
                activeSkill = key;

                if (el.dataset.targetsTask !== 'true') {
                    castSkill(key, null);
                } else {
                    document.body.classList.add('skill-targeting');
                    var hint = document.getElementById('skillTargetHint');
                    if (hint) hint.classList.remove('d-none');
                }
            }

            function deactivateSkill() {
                activeSkill = null;
                document.querySelectorAll('.skill-btn').forEach(function(b) { b.classList.remove('skill-active'); });
                document.body.classList.remove('skill-targeting');
                var hint = document.getElementById('skillTargetHint');
                if (hint) hint.classList.add('d-none');
            }

            // Intercept task-card clicks during skill targeting
            $(document).on('click', '.task-card', function(e) {
                if (!activeSkill) return;
                var skillEl = document.getElementById('skill-' + activeSkill);
                if (!skillEl || skillEl.dataset.targetsTask !== 'true') return;
                e.stopImmediatePropagation();
                e.preventDefault();
                var taskId = this.id.replace('task-', '');
                castSkill(activeSkill, taskId);
            });

            async function castSkill(key, taskId) {
                var skillEl = document.getElementById('skill-' + key);
                if (skillEl) skillEl.classList.add('skill-casting');
                deactivateSkill();

                var fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('spellKey', key);
                if (taskId) fd.append('taskId', taskId);

                try {
                    var res  = await fetch('/Task/CastSpell', { method: 'POST', body: fd });
                    var d    = await res.json();
                    var name = skillEl ? skillEl.dataset.name : key;

                    if (d.success) {
                        currentMana = d.newMana;
                        maxManaVal  = d.maxMana;
                        updateSkillManaDisplay();
                        updateSkillDisabledStates();

                        var msg = (d.data && d.data.toastMessage) ? d.data.toastMessage : (name + ' cast!');
                        showToast('✨', name, msg, 'info', 4500);

                        if (d.data && d.data.xpGained > 0)
                            setTimeout(function(){ showToast('⚡', 'XP!', '+' + d.data.xpGained + ' XP', 'toast-xp', 3000); }, 600);

                        if (taskId && d.data && d.data.taskValueDelta !== undefined)
                            updateCardColor(taskId, parseFloat(d.data.taskValueDelta));

                        if (typeof refreshHud === 'function') refreshHud();
                    } else {
                        showToast('❌', 'Spell Failed', d.error || 'Not enough mana?', 'danger', 4000);
                    }
                } catch(err) {
                    showToast('❌', 'Spell Failed', 'Request error.', 'danger', 4000);
                }

                if (skillEl) skillEl.classList.remove('skill-casting');
            }

            function updateSkillManaDisplay() {
                var pct = maxManaVal > 0 ? Math.min(100, currentMana * 100 / maxManaVal) : 0;
                var bar = document.getElementById('skillManaBar');
                if (bar) bar.style.width = pct + '%';
                var txt = document.querySelector('#skillsBar .mana-text');
                if (txt) txt.textContent = '💧 ' + currentMana + ' / ' + maxManaVal + ' MP';
            }

            function updateSkillDisabledStates() {
                document.querySelectorAll('.skill-btn').forEach(function(btn) {
                    var cost = parseInt(btn.dataset.mana) || 0;
                    if (currentMana < cost) btn.classList.add('skill-disabled');
                    else btn.classList.remove('skill-disabled');
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && activeSkill) deactivateSkill();
            });
    </script>
}
