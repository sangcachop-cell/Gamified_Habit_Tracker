@model HabitTracker.Models.ViewModels.TaskBoardViewModel
@using HabitTracker.Constants

@{
    ViewData["Title"] = "My Tasks";
}

<style>
    body {
        background: #f8fafc !important;
    }

    .board-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

        .board-header h1 {
            font-size: 2rem;
            font-weight: 900;
            color: #0f172a;
            margin: 0;
        }

    .task-board {
        display: grid;
        grid-template-columns: repeat(4, minmax(260px, 1fr));
        gap: 18px;
        align-items: start;
    }

    .board-col {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 18px;
        min-height: 360px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .col-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-bottom: 14px;
        margin-bottom: 16px;
        border-bottom: 1px solid #e5e7eb;
    }

    .col-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.05rem;
        font-weight: 900;
        color: #0f172a;
    }

    .col-icon {
        width: 26px;
        height: 26px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .95rem;
        background: #f3f4f6;
    }

    .col-count {
        background: #f3e8ff;
        color: #6d28d9;
        font-size: .78rem;
        font-weight: 900;
        padding: 3px 9px;
        border-radius: 999px;
    }

        .col-count.urgent {
            background: #fee2e2;
            color: #ef4444;
        }

    .btn-add-task {
        background: #6d28d9;
        color: #ffffff !important;
        border-radius: 12px;
        padding: 8px 14px;
        font-size: .85rem;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
    }

        .btn-add-task:hover {
            background: #5b21b6;
        }

    .empty-state {
        min-height: 210px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #9ca3af;
        font-weight: 700;
        line-height: 1.6;
    }

        .empty-state small {
            font-weight: 600;
            color: #9ca3af;
        }

    .task-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-left: 5px solid #10b981;
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 14px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .04);
        transition: .18s ease;
    }

        .task-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(15, 23, 42, .08);
        }

    .val-blue {
        border-left-color: #3b82f6;
    }

    .val-green {
        border-left-color: #10b981;
    }

    .val-yellow {
        border-left-color: #f59e0b;
    }

    .val-orange {
        border-left-color: #f97316;
    }

    .val-red {
        border-left-color: #ef4444;
    }

    .task-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .task-text {
        font-size: 1rem;
        font-weight: 900;
        color: #111827;
        line-height: 1.4;
        flex: 1;
    }

        .task-text.done {
            text-decoration: line-through;
            color: #9ca3af;
        }

    .task-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .btn-task-icon {
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 9px;
        background: #f3f4f6;
        color: #6b7280;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        text-decoration: none;
        cursor: pointer;
    }

        .btn-task-icon:hover {
            background: #ede9fe;
            color: #6d28d9;
        }

    .priority-badge {
        font-size: .72rem;
        font-weight: 900;
        padding: 4px 9px;
        border-radius: 999px;
        text-transform: uppercase;
    }

    .priority-trivial {
        background: #f3f4f6;
        color: #6b7280;
    }

    .priority-easy {
        background: #dcfce7;
        color: #16a34a;
    }

    .priority-medium {
        background: #fef3c7;
        color: #d97706;
    }

    .priority-hard {
        background: #fee2e2;
        color: #dc2626;
    }

    .habit-controls,
    .daily-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
    }

    .btn-score {
        min-width: 42px;
        height: 42px;
        border: none;
        border-radius: 12px;
        font-size: 1.2rem;
        font-weight: 900;
        cursor: pointer;
        transition: .15s ease;
    }

        .btn-score:hover {
            transform: translateY(-1px);
        }

        .btn-score:active {
            transform: scale(.96);
        }

    .btn-score-up {
        background: #10b981;
        color: #ffffff;
    }

    .btn-score-down {
        background: #ef4444;
        color: #ffffff;
    }

    .btn-claim {
        background: #f59e0b;
        color: #ffffff;
        font-size: .9rem;
        padding: 0 16px;
    }

    .habit-counter {
        flex: 1;
        text-align: center;
        font-size: .9rem;
        font-weight: 800;
        color: #6b7280;
    }

    .daily-check-label {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        cursor: pointer;
        color: #4b5563;
        font-weight: 700;
    }

        .daily-check-label input[type=checkbox] {
            width: 18px;
            height: 18px;
            accent-color: #6d28d9;
            cursor: pointer;
        }

        .daily-check-label input:disabled {
            cursor: default;
            opacity: .5;
        }

    .streak-badge {
        font-size: .85rem;
        font-weight: 900;
        color: #f97316;
        white-space: nowrap;
    }

    .due-badge {
        font-size: .78rem;
        font-weight: 800;
        padding: 4px 9px;
        border-radius: 999px;
        background: #dbeafe;
        color: #2563eb;
        white-space: nowrap;
    }

        .due-badge.overdue {
            background: #fee2e2;
            color: #dc2626;
        }

    .checklist-section {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e5e7eb;
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .88rem;
        color: #4b5563;
        padding: 5px 0;
    }

        .checklist-item input[type=checkbox] {
            accent-color: #6d28d9;
            cursor: pointer;
        }

        .checklist-item.done span {
            text-decoration: line-through;
            color: #9ca3af;
        }

    .gold-cost {
        font-size: .9rem;
        font-weight: 900;
        color: #d97706;
    }

    .clear-todos-link {
        display: block;
        margin-top: 14px;
        text-align: center;
        font-size: .85rem;
        font-weight: 800;
        color: #9ca3af;
        text-decoration: none;
    }

        .clear-todos-link:hover {
            color: #ef4444;
        }

    .task-note {
        font-size: .85rem;
        color: #6b7280;
        margin-bottom: 8px;
        line-height: 1.4;
    }

    @@media (max-width: 1300px) {
        .task-board {
            grid-template-columns: repeat(2, minmax(260px, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .task-board {
            grid-template-columns: 1fr;
        }

        .board-header h1 {
            font-size: 1.65rem;
        }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form id="csrf-form" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="task-board">

    <div class="board-col">
        <div class="col-header">
            <div class="col-title">
                <span class="col-icon">↻</span>
                Habits
                <span class="col-count">@Model.Habits.Count</span>
            </div>
            <a href="/Task/Create?type=habit" class="btn-add-task">+ Add</a>
        </div>

        @if (!Model.Habits.Any())
        {
            <div class="empty-state">
                No habits yet.
                <small>Track recurring behaviors.</small>
            </div>
        }

        @foreach (var task in Model.Habits)
        {
            <partial name="_TaskCard" model="task" />
        }
    </div>

    <div class="board-col">
        <div class="col-header">
            <div class="col-title">
                <span class="col-icon">●</span>
                Dailies
                @if (Model.DueDailiesCount > 0)
                {
                    <span class="col-count urgent">@Model.DueDailiesCount due</span>
                }
                else
                {
                    <span class="col-count">@Model.Dailies.Count</span>
                }
            </div>
            <a href="/Task/Create?type=daily" class="btn-add-task">+ Add</a>
        </div>

        @if (!Model.Dailies.Any())
        {
            <div class="empty-state">
                No dailies yet.
                <small>Build daily routines.</small>
            </div>
        }

        @foreach (var task in Model.Dailies)
        {
            <partial name="_TaskCard" model="task" />
        }
    </div>

    <div class="board-col">
        <div class="col-header">
            <div class="col-title">
                <span class="col-icon">✓</span>
                To-Dos
                <span class="col-count">@Model.PendingTodosCount</span>
            </div>
            <a href="/Task/Create?type=todo" class="btn-add-task">+ Add</a>
        </div>

        @if (!Model.Todos.Any())
        {
            <div class="empty-state">
                No to-dos yet.
                <small>One-time tasks.</small>
            </div>
        }

        @foreach (var task in Model.Todos)
        {
            <partial name="_TaskCard" model="task" />
        }

        @if (Model.Todos.Any())
        {
            <a href="/Task/ClearCompleted" class="clear-todos-link">Clear completed</a>
        }
    </div>

    <div class="board-col">
        <div class="col-header">
            <div class="col-title">
                <span class="col-icon">★</span>
                Rewards
                <span class="col-count">@Model.Rewards.Count</span>
            </div>
            <a href="/Task/Create?type=reward" class="btn-add-task">+ Add</a>
        </div>

        @if (!Model.Rewards.Any())
        {
            <div class="empty-state">
                No rewards yet.
                <small>Treat yourself!</small>
            </div>
        }

        @foreach (var task in Model.Rewards)
        {
            <partial name="_TaskCard" model="task" />
        }
    </div>

</div>

@section Scripts {
    <script>
        var token = $('input[name="__RequestVerificationToken"]').first().val();

        function handleEconomyToasts(r) {
            if (r.notEnoughGold) {
                showToast('🚫', 'Not Enough Gold', 'Need more GP to claim this reward.', 'toast-hp', 3500);
                return;
            }

            if (r.goldGained > 0) {
                showToast('🪙', 'Gold!', '+' + r.goldGained.toFixed(1) + ' GP', 'toast-gold', 2500);
            }

            if (r.isCrit) {
                setTimeout(function () {
                    showToast('⚡', 'Critical Hit!', '1.5× bonus!', 'toast-crit', 3000);
                }, 300);
            }

            if (r.droppedItemName) {
                setTimeout(function () {
                    showToast(r.droppedItemIcon || '📦', 'Item Drop!', r.droppedItemName, 'toast-drop', 5000);
                }, 700);
            }

            if (r.died) {
                setTimeout(function () {
                    showToast('💀', 'You Died!', 'Visit Economy to revive.', 'toast-death', 8000);
                }, 1000);
            }

            if (typeof refreshHud === 'function') refreshHud();
        }

        function valueColor(v) {
            if (v > 5) return 'val-blue';
            if (v > 0) return 'val-green';
            if (v > -5) return 'val-yellow';
            if (v > -15) return 'val-orange';
            return 'val-red';
        }

        function updateCardColor(taskId, newValue) {
            var $card = $('#task-' + taskId);
            $card.removeClass('val-blue val-green val-yellow val-orange val-red').addClass(valueColor(newValue));
        }

        $(document).on('click', '.btn-score', function (e) {
            e.preventDefault();

            var $btn = $(this);
            var taskId = $btn.data('id');
            var direction = $btn.data('direction');

            $btn.prop('disabled', true);

            $.ajax({
                url: '/Task/Score/' + taskId + '?direction=' + direction,
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function (r) {
                    if (!r.success && !r.notEnoughGold) return;

                    handleEconomyToasts(r);

                    if (!r.success) return;

                    updateCardColor(taskId, r.newValue);

                    var $card = $('#task-' + taskId);

                    $card.find('.counter-up').text(r.counterUp);
                    $card.find('.counter-down').text(r.counterDown);

                    if (r.isCompleted) {
                        $card.find('.daily-check-input').prop('checked', true).prop('disabled', true);
                        $card.find('.task-text').addClass('done');
                    }

                    if (r.xpGained > 0) {
                        showToast('⚡', 'XP Gained!', '+' + r.xpGained + ' XP', 'toast-xp', 3000);
                    }

                    if (r.leveledUp) {
                        setTimeout(function () {
                            showToast('⬆️', 'Level Up!', 'Now Level ' + r.newLevel, 'toast-level', 5000);
                        }, 400);
                    }

                    if (r.newBadges && r.newBadges.length) {
                        setTimeout(function () {
                            showToast('🏅', 'New Badge!', r.newBadges.join(', '), 'toast-badge', 5000);
                        }, 900);
                    }

                    if (r.died) {
                        setTimeout(function () {
                            window.location.href = '/Economy';
                        }, 2500);
                    }
                },
                complete: function () {
                    $btn.prop('disabled', false);
                }
            });
        });

        $(document).on('change', '.daily-check-input', function () {
            var $cb = $(this);
            var taskId = $cb.data('id');

            if (!$cb.is(':checked')) return;

            $cb.prop('disabled', true);

            $.ajax({
                url: '/Task/Score/' + taskId + '?direction=up',
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function (r) {
                    if (r.success) {
                        updateCardColor(taskId, r.newValue);

                        var $card = $('#task-' + taskId);

                        $card.find('.task-text').addClass('done');
                        $card.find('.streak-badge').text('🔥 ' + r.newStreak);

                        if (r.xpGained > 0) {
                            showToast('⚡', 'Daily done!', '+' + r.xpGained + ' XP', 'toast-xp', 3000);
                        }

                        if (r.leveledUp) {
                            setTimeout(function () {
                                showToast('⬆️', 'Level Up!', 'Now Level ' + r.newLevel, 'toast-level', 5000);
                            }, 400);
                        }

                        handleEconomyToasts(r);

                        if (r.died) {
                            setTimeout(function () {
                                window.location.href = '/Economy';
                            }, 2500);
                        }
                    } else {
                        $cb.prop('checked', false).prop('disabled', false);
                    }
                },
                error: function () {
                    $cb.prop('checked', false).prop('disabled', false);
                }
            });
        });

        $(document).on('change', '.todo-check-input', function () {
            var $cb = $(this);
            var taskId = $cb.data('id');

            if (!$cb.is(':checked')) return;

            $cb.prop('disabled', true);

            $.ajax({
                url: '/Task/Score/' + taskId + '?direction=up',
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function (r) {
                    if (r.success) {
                        var $card = $('#task-' + taskId);

                        $card.find('.task-text').addClass('done');

                        if (r.xpGained > 0) {
                            showToast('⚡', 'To-Do done!', '+' + r.xpGained + ' XP', 'toast-xp', 3000);
                        }

                        handleEconomyToasts(r);

                        setTimeout(function () {
                            $card.fadeOut(400, function () {
                                $(this).remove();
                            });
                        }, 1200);
                    } else {
                        $cb.prop('checked', false).prop('disabled', false);
                    }
                },
                error: function () {
                    $cb.prop('checked', false).prop('disabled', false);
                }
            });
        });

        $(document).on('change', '.checklist-check', function () {
            var itemId = $(this).data('item-id');
            var $row = $(this).closest('.checklist-item');

            $.ajax({
                url: '/Task/ChecklistToggle/' + itemId,
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function (r) {
                    if (r.isCompleted) {
                        $row.addClass('done');
                    } else {
                        $row.removeClass('done');
                    }
                }
            });
        });
    </script>
}