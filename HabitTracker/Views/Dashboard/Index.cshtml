@model HabitTracker.Models.User
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    int xpInLevel = Model.XP % 100;
    var best = Model.UserQuests?.OrderByDescending(uq => uq.Quest?.XPReward).FirstOrDefault();
    var recentBadges = Model.UserBadges?.OrderByDescending(b => b.EarnedDate).Take(3).ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard — HabitTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Cinzel:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #070711;
            --panel: #121020;
            --panel2: #19142d;
            --violet: #7c4dff;
            --violet2: #9b7cff;
            --gold: #ffd166;
            --rose: #ff4f8b;
            --green: #48d597;
            --text: #ffffff;
            --muted: rgba(255,255,255,.58);
            --border: rgba(255,255,255,.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            font-family: "Be Vietnam Pro", sans-serif;
            overflow-x: hidden;
        }

        .topbar {
            height: 78px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 0 28px;
            background: rgba(8,8,18,.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
        }

        /* LOGO GIỐNG TRANG BADGES */
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 220px;
            height: 64px;
            padding: 8px 16px;
            border-radius: 18px;
            color: white;
            text-decoration: none;
            background: linear-gradient(135deg, rgba(124,77,255,.22), rgba(8,8,18,.78));
            border: 1px solid rgba(168,85,247,.45);
            box-shadow: 0 0 22px rgba(124,77,255,.28), inset 0 0 18px rgba(255,255,255,.04);
            transition: .25s;
            flex-shrink: 0;
        }

            .brand:hover {
                transform: translateY(-2px);
                border-color: rgba(168,85,247,.75);
                box-shadow: 0 0 30px rgba(124,77,255,.38), inset 0 0 20px rgba(255,255,255,.05);
                color: white;
            }

        .brand-logo {
            width: 58px;
            height: 58px;
            object-fit: contain;
            flex-shrink: 0;
            filter: drop-shadow(0 0 8px rgba(168,85,247,.7)) drop-shadow(0 0 22px rgba(124,77,255,.45));
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

            .brand-text span {
                font-family: "Cinzel", serif;
                font-size: 1rem;
                font-weight: 700;
                color: #f8fafc;
                letter-spacing: .6px;
            }

            .brand-text strong {
                margin-top: 2px;
                font-family: "Cinzel", serif;
                font-size: 1.65rem;
                font-weight: 800;
                color: #facc15;
                letter-spacing: .8px;
                text-shadow: 0 0 10px rgba(250,204,21,.5), 0 0 24px rgba(168,85,247,.35);
            }

        .top-nav {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            overflow-x: auto;
        }

            .top-nav a {
                color: rgba(255,255,255,.66);
                text-decoration: none;
                padding: 10px 13px;
                border-radius: 14px;
                font-size: .84rem;
                font-weight: 700;
                white-space: nowrap;
                transition: .2s;
            }

                .top-nav a:hover,
                .top-nav a.active {
                    color: white;
                    background: rgba(124,77,255,.18);
                }

        .top-user {
            display: flex;
            align-items: center;
            gap: 12px;
            white-space: nowrap;
        }

        .level-chip {
            color: var(--gold);
            font-size: .84rem;
            font-weight: 800;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            background: white;
            border: 2px solid rgba(255,255,255,.32);
        }

        .username {
            color: rgba(255,255,255,.75);
            font-size: .86rem;
            font-weight: 700;
        }

        .layout {
            display: grid;
            grid-template-columns: 260px 1fr;
            padding-top: 78px;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 78px;
            bottom: 0;
            width: 260px;
            padding: 22px 16px;
            background: radial-gradient(circle at 20% 0%, rgba(124,77,255,.2), transparent 34%), #080814;
            border-right: 1px solid var(--border);
            overflow-y: auto;
        }

        .side-title {
            font-size: .72rem;
            color: rgba(255,255,255,.36);
            text-transform: uppercase;
            letter-spacing: 1.8px;
            margin: 18px 12px 8px;
            font-weight: 800;
        }

        .side-menu {
            display: grid;
            gap: 8px;
        }

            .side-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border-radius: 15px;
                color: rgba(255,255,255,.68);
                text-decoration: none;
                font-size: .9rem;
                font-weight: 700;
                transition: .2s;
            }

                .side-menu a:hover,
                .side-menu a.active {
                    color: white;
                    background: rgba(124,77,255,.18);
                    box-shadow: inset 0 0 0 1px rgba(124,77,255,.28);
                }

        .side-card {
            margin-top: 24px;
            padding: 18px;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(124,77,255,.2), rgba(255,209,102,.08));
            border: 1px solid rgba(255,255,255,.1);
        }

            .side-card h4 {
                font-size: .9rem;
                font-weight: 800;
                color: var(--gold);
                margin-bottom: 8px;
            }

            .side-card p {
                color: var(--muted);
                font-size: .78rem;
                line-height: 1.6;
                margin-bottom: 14px;
            }

            .side-card a {
                display: block;
                text-align: center;
                padding: 10px 14px;
                border-radius: 14px;
                background: linear-gradient(135deg, var(--violet), #6d28d9);
                color: white;
                text-decoration: none;
                font-size: .82rem;
                font-weight: 800;
            }

        .main {
            grid-column: 2;
            padding: 28px;
            background: radial-gradient(circle at 90% 0%, rgba(124,77,255,.15), transparent 34%), radial-gradient(circle at 20% 100%, rgba(45,226,197,.07), transparent 30%), var(--bg);
        }

        .dash-hero {
            min-height: 260px;
            border-radius: 28px;
            padding: 36px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);
            background: linear-gradient(90deg, rgba(8,8,20,.92), rgba(8,8,20,.48), rgba(8,8,20,.82)), url('/fe/dashboard/dashboard-banner.png');
            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
        }

        .hero-greeting {
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: rgba(255,255,255,.55);
            margin-bottom: 12px;
        }

        .dash-hero h1 {
            font-size: clamp(2.1rem, 4vw, 3.2rem);
            font-weight: 800;
            letter-spacing: -1.4px;
            margin-bottom: 16px;
        }

        .level-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 999px;
            padding: 9px 18px;
            margin-bottom: 22px;
            font-weight: 800;
        }

            .level-badge small {
                color: rgba(255,255,255,.48);
                font-weight: 600;
            }

        .xp-bar-wrap {
            width: min(380px, 80vw);
        }

        .xp-bar-label {
            display: flex;
            justify-content: space-between;
            color: rgba(255,255,255,.68);
            font-size: .8rem;
            margin-bottom: 8px;
        }

        .xp-bar {
            height: 9px;
            background: rgba(255,255,255,.13);
            border-radius: 999px;
            overflow: hidden;
        }

        .xp-fill {
            height: 100%;
            width: @xpInLevel %;
            background: linear-gradient(90deg, var(--gold), var(--rose), var(--violet));
            border-radius: 999px;
        }

        .hero-stats {
            display: flex;
            gap: 22px;
            align-items: center;
            flex-wrap: wrap;
        }

        .hstat {
            text-align: center;
            min-width: 95px;
            padding: 14px 16px;
            border-radius: 18px;
            background: rgba(8,8,18,.45);
            border: 1px solid rgba(255,255,255,.1);
        }

            .hstat .num {
                font-size: 1.8rem;
                font-weight: 800;
                color: var(--gold);
            }

            .hstat .lbl {
                color: var(--muted);
                font-size: .76rem;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 24px;
        }

        .card-box {
            background: linear-gradient(135deg, rgba(255,255,255,.055), rgba(124,77,255,.08));
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 24px;
            padding: 26px;
            color: white;
            box-shadow: 0 16px 40px rgba(0,0,0,.16);
        }

        .card-icon {
            width: 52px;
            height: 52px;
            border-radius: 17px;
            display: grid;
            place-items: center;
            font-size: 1.45rem;
            margin-bottom: 18px;
            background: rgba(124,77,255,.22);
        }

        .card-label {
            font-size: .74rem;
            color: rgba(255,255,255,.55);
            text-transform: uppercase;
            letter-spacing: 1.8px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .card-value {
            font-size: 2.45rem;
            line-height: 1;
            font-weight: 800;
            color: var(--gold);
        }

        .card-sub {
            color: var(--muted);
            font-size: .86rem;
            margin-top: 10px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 18px;
            margin-bottom: 24px;
        }

        .section-title {
            font-size: .95rem;
            font-weight: 800;
            color: var(--gold);
            letter-spacing: .8px;
            margin-bottom: 18px;
        }

        .chart-card,
        .best-card {
            min-height: 310px;
        }

        .empty-text {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.7;
        }

        .btn-soft {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 18px;
            padding: 11px 18px;
            border-radius: 999px;
            background: rgba(124,77,255,.15);
            color: white;
            text-decoration: none;
            font-size: .84rem;
            font-weight: 800;
            border: 1px solid rgba(124,77,255,.35);
        }

            .btn-soft:hover {
                color: white;
                background: rgba(124,77,255,.25);
            }

        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .badge-mini {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

            .badge-mini:last-child {
                border-bottom: none;
            }

        .b-icon {
            width: 50px;
            height: 50px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(255,209,102,.12);
            border: 1px solid rgba(255,209,102,.25);
            font-size: 1.6rem;
        }

        .b-name {
            font-weight: 800;
            font-size: .92rem;
        }

        .b-date {
            font-size: .78rem;
            color: var(--muted);
            margin-top: 4px;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

            .quick-grid a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 15px 16px;
                border-radius: 16px;
                background: rgba(124,77,255,.11);
                color: rgba(255,255,255,.78);
                text-decoration: none;
                font-size: .88rem;
                font-weight: 700;
                transition: .2s;
            }

                .quick-grid a:hover {
                    background: rgba(124,77,255,.2);
                    color: white;
                }

        footer {
            margin-top: 28px;
            padding: 22px;
            text-align: center;
            color: rgba(255,255,255,.36);
            border-top: 1px solid rgba(255,255,255,.08);
            font-size: .82rem;
        }

        @@media (max-width: 1180px) {
            .layout {
                grid-template-columns: 1fr;
                padding-top: 118px;
            }

            .sidebar {
                display: none;
            }

            .main {
                grid-column: 1;
            }

            .stats-grid,
            .content-grid,
            .bottom-grid {
                grid-template-columns: 1fr;
            }

            .dash-hero {
                flex-direction: column;
                align-items: flex-start;
            }

            .topbar {
                height: auto;
                min-height: 78px;
                flex-wrap: wrap;
                padding: 14px 18px;
            }

            .brand {
                min-width: 220px;
            }

            .top-nav {
                order: 3;
                width: 100%;
            }
        }

        @@media (max-width: 600px) {
            .main {
                padding: 18px;
            }

            .dash-hero {
                padding: 24px;
                border-radius: 22px;
            }

            .hero-stats {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
            }

            .quick-grid {
                grid-template-columns: 1fr;
            }

            .username {
                display: none;
            }

            .brand {
                min-width: 190px;
                height: 58px;
                padding: 7px 12px;
            }

            .brand-logo {
                width: 50px;
                height: 50px;
            }

            .brand-text span {
                font-size: .85rem;
            }

            .brand-text strong {
                font-size: 1.35rem;
            }
        }
    </style>
</head>

<body>
    <header class="topbar">
        <a href="/Dashboard" class="brand">
            <img src="/fe/logo/logo.png" class="brand-logo" alt="Logo" />

            <div class="brand-text">
                <span>Vương</span>
                <strong>Quốc</strong>
            </div>
        </a>

        <nav class="top-nav">
            <a href="/Dashboard" class="active">📊 Trang chủ</a>
            <a href="/Task">📋 Nhiệm vụ</a>
            <a href="/Account/Leaderboard">🏆 Bảng xếp hạng</a>
            <a href="/Friend">👥 Bạn bè</a>
            <a href="/Dashboard/Badges">🏅 Thành tựu</a>
            <a href="/Inventory">🎒 Kho đồ</a>
            <a href="/Hideout/Index">🏰 Căn cứ</a>
            <a href="/Task/search">🔍 Tìm nhiệm vụ</a>
        </nav>

        <div class="top-user">
            <span class="level-chip">LV @Model.Level</span>
            <img src="@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default.png" : Model.Avatar)" class="avatar" alt="@Model.Username" />
            <span class="username">@Model.Username</span>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <div class="side-title">Chính</div>
            <nav class="side-menu">
                <a href="/Dashboard" class="active">🏠 Dashboard</a>
                <a href="/Task">📋 Danh sách Quest</a>
                <a href="/Task/search">🔍 Tìm kiếm Quest</a>
                <a href="/Dashboard/Statistics">📊 Thống kê</a>
                <a href="/Forest/Index">🌲 Rừng Sâu</a>
            </nav>

            <div class="side-title">Cộng đồng</div>
            <nav class="side-menu">
                <a href="/Account/Leaderboard">🏆 Bảng xếp hạng</a>
                <a href="/Friend">👥 Bạn bè</a>
                <a href="/Dashboard/Badges">🏅 Thành tựu</a>
            </nav>

            <div class="side-title">Tài khoản</div>
            <nav class="side-menu">
                <a href="/Account/Profile">🧙 Hồ sơ cá nhân</a>
                <a href="/Dashboard/Character">🧝 Nhân vật</a>
                <a href="/Inventory">🎒 Kho đồ</a>
                <a href="/Hideout/Index">🏰 Căn cứ</a>
                <a href="/Account/Logout">🚪 Đăng xuất</a>
            </nav>

            <div class="side-card">
                <h4>Nhiệm vụ hôm nay</h4>
                <p>Hoàn thành quest để nhận XP, giữ streak và mở khóa huy hiệu.</p>
                <a href="/Task/search">Tìm quest mới</a>
            </div>
        </aside>

        <main class="main">
            <section class="dash-hero">
                <div>
                    <div class="hero-greeting">Chào mừng trở lại</div>
                    <h1>@Model.Username 👋</h1>

                    <div class="level-badge">
                        ⚡ Cấp @Model.Level
                        <small>· @Model.XP.ToString("N0") XP tổng cộng</small>
                    </div>

                    <div class="xp-bar-wrap">
                        <div class="xp-bar-label">
                            <span>@xpInLevel / 100 XP</span>
                            <span>→ Level @(Model.Level + 1)</span>
                        </div>
                        <div class="xp-bar">
                            <div class="xp-fill"></div>
                        </div>
                    </div>
                </div>

                <div class="hero-stats">
                    <div class="hstat">
                        <div class="num">@Model.CurrentStreak 🔥</div>
                        <div class="lbl">Streak hiện tại</div>
                    </div>

                    <div class="hstat">
                        <div class="num">@(Model.UserQuests?.Count ?? 0)</div>
                        <div class="lbl">Quests đã làm</div>
                    </div>

                    <div class="hstat">
                        <div class="num">@(Model.UserBadges?.Count ?? 0)</div>
                        <div class="lbl">Badges</div>
                    </div>
                </div>
            </section>

            <section class="stats-grid">
                <div class="card-box">
                    <div class="card-icon">⚡</div>
                    <div class="card-label">Tổng XP</div>
                    <div class="card-value">@Model.XP.ToString("N0")</div>
                    <div class="card-sub">@Model.TotalXPEarned.ToString("N0") XP lifetime</div>
                </div>

                <div class="card-box">
                    <div class="card-icon" style="background:rgba(255,79,139,.16);">🔥</div>
                    <div class="card-label">Streak dài nhất</div>
                    <div class="card-value">@Model.LongestStreak</div>
                    <div class="card-sub">Hiện tại: @Model.CurrentStreak ngày</div>
                </div>

                <div class="card-box">
                    <div class="card-icon" style="background:rgba(72,213,151,.16);">✅</div>
                    <div class="card-label">Hoàn thành</div>
                    <div class="card-value">@Model.TotalQuestsCompleted</div>
                    <div class="card-sub">Tổng số quest</div>
                </div>
            </section>

            <section class="content-grid">
                <div class="card-box chart-card">
                    <h3 class="section-title">📈 Quests hoàn thành — 7 ngày qua</h3>
                    <canvas id="habitChart" height="120"></canvas>
                </div>

                <div class="card-box best-card">
                    <h3 class="section-title">🏆 Quest tốt nhất</h3>

                    @if (best?.Quest != null)
                    {
                        <div style="font-size:2.4rem;margin-bottom:10px">@best.Quest.Icon</div>
                        <div style="font-weight:800;font-size:1.05rem;margin-bottom:12px">@best.Quest.Name</div>

                        <span style="display:inline-flex;background:rgba(124,77,255,.18);color:#c4b5fd;padding:6px 12px;border-radius:999px;font-size:.8rem;font-weight:800">
                            +@best.Quest.XPReward XP
                        </span>

                        <span style="display:inline-flex;background:rgba(255,255,255,.08);color:rgba(255,255,255,.7);padding:6px 12px;border-radius:999px;font-size:.8rem;margin-left:6px">
                            @best.Quest.Category
                        </span>
                    }
                    else
                    {
                        <p class="empty-text">Chưa hoàn thành quest nào. Bắt đầu ngay để nhận XP và mở khóa badge đầu tiên.</p>
                    }

                    <a href="/Task" class="btn-soft">📋 Làm quest ngay</a>
                </div>
            </section>

            <section class="bottom-grid">
                <div class="card-box">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
                        <h3 class="section-title" style="margin:0;">🏅 Badges gần đây</h3>
                        <a href="/Dashboard/Badges" style="color:#9b7cff;text-decoration:none;font-size:.84rem;font-weight:800;">Xem tất cả →</a>
                    </div>

                    @if (recentBadges != null && recentBadges.Count > 0)
                    {
                        foreach (var ub in recentBadges)
                        {
                            <div class="badge-mini">
                                <div class="b-icon">@(ub.Badge?.Icon ?? "🏅")</div>
                                <div>
                                    <div class="b-name">@(ub.Badge?.Name ?? "Badge")</div>
                                    <div class="b-date">@ub.EarnedDate.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-text">Chưa có badge nào. Hoàn thành quest để nhận badge!</p>
                    }
                </div>

                <div class="card-box">
                    <h3 class="section-title">⚡ Hành động nhanh</h3>

                    <div class="quick-grid">
                        <a href="/Task">📋 Danh sách Quest</a>
                        <a href="/Task/search">🔍 Tìm kiếm Quest</a>
                        <a href="/Dashboard/Statistics">📊 Thống kê chi tiết</a>
                        <a href="/Account/Leaderboard">🏆 Bảng xếp hạng</a>
                        <a href="/Account/Profile">👤 Hồ sơ cá nhân</a>
                        <a href="/Dashboard/Badges">🏅 Thành tựu</a>
                    </div>
                </div>
            </section>

            <footer>
                © 2026 HabitTracker · Gamify Your Life
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        new Chart(document.getElementById('habitChart'), {
            type: 'line',
            data: {
                labels: [@Html.Raw(ViewBag.ChartLabels)],
                datasets: [{
                    label: 'Quests hoàn thành',
                    data: [@Html.Raw(ViewBag.ChartData)],
                    borderColor: '#7c4dff',
                    backgroundColor: 'rgba(124,77,255,.12)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#9b7cff',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1,
                            color: 'rgba(255,255,255,.55)'
                        },
                        grid: {
                            color: 'rgba(255,255,255,.08)'
                        }
                    },
                    x: {
                        ticks: {
                            color: 'rgba(255,255,255,.55)'
                        },
                        grid: {
                            color: 'rgba(255,255,255,.05)'
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>