@model HabitTracker.Models.User

@{
    ViewData["Title"] = "Dashboard";

    int currentXp = Model.XP;
    int xpInLevel = Model.XP % 100;

    var hpValue = Model.HP;
    var manaValue = Model.Mana;
    var maxMana = (int)(ViewBag.MaxMana ?? 30);

    var hpPercent = Math.Max(0, Math.Min(100, (double)Model.HP * 100 / 50));
    var manaPercent = Math.Max(0, Math.Min(100, maxMana > 0 ? (double)Model.Mana * 100 / maxMana : 0));

    var recentBadges = Model.UserBadges?
        .OrderByDescending(b => b.EarnedDate)
        .Take(3)
        .ToList();
}

<style>
    .dashboard-page {
        font-family: "Nunito", "Inter", "Segoe UI", sans-serif;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .top-grid {
        display: grid;
        grid-template-columns: 1.8fr repeat(4, 1fr);
        gap: 22px;
    }

    .welcome-card,
    .resource-card,
    .panel-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
    }

    .welcome-card {
        padding: 28px;
        display: flex;
        align-items: center;
        gap: 26px;
    }

    .avatar-placeholder {
        font-size: 4rem;
    }

    .welcome-content h1 {
        font-size: 1.7rem;
        font-weight: 900;
        color: #111827;
        margin-bottom: 8px;
        letter-spacing: -.02em;
    }

    .welcome-content p {
        color: #6b7280;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .xp-row {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .level-pill {
        background: #111827;
        color: #fff;
        padding: 7px 18px;
        border-radius: 999px;
        font-weight: 900;
    }

    .xp-text {
        color: #111827;
        font-weight: 800;
    }

    .xp-bar-main {
        width: 230px;
        height: 10px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

        .xp-bar-main span {
            display: block;
            height: 100%;
            background: #111827;
            border-radius: 999px;
        }

    .resource-card {
        padding: 26px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 170px;
    }

    .resource-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 12px;
    }

    .resource-icon {
        font-size: 1.8rem;
        line-height: 1;
        width: 2rem;
        text-align: center;
    }

    .resource-label {
        color: #1f2937;
        font-weight: 900;
        letter-spacing: -.01em;
    }

    .resource-value {
        font-size: 1.55rem;
        font-weight: 900;
        color: #020617;
        margin-left: 54px;
        line-height: 1.35;
        letter-spacing: -.02em;
        white-space: nowrap;
    }

    .resource-bar {
        height: 7px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 16px;
    }

        .resource-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
        }

    .bar-red {
        background: #f43f5e;
    }

    .bar-blue {
        background: #2563eb;
    }

    .main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .panel-card {
        padding: 28px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 26px;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.25rem;
        font-weight: 900;
        color: #111827;
    }

        .panel-title span,
        .panel-link {
            color: #111827;
        }

    .panel-link {
        font-weight: 800;
        text-decoration: none;
    }

        .panel-link:hover {
            text-decoration: underline;
        }

    .quick-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .quick-stat {
        min-height: 126px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .quick-stat-label {
        color: #374151;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .quick-stat-number {
        font-size: 1.65rem;
        font-weight: 900;
        color: #111827;
    }

        .quick-stat-number.green,
        .quick-stat-number.orange {
            color: #111827;
        }

    .quick-stat-sub {
        color: #6b7280;
        font-weight: 600;
    }

    .badge-list {
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .badge-item {
        display: grid;
        grid-template-columns: 86px 1fr;
        gap: 20px;
        align-items: center;
    }

    .badge-image {
        width: 86px;
        height: 86px;
        border-radius: 22px;
        background: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: #fff;
    }

    .badge-name {
        font-weight: 900;
        color: #111827;
        font-size: 1.05rem;
        margin-bottom: 6px;
    }

    .badge-desc {
        color: #6b7280;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .badge-time {
        color: #111827;
        font-weight: 800;
        font-size: .92rem;
    }

    .empty-box {
        text-align: center;
        color: #9ca3af;
        padding: 42px 10px;
        font-weight: 700;
    }

    @@media(max-width: 1250px) {
        .top-grid {
            grid-template-columns: 1fr 1fr;
        }

        .main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width: 768px) {
        .top-grid {
            grid-template-columns: 1fr;
        }

        .welcome-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .xp-bar-main {
            width: 100%;
        }

        .resource-value {
            margin-left: 0;
        }

        .quick-stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-page">

    <section class="top-grid">
        <div class="welcome-card">
            <div class="avatar-placeholder">🧙‍♂️</div>

            <div class="welcome-content">
                <h1>Chào mừng trở lại, @(Model.Username ?? "Hero")! ✨</h1>
                <p>Tiếp tục hành trình và trở thành phiên bản tốt hơn của chính bạn.</p>

                <div class="xp-row">
                    <span class="level-pill">Lv. @Model.Level</span>
                    <span class="xp-text">@currentXp.ToString("N0") / 5.000 XP</span>

                    <div class="xp-bar-main">
                        <span style="width:@xpInLevel%"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">❤️</span>
                <span class="resource-label">HP</span>
            </div>
            <div class="resource-value">@hpValue.ToString("0.#") / 50</div>
            <div class="resource-bar">
                <span class="bar-red" style="width:@hpPercent.ToString("0.#")%"></span>
            </div>
        </div>

        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">💧</span>
                <span class="resource-label">Mana</span>
            </div>
            <div class="resource-value">@manaValue.ToString("0.#") / @maxMana</div>
            <div class="resource-bar">
                <span class="bar-blue" style="width:@manaPercent.ToString("0.#")%"></span>
            </div>
        </div>

        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">🟡</span>
                <span class="resource-label">Gold</span>
            </div>
            <div class="resource-value">@Model.Gold.ToString("0.#")</div>
        </div>

        <div class="resource-card">
            <div class="resource-head">
                <span class="resource-icon">💎</span>
                <span class="resource-label">Gems</span>
            </div>
            <div class="resource-value">@Model.Gems.ToString("0.#")</div>
        </div>
    </section>

    <section class="main-grid">

        <div class="panel-card">
            <div class="panel-header">
                <div class="panel-title">
                    <span>▥</span>
                    Thống kê nhanh
                </div>
            </div>

            <div class="quick-stats-grid">
                <div class="quick-stat">
                    <div class="quick-stat-label">🔥 Streak hiện tại</div>
                    <div class="quick-stat-number">@Model.CurrentStreak ngày</div>
                    <div class="quick-stat-sub">Cố lên!</div>
                </div>

                <div class="quick-stat">
                    <div class="quick-stat-label">☑ Hoàn thành</div>
                    <div class="quick-stat-number green">@Model.TotalQuestsCompleted</div>
                    <div class="quick-stat-sub">Nhiệm vụ</div>
                </div>

                <div class="quick-stat">
                    <div class="quick-stat-label">⭐ XP kiếm được</div>
                    <div class="quick-stat-number">@Model.TotalXPEarned.ToString("N0")</div>
                    <div class="quick-stat-sub">Điểm</div>
                </div>

                <div class="quick-stat">
                    <div class="quick-stat-label">🟡 Gold hiện có</div>
                    <div class="quick-stat-number orange">@Model.Gold.ToString("0.#")</div>
                    <div class="quick-stat-sub">Vàng</div>
                </div>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-header">
                <div class="panel-title">
                    <span>🏅</span>
                    Huy hiệu mới
                </div>
                <a class="panel-link" href="/Dashboard/Badges">Xem tất cả</a>
            </div>

            <div class="badge-list">
                @if (recentBadges != null && recentBadges.Any())
                {
                    foreach (var ub in recentBadges)
                    {
                        <div class="badge-item">
                            <div class="badge-image">@(ub.Badge?.Icon ?? "🏅")</div>

                            <div>
                                <div class="badge-name">@(ub.Badge?.Name ?? "Badge")</div>
                                <div class="badge-desc">@(ub.Badge?.Description ?? "Bạn vừa mở khóa huy hiệu mới")</div>
                                <div class="badge-time">@ub.EarnedDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-box">
                        Chưa có huy hiệu nào.
                    </div>
                }
            </div>
        </div>

    </section>
</div>