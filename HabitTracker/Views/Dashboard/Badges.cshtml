@model List<HabitTracker.Models.UserBadge>
@{
    ViewData["Title"] = "Tất cả Badges";
}

<style>
    .badges-page {
        max-width: 1220px;
        margin: 24px auto 60px;
        padding: 0 16px;
    }

    .badges-hero {
        background: linear-gradient(135deg, #6366f1, #7c3aed);
        color: white;
        border-radius: 24px;
        padding: 34px 38px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
        box-shadow: 0 18px 40px rgba(99,102,241,.22);
    }

        .badges-hero h2 {
            font-size: 34px;
            font-weight: 900;
            margin: 0;
        }

        .badges-hero p {
            margin: 8px 0 0;
            opacity: .9;
            font-weight: 700;
        }

    .back-btn {
        color: white;
        text-decoration: none;
        border: 2px solid rgba(255,255,255,.45);
        background: rgba(255,255,255,.14);
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 900;
    }

        .back-btn:hover {
            color: white;
            background: rgba(255,255,255,.25);
        }

    .stats-bar {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 22px 28px;
        margin-bottom: 24px;
        display: flex;
        gap: 34px;
        flex-wrap: wrap;
        box-shadow: 0 12px 30px rgba(15,23,42,.06);
    }

    .stat-chip {
        min-width: 90px;
        text-align: center;
    }

        .stat-chip .num {
            display: block;
            font-size: 28px;
            font-weight: 900;
            color: #6366f1;
        }

        .stat-chip .lbl {
            color: #64748b;
            font-weight: 800;
            font-size: 14px;
        }

    .badges-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .badge-card {
        position: relative;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        padding: 30px 22px;
        text-align: center;
        min-height: 260px;
        box-shadow: 0 12px 30px rgba(15,23,42,.06);
        transition: .18s ease;
    }

        .badge-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 38px rgba(15,23,42,.1);
            border-color: #a78bfa;
        }

        .badge-card.new-badge {
            border: 2px solid #f59e0b;
        }

    .new-badge-ribbon {
        position: absolute;
        top: 18px;
        right: -34px;
        width: 150px;
        padding: 6px 0;
        transform: rotate(42deg);
        background: #facc15;
        color: #111827;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .08em;
    }

    .badge-icon {
        width: 86px;
        height: 86px;
        margin: 0 auto 18px;
        border-radius: 26px;
        background: radial-gradient(circle at center, rgba(250,204,21,.22), transparent 58%), #fffbeb;
        border: 1px solid #fde68a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 46px;
    }

    .badge-name {
        font-size: 22px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 10px;
    }

    .badge-description {
        color: #64748b;
        font-weight: 700;
        line-height: 1.5;
        margin-bottom: 16px;
    }

    .badge-meta {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .rarity-tag,
    .xp-tag {
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 900;
    }

    .rarity-Common {
        background: #f1f5f9;
        color: #475569;
    }

    .rarity-Rare {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .rarity-Epic {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .rarity-Legendary {
        background: #ffedd5;
        color: #ea580c;
    }

    .xp-tag {
        background: #dcfce7;
        color: #15803d;
    }

    .earned-date {
        color: #94a3b8;
        font-weight: 800;
        font-size: 14px;
    }

    .empty-state {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 24px;
        padding: 70px 24px;
        text-align: center;
        color: #64748b;
        box-shadow: 0 12px 30px rgba(15,23,42,.05);
    }

        .empty-state .emoji {
            font-size: 64px;
            display: block;
            margin-bottom: 16px;
        }

        .empty-state h4 {
            color: #111827;
            font-weight: 900;
        }

    @@media (max-width: 992px) {
        .badges-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        .badges-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .badges-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="badges-page">

    <div class="badges-hero">
        <div>
            <h2>🏆 Tất cả Badges</h2>
            <p>Bộ sưu tập huy hiệu của bạn</p>
        </div>

        <a href="javascript:history.back()" class="back-btn">← Quay lại</a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        var countByRarity = Model
        .GroupBy(b => b.Badge?.Rarity ?? "Common")
        .ToDictionary(g => g.Key, g => g.Count());

        <div class="stats-bar">
            <div class="stat-chip">
                <span class="num">@Model.Count</span>
                <span class="lbl">Tổng badges</span>
            </div>

            @if (countByRarity.TryGetValue("Legendary", out int leg) && leg > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#ea580c">@leg</span>
                    <span class="lbl">Legendary</span>
                </div>
            }

            @if (countByRarity.TryGetValue("Epic", out int epic) && epic > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#7e22ce">@epic</span>
                    <span class="lbl">Epic</span>
                </div>
            }

            @if (countByRarity.TryGetValue("Rare", out int rare) && rare > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#1d4ed8">@rare</span>
                    <span class="lbl">Rare</span>
                </div>
            }

            @if (countByRarity.TryGetValue("Common", out int common) && common > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#64748b">@common</span>
                    <span class="lbl">Common</span>
                </div>
            }
        </div>

        <div class="badges-grid">
            @foreach (var ub in Model.OrderByDescending(b => b.EarnedDate))
            {
                var isNew = ub.IsNewlyEarned();
                var rarity = ub.Badge?.Rarity ?? "Common";

                <div class="badge-card @(isNew ? "new-badge" : "")">
                    @if (isNew)
                    {
                        <div class="new-badge-ribbon">NEW</div>
                    }

                    <div class="badge-icon">@(ub.Badge?.Icon ?? "🏅")</div>

                    <div class="badge-name">@(ub.Badge?.Name ?? "Badge")</div>

                    @if (!string.IsNullOrEmpty(ub.Badge?.Description))
                    {
                        <div class="badge-description">@ub.Badge.Description</div>
                    }

                    <div class="badge-meta">
                        <span class="rarity-tag rarity-@rarity">@rarity</span>

                        @if (ub.Badge != null && ub.Badge.RequiredXP > 0)
                        {
                            <span class="xp-tag">@ub.Badge.RequiredXP XP</span>
                        }
                    </div>

                    <div class="earned-date">
                        🗓️ Đạt được: @ub.EarnedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="emoji">🏅</span>
            <h4>Chưa có badge nào</h4>
            <p style="margin-top:8px;">Hoàn thành quest để nhận badge đầu tiên của bạn!</p>
            <a href="/task" class="btn btn-primary mt-3">📋 Đi làm quest ngay</a>
        </div>
    }
</div>