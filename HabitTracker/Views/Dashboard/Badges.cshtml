@model List<HabitTracker.Models.UserBadge>
@{
    ViewData["Title"] = "Tất cả Badges";
}

<style>
    body { background: #0d0d1a; color: #e8e8f0; font-family: "DM Sans", sans-serif; }

    .page-header {
        background: linear-gradient(135deg, #5c3dde 0%, #7c3aed 100%);
        color: white;
        padding: 35px 30px;
        border-radius: 16px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h2 { margin: 0; font-size: 1.8em; }
        .page-header p { margin: 6px 0 0; opacity: 0.9; font-size: 0.95em; }

    .back-btn {
        background: rgba(255,255,255,0.15);
        color: white;
        border: 1.5px solid rgba(255,255,255,0.4);
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
        white-space: nowrap;
    }
        .back-btn:hover { background: rgba(255,255,255,0.25); color: white; border-color: white; }

    .badges-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
    }

    .badge-card {
        background: rgba(255,255,255,.05);
        border-radius: 14px;
        padding: 24px 20px;
        border: 1.5px solid rgba(255,255,255,.1);
        text-align: center;
        transition: all 0.25s;
        position: relative;
        overflow: hidden;
    }
        .badge-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.2); }
        .badge-card.new-badge { border-color: #ffc107; }

    .new-badge-ribbon {
        position: absolute; top: 12px; right: -20px;
        background: #ffc107; color: #111;
        font-size: 0.7em; font-weight: bold;
        padding: 3px 28px; transform: rotate(35deg); letter-spacing: 0.5px;
    }

    .badge-icon { font-size: 3em; margin-bottom: 12px; display: block; }
    .badge-name { font-size: 1.15em; font-weight: 700; color: #e8e8f0; margin-bottom: 8px; }
    .badge-description { font-size: 0.88em; color: rgba(255,255,255,.5); line-height: 1.5; margin-bottom: 12px; }

    .badge-meta { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-top: 12px; }

    .rarity-tag { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.8em; font-weight: 700; color: white; }
    .rarity-Common   { background: #6b6b6b; }
    .rarity-Rare     { background: #0070DD; }
    .rarity-Epic     { background: #A335EE; }
    .rarity-Legendary{ background: #FF8000; }

    .earned-date { font-size: 0.8em; color: rgba(255,255,255,.35); margin-top: 8px; }

    .xp-tag {
        display: inline-block;
        background: rgba(0,184,156,.15); color: #00b89c;
        border: 1px solid rgba(0,184,156,.3);
        padding: 4px 12px; border-radius: 20px; font-size: 0.8em; font-weight: 600;
    }

    .empty-state {
        text-align: center; padding: 60px 20px; color: rgba(255,255,255,.4);
        background: rgba(255,255,255,.04);
        border: 1.5px solid rgba(255,255,255,.08);
        border-radius: 14px;
    }
        .empty-state .emoji { font-size: 4em; display: block; margin-bottom: 16px; }

    .stats-bar {
        background: rgba(255,255,255,.05);
        border-radius: 12px; padding: 18px 24px; margin-bottom: 24px;
        border: 1.5px solid rgba(255,255,255,.1);
        display: flex; gap: 30px; flex-wrap: wrap; align-items: center;
    }

    .stat-chip { display: flex; flex-direction: column; align-items: center; }
        .stat-chip .num { font-size: 1.5em; font-weight: 800; color: #9c7cf4; }
        .stat-chip .lbl { font-size: 0.8em; color: rgba(255,255,255,.4); }
</style>

<div class="container mt-4 mb-5">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h2>🏆 Tất cả Badges</h2>
            <p>Bộ sưu tập huy hiệu của bạn</p>
        </div>
        <a href="javascript:history.back()" class="back-btn">← Quay lại</a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Stats summary -->
        var countByRarity = Model
        .GroupBy(b => b.Badge?.Rarity ?? "Common")
        .ToDictionary(g => g.Key, g => g.Count());
        <div class="stats-bar">
            <div class="stat-chip">
                <span class="num">@Model.Count</span>
                <span class="lbl">Tổng badges</span>
            </div>
            @if (countByRarity.TryGetValue("Legendary", out int leg) && leg > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#FF8000">@leg</span>
                    <span class="lbl">Huyền Thoại</span>
                </div>
            }
            @if (countByRarity.TryGetValue("Epic", out int epic) && epic > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#A335EE">@epic</span>
                    <span class="lbl">Sử Thi</span>
                </div>
            }
            @if (countByRarity.TryGetValue("Rare", out int rare) && rare > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#0070DD">@rare</span>
                    <span class="lbl">Hiếm</span>
                </div>
            }
            @if (countByRarity.TryGetValue("Common", out int common) && common > 0)
            {
                <div class="stat-chip">
                    <span class="num" style="color:#808080">@common</span>
                    <span class="lbl">Thường</span>
                </div>
            }
        </div>

        <!-- Badges Grid -->
        <div class="badges-grid">
            @foreach (var ub in Model.OrderByDescending(b => b.EarnedDate))
            {
                var isNew = ub.IsNewlyEarned();
                var rarity = ub.Badge?.Rarity ?? "Common";
                <div class="badge-card @(isNew ? "new-badge" : "")">
                    @if (isNew)
                    {
                        <div class="new-badge-ribbon">MỚI</div>
                    }

                    <span class="badge-icon">@(ub.Badge?.Icon ?? "🏅")</span>
                    <div class="badge-name">@(ub.Badge?.Name ?? "Badge")</div>

                    @if (!string.IsNullOrEmpty(ub.Badge?.Description))
                    {
                        <div class="badge-description">@ub.Badge.Description</div>
                    }

                    <div class="badge-meta">
                        <span class="rarity-tag rarity-@rarity">@(rarity switch { "Common" => "Thường", "Rare" => "Hiếm", "Epic" => "Sử Thi", "Legendary" => "Huyền Thoại", _ => rarity })</span>
                        @if (ub.Badge != null && ub.Badge.RequiredXP > 0)
                        {
                            <span class="xp-tag">@ub.Badge.RequiredXP XP</span>
                        }
                    </div>

                    <div class="earned-date">
                        🗓️ Đạt được: @ub.EarnedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="emoji">🏅</span>
            <h4>Chưa có badge nào</h4>
            <p style="margin-top: 8px;">Hoàn thành quest để nhận badge đầu tiên của bạn!</p>
            <a href="/task" class="btn btn-primary mt-3">📋 Đi làm quest ngay</a>
        </div>
    }
</div>
