@{
    ViewData["Title"] = "Achievements";

    var allBadges   = (List<HabitTracker.Models.Badge>)ViewBag.AllBadges;
    var earnedMap   = (Dictionary<int, HabitTracker.Models.UserBadge>)ViewBag.EarnedMap;
    int earnedCount = (int)ViewBag.EarnedCount;
    int totalCount  = allBadges.Count;

    var categories = new[]
    {
        ("Streak",       "🔥 Streak",          "Keep your task streak alive"),
        ("TaskMilestone","✅ Task Milestones",  "Complete tasks to progress"),
        ("PerfectDay",   "⭐ Perfect Days",     "Complete all dailies in a day"),
        ("UltimateGear", "⚔️ Ultimate Gear",   "Collect your class's full gear set"),
        ("Quest",        "🗺️ Quests",          "Complete party boss quests"),
        ("Stable",       "🐾 Stable",           "Collect pets and mounts"),
        ("Social",       "🏰 Social",           "Connect with the community"),
    };
}

<style>
    .ach-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 32px 28px;
        border-radius: 12px;
        margin-bottom: 28px;
    }
    .ach-progress-bar {
        height: 10px;
        border-radius: 5px;
        background: rgba(255,255,255,0.2);
        margin-top: 12px;
    }
    .ach-progress-fill {
        height: 100%;
        border-radius: 5px;
        background: #ffd700;
        transition: width 0.6s ease;
    }
    .category-section { margin-bottom: 36px; }
    .category-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #444;
        margin-bottom: 14px;
        padding-bottom: 6px;
        border-bottom: 2px solid #e9ecef;
    }
    .ach-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
    }
    .ach-card {
        background: white;
        border-radius: 12px;
        padding: 20px 16px;
        text-align: center;
        border: 2px solid transparent;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
    }
    .ach-card:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(0,0,0,0.12); }
    .ach-card.earned { border-color: #ffc107; }
    .ach-card.locked { opacity: 0.45; filter: grayscale(0.6); }
    .ach-card.locked:hover { transform: none; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
    .ach-icon { font-size: 2.4rem; margin-bottom: 8px; display: block; }
    .ach-name { font-size: 0.95rem; font-weight: 700; color: #222; margin-bottom: 4px; }
    .ach-desc { font-size: 0.8rem; color: #666; line-height: 1.4; margin-bottom: 10px; }
    .rarity-tag {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        color: white;
    }
    .rarity-Common    { background: #808080; }
    .rarity-Rare      { background: #0070DD; }
    .rarity-Epic      { background: #A335EE; }
    .rarity-Legendary { background: #FF8000; }
    .earned-date { font-size: 0.72rem; color: #888; margin-top: 6px; }
    .new-ribbon {
        position: absolute;
        top: 10px; right: -18px;
        background: #ffc107;
        color: #333;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 2px 24px;
        transform: rotate(35deg);
    }
    .lock-icon { position: absolute; top: 8px; right: 8px; font-size: 0.9rem; opacity: 0.5; }
</style>

<div class="container mt-4 mb-5">

    <div class="ach-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h2 class="mb-1">🏆 Achievements</h2>
                <p class="mb-0" style="opacity:.9">@earnedCount / @totalCount unlocked</p>
                <div class="ach-progress-bar mt-2" style="width:260px">
                    <div class="ach-progress-fill" style="width:@(totalCount > 0 ? (earnedCount * 100 / totalCount) : 0)%"></div>
                </div>
            </div>
            <a href="javascript:history.back()" class="btn btn-outline-light btn-sm align-self-start">← Back</a>
        </div>
    </div>

    @foreach (var (triggerType, label, subtitle) in categories)
    {
        var catBadges = allBadges.Where(b => b.TriggerType == triggerType).ToList();
        if (!catBadges.Any()) continue;

        <div class="category-section">
            <div class="category-title">@Html.Raw(label) <small class="text-muted fw-normal" style="font-size:.8rem">— @subtitle</small></div>
            <div class="ach-grid">
                @foreach (var badge in catBadges)
                {
                    bool isEarned = earnedMap.TryGetValue(badge.Id, out var ub);
                    bool isNew    = isEarned && (DateTime.UtcNow - ub!.EarnedDate) < TimeSpan.FromHours(24);

                    <div class="ach-card @(isEarned ? "earned" : "locked")">
                        @if (isNew)
                        {
                            <div class="new-ribbon">NEW</div>
                        }
                        @if (!isEarned)
                        {
                            <span class="lock-icon">🔒</span>
                        }
                        <span class="ach-icon">@(badge.Icon ?? "🏅")</span>
                        <div class="ach-name">@badge.Name</div>
                        <div class="ach-desc">@badge.Description</div>
                        <span class="rarity-tag rarity-@badge.Rarity">@badge.Rarity</span>
                        @if (isEarned)
                        {
                            <div class="earned-date">🗓️ @ub!.EarnedDate.ToString("dd/MM/yyyy")</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (earnedCount == 0 && totalCount == 0)
    {
        <div class="text-center py-5 text-muted">
            <div style="font-size:3rem">🏅</div>
            <p class="mt-3">No achievements defined yet.</p>
        </div>
    }
</div>
