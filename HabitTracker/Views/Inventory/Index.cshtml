@model HabitTracker.Models.ViewModels.InventoryViewModel
@{
    ViewData["Title"] = "Inventory";
    var u         = Model.User;
    var itemTypes = new[] { HabitTracker.Constants.ItemType.Food, HabitTracker.Constants.ItemType.Egg, HabitTracker.Constants.ItemType.HatchingPotion };

    string TypeLabel(HabitTracker.Constants.ItemType t) => t switch
    {
        HabitTracker.Constants.ItemType.Food           => "🍖 Food",
        HabitTracker.Constants.ItemType.Egg            => "🥚 Eggs",
        HabitTracker.Constants.ItemType.HatchingPotion => "🧪 Hatching Potions",
        _ => "📦 Other"
    };

    string SlotIcon(string slot) => slot switch
    {
        "weapon"        => "⚔️",
        "armor"         => "🛡️",
        "head"          => "🪖",
        "shield"        => "🔰",
        _               => "📦"
    };
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<div class="container-fluid py-4" style="max-width:1100px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <h2 class="mb-0">🎒 Inventory</h2>
        <span class="badge bg-secondary">@Model.Items.Sum(i => i.Quantity) items</span>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" id="invTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-items" type="button">
                Items <span class="badge bg-secondary ms-1">@Model.Items.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-gear" type="button">
                Gear <span class="badge bg-secondary ms-1">@Model.OwnedGear.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ITEMS TAB -->
        <div class="tab-pane fade show active" id="tab-items">
            @if (!Model.Items.Any())
            {
                <div class="text-center text-muted py-5">
                    <div style="font-size:3rem;">📦</div>
                    <p class="mt-2">No items yet. Complete tasks to earn drops!</p>
                </div>
            }
            else
            {
                @foreach (var type in itemTypes)
                {
                    var group = Model.Items.Where(i => i.GameItem?.Type == type).ToList();
                    if (!group.Any()) continue;

                    <h5 class="mt-3 mb-2 text-secondary">@TypeLabel(type)</h5>
                    <div class="row g-3 mb-4">
                        @foreach (var inv in group)
                        {
                            var item = inv.GameItem!;
                            bool canSell = item.GoldValue > 0;
                            bool isHatchable = item.Type == HabitTracker.Constants.ItemType.Egg ||
                                               item.Type == HabitTracker.Constants.ItemType.HatchingPotion;
                            <div class="col-6 col-md-4 col-lg-3" id="inv-card-@inv.GameItemId">
                                <div class="card h-100 bg-dark border-secondary text-center p-3">
                                    <img src="@item.ImagePath" alt="@item.Name"
                                         style="width:56px;height:56px;object-fit:contain;margin:auto;"
                                         onerror="this.outerHTML='<div style=\'font-size:2.5rem;\'>@item.Icon</div>'">
                                    <div class="fw-bold mt-1 text-white">@item.Name</div>
                                    <div class="text-muted small">
                                        <span class="badge bg-secondary">×<span class="qty-badge">@inv.Quantity</span></span>
                                    </div>
                                    @if (isHatchable)
                                    {
                                        <a href="/Stable#tab-hatch" class="btn btn-sm btn-outline-info mt-2">🥚 Hatch</a>
                                    }
                                    @if (canSell)
                                    {
                                        <button class="btn btn-sm btn-outline-warning mt-2"
                                                onclick="sellItem(@inv.GameItemId, this)">
                                            Sell · @item.GoldValue GP
                                        </button>
                                    }
                                    @if (!canSell && !isHatchable)
                                    {
                                        <span class="text-muted small mt-2 d-block">Not sellable</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <!-- GEAR TAB -->
        <div class="tab-pane fade" id="tab-gear">
            @if (!Model.OwnedGear.Any())
            {
                <div class="text-center text-muted py-5">
                    <div style="font-size:3rem;">⚔️</div>
                    <p class="mt-2">No gear owned yet. Visit the <a href="/Market">Market</a> or <a href="/Equipment">Equipment</a> page to buy some!</p>
                </div>
            }
            else
            {
                var bySlot = Model.OwnedGear.GroupBy(g => g.GearItem!.Slot).OrderBy(g => g.Key);
                @foreach (var slotGroup in bySlot)
                {
                    <h5 class="mt-3 mb-2 text-secondary">@SlotIcon(slotGroup.Key) @char.ToUpper(slotGroup.Key[0])@slotGroup.Key[1..]</h5>
                    <div class="row g-3 mb-4">
                        @foreach (var ug in slotGroup.OrderBy(g => g.GearItem!.Tier))
                        {
                            var gear = ug.GearItem!;
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="card h-100 bg-dark border-secondary p-2 text-center">
                                    <img src="@gear.ShopImagePath" alt="@gear.Name"
                                         style="width:48px;height:48px;object-fit:contain;margin:auto;"
                                         onerror="this.style.display='none'">
                                    <div class="fw-bold small mt-1 text-white">@gear.Name</div>
                                    <div class="text-muted" style="font-size:.72rem;">
                                        @if (gear.STR > 0) { <span class="me-1 text-danger">STR+@gear.STR</span> }
                                        @if (gear.CON > 0) { <span class="me-1 text-success">CON+@gear.CON</span> }
                                        @if (gear.INT > 0) { <span class="me-1 text-info">INT+@gear.INT</span> }
                                        @if (gear.PER > 0) { <span class="me-1 text-warning">PER+@gear.PER</span> }
                                    </div>
                                    <a href="/Equipment" class="btn btn-sm btn-outline-secondary mt-2" style="font-size:.75rem;">Equip →</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

    </div><!-- tab-content -->
</div>

@section Scripts {
<script>
function token() { return document.querySelector('input[name="__RequestVerificationToken"]').value; }

function sellItem(gameItemId, btn) {
    btn.disabled = true;
    fetch('/Inventory/Sell?gameItemId=' + gameItemId, {
        method: 'POST',
        headers: { 'RequestVerificationToken': token(), 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '__RequestVerificationToken=' + encodeURIComponent(token()) + '&gameItemId=' + gameItemId
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            showToast('🪙', 'Sold!', '+' + d.goldAwarded + ' GP', 'toast-gold', 2500);
            refreshHud();
            const card = document.getElementById('inv-card-' + gameItemId);
            const qtyEl = card?.querySelector('.qty-badge');
            if (qtyEl) {
                const newQty = parseInt(qtyEl.textContent) - 1;
                if (newQty <= 0) {
                    card.remove();
                } else {
                    qtyEl.textContent = newQty;
                    btn.disabled = false;
                }
            }
        } else {
            showToast('🚫', 'Cannot Sell', d.error, 'toast-hp', 3000);
            btn.disabled = false;
        }
    });
}
</script>
}
