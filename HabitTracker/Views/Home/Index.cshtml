@model HabitTracker.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "HabitTracker - Gamify Your Life";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HabitTracker — Gamify Your Life</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Cinzel:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #070711;
            --paper: #f7f4ee;
            --gold: #ffd166;
            --violet: #7c4dff;
            --violet2: #9b7cff;
            --rose: #ff4f8b;
            --teal: #2de2c5;
            --soft: #edeaf5;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: radial-gradient(circle at 20% 0%, rgba(124,77,255,.14), transparent 32%), radial-gradient(circle at 80% 20%, rgba(255,209,102,.12), transparent 28%), var(--paper);
            color: var(--ink);
            font-family: "Be Vietnam Pro", sans-serif;
            overflow-x: hidden;
        }

        /* NAV */
        nav#navbar {
            position: fixed;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            width: min(1160px, calc(100% - 24px));
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 10px 16px;
            background: rgba(7,7,17,.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 28px;
            box-shadow: 0 18px 48px rgba(0,0,0,.35);
            transition: .25s;
        }

        /* LOGO GIỐNG TRANG BADGES */
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 275px;
            height: 78px;
            padding: 8px 18px;
            border-radius: 22px;
            color: white;
            text-decoration: none;
            background: linear-gradient(135deg, rgba(124,77,255,.26), rgba(8,8,18,.88));
            border: 1px solid rgba(168,85,247,.65);
            box-shadow: 0 0 24px rgba(124,77,255,.34), inset 0 0 18px rgba(255,255,255,.05);
            transition: .25s;
        }

            .brand:hover {
                transform: translateY(-2px);
                border-color: rgba(168,85,247,.9);
                box-shadow: 0 0 34px rgba(124,77,255,.48), inset 0 0 22px rgba(255,255,255,.07);
                color: white;
            }

        .brand-logo {
            width: 76px;
            height: 76px;
            object-fit: contain;
            flex-shrink: 0;
            filter: drop-shadow(0 0 8px rgba(168,85,247,.75)) drop-shadow(0 0 22px rgba(124,77,255,.5));
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

            .brand-text span {
                font-family: "Cinzel", serif;
                font-size: 1.12rem;
                font-weight: 800;
                color: #f8fafc;
                letter-spacing: .8px;
            }

            .brand-text strong {
                margin-top: 2px;
                font-family: "Cinzel", serif;
                font-size: 2rem;
                font-weight: 800;
                color: #facc15;
                letter-spacing: 1px;
                text-shadow: 0 0 10px rgba(250,204,21,.6), 0 0 24px rgba(168,85,247,.38);
            }

        .nav-links {
            display: flex;
            gap: 8px;
            align-items: center;
            overflow-x: auto;
        }

            .nav-links a {
                padding: 10px 16px;
                border-radius: 999px;
                font-weight: 700;
                font-size: .9rem;
                text-decoration: none;
                color: rgba(255,255,255,.74);
                white-space: nowrap;
                transition: .2s;
            }

                .nav-links a:hover {
                    background: rgba(124,77,255,.18);
                    color: #fff;
                }

        .btn-nav-cta {
            background: linear-gradient(135deg, var(--gold), #ff9f1c) !important;
            color: #17111f !important;
            font-weight: 900 !important;
            box-shadow: 0 10px 26px rgba(255,209,102,.25);
        }

            .btn-nav-cta:hover {
                background: linear-gradient(135deg, var(--violet), var(--teal)) !important;
                color: #fff !important;
            }

        /* HERO */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 150px 24px 90px;
            position: relative;
            overflow: hidden;
            text-align: center;
            isolation: isolate;
            background-image: linear-gradient(135deg, rgba(8,7,18,.76), rgba(22,14,58,.6) 48%, rgba(6,5,14,.82)), url('/fe/home/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

            .hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 50% 48%, rgba(255,255,255,.16), transparent 0 2px, transparent 3px), radial-gradient(circle at 18% 30%, rgba(255,209,102,.32), transparent 0 2px, transparent 3px), radial-gradient(circle at 77% 22%, rgba(45,226,197,.26), transparent 0 2px, transparent 3px), radial-gradient(circle at 70% 76%, rgba(255,79,139,.24), transparent 0 2px, transparent 3px);
                background-size: 220px 220px, 280px 280px, 250px 250px, 310px 310px;
                opacity: .85;
                z-index: -2;
                animation: sparkleMove 16s linear infinite;
            }

            .hero::after {
                content: "";
                position: absolute;
                width: min(760px, 92vw);
                height: min(760px, 92vw);
                border-radius: 50%;
                background: radial-gradient(circle, rgba(124,77,255,.38) 0%, rgba(255,209,102,.12) 36%, transparent 68%);
                filter: blur(10px);
                z-index: -1;
                animation: haloPulse 5.5s ease-in-out infinite;
            }

        @@keyframes sparkleMove {
            from {
                background-position: 0 0, 0 0, 0 0, 0 0;
            }

            to {
                background-position: 220px 220px, -280px 280px, 250px -250px, -310px -310px;
            }
        }

        @@keyframes haloPulse {
            0%, 100% {
                transform: scale(.96);
                opacity: .75;
            }

            50% {
                transform: scale(1.04);
                opacity: 1;
            }
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 620px;
            background: rgba(8,8,18,.56);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 30px;
            padding: 42px 38px;
            box-shadow: 0 20px 55px rgba(0,0,0,.36);
        }

            .hero-content::before {
                content: "";
                position: absolute;
                inset: 14px;
                border-radius: 24px;
                border: 1px solid rgba(255,255,255,.1);
                pointer-events: none;
            }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 999px;
            padding: 8px 18px;
            font-size: .78rem;
            font-weight: 900;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 26px;
            opacity: 0;
            animation: fadeUp .7s .1s forwards;
        }

        .hero h1 {
            color: #fff;
            font-size: clamp(2.35rem, 5.4vw, 5.2rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -2.4px;
            margin-bottom: 28px;
            text-shadow: 0 12px 36px rgba(0,0,0,.48);
            opacity: 0;
            animation: fadeUp .7s .25s forwards;
        }

        .accent-gold {
            color: transparent;
            background: linear-gradient(135deg, #ffe08a, #ff9f1c);
            -webkit-background-clip: text;
            background-clip: text;
        }

        .accent-violet {
            color: transparent;
            background: linear-gradient(135deg, #a98cff, #2de2c5);
            -webkit-background-clip: text;
            background-clip: text;
        }

        .hero-ctas {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
            opacity: 0;
            animation: fadeUp .7s .55s forwards;
        }

        .btn-primary-hero {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, var(--violet), #6d28d9);
            color: white;
            padding: 15px 34px;
            border-radius: 999px;
            font-weight: 900;
            font-size: 1rem;
            text-decoration: none;
            transition: .2s;
            box-shadow: 0 14px 34px rgba(124,77,255,.32);
        }

            .btn-primary-hero:hover {
                background: linear-gradient(135deg, var(--violet), var(--teal));
                transform: translateY(-2px);
                color: #fff;
            }

        .btn-secondary-hero {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.12);
            color: #fff;
            padding: 15px 30px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            border: 1.5px solid rgba(255,255,255,.24);
            transition: .2s;
        }

            .btn-secondary-hero:hover {
                color: #fff;
                background: rgba(255,255,255,.18);
            }

        .login-bubble {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            padding: 12px 18px;
            color: rgba(255,255,255,.82);
            text-decoration: none;
            border-radius: 999px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.16);
            transition: .2s;
        }

            .login-bubble:hover {
                transform: translateY(-2px);
                color: #fff;
                background: rgba(255,255,255,.16);
            }

        .hero-mini-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin: 34px auto 0;
            opacity: 0;
            animation: fadeUp .7s .7s forwards;
        }

        .mini-stat {
            padding: 16px 12px;
            border-radius: 22px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.14);
            color: rgba(255,255,255,.74);
            font-weight: 700;
        }

            .mini-stat strong {
                display: block;
                font-size: 1.35rem;
                line-height: 1;
                color: var(--gold);
                margin-bottom: 6px;
                font-weight: 900;
            }

        /* STATS */
        .stats-strip {
            background: var(--ink);
            color: var(--paper);
            padding: 40px 48px;
            display: flex;
            justify-content: center;
        }

        .stat-block {
            flex: 1;
            text-align: center;
            max-width: 220px;
            padding: 0 30px;
            border-right: 1px solid rgba(255,255,255,.1);
            opacity: 0;
        }

            .stat-block:last-child {
                border: none;
            }

            .stat-block.visible {
                animation: fadeUp .6s forwards;
            }

        .stat-num {
            font-size: 2.8rem;
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(135deg, var(--gold), var(--rose));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-desc {
            font-size: .85rem;
            color: rgba(255,255,255,.55);
            margin-top: 6px;
        }

        /* FEATURES */
        .features {
            padding: 100px 48px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-label {
            font-size: .78rem;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--violet);
            margin-bottom: 14px;
        }

        .section-title {
            font-size: clamp(1.8rem, 3.5vw, 2.8rem);
            font-weight: 900;
            letter-spacing: -1.5px;
            line-height: 1.1;
            margin-bottom: 60px;
            max-width: 520px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
        }

        .feat-card {
            background: white;
            border-radius: 20px;
            padding: 32px 28px;
            border: 1.5px solid rgba(0,0,0,.06);
            transition: .25s;
            opacity: 0;
        }

            .feat-card.visible {
                animation: fadeUp .6s forwards;
            }

            .feat-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 16px 48px rgba(0,0,0,.1);
                border-color: var(--violet);
            }

        .feat-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 18px;
        }

        .feat-title {
            font-size: 1.1rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .feat-desc {
            font-size: .9rem;
            color: #666;
            line-height: 1.65;
        }

        .fi-violet {
            background: #ede9ff;
        }

        .fi-gold {
            background: #fff5d6;
        }

        .fi-teal {
            background: #d4f5ef;
        }

        .fi-rose {
            background: #fde8ed;
        }

        .fi-ink {
            background: #e8e8f0;
        }

        .fi-green {
            background: #e2f5e2;
        }

        /* HOW */
        .how {
            background: var(--soft);
            padding: 100px 48px;
        }

        .how-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 32px;
            margin-top: 60px;
        }

        .step {
            text-align: center;
            opacity: 0;
        }

            .step.visible {
                animation: fadeUp .6s forwards;
            }

        .step-num {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--ink);
            color: var(--paper);
            font-weight: 900;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
        }

        .step h4 {
            font-size: 1rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .step p {
            font-size: .88rem;
            color: #666;
            line-height: 1.6;
        }

        /* LEADERBOARD */
        .preview-section {
            padding: 100px 48px;
            max-width: 960px;
            margin: 0 auto;
            text-align: center;
        }

        .lb-table {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,.08);
            margin-top: 40px;
            text-align: left;
        }

        .lb-head, .lb-row {
            display: grid;
            grid-template-columns: 64px 1fr 120px 140px;
            gap: 10px;
            align-items: center;
        }

        .lb-head {
            padding: 14px 28px;
            background: var(--ink);
            color: var(--paper);
            font-size: .8rem;
            font-weight: 900;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .lb-row {
            padding: 18px 28px;
            border-bottom: 1px solid #f0f0f0;
            opacity: 0;
            transition: .2s;
        }

            .lb-row.visible {
                animation: fadeLeft .5s forwards;
            }

            .lb-row:hover {
                background: var(--soft);
            }

        .lb-rank {
            font-weight: 900;
            color: #bbb;
            font-size: 1.1rem;
        }

            .lb-rank.gold {
                color: #f0b429;
            }

            .lb-rank.silver {
                color: #9e9e9e;
            }

            .lb-rank.bronze {
                color: #cd7f32;
            }

        .lb-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .lb-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: 900;
            object-fit: cover;
        }

        .lb-name {
            font-weight: 900;
            font-size: .95rem;
        }

        .lb-level {
            font-size: .78rem;
            color: #999;
            margin-top: 2px;
        }

        .lb-xp {
            font-weight: 900;
            color: var(--violet);
            font-size: 1rem;
        }

        .lb-badge {
            font-size: .82rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .rarity-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .r-Legendary {
            background: #FF8000;
        }

        .r-Epic {
            background: #A335EE;
        }

        .r-Rare {
            background: #0070DD;
        }

        .r-Common {
            background: #808080;
        }

        /* CTA */
        .cta-banner {
            margin: 0 48px 80px;
            background: var(--ink);
            border-radius: 28px;
            padding: 70px 60px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .cta-banner::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse at 30% 50%, rgba(124,77,255,.4), transparent 60%), radial-gradient(ellipse at 70% 50%, rgba(255,209,102,.25), transparent 60%);
                pointer-events: none;
            }

            .cta-banner h2 {
                font-size: clamp(2rem, 4vw, 3.2rem);
                font-weight: 900;
                letter-spacing: -1.5px;
                color: white;
                margin-bottom: 16px;
                position: relative;
            }

            .cta-banner p {
                color: rgba(255,255,255,.6);
                font-size: 1.05rem;
                margin-bottom: 36px;
                position: relative;
            }

        .cta-btn-group {
            display: flex;
            gap: 14px;
            justify-content: center;
            flex-wrap: wrap;
            position: relative;
        }

        .btn-cta-white {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: white;
            color: var(--ink);
            padding: 15px 36px;
            border-radius: 999px;
            font-weight: 900;
            font-size: 1rem;
            text-decoration: none;
            transition: .2s;
        }

            .btn-cta-white:hover {
                transform: translateY(-2px);
                color: var(--violet);
            }

        .btn-cta-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: transparent;
            color: white;
            padding: 15px 30px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            border: 1.5px solid rgba(255,255,255,.3);
            transition: .2s;
        }

            .btn-cta-ghost:hover {
                border-color: white;
                background: rgba(255,255,255,.08);
                color: white;
            }

        footer {
            background: var(--ink);
            color: rgba(255,255,255,.4);
            padding: 30px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .85rem;
            flex-wrap: wrap;
            gap: 10px;
        }

            footer a {
                color: rgba(255,255,255,.5);
                text-decoration: none;
            }

                footer a:hover {
                    color: white;
                }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeLeft {
            from {
                opacity: 0;
                transform: translateX(28px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@media (max-width: 980px) {
            nav#navbar {
                align-items: flex-start;
                flex-direction: column;
                border-radius: 24px;
            }

            .brand {
                width: 100%;
                min-width: 0;
                justify-content: center;
            }

            .nav-links {
                width: 100%;
                padding-bottom: 4px;
            }

            .hero {
                padding-top: 210px;
                background-attachment: scroll;
            }

            .hero-mini-stats {
                grid-template-columns: 1fr;
            }

            .stats-strip {
                padding: 40px 24px;
                flex-wrap: wrap;
                gap: 20px;
            }

            .stat-block {
                border: none;
                flex: 0 0 45%;
            }

            .features, .how, .preview-section {
                padding: 70px 24px;
            }

            .cta-banner {
                margin: 0 24px 60px;
                padding: 50px 30px;
            }

            .lb-head, .lb-row {
                grid-template-columns: 48px 1fr 90px;
            }

            .lb-badge {
                display: none;
            }

            footer {
                padding: 24px;
                flex-direction: column;
                text-align: center;
            }
        }

        @@media (max-width: 560px) {
            .brand {
                height: 68px;
            }

            .brand-logo {
                width: 62px;
                height: 62px;
            }

            .brand-text span {
                font-size: .95rem;
            }

            .brand-text strong {
                font-size: 1.65rem;
            }

            .hero-content {
                padding: 34px 22px;
            }
        }
    </style>
</head>
<body>

    <nav id="navbar">
        <a href="/" class="brand">
            <img src="/fe/logo/logo.png" class="brand-logo" alt="Logo" />
            <div class="brand-text">
                <span>Vương</span>
                <strong>Quốc</strong>
            </div>
        </a>

        <div class="nav-links">
            <a href="#features">Tính năng</a>
            <a href="#how">Cách dùng</a>
            <a href="#leaderboard">Leaderboard</a>
            <a href="/Account/Login">Đăng nhập</a>
            <a href="/Account/Register" class="btn-nav-cta">Bắt đầu miễn phí →</a>
        </div>
    </nav>

    <section class="hero">
        <div class="hero-content">
            <div class="hero-eyebrow"><span>✨</span> RPG Habit Builder</div>

            <h1>
                Biến thói quen nhỏ<br>
                thành <span class="accent-gold">nhiệm vụ mỗi ngày</span><br>
                <span class="accent-violet">và level up bản thân.</span>
            </h1>

            <div class="hero-ctas">
                <a href="/Account/Register" class="btn-primary-hero">Bắt đầu miễn phí</a>
                <a href="/Account/Login" class="btn-secondary-hero">Đăng nhập</a>
            </div>

            <a href="#features" class="login-bubble">Khám phá tính năng ↓</a>

            <div class="hero-mini-stats">
                <div class="mini-stat">
                    <strong>@Model.TotalUsers.ToString("N0")</strong>
                    Người dùng
                </div>
                <div class="mini-stat">
                    <strong>@Model.TotalQuestsCompleted.ToString("N0")</strong>
                    Quest hoàn thành
                </div>
                <div class="mini-stat">
                    <strong>@Model.TotalBadges.ToString("N0")</strong>
                    Badge đã kiếm
                </div>
            </div>
        </div>
    </section>

    <div class="stats-strip">
        <div class="stat-block">
            <div class="stat-num" data-target="@Model.TotalUsers">0</div>
            <div class="stat-desc">Người dùng tích cực</div>
        </div>
        <div class="stat-block">
            <div class="stat-num" data-target="@Model.TotalQuestsCompleted">0</div>
            <div class="stat-desc">Quests hoàn thành</div>
        </div>
        <div class="stat-block">
            <div class="stat-num" data-target="@Model.TotalBadges">0</div>
            <div class="stat-desc">Badges đã kiếm</div>
        </div>
        <div class="stat-block">
            <div class="stat-num" data-target="@Model.TotalQuests">0</div>
            <div class="stat-desc">Quests có sẵn</div>
        </div>
    </div>

    <section class="features" id="features">
        <div class="section-label">Tính năng</div>
        <h2 class="section-title">Mọi thứ bạn cần để không bỏ cuộc.</h2>

        <div class="features-grid">
            <div class="feat-card" style="animation-delay:.05s">
                <div class="feat-icon fi-violet">🎯</div>
                <div class="feat-title">Quest System</div>
                <div class="feat-desc">Chuyển đổi thói quen thành nhiệm vụ với độ khó và phần thưởng XP rõ ràng.</div>
            </div>

            <div class="feat-card" style="animation-delay:.12s">
                <div class="feat-icon fi-gold">⚡</div>
                <div class="feat-title">XP & Level Up</div>
                <div class="feat-desc">Mỗi quest hoàn thành mang lại XP. Tích lũy đủ để lên level.</div>
            </div>

            <div class="feat-card" style="animation-delay:.19s">
                <div class="feat-icon fi-rose">🔥</div>
                <div class="feat-title">Streak Tracking</div>
                <div class="feat-desc">Theo dõi chuỗi ngày liên tiếp và giữ động lực mỗi ngày.</div>
            </div>

            <div class="feat-card" style="animation-delay:.26s">
                <div class="feat-icon fi-teal">🏆</div>
                <div class="feat-title">Badge Collection</div>
                <div class="feat-desc">Kiếm huy hiệu Common, Rare, Epic và Legendary.</div>
            </div>

            <div class="feat-card" style="animation-delay:.33s">
                <div class="feat-icon fi-ink">🏅</div>
                <div class="feat-title">Leaderboard</div>
                <div class="feat-desc">Cạnh tranh lành mạnh và leo top bảng xếp hạng XP.</div>
            </div>

            <div class="feat-card" style="animation-delay:.4s">
                <div class="feat-icon fi-green">📊</div>
                <div class="feat-title">Statistics & Charts</div>
                <div class="feat-desc">Dashboard thống kê chi tiết tiến trình rèn luyện của bạn.</div>
            </div>
        </div>
    </section>

    <section class="how" id="how">
        <div class="how-inner">
            <div class="section-label">Cách hoạt động</div>
            <h2 class="section-title">4 bước đơn giản để bắt đầu.</h2>

            <div class="steps">
                <div class="step" style="animation-delay:.05s">
                    <div class="step-num">1</div>
                    <h4>Đăng ký tài khoản</h4>
                    <p>Tạo profile nhanh chóng và bắt đầu hành trình trong Vương Quốc.</p>
                </div>

                <div class="step" style="animation-delay:.15s">
                    <div class="step-num">2</div>
                    <h4>Chọn Quest phù hợp</h4>
                    <p>Tìm những nhiệm vụ phù hợp với thói quen bạn muốn xây dựng.</p>
                </div>

                <div class="step" style="animation-delay:.25s">
                    <div class="step-num">3</div>
                    <h4>Hoàn thành & nhận thưởng</h4>
                    <p>Tick quest mỗi ngày, nhận XP và duy trì streak.</p>
                </div>

                <div class="step" style="animation-delay:.35s">
                    <div class="step-num">4</div>
                    <h4>Unlock badge & lên level</h4>
                    <p>Mở khóa huy hiệu hiếm và nâng cấp bản thân mỗi ngày.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="preview-section" id="leaderboard">
        <div class="section-label">Leaderboard</div>
        <h2 class="section-title" style="margin:0 auto;text-align:center;max-width:100%">Top người dùng hiện tại</h2>

        @if (Model.TopUsers != null && Model.TopUsers.Count > 0)
        {
            <div class="lb-table">
                <div class="lb-head">
                    <span>#</span>
                    <span>Người dùng</span>
                    <span>XP</span>
                    <span>Badge hiếm nhất</span>
                </div>

                @for (int i = 0; i < Model.TopUsers.Count; i++)
                {
                    var u = Model.TopUsers[i];
                    var rankClass = i == 0 ? "gold" : i == 1 ? "silver" : i == 2 ? "bronze" : "";
                    var rankIcon = i == 0 ? "🥇" : i == 1 ? "🥈" : i == 2 ? "🥉" : (i + 1).ToString();
                    var bgColors = new[] { "#fff5d6", "#edeaf5", "#d4f5ef", "#fde8ed", "#e2f5e2" };
                    var bg = bgColors[i % bgColors.Length];

                    <div class="lb-row" style="animation-delay:@((i * 0.07).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))s">
                        <span class="lb-rank @rankClass">@rankIcon</span>

                        <div class="lb-user">
                            @if (!string.IsNullOrEmpty(u.Avatar) && u.Avatar.StartsWith("http"))
                            {
                                <img src="@u.Avatar" class="lb-avatar" alt="@u.Username" />
                            }
                            else
                            {
                                <div class="lb-avatar" style="background:@bg">
                                    @u.Username.Substring(0, 1).ToUpper()
                                </div>
                            }

                            <div>
                                <div class="lb-name">@u.Username</div>
                                <div class="lb-level">Level @u.Level @(u.CurrentStreak > 0 ? $"· 🔥{u.CurrentStreak} ngày" : "")</div>
                            </div>
                        </div>

                        <span class="lb-xp">@u.XP.ToString("N0")</span>

                        <div class="lb-badge">
                            @if (!string.IsNullOrEmpty(u.TopBadgeName))
                            {
                                <span class="rarity-dot r-@u.TopBadgeRarity"></span>
                                <span>@u.TopBadgeIcon @u.TopBadgeName</span>
                            }
                            else
                            {
                                <span style="color:#ccc">—</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div style="margin-top:24px;">
                <a href="/Account/Leaderboard" class="btn-secondary-hero" style="display:inline-flex;">
                    Xem toàn bộ bảng xếp hạng →
                </a>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:60px;color:#999;background:white;border-radius:20px;margin-top:40px;">
                <div style="font-size:3em;margin-bottom:16px;">🏆</div>
                <p>Chưa có người dùng nào. Hãy là người đầu tiên!</p>
                <a href="/Account/Register" class="btn-primary-hero" style="display:inline-flex;margin-top:20px;">Đăng ký ngay</a>
            </div>
        }
    </section>

    <div class="cta-banner">
        <h2>Sẵn sàng level up<br>cuộc sống của bạn?</h2>
        <p>Tham gia cùng @Model.TotalUsers người dùng — miễn phí, không cần thẻ tín dụng.</p>

        <div class="cta-btn-group">
            <a href="/Account/Register" class="btn-cta-white">🚀 Tạo tài khoản miễn phí</a>
            <a href="/Account/Login" class="btn-cta-ghost">Đã có tài khoản →</a>
        </div>
    </div>

    <footer>
        <span>© 2026 HabitTracker 🚀 · Gamify Your Life</span>
        <div style="display:flex;gap:24px;">
            <a href="/Account/Login">Đăng nhập</a>
            <a href="/Account/Register">Đăng ký</a>
            <a href="/Account/Leaderboard">Leaderboard</a>
        </div>
    </footer>

    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(el => {
                if (el.isIntersecting) {
                    el.target.classList.add("visible");
                    observer.unobserve(el.target);
                }
            });
        }, { threshold: 0.12 });

        document.querySelectorAll(".stat-block, .feat-card, .step, .lb-row")
            .forEach(el => observer.observe(el));

        function countUp(el, target) {
            let start = 0;
            const duration = 1600;

            const step = (ts) => {
                if (!start) start = ts;

                const p = Math.min((ts - start) / duration, 1);
                const e = 1 - Math.pow(1 - p, 3);

                el.textContent = Math.floor(e * target).toLocaleString("vi");

                if (p < 1) requestAnimationFrame(step);
            };

            requestAnimationFrame(step);
        }

        const statsObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.querySelectorAll("[data-target]").forEach(el => {
                        countUp(el, parseInt(el.dataset.target));
                    });

                    statsObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.3 });

        const strip = document.querySelector(".stats-strip");
        if (strip) statsObserver.observe(strip);

        window.addEventListener("scroll", () => {
            const nav = document.getElementById("navbar");
            if (!nav) return;

            nav.style.padding = window.scrollY > 60 ? "8px 16px" : "10px 16px";
        });
    </script>

</body>
</html>