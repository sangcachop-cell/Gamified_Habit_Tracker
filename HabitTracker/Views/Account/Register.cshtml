@model HabitTracker.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký — HabitTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #070711;
            --panel: #10101d;
            --violet: #7c4dff;
            --violet-2: #9b5cff;
            --gold: #ffd166;
            --text: #ffffff;
            --muted: rgba(255,255,255,.62);
            --border: rgba(255,255,255,.12);
            --danger: #fca5a5;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            background: var(--bg);
            color: var(--text);
            font-family: "Be Vietnam Pro", sans-serif;
            overflow-x: hidden;
        }

        .left-panel {
            position: relative;
            min-height: 100vh;
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            background: linear-gradient(90deg, rgba(7,7,17,.9), rgba(7,7,17,.38)), url('/fe/register-illustration.png');
            background-size: cover;
            background-position: center;
            border-right: 1px solid rgba(255,255,255,.08);
        }

            .left-panel::after {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 25% 18%, rgba(124,77,255,.25), transparent 28%), radial-gradient(circle at 20% 88%, rgba(45,226,197,.12), transparent 30%);
                pointer-events: none;
            }

        .brand {
            position: relative;
            z-index: 2;
            color: white;
            text-decoration: none;
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -.5px;
        }

            .brand span {
                color: var(--gold);
            }

        .left-content {
            position: relative;
            z-index: 2;
            max-width: 520px;
        }

            .left-content h1 {
                font-size: clamp(2.1rem, 4vw, 4rem);
                font-weight: 800;
                line-height: 1.12;
                letter-spacing: -1.8px;
                margin-bottom: 18px;
                text-shadow: 0 10px 30px rgba(0,0,0,.45);
            }

                .left-content h1 span {
                    color: #9b7cff;
                }

            .left-content p {
                color: rgba(255,255,255,.78);
                font-size: 1rem;
                line-height: 1.8;
                max-width: 430px;
            }

        .steps-list {
            position: relative;
            z-index: 2;
            display: grid;
            gap: 16px;
            max-width: 430px;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 14px;
            color: rgba(255,255,255,.78);
        }

        .step-dot {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            flex-shrink: 0;
            box-shadow: 0 10px 26px rgba(0,0,0,.2);
        }

        .step-text h5 {
            font-size: .95rem;
            color: white;
            font-weight: 800;
            margin-bottom: 3px;
        }

        .step-text p {
            font-size: .84rem;
            color: rgba(255,255,255,.62);
            margin: 0;
            line-height: 1.5;
        }

        .footer-left {
            position: relative;
            z-index: 2;
            color: rgba(255,255,255,.55);
            font-size: .85rem;
        }

        .right-panel {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 42px 48px;
            background: radial-gradient(circle at 80% 10%, rgba(124,77,255,.16), transparent 28%), radial-gradient(circle at 15% 90%, rgba(255,209,102,.06), transparent 26%), #080814;
            overflow-y: auto;
        }

        .auth-box {
            width: 100%;
            max-width: 560px;
        }

        .back-home {
            display: inline-flex;
            color: rgba(255,255,255,.55);
            text-decoration: none;
            font-size: .86rem;
            margin-bottom: 26px;
            transition: .2s;
        }

            .back-home:hover {
                color: white;
            }

        .auth-box h2 {
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.1;
            margin-bottom: 10px;
        }

            .auth-box h2 span {
                color: var(--violet-2);
            }

        .subtitle {
            color: var(--muted);
            font-size: .98rem;
            margin-bottom: 28px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-field {
            margin-bottom: 18px;
        }

            .form-field label {
                display: block;
                color: white;
                font-size: .88rem;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .form-field input {
                width: 100%;
                height: 56px;
                border-radius: 14px;
                border: 1px solid var(--border);
                background: rgba(255,255,255,.045);
                color: white;
                padding: 0 16px;
                outline: none;
                font-size: .94rem;
                transition: .25s;
            }

                .form-field input:focus {
                    border-color: rgba(124,77,255,.75);
                    box-shadow: 0 0 0 4px rgba(124,77,255,.14);
                    background: rgba(255,255,255,.07);
                }

                .form-field input::placeholder {
                    color: rgba(255,255,255,.36);
                }

        .text-danger {
            display: block;
            color: var(--danger) !important;
            font-size: .78rem;
            margin-top: 6px;
        }

        .avatar-area {
            position: relative;
            border: 1.5px dashed rgba(255,255,255,.18);
            border-radius: 20px;
            padding: 22px;
            text-align: center;
            cursor: pointer;
            transition: .25s;
            margin-bottom: 18px;
            background: rgba(255,255,255,.035);
        }

            .avatar-area:hover {
                border-color: rgba(124,77,255,.65);
                background: rgba(124,77,255,.08);
            }

            .avatar-area input[type=file] {
                position: absolute;
                inset: 0;
                opacity: 0;
                cursor: pointer;
            }

        .avatar-preview-img {
            width: 78px;
            height: 78px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 10px;
            display: block;
            border: 2px solid rgba(255,255,255,.75);
            background: white;
        }

        .avatar-area p {
            font-size: .85rem;
            color: rgba(255,255,255,.62);
            margin: 0;
        }

        .btn-submit {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--violet), #6d28d9);
            color: white;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            transition: .25s;
            box-shadow: 0 16px 36px rgba(124,77,255,.26);
            margin-bottom: 20px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 20px 42px rgba(124,77,255,.36);
            }

        .auth-footer {
            text-align: center;
            color: var(--muted);
            font-size: .9rem;
        }

            .auth-footer a {
                color: #9b7cff;
                text-decoration: none;
                font-weight: 800;
            }

                .auth-footer a:hover {
                    color: white;
                }

        @@media (max-width: 960px) {
            body {
                grid-template-columns: 1fr;
            }

            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 32px 20px;
            }

            .auth-box {
                max-width: 440px;
            }

                .auth-box h2 {
                    font-size: 2.1rem;
                }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
    </style>
</head>

<body>
    <section class="left-panel">
        <a href="/" class="brand">⚔️ Vương Quốc</span></a>

        <div class="left-content">
            <h1>Bắt đầu <span>hành trình</span> của bạn</h1>
            <p>Tạo tài khoản, chọn quest yêu thích, nhận XP và xây dựng phiên bản tốt hơn của chính bạn mỗi ngày.</p>
        </div>

        <div class="steps-list">
            <div class="step-item">
                <div class="step-dot">1</div>
                <div class="step-text">
                    <h5>Tạo tài khoản</h5>
                    <p>Chỉ mất 30 giây, hoàn toàn miễn phí.</p>
                </div>
            </div>

            <div class="step-item">
                <div class="step-dot">2</div>
                <div class="step-text">
                    <h5>Chọn quest yêu thích</h5>
                    <p>Chọn thói quen bạn muốn xây dựng mỗi ngày.</p>
                </div>
            </div>

            <div class="step-item">
                <div class="step-dot">3</div>
                <div class="step-text">
                    <h5>Hoàn thành & nhận XP</h5>
                    <p>Tick quest, duy trì streak và lên level.</p>
                </div>
            </div>

            <div class="step-item">
                <div class="step-dot">4</div>
                <div class="step-text">
                    <h5>Unlock badge & leo rank</h5>
                    <p>Mở khóa huy hiệu và cạnh tranh trên bảng xếp hạng.</p>
                </div>
            </div>
        </div>

        <div class="footer-left">
            © 2026 HabitTracker
        </div>
    </section>

    <section class="right-panel">
        <div class="auth-box">
            <a href="/" class="back-home">← Về trang chủ</a>

            <h2>Tạo tài khoản <span>mới</span></h2>
            <p class="subtitle">Miễn phí mãi mãi — bắt đầu hành trình rèn thói quen ngay hôm nay.</p>

            <form method="post" enctype="multipart/form-data">
                <div class="form-row">
                    <div class="form-field">
                        <label>Tên đăng nhập</label>
                        <input asp-for="Username" placeholder="tennguoidung" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-field">
                        <label>Email</label>
                        <input asp-for="Email" placeholder="ban@email.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-field">
                    <label>Mật khẩu</label>
                    <input asp-for="Password" type="password" placeholder="Ít nhất 6 ký tự" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="avatar-area" onclick="document.getElementById('avatarInput').click()">
                    <img id="preview" src="~/images/default.png" class="avatar-preview-img" alt="Ảnh đại diện" />
                    <p>Chọn ảnh đại diện (tuỳ chọn)</p>
                    <input type="file" id="avatarInput" asp-for="AvatarFile" accept="image/*" onchange="previewImage(event)" />
                </div>

                <button type="submit" class="btn-submit">
                    Tạo tài khoản →
                </button>
            </form>

            <div class="auth-footer">
                Đã có tài khoản?
                <a href="/Account/Login">Đăng nhập</a>
            </div>
        </div>
    </section>

    <script>
        function previewImage(event) {
            const file = event.target.files && event.target.files[0];

            if (!file) return;

            const reader = new FileReader();

            reader.onload = function () {
                document.getElementById("preview").src = reader.result;
            };

            reader.readAsDataURL(file);
        }
    </script>
</body>
</html>