@using HabitTracker.Constants
@using HabitTracker.Models
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Bảng xếp hạng";

    var topXP = ViewBag.TopXP as List<User> ?? new List<User>();
    var topStreak = ViewBag.TopStreak as List<User> ?? new List<User>();
    var currentUserId = Context.Session.GetInt32(AppConstants.SESSION_USER_ID);

    var currentUserXPIndex = currentUserId.HasValue ? topXP.FindIndex(x => x.Id == currentUserId.Value) : -1;
    var currentUserStreakIndex = currentUserId.HasValue ? topStreak.FindIndex(x => x.Id == currentUserId.Value) : -1;
    var currentUser = currentUserXPIndex >= 0 ? topXP[currentUserXPIndex] : null;

    Func<User, string> avatarUrl = u => string.IsNullOrWhiteSpace(u.Avatar)
        ? Url.Content("~/images/default.png")
        : Url.Content("~/images/" + u.Avatar);

    Func<User, string> firstLetter = u => string.IsNullOrWhiteSpace(u.Username)
        ? "?"
        : u.Username.Trim().Substring(0, 1).ToUpper();

    Func<int, string> rankText = i => i == 0 ? "1" : i == 1 ? "2" : i == 2 ? "3" : (i + 1).ToString();
    Func<int, string> medalIcon = i => i == 0 ? "🥇" : i == 1 ? "🥈" : i == 2 ? "🥉" : (i + 1).ToString();
    Func<int, string> rankClass = i => i == 0 ? "rank-gold" : i == 1 ? "rank-silver" : i == 2 ? "rank-bronze" : "";

    var podiumXP = new List<User>();
    if (topXP.Count > 1) { podiumXP.Add(topXP[1]); }
    if (topXP.Count > 0) { podiumXP.Add(topXP[0]); }
    if (topXP.Count > 2) { podiumXP.Add(topXP[2]); }
}

<style>
    body {
        background: #f8fafc !important;
    }

    .leader-page {
        padding: 18px 28px 50px;
        color: #071733;
    }

    .leader-head {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .leader-head-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 14px 28px rgba(124, 58, 237, .22);
    }

    .leader-head h1 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.1;
        font-weight: 950;
        letter-spacing: -.04em;
        color: #071733;
    }

    .leader-head p {
        margin: 6px 0 0;
        color: #64748b;
        font-weight: 700;
    }

    .leader-tabs {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-bottom: 18px;
        margin-bottom: 26px;
        border-bottom: 1px solid #e5e7eb;
    }

    .leader-tab {
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #475569;
        border-radius: 14px;
        padding: 13px 22px;
        font-weight: 950;
        box-shadow: 0 10px 25px rgba(15, 23, 42, .04);
        transition: .18s ease;
    }

    .leader-tab:hover {
        transform: translateY(-1px);
        color: #6d28d9;
        border-color: #c4b5fd;
    }

    .leader-tab.active {
        color: #6d28d9;
        border-color: #8b5cf6;
        background: #fbfaff;
        box-shadow: 0 12px 28px rgba(124, 58, 237, .12);
    }

    .leader-panel {
        display: none;
    }

    .leader-panel.active {
        display: block;
    }

    .podium {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        align-items: end;
        margin: 8px 44px 26px;
    }

    .pod-card {
        position: relative;
        min-height: 250px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 26px 24px;
        text-align: center;
        overflow: hidden;
        text-decoration: none;
        box-shadow: 0 14px 34px rgba(15, 23, 42, .05);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .pod-card::before,
    .pod-card::after {
        content: "";
        position: absolute;
        width: 80px;
        height: 120px;
        bottom: 34px;
        opacity: .36;
        background-repeat: no-repeat;
        background-size: contain;
        pointer-events: none;
    }

    .pod-card::before {
        left: 34px;
        background-image: radial-gradient(ellipse at center, currentColor 0 38%, transparent 40%);
        transform: rotate(-24deg);
        color: #93c5fd;
    }

    .pod-card::after {
        right: 34px;
        background-image: radial-gradient(ellipse at center, currentColor 0 38%, transparent 40%);
        transform: rotate(24deg);
        color: #93c5fd;
    }

    .pod-card.top-1 {
        min-height: 290px;
        border-color: #fbbf24;
        background: linear-gradient(180deg, #fffbeb, #fff);
    }

    .pod-card.top-1::before,
    .pod-card.top-1::after {
        color: #f59e0b;
    }

    .pod-card.top-2 {
        background: linear-gradient(180deg, #f8fbff, #fff);
    }

    .pod-card.top-3 {
        background: linear-gradient(180deg, #fff7f3, #fff);
    }

    .pod-card.top-3::before,
    .pod-card.top-3::after {
        color: #fb7185;
    }

    .pod-rank {
        position: absolute;
        top: 18px;
        left: 28px;
        width: 44px;
        height: 44px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        font-weight: 950;
        color: #fff;
        background: #60a5fa;
        box-shadow: 0 8px 18px rgba(96, 165, 250, .25);
    }

    .top-1 .pod-rank {
        left: 50%;
        transform: translateX(-50%);
        top: 16px;
        background: #f59e0b;
        box-shadow: 0 8px 18px rgba(245, 158, 11, .28);
    }

    .top-3 .pod-rank {
        background: #f43f5e;
        box-shadow: 0 8px 18px rgba(244, 63, 94, .22);
    }

    .pod-avatar {
        width: 86px;
        height: 86px;
        border-radius: 999px;
        object-fit: cover;
        background: #ede9fe;
        border: 3px solid #60a5fa;
        box-shadow: 0 12px 24px rgba(15, 23, 42, .10);
        margin-top: 16px;
        z-index: 2;
    }

    .top-1 .pod-avatar {
        width: 92px;
        height: 92px;
        border-color: #f59e0b;
        margin-top: 34px;
    }

    .top-3 .pod-avatar {
        border-color: #fb7185;
    }

    .pod-fallback {
        display: none;
        align-items: center;
        justify-content: center;
        color: #6d28d9;
        font-weight: 950;
        font-size: 1.8rem;
    }

    .pod-name {
        margin-top: 14px;
        color: #071733;
        font-size: 1.1rem;
        font-weight: 950;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        z-index: 2;
    }

    .level-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 13px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 950;
        background: #dbeafe;
        color: #2563eb;
        margin-top: 10px;
        z-index: 2;
    }

    .top-1 .level-pill {
        background: #fef3c7;
        color: #d97706;
    }

    .top-3 .level-pill {
        background: #ffe4e6;
        color: #e11d48;
    }

    .pod-score {
        margin-top: 14px;
        font-size: 1.45rem;
        font-weight: 950;
        color: #2563eb;
        z-index: 2;
    }

    .top-1 .pod-score {
        color: #f59e0b;
        font-size: 1.7rem;
    }

    .top-3 .pod-score {
        color: #f43f5e;
    }

    .leader-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 22px;
        align-items: start;
    }

    .leader-table-card,
    .my-stat-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        box-shadow: 0 14px 34px rgba(15, 23, 42, .05);
        overflow: hidden;
    }

    .leader-table {
        width: 100%;
        border-collapse: collapse;
    }

    .leader-table th {
        text-align: left;
        color: #475569;
        font-size: .86rem;
        font-weight: 950;
        padding: 20px 22px 14px;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .leader-table td {
        padding: 14px 22px;
        border-bottom: 1px solid #eef2f7;
        color: #1e293b;
        font-weight: 800;
        vertical-align: middle;
    }

    .leader-table tr:last-child td {
        border-bottom: none;
    }

    .leader-table tr.me td {
        background: #f3e8ff;
        color: #6d28d9;
        font-weight: 950;
    }

    .table-rank {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #475569;
        font-weight: 950;
    }

    .table-rank.rank-gold {
        background: #fef3c7;
        color: #d97706;
    }

    .table-rank.rank-silver {
        background: #e2e8f0;
        color: #64748b;
    }

    .table-rank.rank-bronze {
        background: #fed7aa;
        color: #c2410c;
    }

    .table-user {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .table-avatar {
        width: 42px;
        height: 42px;
        border-radius: 999px;
        object-fit: cover;
        background: #ede9fe;
        flex-shrink: 0;
    }

    .table-fallback {
        display: none;
        align-items: center;
        justify-content: center;
        color: #6d28d9;
        font-weight: 950;
    }

    .table-name {
        text-decoration: none;
        color: #071733;
        font-weight: 950;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .me .table-name {
        color: #6d28d9;
    }

    .table-level {
        display: inline-flex;
        padding: 6px 13px;
        border-radius: 999px;
        background: #fef3c7;
        color: #d97706;
        font-weight: 950;
        font-size: .82rem;
    }

    .table-xp {
        color: #334155;
        font-weight: 950;
        white-space: nowrap;
    }

    .me .table-xp {
        color: #6d28d9;
    }

    .table-streak {
        color: #334155;
        font-weight: 950;
        white-space: nowrap;
    }

    .my-stat-card {
        padding: 24px;
    }

    .my-stat-title {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #6d28d9;
        font-size: 1.15rem;
        font-weight: 950;
        padding-bottom: 18px;
        border-bottom: 1px solid #e2e8f0;
    }

    .my-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 22px 0;
    }

    .my-avatar {
        width: 70px;
        height: 70px;
        border-radius: 999px;
        object-fit: cover;
        border: 2px solid #8b5cf6;
        background: #ede9fe;
    }

    .my-name {
        font-size: 1.08rem;
        color: #071733;
        font-weight: 950;
    }

    .my-desc {
        margin-top: 5px;
        color: #64748b;
        font-weight: 700;
        font-size: .92rem;
    }

    .my-list {
        display: grid;
        gap: 14px;
    }

    .my-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
        color: #475569;
        font-weight: 850;
    }

    .my-row strong {
        color: #0f172a;
        font-weight: 950;
    }

    .my-note {
        margin-top: 24px;
        display: flex;
        gap: 13px;
        align-items: center;
        border-radius: 16px;
        background: #f3e8ff;
        color: #6d28d9;
        padding: 16px;
        font-weight: 850;
    }

    .empty-leader {
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 52px 20px;
        text-align: center;
        color: #94a3b8;
        font-weight: 800;
    }

    .empty-leader strong {
        display: block;
        color: #071733;
        font-size: 1.18rem;
        margin-bottom: 6px;
    }

    @@media (max-width: 1200px) {
        .podium {
            margin-left: 0;
            margin-right: 0;
        }

        .leader-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 850px) {
        .leader-page {
            padding: 14px 14px 40px;
        }

        .podium {
            grid-template-columns: 1fr;
        }

        .pod-card,
        .pod-card.top-1 {
            min-height: 230px;
        }

        .leader-table-card {
            overflow-x: auto;
        }

        .leader-table {
            min-width: 720px;
        }
    }

    @@media (max-width: 560px) {
        .leader-head {
            align-items: flex-start;
        }

        .leader-head h1 {
            font-size: 1.65rem;
        }

        .leader-tabs {
            display: grid;
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="leader-page">

    <div class="leader-tabs" role="tablist" aria-label="Leaderboard tabs">
        <button type="button" class="leader-tab active" onclick="switchLeaderboardTab('xp', this)">⭐ Top XP (Tất cả thời gian)</button>
        <button type="button" class="leader-tab" onclick="switchLeaderboardTab('streak', this)">🔥 Top Streak (Hiện tại)</button>
    </div>

    <section id="panel-xp" class="leader-panel active">
        @if (topXP.Any())
        {
            if (podiumXP.Any())
            {
                <div class="podium">
                    @foreach (var u in podiumXP)
                    {
                        var realIndex = topXP.FindIndex(x => x.Id == u.Id);
                        <a asp-controller="Friend" asp-action="ViewProfile" asp-route-id="@u.Id" class="pod-card top-@(realIndex + 1)">
                            <div class="pod-rank">@rankText(realIndex)</div>
                            <img class="pod-avatar" src="@avatarUrl(u)" alt="@u.Username" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="pod-avatar pod-fallback">@firstLetter(u)</div>
                            <div class="pod-name">@u.Username</div>
                            <div class="level-pill">Level @u.Level</div>
                            <div class="pod-score">@u.XP.ToString("N0") XP</div>
                        </a>
                    }
                </div>
            }

            <div class="leader-layout">
                <div class="leader-table-card">
                    <table class="leader-table">
                        <thead>
                            <tr>
                                <th style="width:86px;">#</th>
                                <th>Người chơi</th>
                                <th>Level</th>
                                <th>XP</th>
                                <th>Streak hiện tại 🔥</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < topXP.Count; i++)
                            {
                                var u = topXP[i];
                                var isMe = currentUserId.HasValue && currentUserId.Value == u.Id;
                                <tr class="@(isMe ? "me" : "")">
                                    <td><span class="table-rank @rankClass(i)">@medalIcon(i)</span></td>
                                    <td>
                                        <div class="table-user">
                                            <img class="table-avatar" src="@avatarUrl(u)" alt="@u.Username" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                            <div class="table-avatar table-fallback">@firstLetter(u)</div>
                                            <a asp-controller="Friend" asp-action="ViewProfile" asp-route-id="@u.Id" class="table-name">@u.Username @(isMe ? "(Demo User)" : "")</a>
                                        </div>
                                    </td>
                                    <td><span class="table-level">Level @u.Level</span></td>
                                    <td class="table-xp">@u.XP.ToString("N0") XP</td>
                                    <td class="table-streak">@u.CurrentStreak ngày 🔥</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <aside class="my-stat-card">
                    <div class="my-stat-title">👤 Thông tin của bạn</div>
                    @if (currentUser != null)
                    {
                        <div class="my-profile">
                            <img class="my-avatar" src="@avatarUrl(currentUser)" alt="@currentUser.Username" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="my-avatar table-fallback">@firstLetter(currentUser)</div>
                            <div>
                                <div class="my-name">@currentUser.Username <span class="table-level">Level @currentUser.Level</span></div>
                                <div class="my-desc">Đang trên đà tiến bộ! 🚀</div>
                            </div>
                        </div>

                        <div class="my-list">
                            <div class="my-row"><span>⭐ Tổng XP</span><strong>@currentUser.XP.ToString("N0")</strong></div>
                            <div class="my-row"><span>🔥 Streak hiện tại</span><strong>@currentUser.CurrentStreak ngày</strong></div>
                            <div class="my-row"><span>🏆 Hạng (XP)</span><strong>@(currentUserXPIndex >= 0 ? (currentUserXPIndex + 1).ToString() : "-")</strong></div>
                            <div class="my-row"><span>🔥 Hạng (Streak)</span><strong>@(currentUserStreakIndex >= 0 ? (currentUserStreakIndex + 1).ToString() : "-")</strong></div>
                        </div>
                    }
                    else
                    {
                        <div class="my-note">Bạn chưa có trong bảng xếp hạng. Hãy hoàn thành nhiệm vụ để leo top nhé!</div>
                    }
                    <div class="my-note">🏆 Cố gắng duy trì thói quen và leo top nhé!</div>
                </aside>
            </div>
        }
        else
        {
            <div class="empty-leader"><strong>Chưa có dữ liệu xếp hạng</strong>Hãy hoàn thành nhiệm vụ để xuất hiện trên bảng xếp hạng.</div>
        }
    </section>

    <section id="panel-streak" class="leader-panel">
        @if (topStreak.Any())
        {
            <div class="leader-layout">
                <div class="leader-table-card">
                    <table class="leader-table">
                        <thead>
                            <tr>
                                <th style="width:86px;">#</th>
                                <th>Người chơi</th>
                                <th>Level</th>
                                <th>XP</th>
                                <th>Streak hiện tại 🔥</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < topStreak.Count; i++)
                            {
                                var u = topStreak[i];
                                var isMe = currentUserId.HasValue && currentUserId.Value == u.Id;
                                <tr class="@(isMe ? "me" : "")">
                                    <td><span class="table-rank @rankClass(i)">@medalIcon(i)</span></td>
                                    <td>
                                        <div class="table-user">
                                            <img class="table-avatar" src="@avatarUrl(u)" alt="@u.Username" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                            <div class="table-avatar table-fallback">@firstLetter(u)</div>
                                            <a asp-controller="Friend" asp-action="ViewProfile" asp-route-id="@u.Id" class="table-name">@u.Username @(isMe ? "(Bạn)" : "")</a>
                                        </div>
                                    </td>
                                    <td><span class="table-level">Level @u.Level</span></td>
                                    <td class="table-xp">@u.XP.ToString("N0") XP</td>
                                    <td class="table-streak">@u.CurrentStreak ngày 🔥</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <aside class="my-stat-card">
                    <div class="my-stat-title">🔥 Xếp hạng Streak</div>
                    <div class="my-note">Hoàn thành nhiệm vụ mỗi ngày để giữ streak và tăng thứ hạng.</div>
                    @if (currentUser != null)
                    {
                        <div class="my-list" style="margin-top:18px;">
                            <div class="my-row"><span>🔥 Streak của bạn</span><strong>@currentUser.CurrentStreak ngày</strong></div>
                            <div class="my-row"><span>🏆 Hạng Streak</span><strong>@(currentUserStreakIndex >= 0 ? (currentUserStreakIndex + 1).ToString() : "-")</strong></div>
                            <div class="my-row"><span>⭐ Tổng XP</span><strong>@currentUser.XP.ToString("N0")</strong></div>
                        </div>
                    }
                </aside>
            </div>
        }
        else
        {
            <div class="empty-leader"><strong>Chưa có dữ liệu streak</strong>Hoàn thành nhiệm vụ hằng ngày để tạo chuỗi streak.</div>
        }
    </section>
</div>

@section Scripts {
    <script>
        function switchLeaderboardTab(id, btn) {
            document.querySelectorAll('.leader-panel').forEach(function (panel) {
                panel.classList.remove('active');
            });

            document.querySelectorAll('.leader-tab').forEach(function (tab) {
                tab.classList.remove('active');
            });

            document.getElementById('panel-' + id).classList.add('active');
            btn.classList.add('active');
        }
    </script>
}
