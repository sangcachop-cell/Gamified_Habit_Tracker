@{
    ViewData["Title"] = "Leaderboard";
    var topXP = ViewBag.TopXP as List<HabitTracker.Models.User>;
    var topStreak = ViewBag.TopStreak as List<HabitTracker.Models.User>;

    var xpCount = topXP?.Count ?? 0;
    var streakCount = topStreak?.Count ?? 0;
    var bestXp = topXP != null && topXP.Count > 0 ? topXP[0] : null;
    var bestStreak = topStreak != null && topStreak.Count > 0 ? topStreak[0] : null;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

    :root {
        --page-bg: #f6f1e8;
        --card-bg: #ffffff;
        --text-main: #24211f;
        --text-muted: #766f68;
        --border: #e8dfd2;
        --primary: #7c5cff;
        --primary-dark: #4f35c8;
        --primary-soft: #f0ecff;
        --gold: #d89b21;
        --gold-soft: #fff6dd;
        --danger: #e25563;
        --danger-soft: #fff0f2;
        --success: #0f9f83;
        --success-soft: #e9fbf6;
        --shadow: 0 16px 34px rgba(61, 47, 33, .08);
        --radius-lg: 24px;
        --radius-md: 18px;
        --radius-sm: 14px;
    }

    body {
        background: var(--page-bg);
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .leaderboard-page {
        padding: 10px 0 48px;
        color: var(--text-main);
    }

    .leaderboard-hero {
        background: linear-gradient(135deg, #ffffff 0%, #fbf7ef 100%);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        margin-bottom: 18px;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

        .leaderboard-hero::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(124, 92, 255, .16), transparent 68%);
            right: -90px;
            top: -110px;
            pointer-events: none;
        }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 20px;
        align-items: center;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary-soft);
        color: var(--primary-dark);
        border: 1px solid rgba(124, 92, 255, .18);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: .78rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .leaderboard-title {
        margin: 0;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        font-weight: 900;
        letter-spacing: -.04em;
        color: var(--text-main);
        line-height: 1.05;
    }

    .leaderboard-subtitle {
        margin: 10px 0 0;
        color: var(--text-muted);
        font-size: .96rem;
        line-height: 1.55;
        max-width: 620px;
    }

    .hero-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(138px, 1fr));
        gap: 10px;
        min-width: 300px;
    }

    .stat-card {
        background: rgba(255, 255, 255, .78);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 14px;
        box-shadow: 0 10px 24px rgba(61, 47, 33, .045);
    }

    .stat-label {
        font-size: .76rem;
        color: var(--text-muted);
        font-weight: 800;
        margin-bottom: 7px;
    }

    .stat-value {
        font-size: 1.35rem;
        font-weight: 900;
        letter-spacing: -.03em;
        color: var(--text-main);
    }

    .leaderboard-tabs-wrap {
        display: flex;
        justify-content: center;
        margin: 18px 0;
    }

    .leaderboard-tabs {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 6px;
        display: flex;
        gap: 6px;
        box-shadow: 0 10px 22px rgba(61, 47, 33, .06);
    }

    .lb-tab {
        border: 0;
        background: transparent;
        color: var(--text-muted);
        border-radius: 999px;
        padding: 10px 20px;
        font-weight: 900;
        font-size: .9rem;
        cursor: pointer;
        transition: background .15s, color .15s, transform .15s;
    }

        .lb-tab:hover {
            background: #f8f3eb;
            color: var(--text-main);
        }

        .lb-tab.active {
            background: var(--text-main);
            color: #fff;
            box-shadow: 0 8px 16px rgba(36, 33, 31, .15);
        }

    .lb-panel {
        display: none;
    }

        .lb-panel.active {
            display: block;
        }

    .top-three {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .top-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 16px;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 104px;
        transition: transform .15s, box-shadow .15s;
    }

        .top-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 38px rgba(61, 47, 33, .11);
        }

        .top-card.first {
            border-color: rgba(216, 155, 33, .38);
            background: linear-gradient(135deg, #fff7df, #ffffff 72%);
        }

        .top-card.second {
            background: linear-gradient(135deg, #f7f7f7, #ffffff 72%);
        }

        .top-card.third {
            background: linear-gradient(135deg, #fff0df, #ffffff 72%);
        }

    .rank-medal {
        width: 50px;
        height: 50px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        background: rgba(255, 255, 255, .72);
        border: 1px solid rgba(232, 223, 210, .9);
        flex-shrink: 0;
    }

    .top-info {
        min-width: 0;
    }

    .top-name {
        font-size: .98rem;
        font-weight: 900;
        color: var(--text-main);
        text-decoration: none;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .top-name:hover {
            color: var(--primary-dark);
        }

    .top-value {
        margin-top: 5px;
        font-size: .84rem;
        color: var(--text-muted);
        font-weight: 700;
        line-height: 1.35;
    }

    .lb-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .lb-row {
        display: grid;
        grid-template-columns: 74px minmax(0, 1fr) 126px 106px;
        align-items: center;
        gap: 12px;
        padding: 15px 18px;
        border-bottom: 1px solid #f1e9de;
    }

        .lb-row:last-child {
            border-bottom: 0;
        }

        .lb-row:not(.lb-head):hover {
            background: #fffaf3;
        }

    .lb-head {
        background: #fbf6ee;
        color: var(--text-muted);
        font-size: .74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .06em;
        padding-top: 13px;
        padding-bottom: 13px;
    }

    .rank {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        color: #9b948c;
        background: #f8f3eb;
        border: 1px solid var(--border);
    }

        .rank.gold {
            color: var(--gold);
            background: var(--gold-soft);
        }

        .rank.silver {
            color: #7b818a;
            background: #f5f6f7;
        }

        .rank.bronze {
            color: #b06b29;
            background: #fff0df;
        }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 15px;
        background: var(--primary-soft);
        color: var(--primary-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        flex-shrink: 0;
        border: 1px solid rgba(124, 92, 255, .14);
    }

    .user-meta {
        min-width: 0;
    }

    .user-name {
        color: var(--text-main);
        text-decoration: none;
        font-weight: 900;
        font-size: .94rem;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .user-name:hover {
            color: var(--primary-dark);
        }

    .user-small {
        color: var(--text-muted);
        font-size: .78rem;
        margin-top: 3px;
    }

    .value-xp,
    .value-streak,
    .value-level {
        font-weight: 900;
        font-size: .92rem;
        white-space: nowrap;
    }

    .value-xp {
        color: var(--primary-dark);
        background: var(--primary-soft);
        border-radius: 999px;
        padding: 7px 10px;
        width: fit-content;
    }

    .value-streak {
        color: var(--danger);
        background: var(--danger-soft);
        border-radius: 999px;
        padding: 7px 10px;
        width: fit-content;
    }

    .value-level {
        color: var(--text-main);
    }

    .empty-state {
        background: #fff;
        border: 1px dashed #d8cdbd;
        border-radius: var(--radius-lg);
        padding: 52px 20px;
        text-align: center;
        color: var(--text-muted);
        box-shadow: var(--shadow);
        font-weight: 700;
    }

    .empty-icon {
        font-size: 2.3rem;
        margin-bottom: 10px;
    }

    @@media (max-width: 900px) {
        .hero-inner {
            grid-template-columns: 1fr;
        }

        .hero-stats {
            min-width: 0;
        }

        .top-three {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 680px) {
        .leaderboard-hero {
            padding: 18px;
            border-radius: 20px;
        }

        .hero-stats {
            grid-template-columns: 1fr;
        }

        .leaderboard-tabs {
            width: 100%;
            border-radius: 18px;
        }

        .lb-tab {
            flex: 1;
            padding-left: 10px;
            padding-right: 10px;
        }

        .lb-row {
            grid-template-columns: 48px minmax(0, 1fr) 96px;
            padding: 13px 12px;
        }

        .col-extra {
            display: none;
        }

        .rank {
            width: 34px;
            height: 34px;
            border-radius: 12px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 13px;
        }
    }
</style>

<div class="leaderboard-page">

    <div class="leaderboard-hero">
        <div class="hero-inner">
            <div>
                <div class="eyebrow">🏆 Bảng xếp hạng cộng đồng</div>
                <h1 class="leaderboard-title">Theo dõi người dùng nổi bật</h1>
                <p class="leaderboard-subtitle">
                    Xem ai đang có nhiều XP nhất và ai đang giữ chuỗi ngày tốt nhất. Giao diện được làm gọn hơn để dễ nhìn và dễ sử dụng.
                </p>
            </div>

            <div class="hero-stats">
                <div class="stat-card">
                    <div class="stat-label">⚡ Người trong Top XP</div>
                    <div class="stat-value">@xpCount</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">🔥 Người trong Top Streak</div>
                    <div class="stat-value">@streakCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="leaderboard-tabs-wrap">
        <div class="leaderboard-tabs">
            <button type="button" class="lb-tab active" onclick="switchTab('xp', this)">⚡ Top XP</button>
            <button type="button" class="lb-tab" onclick="switchTab('streak', this)">🔥 Top Streak</button>
        </div>
    </div>

    <div id="panel-xp" class="lb-panel active">
        @if (topXP != null && topXP.Count > 0)
        {
            @if (topXP.Count >= 3)
            {
                <div class="top-three">
                    <div class="top-card first">
                        <div class="rank-medal">🥇</div>
                        <div class="top-info">
                            <a href="/Friend/ViewProfile/@topXP[0].Id" class="top-name">@topXP[0].Username</a>
                            <div class="top-value">@topXP[0].XP.ToString("N0") XP • Level @topXP[0].Level</div>
                        </div>
                    </div>

                    <div class="top-card second">
                        <div class="rank-medal">🥈</div>
                        <div class="top-info">
                            <a href="/Friend/ViewProfile/@topXP[1].Id" class="top-name">@topXP[1].Username</a>
                            <div class="top-value">@topXP[1].XP.ToString("N0") XP • Level @topXP[1].Level</div>
                        </div>
                    </div>

                    <div class="top-card third">
                        <div class="rank-medal">🥉</div>
                        <div class="top-info">
                            <a href="/Friend/ViewProfile/@topXP[2].Id" class="top-name">@topXP[2].Username</a>
                            <div class="top-value">@topXP[2].XP.ToString("N0") XP • Level @topXP[2].Level</div>
                        </div>
                    </div>
                </div>
            }

            <div class="lb-card">
                <div class="lb-row lb-head">
                    <span>Hạng</span>
                    <span>Người dùng</span>
                    <span>XP</span>
                    <span class="col-extra">Level</span>
                </div>

                @for (int i = 0; i < topXP.Count; i++)
                {
                    var u = topXP[i];
                    var rankClass = i == 0 ? "gold" : i == 1 ? "silver" : i == 2 ? "bronze" : "";
                    var rankText = i == 0 ? "🥇" : i == 1 ? "🥈" : i == 2 ? "🥉" : (i + 1).ToString();
                    var initial = !string.IsNullOrWhiteSpace(u.Username) ? u.Username.Substring(0, 1).ToUpper() : "?";

                    <div class="lb-row">
                        <span class="rank @rankClass">@rankText</span>

                        <div class="user-cell">
                            <div class="avatar">@initial</div>
                            <div class="user-meta">
                                <a href="/Friend/ViewProfile/@u.Id" class="user-name">@u.Username</a>
                                <div class="user-small">@(u.CurrentStreak > 0 ? $"🔥 {u.CurrentStreak} ngày liên tiếp" : "Chưa có streak")</div>
                            </div>
                        </div>

                        <span class="value-xp">@u.XP.ToString("N0")</span>
                        <span class="value-level col-extra">Lv.@u.Level</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <div>Chưa có dữ liệu xếp hạng XP.</div>
            </div>
        }
    </div>

    <div id="panel-streak" class="lb-panel">
        @if (topStreak != null && topStreak.Count > 0)
        {
            @if (topStreak.Count >= 3)
            {
                <div class="top-three">
                    <div class="top-card first">
                        <div class="rank-medal">🥇</div>
                        <div class="top-info">
                            <a href="/Friend/ViewProfile/@topStreak[0].Id" class="top-name">@topStreak[0].Username</a>
                            <div class="top-value">🔥 @topStreak[0].CurrentStreak ngày • @topStreak[0].XP.ToString("N0") XP</div>
                        </div>
                    </div>

                    <div class="top-card second">
                        <div class="rank-medal">🥈</div>
                        <div class="top-info">
                            <a href="/Friend/ViewProfile/@topStreak[1].Id" class="top-name">@topStreak[1].Username</a>
                            <div class="top-value">🔥 @topStreak[1].CurrentStreak ngày • @topStreak[1].XP.ToString("N0") XP</div>
                        </div>
                    </div>

                    <div class="top-card third">
                        <div class="rank-medal">🥉</div>
                        <div class="top-info">
                            <a href="/Friend/ViewProfile/@topStreak[2].Id" class="top-name">@topStreak[2].Username</a>
                            <div class="top-value">🔥 @topStreak[2].CurrentStreak ngày • @topStreak[2].XP.ToString("N0") XP</div>
                        </div>
                    </div>
                </div>
            }

            <div class="lb-card">
                <div class="lb-row lb-head">
                    <span>Hạng</span>
                    <span>Người dùng</span>
                    <span>Streak</span>
                    <span class="col-extra">XP</span>
                </div>

                @for (int i = 0; i < topStreak.Count; i++)
                {
                    var u = topStreak[i];
                    var rankClass = i == 0 ? "gold" : i == 1 ? "silver" : i == 2 ? "bronze" : "";
                    var rankText = i == 0 ? "🥇" : i == 1 ? "🥈" : i == 2 ? "🥉" : (i + 1).ToString();
                    var initial = !string.IsNullOrWhiteSpace(u.Username) ? u.Username.Substring(0, 1).ToUpper() : "?";

                    <div class="lb-row">
                        <span class="rank @rankClass">@rankText</span>

                        <div class="user-cell">
                            <div class="avatar">@initial</div>
                            <div class="user-meta">
                                <a href="/Friend/ViewProfile/@u.Id" class="user-name">@u.Username</a>
                                <div class="user-small">Level @u.Level</div>
                            </div>
                        </div>

                        <span class="value-streak">🔥 @u.CurrentStreak</span>
                        <span class="value-xp col-extra">@u.XP.ToString("N0")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <div>Chưa có dữ liệu xếp hạng streak.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(id, btn) {
            document.querySelectorAll(".lb-panel").forEach(function (panel) {
                panel.classList.remove("active");
            });

            document.querySelectorAll(".lb-tab").forEach(function (tab) {
                tab.classList.remove("active");
            });

            document.getElementById("panel-" + id).classList.add("active");
            btn.classList.add("active");
        }
    </script>
}
