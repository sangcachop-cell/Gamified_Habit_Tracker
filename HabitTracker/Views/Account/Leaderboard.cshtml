@{
    ViewData["Title"] = "Leaderboard";
    Layout = null;

    var topXP = ViewBag.TopXP as List<HabitTracker.Models.User>
                ?? new List<HabitTracker.Models.User>();

    var topStreak = ViewBag.TopStreak as List<HabitTracker.Models.User>
                    ?? new List<HabitTracker.Models.User>();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bảng xếp hạng</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Cinzel:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #070711;
            --panel: #121020;
            --violet: #7c4dff;
            --violet2: #9b7cff;
            --gold: #ffd166;
            --border: rgba(255,255,255,.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: white;
            font-family: 'Be Vietnam Pro', sans-serif;
            overflow-x: hidden;
        }

        .topbar {
            height: 78px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 0 28px;
            background: rgba(8,8,18,.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 220px;
            height: 64px;
            padding: 8px 16px;
            border-radius: 18px;
            color: white;
            text-decoration: none;
            background: linear-gradient(135deg, rgba(124,77,255,.22), rgba(8,8,18,.78));
            border: 1px solid rgba(168,85,247,.45);
            box-shadow: 0 0 22px rgba(124,77,255,.28), inset 0 0 18px rgba(255,255,255,.04);
            transition: .25s;
            white-space: nowrap;
        }

            .brand:hover {
                transform: translateY(-2px);
                color: white;
                border-color: rgba(168,85,247,.75);
                box-shadow: 0 0 30px rgba(124,77,255,.38), inset 0 0 20px rgba(255,255,255,.05);
            }

        .brand-logo {
            width: 58px;
            height: 58px;
            object-fit: contain;
            flex-shrink: 0;
            filter: drop-shadow(0 0 8px rgba(168,85,247,.7)) drop-shadow(0 0 22px rgba(124,77,255,.45));
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

            .brand-text span {
                font-family: "Cinzel", serif;
                font-size: 1rem;
                font-weight: 700;
                color: #f8fafc;
                letter-spacing: .6px;
            }

            .brand-text strong {
                margin-top: 2px;
                font-family: "Cinzel", serif;
                font-size: 1.65rem;
                font-weight: 800;
                color: #facc15;
                letter-spacing: .8px;
                text-shadow: 0 0 10px rgba(250,204,21,.5), 0 0 24px rgba(168,85,247,.35);
            }

        .top-nav {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
        }

            .top-nav a {
                color: rgba(255,255,255,.66);
                text-decoration: none;
                padding: 10px 13px;
                border-radius: 14px;
                font-size: .84rem;
                font-weight: 800;
                transition: .2s;
                white-space: nowrap;
            }

                .top-nav a:hover,
                .top-nav a.active {
                    color: white;
                    background: rgba(124,77,255,.18);
                }

        .top-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: white;
        }

        .level-chip {
            color: var(--gold);
            font-weight: 900;
        }

        .layout {
            display: grid;
            grid-template-columns: 260px 1fr;
            padding-top: 78px;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            top: 78px;
            left: 0;
            bottom: 0;
            width: 260px;
            padding: 22px 16px;
            background: radial-gradient(circle at 20% 0%,rgba(124,77,255,.2),transparent 34%), #080814;
            border-right: 1px solid var(--border);
            overflow-y: auto;
        }

        .side-title {
            font-size: .72rem;
            color: rgba(255,255,255,.36);
            text-transform: uppercase;
            letter-spacing: 1.8px;
            margin: 18px 12px 8px;
            font-weight: 900;
        }

        .side-menu {
            display: grid;
            gap: 8px;
        }

            .side-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border-radius: 15px;
                color: rgba(255,255,255,.68);
                text-decoration: none;
                font-size: .9rem;
                font-weight: 800;
                transition: .2s;
            }

                .side-menu a:hover,
                .side-menu a.active {
                    color: white;
                    background: rgba(124,77,255,.18);
                    box-shadow: inset 0 0 0 1px rgba(124,77,255,.28);
                }

        .side-card {
            margin-top: 24px;
            padding: 18px;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(124,77,255,.2), rgba(255,209,102,.08));
            border: 1px solid rgba(255,255,255,.1);
        }

            .side-card h4 {
                font-size: .9rem;
                font-weight: 800;
                color: var(--gold);
                margin-bottom: 8px;
            }

            .side-card p {
                color: rgba(255,255,255,.58);
                font-size: .78rem;
                line-height: 1.6;
                margin-bottom: 14px;
            }

            .side-card a {
                display: block;
                text-align: center;
                padding: 10px 14px;
                border-radius: 14px;
                background: linear-gradient(135deg, var(--violet), #6d28d9);
                color: white;
                text-decoration: none;
                font-size: .82rem;
                font-weight: 800;
            }

        .main {
            grid-column: 2;
            padding: 28px;
            background: radial-gradient(circle at 90% 0%,rgba(124,77,255,.15),transparent 34%), radial-gradient(circle at 20% 100%,rgba(45,226,197,.07),transparent 30%), var(--bg);
        }

        .rank-hero {
            position: relative;
            overflow: hidden;
            border-radius: 32px;
            min-height: 290px;
            padding: 50px;
            margin-bottom: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,.12);
            background-image: url('/fe/leaderboard/leaderboard-banner.png');
            background-size: cover;
            background-position: center;
            box-shadow: 0 20px 80px rgba(0,0,0,.45), inset 0 0 120px rgba(0,0,0,.35);
        }

            .rank-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(4,4,12,.72), rgba(4,4,12,.36), rgba(4,4,12,.72));
                backdrop-filter: blur(1px);
            }

            .rank-hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at center, rgba(124,77,255,.18), transparent 55%);
            }

        .hero-copy {
            position: relative;
            z-index: 5;
            text-align: center;
            max-width: 900px;
        }

            .hero-copy h1 {
                font-size: clamp(3rem,6vw,5.5rem);
                font-weight: 900;
                line-height: 1;
                letter-spacing: -4px;
                margin-bottom: 18px;
                color: white;
                text-transform: uppercase;
                text-shadow: 0 8px 30px rgba(0,0,0,.75), 0 0 40px rgba(124,77,255,.25);
            }

            .hero-copy p {
                font-size: 1.25rem;
                font-weight: 700;
                color: rgba(255,255,255,.88);
                text-shadow: 0 4px 18px rgba(0,0,0,.7);
            }

        .rank-tabs-wrap {
            display: flex;
            justify-content: center;
            margin-bottom: 28px;
        }

        .rank-tabs {
            display: flex;
            padding: 6px;
            border-radius: 18px;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
        }

        .rank-tab {
            border: 0;
            padding: 14px 34px;
            border-radius: 14px;
            background: transparent;
            color: rgba(255,255,255,.58);
            font-weight: 900;
            cursor: pointer;
            transition: .2s;
        }

            .rank-tab.active {
                color: white;
                background: linear-gradient(135deg,var(--violet),#6d28d9);
                box-shadow: 0 12px 30px rgba(124,77,255,.3);
            }

        .rank-panel {
            display: none;
        }

            .rank-panel.active {
                display: block;
            }

        .lb-table {
            background: linear-gradient(135deg, rgba(255,255,255,.045), rgba(124,77,255,.055));
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 20px 70px rgba(0,0,0,.35);
        }

        .lb-row {
            display: grid;
            grid-template-columns: 76px 1fr 150px 150px;
            align-items: center;
            gap: 12px;
            padding: 20px 28px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

            .lb-row:hover {
                background: rgba(124,77,255,.08);
            }

        .lb-head {
            background: rgba(255,255,255,.04);
            color: rgba(255,255,255,.45);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: .8rem;
            font-weight: 900;
        }

        .rank-badge {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-weight: 900;
            background: rgba(255,255,255,.07);
        }

            .rank-badge.gold {
                background: linear-gradient(135deg,#ffe08a,#ff9f1c);
                color: #4a2a00;
            }

            .rank-badge.silver {
                background: linear-gradient(135deg,#f8fafc,#94a3b8);
                color: #1f2937;
            }

            .rank-badge.bronze {
                background: linear-gradient(135deg,#f7b267,#9c4f1b);
            }

        .user-box {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-av {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #fff5d6;
            color: #b78c33;
            font-size: 1.35rem;
            font-weight: 900;
        }

        .user-name {
            color: white;
            text-decoration: none;
            font-weight: 900;
            font-size: 1rem;
        }

            .user-name:hover {
                color: var(--gold);
            }

        .user-sub {
            margin-top: 4px;
            color: rgba(255,255,255,.5);
            font-size: .82rem;
            font-weight: 600;
        }

        .xp-val {
            color: var(--violet2);
            font-size: 1.2rem;
            font-weight: 900;
        }

        .level-val {
            color: rgba(255,255,255,.78);
            font-size: 1rem;
            font-weight: 900;
        }

        @@media(max-width:1180px) {
            .layout {
                grid-template-columns: 1fr;
                padding-top: 118px;
            }

            .sidebar {
                display: none;
            }

            .main {
                grid-column: 1;
            }

            .topbar {
                height: auto;
                min-height: 78px;
                flex-wrap: wrap;
                padding: 14px 18px;
            }

            .top-nav {
                order: 3;
                width: 100%;
                overflow-x: auto;
            }
        }

        @@media(max-width:700px) {
            .main {
                padding: 18px;
            }

            .rank-hero {
                min-height: 220px;
                padding: 24px;
            }

            .hero-copy h1 {
                font-size: 2.2rem;
                letter-spacing: -2px;
            }

            .hero-copy p {
                font-size: .95rem;
            }

            .lb-row {
                grid-template-columns: 46px 1fr 80px;
                padding: 16px;
            }

            .level-val {
                display: none;
            }

            .user-av {
                width: 46px;
                height: 46px;
                font-size: 1rem;
            }

            .brand {
                min-width: 190px;
            }

            .brand-logo {
                width: 50px;
                height: 50px;
            }
        }
    </style>
</head>

<body>
    <header class="topbar">
        <a href="/Dashboard" class="brand">
            <img src="/fe/logo/logo.png" class="brand-logo" alt="Logo" />
            <div class="brand-text">
                <span>Vương</span>
                <strong>Quốc</strong>
            </div>
        </a>

        <nav class="top-nav">
            <a href="/Dashboard">📊 Trang chủ</a>
            <a href="/Task">📋 Nhiệm vụ</a>
            <a href="/Account/Leaderboard" class="active">🏆 Bảng xếp hạng</a>
            <a href="/Friend">👥 Bạn bè</a>
            <a href="/Dashboard/Badges">🏅 Thành tựu</a>
            <a href="/Inventory">🎒 Kho đồ</a>
            <a href="/Hideout/Index">🏰 Căn cứ</a>
            <a href="/Task/search">🔍 Tìm nhiệm vụ</a>
        </nav>

        <div class="top-user">
            <span class="level-chip">LV</span>
            <div class="avatar"></div>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <div class="side-title">Chính</div>

            <nav class="side-menu">
                <a href="/Dashboard">🏠 Dashboard</a>
                <a href="/Task">📋 Danh sách Quest</a>
                <a href="/Task/search">🔍 Tìm kiếm Quest</a>
                <a href="/Dashboard/Statistics">📊 Thống kê</a>
                <a href="/Forest/Index">🌲 Rừng Sâu</a>
            </nav>

            <div class="side-title">Cộng đồng</div>

            <nav class="side-menu">
                <a href="/Account/Leaderboard" class="active">🏆 Bảng xếp hạng</a>
                <a href="/Friend">👥 Bạn bè</a>
                <a href="/Dashboard/Badges">🏅 Thành tựu</a>
            </nav>

            <div class="side-title">Tài khoản</div>

            <nav class="side-menu">
                <a href="/Account/Profile">🧙 Hồ sơ cá nhân</a>
                <a href="/Dashboard/Character">🧝 Nhân vật</a>
                <a href="/Inventory">🎒 Kho đồ</a>
                <a href="/Hideout/Index">🏰 Căn cứ</a>
                <a href="/Account/Logout">🚪 Đăng xuất</a>
            </nav>

            <div class="side-card">
                <h4>Nhiệm vụ hôm nay</h4>
                <p>Hoàn thành quest để nhận XP, giữ streak và mở khóa huy hiệu.</p>
                <a href="/Task/search">Tìm quest mới</a>
            </div>
        </aside>

        <main class="main">
            <section class="rank-hero">
                <div class="hero-copy">
                    <h1>BẢNG XẾP HẠNG</h1>
                    <p>Top người dùng xuất sắc nhất trong cộng đồng</p>
                </div>
            </section>

            <div class="rank-tabs-wrap">
                <div class="rank-tabs">
                    <button type="button" class="rank-tab active" onclick="switchRankTab('xp', this)">
                        ⚡ Top XP
                    </button>

                    <button type="button" class="rank-tab" onclick="switchRankTab('streak', this)">
                        🔥 Top Streak
                    </button>
                </div>
            </div>

            <section id="panel-xp" class="rank-panel active">
                <div class="lb-table">
                    <div class="lb-row lb-head">
                        <span>#</span>
                        <span>Người dùng</span>
                        <span>XP</span>
                        <span>Level</span>
                    </div>

                    @for (int i = 0; i < topXP.Count; i++)
                    {
                        var u = topXP[i];

                        var badgeClass =
                        i == 0 ? "gold" :
                        i == 1 ? "silver" :
                        i == 2 ? "bronze" : "";

                        <div class="lb-row">
                            <span class="rank-badge @badgeClass">
                                @(i + 1)
                            </span>

                            <div class="user-box">
                                <div class="user-av">
                                    @u.Username.Substring(0, 1).ToUpper()
                                </div>

                                <div>
                                    <a href="/Friend/ViewProfile/@u.Id" class="user-name">
                                        @u.Username
                                    </a>

                                    <div class="user-sub">
                                        🔥 @u.CurrentStreak streak
                                    </div>
                                </div>
                            </div>

                            <span class="xp-val">@u.XP</span>

                            <span class="level-val">Cấp @u.Level</span>
                        </div>
                    }
                </div>
            </section>

            <section id="panel-streak" class="rank-panel">
                <div class="lb-table">
                    <div class="lb-row lb-head">
                        <span>#</span>
                        <span>Người dùng</span>
                        <span>Streak</span>
                        <span>XP</span>
                    </div>

                    @for (int i = 0; i < topStreak.Count; i++)
                    {
                        var u = topStreak[i];

                        var badgeClass =
                        i == 0 ? "gold" :
                        i == 1 ? "silver" :
                        i == 2 ? "bronze" : "";

                        <div class="lb-row">
                            <span class="rank-badge @badgeClass">
                                @(i + 1)
                            </span>

                            <div class="user-box">
                                <div class="user-av">
                                    @u.Username.Substring(0, 1).ToUpper()
                                </div>

                                <div>
                                    <a href="/Friend/ViewProfile/@u.Id" class="user-name">
                                        @u.Username
                                    </a>

                                    <div class="user-sub">
                                        Cấp @u.Level
                                    </div>
                                </div>
                            </div>

                            <span class="xp-val">🔥 @u.CurrentStreak</span>

                            <span class="level-val">@u.XP XP</span>
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>

    <script>
        function switchRankTab(id, btn) {
            document.querySelectorAll(".rank-panel")
                .forEach(x => x.classList.remove("active"));

            document.querySelectorAll(".rank-tab")
                .forEach(x => x.classList.remove("active"));

            document.getElementById("panel-" + id)
                .classList.add("active");

            btn.classList.add("active");
        }
    </script>
</body>
</html>