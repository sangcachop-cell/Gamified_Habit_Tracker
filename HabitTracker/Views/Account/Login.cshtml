@model HabitTracker.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — HabitTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #070711;
            --panel: #10101d;
            --panel-soft: #17172a;
            --violet: #7c4dff;
            --violet-2: #9b5cff;
            --gold: #ffd166;
            --text: #ffffff;
            --muted: rgba(255,255,255,.62);
            --border: rgba(255,255,255,.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            background: var(--bg);
            color: var(--text);
            font-family: "Be Vietnam Pro", sans-serif;
            overflow-x: hidden;
        }

        .left-panel {
            position: relative;
            min-height: 100vh;
            padding: 48px 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            background: linear-gradient(90deg, rgba(7,7,17,.88), rgba(7,7,17,.38)), url('/fe/login-illustration.png');
            background-size: cover;
            background-position: center;
            border-right: 1px solid rgba(255,255,255,.08);
        }

            .left-panel::after {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 25% 20%, rgba(124,77,255,.25), transparent 28%), radial-gradient(circle at 18% 85%, rgba(45,226,197,.12), transparent 30%);
                pointer-events: none;
            }

        .brand {
            position: relative;
            z-index: 2;
            color: white;
            text-decoration: none;
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -.5px;
        }

            .brand span {
                color: var(--gold);
            }

        .left-content {
            position: relative;
            z-index: 2;
            max-width: 520px;
        }

            .left-content h1 {
                font-size: clamp(2.1rem, 4vw, 4rem);
                font-weight: 800;
                line-height: 1.12;
                letter-spacing: -1.8px;
                margin-bottom: 18px;
                text-shadow: 0 10px 30px rgba(0,0,0,.45);
            }

                .left-content h1 span {
                    color: #9b7cff;
                }

            .left-content p {
                color: rgba(255,255,255,.78);
                font-size: 1rem;
                line-height: 1.8;
                max-width: 430px;
            }

        .feature-list {
            position: relative;
            z-index: 2;
            display: grid;
            gap: 16px;
            max-width: 430px;
        }

        .feat-item {
            display: flex;
            align-items: center;
            gap: 14px;
            color: rgba(255,255,255,.78);
        }

        .feat-icon {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
            box-shadow: 0 10px 26px rgba(0,0,0,.2);
        }

        .feat-item strong {
            display: block;
            font-size: .95rem;
            color: white;
            margin-bottom: 2px;
        }

        .feat-item span {
            font-size: .84rem;
            color: rgba(255,255,255,.62);
        }

        .footer-left {
            position: relative;
            z-index: 2;
            color: rgba(255,255,255,.55);
            font-size: .85rem;
        }

        .right-panel {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
            background: radial-gradient(circle at 80% 10%, rgba(124,77,255,.16), transparent 28%), radial-gradient(circle at 15% 90%, rgba(255,209,102,.06), transparent 26%), #080814;
        }

        .auth-box {
            width: 100%;
            max-width: 520px;
        }

        .back-home {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: rgba(255,255,255,.55);
            text-decoration: none;
            font-size: .86rem;
            margin-bottom: 32px;
            transition: .2s;
        }

            .back-home:hover {
                color: white;
            }

        .auth-box h2 {
            font-size: clamp(2rem, 4vw, 3.1rem);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.1;
            margin-bottom: 10px;
        }

            .auth-box h2 span {
                color: var(--violet-2);
            }

        .subtitle {
            color: var(--muted);
            font-size: .98rem;
            margin-bottom: 34px;
        }

        .error-msg {
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.32);
            color: #fca5a5;
            padding: 12px 14px;
            border-radius: 14px;
            font-size: .9rem;
            margin-bottom: 18px;
        }

        .form-field {
            margin-bottom: 20px;
        }

            .form-field label {
                display: block;
                color: white;
                font-size: .9rem;
                font-weight: 700;
                margin-bottom: 8px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap .input-icon {
                position: absolute;
                left: 18px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255,255,255,.42);
                font-size: 1rem;
            }

        .form-field input {
            width: 100%;
            height: 58px;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.045);
            color: white;
            padding: 0 18px 0 48px;
            outline: none;
            font-size: .96rem;
            transition: .25s;
        }

            .form-field input:focus {
                border-color: rgba(124,77,255,.75);
                box-shadow: 0 0 0 4px rgba(124,77,255,.14);
                background: rgba(255,255,255,.07);
            }

            .form-field input::placeholder {
                color: rgba(255,255,255,.36);
            }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 4px 0 24px;
            gap: 12px;
            color: var(--muted);
            font-size: .88rem;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .remember input {
                accent-color: var(--violet);
            }

        .forgot {
            color: #9b7cff;
            text-decoration: none;
            font-weight: 600;
        }

            .forgot:hover {
                color: white;
            }

        .btn-submit {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--violet), #6d28d9);
            color: white;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            transition: .25s;
            box-shadow: 0 16px 36px rgba(124,77,255,.26);
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 20px 42px rgba(124,77,255,.36);
            }

        .divider {
            display: flex;
            align-items: center;
            gap: 16px;
            color: rgba(255,255,255,.48);
            font-size: .86rem;
            margin: 28px 0;
        }

            .divider::before,
            .divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: rgba(255,255,255,.1);
            }

        .btn-google {
            width: 100%;
            height: 58px;
            border-radius: 999px;
            background: rgba(255,255,255,.035);
            color: white;
            border: 1px solid rgba(255,255,255,.12);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
            font-weight: 700;
            transition: .25s;
        }

            .btn-google:hover {
                background: rgba(255,255,255,.07);
                border-color: rgba(124,77,255,.55);
                color: white;
                transform: translateY(-1px);
            }

        .auth-footer {
            text-align: center;
            margin-top: 28px;
            color: var(--muted);
            font-size: .9rem;
        }

            .auth-footer a {
                color: #9b7cff;
                text-decoration: none;
                font-weight: 800;
            }

                .auth-footer a:hover {
                    color: white;
                }

        @@media (max-width: 960px) {
            body {
                grid-template-columns: 1fr;
            }

            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 32px 20px;
            }

            .auth-box {
                max-width: 440px;
            }

                .auth-box h2 {
                    font-size: 2.1rem;
                }
        }
    </style>
</head>

<body>
    <section class="left-panel">
        <a href="/" class="brand">⚔️ Vương Quốc</span></a>

        <div class="left-content">
            <h1>Đăng nhập để tiếp tục <span>hành trình</span> của bạn</h1>
            <p>Hoàn thành thói quen mỗi ngày, nhận XP, giữ streak và leo bảng xếp hạng cùng cộng đồng.</p>
        </div>

        <div class="feature-list">
            <div class="feat-item">
                <div class="feat-icon">🎮</div>
                <div>
                    <strong>Nhiệm vụ mỗi ngày</strong>
                    <span>Hoàn thành quest và nhận XP hấp dẫn</span>
                </div>
            </div>

            <div class="feat-item">
                <div class="feat-icon">🔥</div>
                <div>
                    <strong>Duy trì chuỗi ngày</strong>
                    <span>Giữ streak càng dài, phần thưởng càng lớn</span>
                </div>
            </div>

            <div class="feat-item">
                <div class="feat-icon">🏆</div>
                <div>
                    <strong>Thành tích & Huy hiệu</strong>
                    <span>Mở khóa huy hiệu hiếm và thể hiện đẳng cấp</span>
                </div>
            </div>

            <div class="feat-item">
                <div class="feat-icon">📊</div>
                <div>
                    <strong>Bảng xếp hạng</strong>
                    <span>Cạnh tranh lành mạnh và vươn lên top</span>
                </div>
            </div>
        </div>

        <div class="footer-left">
            © 2026 HabitTracker
        </div>
    </section>

    <section class="right-panel">
        <div class="auth-box">
            <a href="/" class="back-home">← Về trang chủ</a>

            <h2>Chào mừng <span>trở lại!</span></h2>
            <p class="subtitle">Đăng nhập để tiếp tục hành trình chinh phục thói quen.</p>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">@ViewBag.Error</div>
            }

            <form method="post">
                <div class="form-field">
                    <label>Email</label>
                    <div class="input-wrap">
                        <span class="input-icon">✉</span>
                        <input asp-for="Email" placeholder="Nhập email của bạn" autocomplete="email" />
                    </div>
                </div>

                <div class="form-field">
                    <label>Mật khẩu</label>
                    <div class="input-wrap">
                        <span class="input-icon">⌕</span>
                        <input asp-for="Password" type="password" placeholder="Nhập mật khẩu của bạn" autocomplete="current-password" />
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember">
                        <input type="checkbox" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>

                    <a href="#" class="forgot">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn-submit">
                    Đăng nhập →
                </button>
            </form>

            <div class="divider">hoặc</div>

            <a asp-controller="Account" asp-action="GoogleLogin" class="btn-google">
                <svg width="19" height="19" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                Tiếp tục với Google
            </a>

            <div class="auth-footer">
                Chưa có tài khoản?
                <a href="/Account/Register">Đăng ký miễn phí</a>
            </div>
        </div>
    </section>
</body>
</html>