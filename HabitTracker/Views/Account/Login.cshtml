@model HabitTracker.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — HabitTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        :root {
            --bg-deep: #0d0a1a;
            --bg-card: #16112a;
            --bg-panel: #1e1535;
            --gold: #c9a84c;
            --gold-light: #f0c878;
            --purple: #7c3aed;
            --text: #e8dfc8;
            --text-muted: #8b7fa8;
            --border: #2d1f4e;
            --glow-gold: rgba(201,168,76,0.2);
            --glow-purple: rgba(124,58,237,0.2);
        }

        body {
            font-family: "Crimson Pro","DM Sans",serif;
            background: var(--bg-deep);
            color: var(--text);
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr
        }

        h1, h2, h3 {
            font-family: "Cinzel","Syne",serif
        }

        .left-panel {
            background: #0a0818;
            color: var(--text);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 52px 56px;
            position: relative;
            overflow: hidden;
            border-right: 1px solid var(--border)
        }

            .left-panel::before {
                content: "";
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: radial-gradient(circle,rgba(124,58,237,.25) 0%,transparent 70%);
                top: -200px;
                right: -200px
            }

            .left-panel::after {
                content: "";
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: radial-gradient(circle,rgba(201,168,76,.15) 0%,transparent 70%);
                bottom: -100px;
                left: -100px
            }

        .brand {
            font-family: "Cinzel",serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--gold);
            text-decoration: none;
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: 1px;
            text-shadow: 0 0 20px rgba(201,168,76,0.3)
        }

            .brand span {
                color: var(--gold-light)
            }

        .hero-text {
            position: relative;
            z-index: 2
        }

            .hero-text h2 {
                font-family: "Cinzel",serif;
                font-size: clamp(1.8rem,3.5vw,2.8rem);
                font-weight: 700;
                line-height: 1.2;
                letter-spacing: 1px;
                margin-bottom: 16px;
                color: var(--text)
            }

            .hero-text p {
                color: var(--text-muted);
                font-size: 1rem;
                line-height: 1.7;
                max-width: 380px
            }

        .feature-list {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: 12px
        }

        .feat-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-muted);
            font-size: .9rem
        }

        .feat-dot {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(201,168,76,.12);
            border: 1px solid rgba(201,168,76,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .9rem;
            flex-shrink: 0
        }
        /* RIGHT */
        .right-panel {
            background: var(--bg-card);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 52px
        }

        .auth-box {
            width: 100%;
            max-width: 420px
        }

            .auth-box h3 {
                font-family: "Cinzel",serif;
                font-size: 1.7rem;
                font-weight: 700;
                letter-spacing: 1px;
                margin-bottom: 5px;
                color: var(--gold)
            }

            .auth-box .subtitle {
                color: var(--text-muted);
                font-size: .9rem;
                margin-bottom: 34px
            }

        .form-field {
            margin-bottom: 18px
        }

            .form-field label {
                font-weight: 600;
                font-size: .83rem;
                color: var(--text-muted);
                display: block;
                margin-bottom: 7px;
                font-family: "Cinzel",serif;
                letter-spacing: 0.5px
            }

            .form-field input {
                width: 100%;
                padding: 12px 16px;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                font-family: "Crimson Pro",serif;
                font-size: 1rem;
                background: var(--bg-panel);
                color: var(--text);
                transition: border-color .2s,box-shadow .2s;
                outline: none
            }

                .form-field input:focus {
                    border-color: var(--gold);
                    box-shadow: 0 0 0 3px var(--glow-gold)
                }

                .form-field input::placeholder {
                    color: var(--text-muted)
                }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--purple), #9f45f5);
            color: white;
            border: none;
            border-radius: 50px;
            font-family: "Cinzel",serif;
            font-weight: 700;
            font-size: .9rem;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: all .2s;
            margin-bottom: 18px
        }

            .btn-submit:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 24px var(--glow-purple)
            }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-muted);
            font-size: .8rem;
            margin: 20px 0
        }

            .divider::before, .divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--border)
            }

        .btn-google {
            width: 100%;
            padding: 12px 16px;
            background: var(--bg-panel);
            color: var(--text);
            border: 1.5px solid var(--border);
            border-radius: 50px;
            font-weight: 600;
            font-size: .9rem;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 22px
        }

            .btn-google:hover {
                border-color: var(--gold);
                color: var(--gold)
            }

        .auth-footer {
            text-align: center;
            font-size: .88rem;
            color: var(--text-muted)
        }

            .auth-footer a {
                color: var(--gold);
                font-weight: 600;
                text-decoration: none
            }

                .auth-footer a:hover {
                    color: var(--gold-light);
                    text-decoration: underline
                }

        .error-msg {
            background: rgba(185,28,28,0.15);
            color: #fca5a5;
            border: 1px solid rgba(185,28,28,0.4);
            padding: 11px 15px;
            border-radius: 8px;
            font-size: .86rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px
        }

        @@media(max-width:768px) {
            body {
                grid-template-columns: 1fr
            }

            .left-panel {
                display: none
            }
        }
    </style>
</head>
<body>
    <!-- LEFT -->
    <div class="left-panel">
        <a href="/" class="brand">⚔️ Habit<span>Tracker</span></a>

        <div class="hero-text">
            <h2>Your Legend<br>Begins Here.</h2>
            <p>Complete quests. Earn XP. Level up your real life — one habit at a time.</p>
        </div>

        <div class="feature-list">
            <div class="feat-item"><div class="feat-dot">⚔️</div><span>Quest-based habits with XP rewards</span></div>
            <div class="feat-item"><div class="feat-dot">🔥</div><span>Streak tracking — keep your fire burning</span></div>
            <div class="feat-item"><div class="feat-dot">🏰</div><span>Hideout, Forest raids & crafting</span></div>
            <div class="feat-item"><div class="feat-dot">🏆</div><span>Badges, leaderboard & rivalries</span></div>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="right-panel">
        <div class="auth-box">
            <a href="/" style="display:inline-flex;align-items:center;gap:6px;color:#8b7fa8;text-decoration:none;font-size:.85rem;margin-bottom:24px;transition:color .2s" onmouseover="this.style.color='#c9a84c'" onmouseout="this.style.color='#8b7fa8'">← Return to home</a>
            <h3>Welcome Back ⚔️</h3>
            <p class="subtitle">Continue your adventure</p>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">❌ @ViewBag.Error</div>
            }

            <form method="post">
                <div class="form-field">
                    <label>Email</label>
                    <input asp-for="Email" placeholder="you@example.com" autocomplete="email" />
                </div>
                <div class="form-field">
                    <label>Mật khẩu</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" />
                </div>
                <button type="submit" class="btn-submit">Enter the Realm →</button>
            </form>

            <div class="divider">hoặc</div>

            <a asp-controller="Account" asp-action="GoogleLogin" class="btn-google">
                <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
                Tiếp tục với Google
            </a>

            <div class="auth-footer">
                Chưa có tài khoản? <a href="/Account/Register">Đăng ký miễn phí</a>
            </div>
        </div>
    </div>
</body>
</html>
