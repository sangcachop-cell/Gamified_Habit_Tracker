@model HabitTracker.Models.User
@{
    ViewData["Title"] = "Hồ sơ — " + Model.Username;
    int xpInLevel = Model.XP % 100;
}

<style>
    :root {
        --profile-bg: #f8fafc;
        --profile-card: #ffffff;
        --profile-border: #e5e7eb;
        --profile-text: #0f172a;
        --profile-muted: #64748b;
        --profile-purple: #7c3aed;
        --profile-purple-soft: #f5f3ff;
        --profile-green: #10b981;
        --profile-red: #f43f5e;
        --profile-blue: #2563eb;
        --profile-gold: #f59e0b;
    }

    body {
        background: var(--profile-bg);
        font-family: "Nunito", sans-serif;
    }

    .profile-page {
        max-width: 1320px;
        margin: 22px auto;
        padding: 0 16px 40px;
    }

    .profile-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 34px;
        color: white;
        margin-bottom: 24px;
        background: radial-gradient(circle at 18% 55%, rgba(124, 58, 237, .65), transparent 32%), radial-gradient(circle at 85% 20%, rgba(245, 158, 11, .30), transparent 30%), linear-gradient(135deg, #070714, #17102d 55%, #1f1608);
        box-shadow: 0 18px 45px rgba(15, 23, 42, .18);
    }

    .profile-hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
    }

    .profile-avatar,
    .profile-avatar-placeholder {
        width: 118px;
        height: 118px;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,.35);
        box-shadow: 0 16px 30px rgba(0,0,0,.25);
        flex-shrink: 0;
    }

    .profile-avatar {
        object-fit: cover;
    }

    .profile-avatar-placeholder {
        background: rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        font-weight: 900;
    }

    .profile-name {
        font-size: 34px;
        font-weight: 900;
        margin: 0;
    }

    .profile-email {
        color: rgba(255,255,255,.72);
        margin: 4px 0 14px;
        font-weight: 700;
    }

    .profile-bio {
        color: rgba(255,255,255,.82);
        font-style: italic;
        margin-bottom: 14px;
        max-width: 720px;
    }

    .hero-stats {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .hero-stat {
        min-width: 92px;
        padding: 12px 16px;
        border-radius: 16px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        text-align: center;
        backdrop-filter: blur(8px);
    }

        .hero-stat .num {
            font-size: 26px;
            font-weight: 900;
            line-height: 1;
        }

        .hero-stat .label {
            color: rgba(255,255,255,.65);
            font-size: 13px;
            margin-top: 6px;
            font-weight: 700;
        }

    .social-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .social-btn {
        color: white;
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.16);
        font-weight: 800;
        font-size: 13px;
    }

    .profile-layout {
        display: grid;
        grid-template-columns: minmax(0, 2fr) 390px;
        gap: 22px;
        align-items: start;
    }

    .profile-card {
        background: var(--profile-card);
        border: 1px solid var(--profile-border);
        border-radius: 22px;
        padding: 22px;
        margin-bottom: 18px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .05);
    }

    .profile-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 19px;
        font-weight: 900;
        color: var(--profile-text);
        padding-bottom: 14px;
        margin-bottom: 20px;
        border-bottom: 1px solid #ede9fe;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px 18px;
    }

    .form-field label {
        display: block;
        margin-bottom: 7px;
        font-weight: 800;
        color: #475569;
        font-size: 14px;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
        width: 100%;
        border: 1px solid var(--profile-border);
        border-radius: 14px;
        padding: 12px 14px;
        background: #fff;
        color: var(--profile-text);
        outline: none;
        font-weight: 700;
        transition: .15s ease;
    }

        .form-field input:focus,
        .form-field select:focus,
        .form-field textarea:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 4px rgba(167,139,250,.14);
        }

    .form-field textarea {
        min-height: 120px;
        resize: vertical;
    }

    .avatar-upload {
        position: relative;
        border: 2px dashed #cbd5e1;
        border-radius: 20px;
        padding: 24px;
        text-align: center;
        cursor: pointer;
        background: #f8fafc;
        transition: .18s ease;
    }

        .avatar-upload:hover {
            border-color: #a78bfa;
            background: #faf5ff;
        }

        .avatar-upload input[type=file] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    .avatar-preview {
        width: 92px;
        height: 92px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: 0 10px 22px rgba(15,23,42,.12);
        margin-bottom: 10px;
    }

    .avatar-note {
        color: var(--profile-muted);
        font-weight: 700;
        margin: 0;
    }

    .action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 4px;
    }

    .btn-save-profile {
        border: 0;
        border-radius: 999px;
        padding: 12px 28px;
        color: white;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        font-weight: 900;
        box-shadow: 0 10px 22px rgba(124,58,237,.25);
    }

    .btn-soft-profile {
        text-decoration: none;
        border: 1px solid var(--profile-border);
        border-radius: 999px;
        padding: 11px 22px;
        color: var(--profile-text);
        background: #fff;
        font-weight: 800;
    }

    .sidebar-card {
        position: static;
    }

    .xp-line {
        display: flex;
        justify-content: space-between;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .xp-bar {
        height: 9px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .xp-fill {
        height: 100%;
        width: @xpInLevel %;
        background: linear-gradient(90deg, var(--profile-purple), var(--profile-green));
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .stat-row:last-child {
            border-bottom: none;
        }

    .stat-label {
        color: var(--profile-muted);
        font-weight: 800;
    }

    .stat-value {
        color: var(--profile-text);
        font-weight: 900;
    }

    .quick-list {
        display: grid;
        gap: 10px;
    }

    .quick-link {
        text-decoration: none;
        color: var(--profile-text);
        background: var(--profile-purple-soft);
        border: 1px solid #ede9fe;
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 900;
        transition: .15s ease;
    }

        .quick-link:hover {
            transform: translateY(-1px);
            background: #ede9fe;
            color: var(--profile-purple);
        }

    .badge-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .badge-chip {
        background: var(--profile-purple-soft);
        color: var(--profile-purple);
        border: 1px solid #ede9fe;
        border-radius: 999px;
        padding: 7px 12px;
        font-weight: 800;
        font-size: 13px;
    }

    .alert-s,
    .alert-e {
        border-radius: 16px;
        padding: 13px 16px;
        margin-bottom: 16px;
        font-weight: 800;
    }

    .alert-s {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-e {
        background: #ffe4e6;
        color: #be123c;
        border: 1px solid #fecdd3;
    }

    @@media(max-width: 992px) {
        .profile-layout {
            grid-template-columns: 1fr;
        }

        .sidebar-card {
            position: static;
        }
    }

    @@media(max-width: 640px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .profile-hero {
            padding: 24px;
        }

        .profile-name {
            font-size: 28px;
        }
    }
</style>

<div class="profile-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert-s">✅ @TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-e">❌ @TempData["Error"]</div>
    }

    <div class="profile-hero">
        <div class="profile-hero-inner">
            @if (!string.IsNullOrEmpty(Model.Avatar) && Model.Avatar.StartsWith("http"))
            {
                <img src="@Model.Avatar" class="profile-avatar" alt="@Model.Username" />
            }
            else if (!string.IsNullOrEmpty(Model.Avatar))
            {
                <img src="@Url.Content("~/images/" + Model.Avatar)"
                     class="profile-avatar"
                     alt="@Model.Username"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                <div class="profile-avatar-placeholder" style="display:none">
                    @Model.Username.Substring(0, 1).ToUpper()
                </div>
            }
            else
            {
                <div class="profile-avatar-placeholder">
                    @Model.Username.Substring(0, 1).ToUpper()
                </div>
            }

            <div>
                <h2 class="profile-name">@Model.Username</h2>
                <div class="profile-email">
                    @Model.Email @(!string.IsNullOrEmpty(Model.Location) ? $"· 📍 {Model.Location}" : "")
                </div>

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <div class="profile-bio">"@Model.Bio"</div>
                }

                <div class="hero-stats">
                    <div class="hero-stat">
                        <div class="num">@Model.Level</div>
                        <div class="label">Level</div>
                    </div>

                    <div class="hero-stat">
                        <div class="num">@Model.XP.ToString("N0")</div>
                        <div class="label">Total XP</div>
                    </div>

                    <div class="hero-stat">
                        <div class="num">@Model.CurrentStreak 🔥</div>
                        <div class="label">Streak</div>
                    </div>

                    <div class="hero-stat">
                        <div class="num">@(Model.UserQuests?.Count ?? 0)</div>
                        <div class="label">Quests</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.FacebookLink) || !string.IsNullOrEmpty(Model.InstagramLink) || !string.IsNullOrEmpty(Model.LinkedInLink))
                {
                    <div class="social-row">
                        @if (!string.IsNullOrEmpty(Model.FacebookLink))
                        {
                            <a href="@Model.FacebookLink" target="_blank" class="social-btn">f Facebook</a>
                        }

                        @if (!string.IsNullOrEmpty(Model.InstagramLink))
                        {
                            <a href="@Model.InstagramLink" target="_blank" class="social-btn">📷 Instagram</a>
                        }

                        @if (!string.IsNullOrEmpty(Model.LinkedInLink))
                        {
                            <a href="@Model.LinkedInLink" target="_blank" class="social-btn">in LinkedIn</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="profile-layout">
        <div>
            <form method="post" asp-action="Profile" enctype="multipart/form-data">
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="profile-card">
                    <div class="profile-card-title">👤 Thông tin cơ bản</div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label>Username</label>
                            <input type="text" name="Username" value="@Model.Username" />
                        </div>

                        <div class="form-field">
                            <label>Email</label>
                            <input type="email" name="Email" value="@Model.Email" />
                        </div>

                        <div class="form-field">
                            <label>Số điện thoại</label>
                            <input type="tel" name="PhoneNumber" value="@(Model.PhoneNumber ?? "")" />
                        </div>

                        <div class="form-field">
                            <label>Địa điểm</label>
                            <input type="text" name="Location" value="@(Model.Location ?? "")" placeholder="TP. Hồ Chí Minh..." />
                        </div>

                        <div class="form-field">
                            <label>Giới tính</label>
                            <select name="Gender">
                                <option value="">-- Chọn --</option>
                                <option value="Male" selected="@(Model.Gender == "Male" ? "selected" : null)">Nam</option>
                                <option value="Female" selected="@(Model.Gender == "Female" ? "selected" : null)">Nữ</option>
                                <option value="Other" selected="@(Model.Gender == "Other" ? "selected" : null)">Khác</option>
                            </select>
                        </div>

                        <div class="form-field">
                            <label>Ngày sinh</label>
                            <input type="date" name="DateOfBirth"
                                   value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card-title">🖼️ Ảnh đại diện</div>

                    <div class="avatar-upload" onclick="document.getElementById('avFile').click()">
                        @{
                            var avSrc = !string.IsNullOrEmpty(Model.Avatar)
                            ? (Model.Avatar.StartsWith("http") ? Model.Avatar : Url.Content("~/images/" + Model.Avatar))
                            : Url.Content("~/images/default.png");
                        }

                        <img id="avPreview"
                             src="@avSrc"
                             class="avatar-preview"
                             onerror="this.src='@Url.Content("~/images/default.png")'" />

                        <p class="avatar-note">📷 Nhấn để chọn ảnh mới (JPG, PNG · tối đa 5MB)</p>

                        <input type="file"
                               id="avFile"
                               name="AvatarFile"
                               accept="image/*"
                               style="display:none"
                               onchange="previewAv(event)" />
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card-title">📝 Giới thiệu bản thân</div>

                    <div class="form-field">
                        <textarea name="Bio" placeholder="Kể về bản thân bạn...">@(Model.Bio ?? "")</textarea>
                        <small style="color:#64748b;font-weight:700;">Tối đa 500 ký tự</small>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card-title">🔗 Mạng xã hội</div>

                    <div class="form-field">
                        <label>Facebook</label>
                        <input type="url" name="FacebookLink" value="@(Model.FacebookLink ?? "")"
                               placeholder="https://facebook.com/yourprofile" />
                    </div>

                    <div class="form-field">
                        <label>Instagram</label>
                        <input type="url" name="InstagramLink" value="@(Model.InstagramLink ?? "")"
                               placeholder="https://instagram.com/yourprofile" />
                    </div>

                    <div class="form-field">
                        <label>LinkedIn</label>
                        <input type="url" name="LinkedInLink" value="@(Model.LinkedInLink ?? "")"
                               placeholder="https://linkedin.com/in/yourprofile" />
                    </div>
                </div>

                <div class="action-row">
                    <button type="submit" class="btn-save-profile">💾 Lưu thay đổi</button>
                    <a href="/dashboard" class="btn-soft-profile">↩ Huỷ</a>
                    <a href="javascript:history.back()" class="btn-soft-profile">← Quay lại</a>
                </div>
            </form>
        </div>

        <div>
            <div class="profile-card sidebar-card">
                <div class="profile-card-title">⚡ Tiến trình</div>

                <div class="xp-line">
                    <span>Level @Model.Level</span>
                    <span style="color:var(--profile-purple)">@xpInLevel / 100 XP</span>
                </div>

                <div class="xp-bar">
                    <div class="xp-fill"></div>
                </div>

                <div style="font-size:13px;color:#94a3b8;font-weight:800;margin-bottom:14px;">
                    → Level @(Model.Level + 1)
                </div>

                <div class="stat-row">
                    <span class="stat-label">🏆 Tổng XP</span>
                    <span class="stat-value" style="color:var(--profile-purple)">@Model.XP.ToString("N0")</span>
                </div>

                <div class="stat-row">
                    <span class="stat-label">🔥 Streak hiện tại</span>
                    <span class="stat-value" style="color:var(--profile-red)">@Model.CurrentStreak ngày</span>
                </div>

                <div class="stat-row">
                    <span class="stat-label">🏅 Streak dài nhất</span>
                    <span class="stat-value">@Model.LongestStreak ngày</span>
                </div>

                <div class="stat-row">
                    <span class="stat-label">✅ Quests hoàn thành</span>
                    <span class="stat-value">@Model.TotalQuestsCompleted</span>
                </div>

                <div class="stat-row">
                    <span class="stat-label">📅 Tham gia từ</span>
                    <span class="stat-value">@Model.CreatedAt.ToString("MM/yyyy")</span>
                </div>

                <a href="/account/changepassword" class="quick-link" style="display:block;margin-top:16px;">
                    🔐 Đổi mật khẩu
                </a>
            </div>

            @if (Model.UserBadges != null && Model.UserBadges.Count > 0)
            {
                <div class="profile-card">
                    <div class="profile-card-title" style="justify-content:space-between;">
                        <span>🏆 Badges (@Model.UserBadges.Count)</span>
                        <a href="/Dashboard/Badges"
                           style="font-size:13px;color:var(--profile-purple);text-decoration:none;font-weight:900;">
                            Xem tất cả →
                        </a>
                    </div>

                    <div class="badge-grid">
                        @foreach (var ub in Model.UserBadges.Take(9))
                        {
                            <div class="badge-chip">@(ub.Badge?.Icon ?? "🏅") @(ub.Badge?.Name ?? "Badge")</div>
                        }

                        @if (Model.UserBadges.Count > 9)
                        {
                            <div class="badge-chip">+@(Model.UserBadges.Count - 9)</div>
                        }
                    </div>
                </div>
            }

            <div class="profile-card">
                <div class="profile-card-title">⚡ Nhanh</div>

                <div class="quick-list">
                    <a href="/task" class="quick-link">📋 Danh sách Quest</a>
                    <a href="/dashboard" class="quick-link">📊 Dashboard</a>
                    <a href="/Dashboard/Statistics" class="quick-link">📈 Thống kê</a>
                    <a href="/account/leaderboard" class="quick-link">🏅 Leaderboard</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewAv(e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;

            const r = new FileReader();
            r.onload = () => {
                document.getElementById('avPreview').src = r.result;
            };
            r.readAsDataURL(file);
        }
    </script>
}