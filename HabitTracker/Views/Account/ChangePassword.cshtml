@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    :root {
        --cp-bg: #f8fafc;
        --cp-card: #ffffff;
        --cp-border: #e5e7eb;
        --cp-text: #0f172a;
        --cp-muted: #64748b;
        --cp-purple: #7c3aed;
        --cp-purple-soft: #f5f3ff;
        --cp-green: #10b981;
        --cp-red: #f43f5e;
        --cp-gold: #f59e0b;
    }

    body {
        background: var(--cp-bg);
        font-family: "Nunito", sans-serif;
    }

    .cp-page {
        max-width: 620px;
        margin: 38px auto 70px;
        padding: 0 16px;
    }

    .page-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 18px;
        text-decoration: none;
        color: var(--cp-muted);
        font-weight: 800;
    }

        .page-back:hover {
            color: var(--cp-purple);
        }

    .cp-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 30px 34px;
        color: white;
        margin-bottom: 22px;
        background: radial-gradient(circle at 75% 55%, rgba(124,58,237,.55), transparent 38%), linear-gradient(135deg, #070714, #17102d 65%, #1f1608);
        box-shadow: 0 18px 40px rgba(15,23,42,.18);
    }

        .cp-hero h2 {
            position: relative;
            z-index: 2;
            font-size: 30px;
            font-weight: 900;
            margin: 0 0 8px;
        }

        .cp-hero p {
            position: relative;
            z-index: 2;
            margin: 0;
            color: rgba(255,255,255,.72);
            font-weight: 700;
        }

    .cp-card {
        background: var(--cp-card);
        border: 1px solid var(--cp-border);
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 16px 38px rgba(15,23,42,.07);
    }

    .form-field {
        margin-bottom: 22px;
    }

        .form-field label {
            display: block;
            margin-bottom: 8px;
            color: #334155;
            font-weight: 900;
        }

    .pw-wrap {
        position: relative;
    }

    .form-field input {
        width: 100%;
        padding: 14px 48px 14px 16px;
        border: 1px solid var(--cp-border);
        border-radius: 16px;
        background: #fff;
        color: var(--cp-text);
        font-size: 16px;
        font-weight: 800;
        outline: none;
        transition: .16s ease;
    }

        .form-field input:focus {
            border-color: #a78bfa;
            box-shadow: 0 0 0 4px rgba(167,139,250,.15);
        }

    .eye-btn {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: var(--cp-muted);
        cursor: pointer;
        font-size: 18px;
    }

    .strength-bar {
        height: 7px;
        border-radius: 999px;
        margin-top: 10px;
        background: #e5e7eb;
        overflow: hidden;
    }

    .strength-fill {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        transition: width .25s ease, background .25s ease;
    }

    .strength-label {
        margin-top: 6px;
        font-size: 13px;
        color: var(--cp-muted);
        font-weight: 700;
    }

    .rules {
        background: var(--cp-purple-soft);
        border: 1px solid #ede9fe;
        border-radius: 18px;
        padding: 16px 18px;
        margin-top: 4px;
    }

        .rules p {
            margin: 0 0 10px;
            color: var(--cp-text);
            font-weight: 900;
        }

    .rule {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--cp-muted);
        font-weight: 800;
        font-size: 14px;
        margin-bottom: 6px;
    }

        .rule.ok {
            color: var(--cp-green);
        }

            .rule.ok::before {
                content: "✓";
                font-weight: 900;
            }

        .rule:not(.ok)::before {
            content: "•";
            font-weight: 900;
        }

    .btn-submit {
        width: 100%;
        border: 0;
        border-radius: 999px;
        padding: 14px 18px;
        margin-top: 22px;
        color: white;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        font-weight: 900;
        font-size: 16px;
        box-shadow: 0 12px 28px rgba(124,58,237,.24);
        transition: .16s ease;
    }

        .btn-submit:hover {
            transform: translateY(-1px);
            filter: brightness(.98);
        }

    .alert-s,
    .alert-e {
        border-radius: 16px;
        padding: 13px 16px;
        margin-bottom: 16px;
        font-weight: 800;
    }

    .alert-s {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-e {
        background: #ffe4e6;
        color: #be123c;
        border: 1px solid #fecdd3;
    }

    .field-error {
        color: #be123c;
        font-size: 13px;
        font-weight: 800;
        margin-top: 6px;
    }

    @@media(max-width: 640px) {
        .cp-page {
            margin-top: 20px;
        }

        .cp-card {
            padding: 22px;
        }

        .cp-hero {
            padding: 24px;
        }

            .cp-hero h2 {
                font-size: 26px;
            }
    }
</style>

<div class="cp-page">
    <a href="javascript:history.back()" class="page-back">← Quay lại</a>

    <div class="cp-hero">
        <h2>🔐 Đổi mật khẩu</h2>
        <p>Bảo vệ tài khoản với mật khẩu mạnh</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-s">✅ @TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-e">❌ @TempData["Error"]</div>
    }

    <div class="cp-card">
        <form method="post">
            <div class="form-field">
                <label>Mật khẩu hiện tại</label>
                <div class="pw-wrap">
                    <input type="password" name="oldPassword" id="oldPw" placeholder="••••••••" required />
                    <button type="button" class="eye-btn" onclick="togglePw('oldPw',this)">👁</button>
                </div>

                @if (ViewData.ModelState["oldPassword"]?.Errors.Count > 0)
                {
                    <div class="field-error">@ViewData.ModelState["oldPassword"].Errors[0].ErrorMessage</div>
                }
            </div>

            <div class="form-field">
                <label>Mật khẩu mới</label>
                <div class="pw-wrap">
                    <input type="password"
                           name="newPassword"
                           id="newPw"
                           placeholder="Ít nhất 6 ký tự"
                           required
                           oninput="checkStrength(this.value)" />
                    <button type="button" class="eye-btn" onclick="togglePw('newPw',this)">👁</button>
                </div>

                <div class="strength-bar">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>

                <div class="strength-label" id="strengthLabel">
                    Nhập mật khẩu để kiểm tra độ mạnh
                </div>

                @if (ViewData.ModelState["newPassword"]?.Errors.Count > 0)
                {
                    <div class="field-error">@ViewData.ModelState["newPassword"].Errors[0].ErrorMessage</div>
                }
            </div>

            <div class="form-field">
                <label>Xác nhận mật khẩu mới</label>
                <div class="pw-wrap">
                    <input type="password"
                           name="confirmPassword"
                           id="cfPw"
                           placeholder="Nhập lại mật khẩu mới"
                           required
                           oninput="checkMatch()" />
                    <button type="button" class="eye-btn" onclick="togglePw('cfPw',this)">👁</button>
                </div>

                <div class="strength-label" id="matchLabel"></div>

                @if (ViewData.ModelState["confirmPassword"]?.Errors.Count > 0)
                {
                    <div class="field-error">@ViewData.ModelState["confirmPassword"].Errors[0].ErrorMessage</div>
                }
            </div>

            <div class="rules">
                <p>Yêu cầu mật khẩu:</p>
                <div class="rule" id="r1">Ít nhất 6 ký tự</div>
                <div class="rule" id="r2">Có chữ hoa</div>
                <div class="rule" id="r3">Có chữ số</div>
            </div>

            <button type="submit" class="btn-submit">
                🔐 Đổi mật khẩu
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePw(id, btn) {
            const i = document.getElementById(id);
            i.type = i.type === 'password' ? 'text' : 'password';
            btn.textContent = i.type === 'password' ? '👁' : '🙈';
        }

        function checkStrength(v) {
            let score = 0;

            if (v.length >= 6) score++;
            if (v.length >= 10) score++;
            if (/[A-Z]/.test(v)) score++;
            if (/[0-9]/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;

            const pct = score * 20;
            const colors = ['#e5e7eb', '#f43f5e', '#f59e0b', '#f59e0b', '#10b981', '#7c3aed'];
            const labels = ['', 'Rất yếu', 'Yếu', 'Trung bình', 'Mạnh', 'Rất mạnh'];

            document.getElementById('strengthFill').style.width = pct + '%';
            document.getElementById('strengthFill').style.background = colors[score];
            document.getElementById('strengthLabel').textContent = labels[score] || 'Nhập mật khẩu để kiểm tra độ mạnh';

            document.getElementById('r1').className = 'rule' + (v.length >= 6 ? ' ok' : '');
            document.getElementById('r2').className = 'rule' + (/[A-Z]/.test(v) ? ' ok' : '');
            document.getElementById('r3').className = 'rule' + (/[0-9]/.test(v) ? ' ok' : '');

            checkMatch();
        }

        function checkMatch() {
            const nv = document.getElementById('newPw').value;
            const cv = document.getElementById('cfPw').value;
            const lbl = document.getElementById('matchLabel');

            if (!cv) {
                lbl.textContent = '';
                return;
            }

            lbl.textContent = nv === cv ? '✓ Mật khẩu khớp' : '✗ Mật khẩu không khớp';
            lbl.style.color = nv === cv ? '#10b981' : '#f43f5e';
        }
    </script>
}