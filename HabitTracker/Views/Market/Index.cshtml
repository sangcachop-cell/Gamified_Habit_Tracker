@model HabitTracker.Models.ViewModels.MarketViewModel
@{
    ViewData["Title"] = "Market";
    var u = Model.User;

    string SlotIcon(string slot) => slot switch
    {
        "weapon"        => "⚔️",
        "armor"         => "🛡️",
        "head"          => "🪖",
        "shield"        => "🔰",
        "back"          => "🌊",
        "eyewear"       => "👓",
        "headAccessory" => "🎀",
        "body"          => "👘",
        _               => "📦"
    };

    var classes  = new[] { "warrior", "mage", "rogue", "healer" };
    var classIcons = new Dictionary<string, string>
    {
        ["warrior"] = "⚔️",
        ["mage"]    = "🧙",
        ["rogue"]   = "🗡️",
        ["healer"]  = "💊"
    };
}

<form id="csrf-form" style="display:none">@Html.AntiForgeryToken()</form>

<div class="container-fluid py-4" style="max-width:1200px;">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <h2 class="mb-0">🏪 Market</h2>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-warning text-dark fs-6">💰 @u.Gold.ToString("F1") GP</span>
            <span class="badge bg-info text-dark fs-6">💎 @u.Gems Gems</span>
        </div>
    </div>

    <!-- Tabs: Gear / Gem Shop / Armoire / Quest Shop -->
    <ul class="nav nav-tabs mb-4" id="marketTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-gear" type="button">⚔️ Gear</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-gems" type="button">💎 Gem Shop</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-armoire" type="button">🎁 Armoire</button>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/QuestShop">📜 Quest Shop</a>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ── GEAR TAB ───────────────────────────────────────────────────── -->
        <div class="tab-pane fade show active" id="tab-gear">

            <!-- Class filter pills -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                <button class="btn btn-sm btn-primary class-filter active" data-class="all">All</button>
                @foreach (var cls in classes)
                {
                    bool isUserClass = u.Class == cls;
                    <button class="btn btn-sm @(isUserClass ? "btn-warning" : "btn-outline-secondary") class-filter"
                            data-class="@cls">
                        @classIcons.GetValueOrDefault(cls) @char.ToUpper(cls[0])@cls[1..]
                        @if (isUserClass) { <span class="badge bg-dark ms-1">you</span> }
                    </button>
                }
            </div>

            @foreach (var classEntry in Model.ByClassAndSlot)
            {
                <div class="gear-class-section" data-class="@classEntry.Key">
                    <h5 class="text-secondary mb-2">
                        @classIcons.GetValueOrDefault(classEntry.Key, "📦")
                        @char.ToUpper(classEntry.Key[0])@classEntry.Key[1..]
                    </h5>
                    @foreach (var slotEntry in classEntry.Value)
                    {
                        <h6 class="text-muted ms-2 mt-3">@SlotIcon(slotEntry.Key) @char.ToUpper(slotEntry.Key[0])@slotEntry.Key[1..]</h6>
                        <div class="row g-3 mb-3">
                            @foreach (var gear in slotEntry.Value)
                            {
                                bool owned   = Model.OwnedKeys.Contains(gear.Key);
                                bool canAfford = u.Gold >= gear.GoldCost;
                                bool classOk = gear.GearClass == "all" || gear.GearClass == "special" || gear.GearClass == u.Class;
                                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                                    <div class="card h-100 bg-dark border-@(owned ? "success" : "secondary") p-2 text-center">
                                        <img src="@gear.ShopImagePath" alt="@gear.Name"
                                             style="width:48px;height:48px;object-fit:contain;margin:auto;"
                                             onerror="this.style.display='none'">
                                        <div class="fw-bold small mt-1">@gear.Name</div>
                                        <div class="text-muted" style="font-size:.7rem;">
                                            @if (gear.STR > 0) { <span class="text-danger me-1">STR+@gear.STR</span> }
                                            @if (gear.CON > 0) { <span class="text-success me-1">CON+@gear.CON</span> }
                                            @if (gear.INT > 0) { <span class="text-info me-1">INT+@gear.INT</span> }
                                            @if (gear.PER > 0) { <span class="text-warning me-1">PER+@gear.PER</span> }
                                            @if (gear.TwoHanded) { <span class="text-secondary">2H</span> }
                                        </div>
                                        @if (owned)
                                        {
                                            <span class="badge bg-success mt-2">✓ Owned</span>
                                        }
                                        else if (!classOk)
                                        {
                                            <span class="badge bg-secondary mt-2">Wrong class</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm @(canAfford ? "btn-outline-warning" : "btn-secondary") mt-2"
                                                    onclick="buyGear('@gear.Key', this)"
                                                    @(!canAfford ? "disabled" : "")>
                                                @gear.GoldCost GP
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <hr class="border-secondary">
                </div>
            }
        </div>

        <!-- ── GEM SHOP TAB ───────────────────────────────────────────────── -->
        <div class="tab-pane fade" id="tab-gems">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card bg-dark border-info p-4 text-center">
                        <div style="font-size:3rem;">💎</div>
                        <h4 class="mt-2">Gem Shop</h4>
                        <p class="text-muted">Convert gold into gems. Gems unlock special items, Rebirth, and class changes.</p>
                        <hr class="border-secondary">
                        <div class="mb-3">
                            <span class="text-warning fs-5">💰 @u.Gold.ToString("F1") GP</span>
                            <span class="mx-2 text-muted">→</span>
                            <span class="text-info fs-5">💎 @u.Gems Gems</span>
                        </div>
                        <div class="card bg-secondary bg-opacity-25 border-info p-3 mb-3">
                            <div class="fw-bold">1 Gem</div>
                            <div class="text-muted small">Costs 25 GP</div>
                            <button class="btn btn-info mt-2 @(u.Gold < 25 ? "disabled" : "")"
                                    onclick="buyGem(this)" @(u.Gold < 25 ? "disabled" : "")>
                                Buy 1 Gem — 25 GP
                            </button>
                        </div>
                        <p class="text-muted small">
                            Gems unlock: Rebirth (Phase 4.3) · Class Change (future) · Cosmetics (future)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── ARMOIRE TAB ────────────────────────────────────────────────── -->
        <div class="tab-pane fade" id="tab-armoire">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card bg-dark border-warning p-4 text-center">
                        <div style="font-size:3rem;">🎁</div>
                        <h4 class="mt-2">Enchanted Armoire</h4>
                        <p class="text-muted">
                            A mysterious chest filled with wonders. Each pull costs <strong>100 GP</strong>
                            and awards a random reward.
                        </p>
                        <hr class="border-secondary">
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <div style="font-size:1.5rem;">⚔️</div>
                                <div class="small text-muted">60% Gear</div>
                            </div>
                            <div class="col-4">
                                <div style="font-size:1.5rem;">🍖</div>
                                <div class="small text-muted">20% Food</div>
                            </div>
                            <div class="col-4">
                                <div style="font-size:1.5rem;">⚡</div>
                                <div class="small text-muted">20% XP</div>
                            </div>
                        </div>
                        <button id="btn-armoire" class="btn btn-warning btn-lg @(u.Gold < 100 ? "disabled" : "")"
                                onclick="pullArmoire(this)" @(u.Gold < 100 ? "disabled" : "")>
                            🎁 Pull from Armoire — 100 GP
                        </button>
                        @if (u.Gold < 100)
                        {
                            <p class="text-danger small mt-2">Need 100 GP (you have @u.Gold.ToString("F1"))</p>
                        }

                        <!-- Armoire pool preview -->
                        @if (Model.ArmoireItems.Any())
                        {
                            <hr class="border-secondary mt-4">
                            <p class="text-muted small">Possible gear rewards:</p>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                @foreach (var ag in Model.ArmoireItems)
                                {
                                    <img src="@ag.ShopImagePath" alt="@ag.Name" title="@ag.Name"
                                         style="width:36px;height:36px;object-fit:contain;"
                                         onerror="this.style.display='none'">
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div><!-- tab-content -->
</div>

@section Scripts {
<script>
function token() { return document.querySelector('input[name="__RequestVerificationToken"]').value; }

// ── Class filter pills ──────────────────────────────────────────────────
document.querySelectorAll('.class-filter').forEach(btn => {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.class-filter').forEach(b => b.classList.remove('active','btn-primary'));
        this.classList.add('active', 'btn-primary');
        const cls = this.dataset.class;
        document.querySelectorAll('.gear-class-section').forEach(sec => {
            sec.style.display = (cls === 'all' || sec.dataset.class === cls) ? '' : 'none';
        });
    });
});

// ── Buy gear ────────────────────────────────────────────────────────────
function buyGear(key, btn) {
    btn.disabled = true;
    fetch('/Market/Buy?key=' + encodeURIComponent(key), {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '__RequestVerificationToken=' + encodeURIComponent(token())
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            showToast('⚔️', 'Purchased!', 'Added to inventory', 'toast-gold', 2500);
            refreshHud();
            // Replace button with "Owned" badge
            btn.outerHTML = '<span class="badge bg-success mt-2">✓ Owned</span>';
        } else {
            showToast('🚫', 'Cannot Buy', d.error, 'toast-hp', 3000);
            btn.disabled = false;
        }
    });
}

// ── Buy gem ─────────────────────────────────────────────────────────────
function buyGem(btn) {
    btn.disabled = true;
    fetch('/Economy/BuyGem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '__RequestVerificationToken=' + encodeURIComponent(token())
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            showToast('💎', 'Gem purchased!', 'You now have ' + d.newGems + ' gems', 'toast-gold', 3000);
            refreshHud();
            btn.disabled = false;
        } else {
            showToast('🚫', 'Cannot Buy', d.error, 'toast-hp', 3000);
            btn.disabled = false;
        }
    });
}

// ── Armoire pull ─────────────────────────────────────────────────────────
function pullArmoire(btn) {
    btn.disabled = true;
    btn.textContent = '✨ Opening...';
    fetch('/Market/PullArmoire', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '__RequestVerificationToken=' + encodeURIComponent(token())
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            if (d.rewardType === 'gear') {
                var gearIconHtml = d.gearImgPath ? '<img src="' + d.gearImgPath + '" style="width:36px;height:36px;object-fit:contain;" onerror="this.replaceWith(document.createTextNode(\'⚔️\'))">' : '⚔️';
                showToast(gearIconHtml, 'Armoire!', 'You found: ' + d.gearName, 'toast-drop', 5000);
            } else if (d.rewardType === 'food') {
                var foodIconHtml = d.foodIcon ? '<img src="' + d.foodIcon + '" style="width:36px;height:36px;object-fit:contain;">' : '🍖';
                showToast(foodIconHtml, 'Armoire!', 'You found: ' + d.foodName, 'toast-drop', 4000);
            } else {
                showToast('⚡', 'Armoire!', 'You gained ' + d.xpGained + ' XP!', 'toast-xp', 4000);
            }
            refreshHud();
        } else {
            showToast('🚫', 'Armoire failed', d.error, 'toast-hp', 3000);
        }
        btn.textContent = '🎁 Pull from Armoire — 100 GP';
        btn.disabled = false;
    });
}
</script>
}
