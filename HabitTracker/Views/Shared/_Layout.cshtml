@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Html

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isFullPage = controller == "Account" &&
        (action == "Login" || action == "Register");

    bool isSocialActive = controller == "Friend"
        || controller == "Message"
        || controller == "Guild"
        || controller == "Party"
        || (controller == "Account" && action == "Leaderboard");

    string Active(string c, string? a = null)
    {
        bool ok = controller == c && (a == null || action == a);
        return ok ? "active" : "";
    }

    IHtmlContent Icon(string name)
    {
        string svg = name switch
        {
            "dashboard" => @"<svg viewBox='0 0 24 24'><path d='M3 11l9-8 9 8'/><path d='M5 10v10h14V10'/><path d='M9 20v-6h6v6'/></svg>",
            "tasks" => @"<svg viewBox='0 0 24 24'><rect x='4' y='4' width='16' height='16' rx='2'/><path d='M8 12l3 3 5-7'/></svg>",
            "social" => @"<svg viewBox='0 0 24 24'><circle cx='8' cy='8' r='3'/><circle cx='16' cy='8' r='3'/><path d='M2 20c1-4 4-6 6-6s5 2 6 6'/><path d='M10 20c1-4 4-6 6-6s5 2 6 6'/></svg>",
            "economy" => @"<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='8'/><path d='M12 7v10'/><path d='M9 10c0-2 6-2 6 0 0 3-6 1-6 4 0 2 6 2 6 0'/></svg>",
            "character" => @"<svg viewBox='0 0 24 24'><path d='M4 20L20 4'/><path d='M14 4l6 6'/><path d='M20 20L4 4'/><path d='M10 4l-6 6'/></svg>",
            "equipment" => @"<svg viewBox='0 0 24 24'><path d='M12 3l8 3v5c0 5-3 8-8 10-5-2-8-5-8-10V6l8-3z'/><path d='M9 12l2 2 4-5'/></svg>",
            "market" => @"<svg viewBox='0 0 24 24'><path d='M4 10h16'/><path d='M5 10l2-5h10l2 5'/><path d='M6 10v10h12V10'/><path d='M9 20v-6h6v6'/></svg>",
            "inventory" => @"<svg viewBox='0 0 24 24'><rect x='4' y='5' width='16' height='14' rx='2'/><path d='M4 10h16'/><path d='M9 5a3 3 0 0 1 6 0'/></svg>",
            "stable" => @"<svg viewBox='0 0 24 24'><path d='M6 18c2-4 1-9 6-12 4 2 6 5 6 9 0 3-2 5-6 5H6z'/><path d='M13 6l4-3'/><path d='M10 20v2'/><path d='M16 20v2'/></svg>",
            "bell" => @"<svg viewBox='0 0 24 24'><path d='M6 9a6 6 0 0 1 12 0c0 7 3 7 3 9H3c0-2 3-2 3-9'/><path d='M10 21h4'/></svg>",
            _ => @"<svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='8'/></svg>"
        };

        return new HtmlString(svg);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitTracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background: #f8fafc;
            font-family: "Nunito", sans-serif;
        }

        .app-navbar {
            margin: 8px 14px 0;
            padding: 10px 14px;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 22px;
            box-shadow: 0 14px 35px rgba(15,23,42,.08);
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 66px;
            overflow: visible;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            color: #0f172a;
            font-weight: 900;
            font-size: 20px;
            white-space: nowrap;
            padding-right: 12px;
            border-right: 1px solid #e5e7eb;
        }

        .brand-star {
            color: #7c3aed;
            font-size: 22px;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 2px;
            flex: 1;
            overflow: visible;
            position: relative;
            z-index: 20;
        }

            .nav-menu::-webkit-scrollbar {
                height: 0;
            }

        .nav-item-link,
        .nav-dropdown-btn {
            min-width: 68px;
            height: 54px;
            border-radius: 16px;
            color: #020617;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            font-weight: 900;
            transition: .16s ease;
            border: 0;
            background: transparent;
            padding: 0 6px;
            white-space: nowrap;
        }

            .nav-item-link:hover,
            .nav-dropdown-btn:hover {
                color: #020617;
                background: #f1f5f9;
                transform: translateY(-1px);
            }

            .nav-item-link.active,
            .nav-dropdown-btn.active {
                background: #eee7ff;
                color: #020617;
            }

        .nav-svg {
            width: 22px;
            height: 22px;
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .nav-svg svg {
                width: 22px;
                height: 22px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .nav-item-link small,
        .nav-dropdown-btn small {
            font-size: 12px;
            font-weight: 900;
        }

        .nav-social-dropdown {
            position: relative;
            z-index: 100000;
        }

        .social-menu {
            min-width: 220px;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 8px;
            margin-top: 8px;
            box-shadow: 0 18px 35px rgba(15,23,42,.14);
            z-index: 99999;
        }

            .social-menu .dropdown-item {
                border-radius: 10px;
                font-weight: 800;
                padding: 10px 14px;
            }

                .social-menu .dropdown-item:hover,
                .social-menu .dropdown-item.active {
                    background: #f5f3ff;
                    color: #7c3aed;
                }

        .nav-social-dropdown .dropdown-menu.show {
            display: block;
        }

        .social-caret {
            font-size: 10px;
            margin-left: 3px;
        }

        .hud-area {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-left: 12px;
            border-left: 1px solid #e5e7eb;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .hud-stat {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 900;
            color: #0f172a;
            font-size: 14px;
        }

        .hud-icon {
            font-size: 20px;
        }

        .hud-bar {
            width: 78px;
            height: 7px;
            border-radius: 999px;
            background: #e5e7eb;
            overflow: hidden;
            margin-top: 4px;
        }

        .hud-fill {
            height: 100%;
            border-radius: 999px;
            width: 100%;
            transition: width .25s ease;
        }

            .hud-fill.hp {
                background: #f43f5e;
            }

            .hud-fill.mana {
                background: #2563eb;
            }

        .notif-btn {
            width: 38px;
            height: 38px;
            border: 0;
            background: #fff;
            color: #000;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .notif-btn svg {
                width: 22px;
                height: 22px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .user-circle {
            width: 46px;
            height: 46px;
            border-radius: 999px;
            border: 2px solid #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #0f172a;
            text-decoration: none;
            font-weight: 900;
            gap: 4px;
        }

        .avatar-mini {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            object-fit: cover;
        }

        .custom-dropdown {
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 10px;
            box-shadow: 0 18px 35px rgba(15,23,42,.14);
        }

            .custom-dropdown .dropdown-item {
                border-radius: 10px;
                font-weight: 800;
                padding: 9px 12px;
            }

                .custom-dropdown .dropdown-item:hover {
                    background: #f5f3ff;
                    color: #7c3aed;
                }

        .app-body {
            max-width: 1320px;
            margin: 24px auto;
            padding: 0 16px;
        }

        .auth-body {
            margin: 0;
            padding: 0;
        }

        #toast-container {
            position: fixed;
            top: 96px;
            right: 22px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast-noti {
            min-width: 280px;
            max-width: 340px;
            padding: 14px 18px;
            border-radius: 14px;
            color: white;
            font-size: .95rem;
            font-weight: 600;
            box-shadow: 0 10px 28px rgba(0,0,0,.18);
            display: flex;
            align-items: center;
            gap: 12px;
            opacity: 0;
            transform: translateX(120px);
            transition: opacity .35s ease, transform .35s ease;
            position: relative;
            overflow: hidden;
        }

            .toast-noti.show {
                opacity: 1;
                transform: translateX(0);
            }

            .toast-noti.hide {
                opacity: 0;
                transform: translateX(120px);
            }

        .toast-xp {
            background: linear-gradient(135deg,#f59e0b,#f97316);
        }

        .toast-badge {
            background: linear-gradient(135deg,#7c3aed,#2563eb);
        }

        .toast-streak {
            background: linear-gradient(135deg,#f43f5e,#ef4444);
        }

        .toast-level {
            background: linear-gradient(135deg,#10b981,#22c55e);
            color: #111827;
        }

        .toast-gold {
            background: linear-gradient(135deg,#f59e0b,#f97316);
        }

        .toast-hp {
            background: linear-gradient(135deg,#f43f5e,#be123c);
        }

        .toast-crit {
            background: linear-gradient(135deg,#facc15,#fb923c);
            color: #111827;
        }

        .toast-drop {
            background: linear-gradient(135deg,#7c3aed,#2563eb);
        }

        .toast-death {
            background: linear-gradient(135deg,#0f172a,#be123c);
        }

        .toast-rebirth {
            background: linear-gradient(135deg,#7c3aed,#10b981);
        }

        .success {
            background: linear-gradient(135deg,#10b981,#059669);
        }

        .danger {
            background: linear-gradient(135deg,#ef4444,#dc2626);
        }

        .info {
            background: linear-gradient(135deg,#3b82f6,#2563eb);
        }

        .warning {
            background: linear-gradient(135deg,#f59e0b,#d97706);
            color: #1a1a1a;
        }

        .toast-icon {
            font-size: 2rem;
            line-height: 1;
            flex-shrink: 0;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: rgba(255,255,255,.55);
            animation: progressBar 3.5s linear forwards;
        }

        @@keyframes progressBar {
            from {
                width: 100%;
            }

            to {
                width: 0%;
            }
        }

        @@media(max-width: 1250px) {
            .app-navbar {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .nav-menu {
                order: 3;
                width: 100%;
                flex-wrap: wrap;
                overflow: visible;
            }

            .hud-area {
                margin-left: auto;
            }
        }
    </style>
</head>

<body>

    @if (!isFullPage)
    {
        <header class="app-navbar">
            <a class="brand-box" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-star">✦</span>
                <span>HabitTracker</span>
            </a>

            <div class="nav-menu">
                <a class="nav-item-link @Active("Dashboard", "Index")" asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-svg">@Icon("dashboard")</span>
                    <small>Dashboard</small>
                </a>

                <a class="nav-item-link @Active("Task")" asp-controller="Task" asp-action="Index">
                    <span class="nav-svg">@Icon("tasks")</span>
                    <small>Tasks</small>
                </a>

                <div class="dropdown nav-social-dropdown">
                    <button class="nav-dropdown-btn @(isSocialActive ? "active" : "")"
                            type="button"
                            id="socialDropdown"
                            aria-expanded="false">
                        <span class="nav-svg">@Icon("social")</span>
                        <small>Social <span class="social-caret">▼</span></small>
                    </button>

                    <ul class="dropdown-menu social-menu" aria-labelledby="socialDropdown">
                        <li>
                            <a class="dropdown-item @(controller == "Account" && action == "Leaderboard" ? "active" : "")"
                               asp-controller="Account" asp-action="Leaderboard">
                                🏆 Leaderboard
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item @(controller == "Friend" ? "active" : "")"
                               asp-controller="Friend" asp-action="Index">
                                👥 Friends
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item @(controller == "Message" ? "active" : "")"
                               asp-controller="Message" asp-action="Index">
                                ✉️ Messages
                                <span id="msg-badge-dd" class="badge rounded-pill bg-danger d-none ms-1" style="font-size:10px;"></span>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider" /></li>

                        <li>
                            <a class="dropdown-item @(controller == "Guild" ? "active" : "")"
                               asp-controller="Guild" asp-action="Index">
                                ⚔️ Guilds
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item @(controller == "Party" ? "active" : "")"
                               asp-controller="Party" asp-action="Index">
                                🛡️ Party
                            </a>
                        </li>
                    </ul>
                </div>

                <a class="nav-item-link @Active("Character")" asp-controller="Character" asp-action="Index">
                    <span class="nav-svg">@Icon("character")</span>
                    <small>Character</small>
                </a>

                <a class="nav-item-link @Active("Equipment")" asp-controller="Equipment" asp-action="Index">
                    <span class="nav-svg">@Icon("equipment")</span>
                    <small>Equipment</small>
                </a>

                <a class="nav-item-link @Active("Market")" asp-controller="Market" asp-action="Index">
                    <span class="nav-svg">@Icon("market")</span>
                    <small>Market</small>
                </a>

                <a class="nav-item-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index">
                    <span class="nav-svg">@Icon("inventory")</span>
                    <small>Inventory</small>
                </a>

                <a class="nav-item-link @Active("Stable")" asp-controller="Stable" asp-action="Index">
                    <span class="nav-svg">@Icon("stable")</span>
                    <small>Stable</small>
                </a>
            </div>

            @if (Context.Session.GetString("Username") != null)
            {
                <div class="hud-area">
                    <div class="hud-stat">
                        <span class="hud-icon">♡</span>
                        <div>
                            <span id="hud-hp-text">50/50</span>
                            <div class="hud-bar"><div id="hud-hp-bar" class="hud-fill hp"></div></div>
                        </div>
                    </div>

                    <div class="hud-stat">
                        <span class="hud-icon">♢</span>
                        <div>
                            <span id="hud-mana-text">42/42</span>
                            <div class="hud-bar"><div id="hud-mana-bar" class="hud-fill mana"></div></div>
                        </div>
                    </div>

                    <div class="hud-stat">
                        <span class="hud-icon">🟡</span>
                        <span id="hud-gold-text">0</span>
                    </div>

                    <span id="hud-gems-text" style="display:none;">0</span>
                    <span id="navbar-level" style="display:none;">-</span>
                    <small id="hud-sleep" style="display:none;">🌙</small>
                    <a id="hud-dead" href="/Economy" style="display:none;color:#e8436a;font-weight:900;text-decoration:none;">💀 Dead!</a>

                    <div class="dropdown">
                        <button class="notif-btn" data-bs-toggle="dropdown" id="notifBell" title="Notifications">
                            @Icon("bell")
                            <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size:10px;"></span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end custom-dropdown" id="notif-dropdown" style="min-width:320px;max-height:440px;overflow-y:auto;">
                            <li class="dropdown-header d-flex justify-content-between align-items-center">
                                <a href="/Notifications" class="text-decoration-none fw-semibold" style="color:inherit">Notifications</a>
                                <a href="#" class="small" onclick="markAllRead(event)">Mark all read</a>
                            </li>
                            <li>
                                <div id="notif-list" class="px-1 py-1">Loading…</div>
                            </li>
                            <li class="border-top text-center py-2">
                                <a href="/Notifications" class="small text-decoration-none" style="opacity:.7">See all notifications →</a>
                            </li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <a class="user-circle" href="#" data-bs-toggle="dropdown">
                            <img src="@(Context.Session.GetString("Avatar") != null && Context.Session.GetString("Avatar").StartsWith("http")
                                                             ? Context.Session.GetString("Avatar")
                                                             : Url.Content("~/images/" + (Context.Session.GetString("Avatar") ?? "default.png")))"
                         class="avatar-mini"
                         onerror="this.src='@Url.Content("~/images/default.png")'" />
                    <span>⌄</span>
                </a>

                        <ul class="dropdown-menu dropdown-menu-end custom-dropdown">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">👤 My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a></li>

                            <li><a class="dropdown-item" asp-controller="Task" asp-action="Index">📋 All Tasks</a></li>
                            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Badges">🏆 My Badges</a></li>
                            <li><a class="dropdown-item" href="/Notifications">🔔 Notifications</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Leaderboard">🏅 Leaderboard</a></li>
                            @if (Context.Session.GetString("IsAdmin") == "true")
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-warning" asp-controller="Admin" asp-action="Index">🛡️ Admin Panel</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Settings">⚙️ Settings</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">🔐 Change Password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">🚪 Logout</a></li>
                        </ul>
                    </div>
                </div>
                }
        </header>

        @if (TempData["ToastXP"] != null)
        {
            <div id="toast-data-xp" data-value="@TempData["ToastXP"]" style="display:none"></div>
        }
        @if (TempData["ToastBadge"] != null)
        {
            <div id="toast-data-badge" data-value="@TempData["ToastBadge"]" style="display:none"></div>
        }
        @if (TempData["ToastLevel"] != null)
        {
            <div id="toast-data-level" data-value="@TempData["ToastLevel"]" style="display:none"></div>
        }
        @if (TempData["ToastStreak"] != null)
        {
            <div id="toast-data-streak" data-value="@TempData["ToastStreak"]" style="display:none"></div>
        }
        @if (TempData["ToastRebirth"] != null)
        {
            <div id="toast-data-rebirth" data-value="@TempData["ToastRebirth"]" style="display:none"></div>
        }
    }

    <div class="@(isFullPage ? "auth-body" : "app-body")">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (!isFullPage)
    {
        <footer class="text-center py-4 text-muted">
            © 2026 - HabitTracker | v1.0
        </footer>
    }

    <div id="toast-container"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        function showToast(icon, title, message, type, duration) {
            duration = duration || 3500;
            var container = document.getElementById('toast-container');
            if (!container) return;

            var toast = document.createElement('div');
            toast.className = 'toast-noti ' + type;
            toast.innerHTML =
                '<div class="toast-icon">' + icon + '</div>' +
                '<div><div style="font-weight:900;font-size:1rem;">' + title + '</div>' +
                '<div style="font-size:.86rem;opacity:.9;">' + message + '</div></div>' +
                '<div class="toast-progress"></div>';

            container.appendChild(toast);

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    toast.classList.add('show');
                });
            });

            setTimeout(function () {
                toast.classList.remove('show');
                toast.classList.add('hide');
                setTimeout(function () { toast.remove(); }, 400);
            }, duration);
        }

        function refreshHud() {
            $.getJSON('/Economy/GetStats', function (s) {
                if (!s) return;

                var hpPct = s.maxHp > 0 ? Math.round(s.hp / s.maxHp * 100) : 0;
                var mpPct = s.maxMana > 0 ? Math.round(s.mana / s.maxMana * 100) : 0;

                $('#navbar-level').text(s.level);
                $('#hud-hp-bar').css('width', hpPct + '%');
                $('#hud-mana-bar').css('width', mpPct + '%');
                $('#hud-hp-text').text(Math.round(s.hp) + '/' + s.maxHp);
                $('#hud-mana-text').text(Math.round(s.mana) + '/' + s.maxMana);
                $('#hud-gold-text').text(Math.round(s.gold * 10) / 10);
                $('#hud-gems-text').text(s.gems ?? 0);
                $('#hud-sleep').css('display', s.isSleeping ? 'inline' : 'none');
                $('#hud-dead').css('display', s.isDead ? 'inline' : 'none');
            });

            fetch('/Message/UnreadCount')
                .then(r => r.json())
                .then(d => {
                    var bd = document.getElementById('msg-badge-dd');
                    var show = d.count > 0;
                    if (bd) {
                        bd.textContent = d.count;
                        bd.classList.toggle('d-none', !show);
                    }
                })
                .catch(() => { });

            fetch('/api/notification/unread-count')
                .then(r => r.json())
                .then(d => {
                    var b = document.getElementById('notif-badge');
                    if (b) {
                        var count = d.count ?? d;
                        b.textContent = count;
                        b.classList.toggle('d-none', !(count > 0));
                    }
                })
                .catch(() => { });
        }

        document.getElementById('notifBell')?.addEventListener('show.bs.dropdown', function () {
            fetch('/api/notification?limit=8')
                .then(function (r) { return r.json(); })
                .then(function (items) {
                    var list = document.getElementById('notif-list');
                    if (!list) return;

                    if (!items || items.length === 0) {
                        list.innerHTML = '<div class="py-3 text-center text-muted small">No notifications.</div>';
                        return;
                    }

                    var typeColor = function (type) {
                        var map = {
                            'achievement': '#f0a500', 'Achievement': '#f0a500',
                            'Streak': '#fc9044',
                            'LevelUp': '#4e9af1', 'level_up': '#4e9af1',
                            'Quest': '#a680e8', 'quest': '#a680e8', 'quest_invite': '#a680e8', 'quest_complete': '#4caf50',
                            'quest_rage': '#e8436a',
                            'Guild': '#26a69a', 'Party': '#42a5f5', 'Social': '#e76e78'
                        };
                        return map[type] || '#8a8a8a';
                    };

                    list.innerHTML = items.map(function (n) {
                        var color = typeColor(n.type);
                        var unread = !n.isRead;
                        var borderLeft = unread ? '3px solid ' + color : '3px solid transparent';
                        var bg = unread ? 'rgba(255,255,255,0.04)' : 'transparent';
                        return '<div class="d-flex align-items-start gap-2 py-2 px-2 border-bottom"'
                            + ' style="cursor:pointer;border-left:' + borderLeft + ';background:' + bg + ';font-size:.82rem;"'
                            + ' data-id="' + n.id + '" data-link="' + (n.link || '') + '" data-read="' + (n.isRead ? 'true' : 'false') + '"'
                            + ' onclick="notifDropClick(this)">'
                            + '<span style="font-size:1rem;flex-shrink:0;padding-top:1px;">' + (n.icon || 'ℹ️') + '</span>'
                            + '<div style="min-width:0;flex:1;">'
                            + '<div class="' + (unread ? 'fw-semibold' : '') + '" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + n.title + '</div>'
                            + (n.message ? '<div class="text-muted" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + n.message + '</div>' : '')
                            + '</div>'
                            + '</div>';
                    }).join('');
                });
        });

        async function notifDropClick(el) {
            var id = el.dataset.id;
            var link = el.dataset.link;
            if (el.dataset.read === 'false') {
                fetch('/api/notification/' + id + '/read', { method: 'PUT' }).catch(function () {});
                el.dataset.read = 'true';
                el.style.borderLeft = '3px solid transparent';
                el.style.background = 'transparent';
                var title = el.querySelector('.fw-semibold');
                if (title) title.classList.remove('fw-semibold');
                var b = document.getElementById('notif-badge');
                if (b) {
                    var cur = parseInt(b.textContent) || 0;
                    if (cur > 0) {
                        b.textContent = cur - 1;
                        b.classList.toggle('d-none', cur - 1 <= 0);
                    }
                }
            }
            if (link) window.location.href = link;
        }

        async function markAllRead(e) {
            e.preventDefault();
            await fetch('/api/notification/read-all', { method: 'PUT' });
            var b = document.getElementById('notif-badge');
            if (b) {
                b.textContent = '0';
                b.classList.add('d-none');
            }
        }

        function initSocialDropdown() {
            var btn = document.getElementById('socialDropdown');
            if (!btn || typeof bootstrap === 'undefined') return;

            var dropdown = bootstrap.Dropdown.getOrCreateInstance(btn, {
                autoClose: true,
                boundary: document.body,
                popperConfig: function (defaultConfig) {
                    defaultConfig.strategy = 'fixed';
                    return defaultConfig;
                }
            });

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropdown.toggle();
            });
        }

        function updateCountdown() {
            const cards = document.querySelectorAll(".card");

            cards.forEach(card => {
                const deadlineEl = card.querySelector(".deadline");
                const countdownEl = card.querySelector(".countdown");

                if (!deadlineEl || !deadlineEl.dataset.deadline || !countdownEl) return;

                const deadline = new Date(deadlineEl.dataset.deadline);
                const now = new Date();
                const diff = deadline - now;

                if (diff <= 0) {
                    countdownEl.innerHTML = "⛔ Expired";
                    return;
                }

                const hours = Math.floor(diff / (1000 * 60 * 60));
                const minutes = Math.floor((diff / (1000 * 60)) % 60);

                countdownEl.innerHTML = `⏳ ${hours}h ${minutes}m left`;

                if (diff <= 600000) {
                    countdownEl.innerHTML += " 🔔 Hurry!";
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            initSocialDropdown();
            var xp = document.getElementById('toast-data-xp');
            var badge = document.getElementById('toast-data-badge');
            var level = document.getElementById('toast-data-level');
            var streak = document.getElementById('toast-data-streak');
            var rebirth = document.getElementById('toast-data-rebirth');

            if (xp) showToast('⚡', 'Nhận XP!', xp.dataset.value, 'toast-xp', 3500);
            if (streak) setTimeout(function () { showToast('🔥', 'Streak!', streak.dataset.value, 'toast-streak', 4000); }, 300);
            if (badge) setTimeout(function () { showToast('🏅', 'Huy hiệu mới!', badge.dataset.value, 'toast-badge', 5000); }, 800);
            if (level) setTimeout(function () { showToast('⬆️', 'Level Up!', level.dataset.value, 'toast-level', 5000); }, 1400);
            if (rebirth) setTimeout(function () { showToast('🔁', 'Reborn!', rebirth.dataset.value, 'toast-rebirth', 5000); }, 300);

            @if (Context.Session.GetString("Username") != null)
            {
                    <text>refreshHud();</text>
            }

            setInterval(updateCountdown, 1000);
            updateCountdown();
        });
    </script>

</body>
</html>