@using HabitTracker.Data
@using HabitTracker.Constants
@using HabitTracker.Models
@using Microsoft.AspNetCore.Http
@using System.Text.Json
@inject AppDbContext Db

@{
    var sessionUserId = Context.Session.GetInt32(AppConstants.SESSION_USER_ID);
    User? currentUser = null;

    if (sessionUserId.HasValue)
    {
        currentUser = Db.Users.FirstOrDefault(u => u.Id == sessionUserId.Value);
    }

    double maxHp = 50;
    double maxMana = 32;

    double hp = currentUser?.HP ?? 0;
    double mana = currentUser?.Mana ?? 0;
    double gold = currentUser?.Gold ?? 0;

    double hpPercent = maxHp > 0 ? Math.Min(100, Math.Max(0, hp * 100 / maxHp)) : 0;
    double manaPercent = maxMana > 0 ? Math.Min(100, Math.Max(0, mana * 100 / maxMana)) : 0;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string controller, string? action = null)
    {
        if (action == null)
        {
            return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "";
        }

        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitTracker</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .nav-item-link {
            height: 68px;
            min-width: 86px;
            padding: 8px 12px;
            border-radius: 16px;
            text-decoration: none;
            color: #000;
            font-weight: 900;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: .18s ease;
        }

            .nav-item-link .line-icon {
                font-size: 21px;
                line-height: 1;
            }

            .nav-item-link small {
                font-size: .86rem;
                font-weight: 900;
            }

            .nav-item-link:hover,
            .nav-item-link.active {
                background: #f0eaff;
                color: #6d28d9;
            }

                .nav-item-link.active .line-icon {
                    color: #6d28d9;
                }
    </style>
</head>

<body>
    <header class="app-header">
        <nav class="top-navbar">

            <a class="brand-logo" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-icon">✦</span>
                <span>HabitTracker</span>
            </a>

            <div class="nav-menu">
                <a class="nav-item-link @Active("Dashboard", "Index")" asp-controller="Dashboard" asp-action="Index">
                    <span class="line-icon">⌂</span>
                    <small>Dashboard</small>
                </a>

                <a class="nav-item-link @Active("Task")" asp-controller="Task" asp-action="Index">
                    <span class="line-icon">☑</span>
                    <small>Tasks</small>
                </a>

                <a class="nav-item-link @Active("Account", "Leaderboard")" asp-controller="Account" asp-action="Leaderboard">
                    <span class="line-icon">♛</span>
                    <small>Leaderboard</small>
                </a>

                <a class="nav-item-link @Active("Friend")" asp-controller="Friend" asp-action="Index">
                    <span class="line-icon">☺</span>
                    <small>Bạn bè</small>
                </a>

                <a class="nav-item-link @Active("Economy")" asp-controller="Economy" asp-action="Index">
                    <span class="line-icon">◉</span>
                    <small>Economy</small>
                </a>

                <a class="nav-item-link @Active("Character")" asp-controller="Character" asp-action="Index">
                    <span class="line-icon">⚔</span>
                    <small>Character</small>
                </a>

                <a class="nav-item-link @Active("Equipment")" asp-controller="Equipment" asp-action="Index">
                    <span class="line-icon">⛨</span>
                    <small>Equipment</small>
                </a>

                <a class="nav-item-link @Active("Market")" asp-controller="Market" asp-action="Index">
                    <span class="line-icon">⌘</span>
                    <small>Market</small>
                </a>

                <a class="nav-item-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index">
                    <span class="line-icon">▣</span>
                    <small>Inventory</small>
                </a>

                <a class="nav-item-link @Active("Stable")" asp-controller="Stable" asp-action="Index">
                    <span class="line-icon">♞</span>
                    <small>Stable</small>
                </a>
            </div>

            <div class="player-status">
                <div class="mini-stat">
                    <span class="stat-icon">♡</span>
                    <div>
                        <strong>@hp.ToString("0")/@maxHp.ToString("0")</strong>
                        <div class="mini-bar hp">
                            <span style="width:@hpPercent.ToString("0")%"></span>
                        </div>
                    </div>
                </div>

                <div class="mini-stat">
                    <span class="stat-icon">♢</span>
                    <div>
                        <strong>@mana.ToString("0")/@maxMana.ToString("0")</strong>
                        <div class="mini-bar mana">
                            <span style="width:@manaPercent.ToString("0")%"></span>
                        </div>
                    </div>
                </div>

                <div class="mini-stat gold">
                    <span class="coin-icon">◉</span>
                    <strong>@gold.ToString("N0")</strong>
                </div>
            </div>

            <div class="user-dropdown dropdown">
                <button class="avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="avatar-icon">◉</span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end user-menu">
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                            👤 Hồ sơ cá nhân
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" asp-controller="Character" asp-action="Index">
                            🧙 Nhân vật
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" asp-controller="Inventory" asp-action="Index">
                            🎒 Kho đồ
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" asp-controller="Equipment" asp-action="Index">
                            🛡️ Trang bị
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Badges">
                            🏅 Huy hiệu
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Leaderboard">
                            🏆 Bảng xếp hạng
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                            🔐 Đổi mật khẩu
                        </a>
                    </li>

                    <li><hr class="dropdown-divider" /></li>

                    <li>
                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                            🚪 Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>

        </nav>
    </header>

    <main class="page-wrapper">
        @RenderBody()
    </main>

    <div id="toast-area"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        window.showToast = function (icon, title, message, type, duration) {
            var area = document.getElementById('toast-area');

            if (!area) {
                area = document.createElement('div');
                area.id = 'toast-area';
                document.body.appendChild(area);
            }

            var toast = document.createElement('div');
            toast.className = 'game-toast ' + (type || 'toast-success');

            toast.innerHTML =
                '<div class="game-toast-icon">' + icon + '</div>' +
                '<div class="game-toast-body">' +
                    '<strong>' + title + '</strong>' +
                    '<span>' + message + '</span>' +
                '</div>' +
                '<button class="game-toast-close" type="button">×</button>';

            area.appendChild(toast);

            toast.querySelector('.game-toast-close').addEventListener('click', function () {
                removeToast(toast);
            });

            setTimeout(function () {
                removeToast(toast);
            }, duration || 3500);
        };

        function removeToast(toast) {
            if (!toast) return;

            toast.style.opacity = '0';
            toast.style.transform = 'translateX(35px)';

            setTimeout(function () {
                toast.remove();
            }, 300);
        }

        @if (TempData["Success"] != null)
        {
                <text>
                    showToast('✅', 'Thành công', @Html.Raw(JsonSerializer.Serialize(TempData["Success"]?.ToString())), 'toast-success', 3500);
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                    showToast('❌', 'Lỗi', @Html.Raw(JsonSerializer.Serialize(TempData["Error"]?.ToString())), 'toast-death', 4000);
                </text>
        }

        @if (TempData["Warning"] != null)
        {
                <text>
                    showToast('⚠️', 'Thông báo', @Html.Raw(JsonSerializer.Serialize(TempData["Warning"]?.ToString())), 'toast-hp', 4000);
                </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>