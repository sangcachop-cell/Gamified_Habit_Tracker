@using Microsoft.AspNetCore.Http

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isFullPage = controller == "Account" &&
        (action == "Login" || action == "Register"
         || action == "Profile"
         || action == "EditProfile"
         || action == "ChangePassword");

    bool isSocialActive = controller == "Friend"
        || controller == "Message"
        || controller == "Guild"
        || controller == "Party"
        || (controller == "Account" && action == "Leaderboard");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @if (!isFullPage)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom">
                <div class="container-fluid">

                    <!-- Logo -->
                    <a class="navbar-brand fw-bold text-primary"
                       asp-controller="Dashboard" asp-action="Index">
                        🚀 HabitTracker
                    </a>

                    <button class="navbar-toggler" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">

                        <!-- LEFT MENU -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    📊 Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Task" asp-action="Index">
                                    📋 Tasks
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isSocialActive ? "active" : "")"
                                   href="#" data-bs-toggle="dropdown">
                                    👥 Social
                                    <span id="msg-badge" class="badge rounded-pill bg-danger d-none ms-1"
                                          style="font-size:10px;vertical-align:middle;"></span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item @(controller == "Account" && action == "Leaderboard" ? "active" : "")"
                                           asp-controller="Account" asp-action="Leaderboard">
                                            🏆 Leaderboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(controller == "Friend" ? "active" : "")"
                                           asp-controller="Friend" asp-action="Index">
                                            👥 Friends
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(controller == "Message" ? "active" : "")"
                                           asp-controller="Message" asp-action="Index">
                                            ✉️ Messages
                                            <span id="msg-badge-dd" class="badge rounded-pill bg-danger d-none ms-1"
                                                  style="font-size:10px;"></span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item @(controller == "Guild" ? "active" : "")"
                                           asp-controller="Guild" asp-action="Index">
                                            ⚔️ Guilds
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(controller == "Party" ? "active" : "")"
                                           asp-controller="Party" asp-action="Index">
                                            🛡️ Party
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Character" asp-action="Index">
                                    ⚔️ Character
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Equipment" asp-action="Index">
                                    🛡️ Equipment
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Market" asp-action="Index">
                                    🏪 Market
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Inventory" asp-action="Index">
                                    🎒 Inventory
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Stable" asp-action="Index">
                                    🐾 Stable
                                </a>
                            </li>

                            @if (Context.Session.GetString("IsAdmin") == "true")
                            {
                                <li class="nav-item ms-2">
                                    <a class="nav-link text-warning fw-bold"
                                       asp-controller="Admin" asp-action="Index">
                                        ⚙️ Admin
                                    </a>
                                </li>
                            }

                        </ul>

                        <!-- CENTER - HUD BARS -->
                        @if (Context.Session.GetString("Username") != null)
                        {
                            <div id="hud-bars" style="margin:0 16px;display:flex;gap:10px;align-items:center;flex-wrap:nowrap;">
                                <div title="HP" style="display:flex;align-items:center;gap:4px;">
                                    <span>❤️</span>
                                    <div style="width:72px;height:7px;background:#eee;border-radius:4px;overflow:hidden;">
                                        <div id="hud-hp-bar" style="height:100%;background:#e8436a;border-radius:4px;transition:width .3s;width:100%;"></div>
                                    </div>
                                    <small id="hud-hp-text" style="color:#e8436a;font-weight:700;font-size:.75rem;min-width:36px;"></small>
                                </div>
                                <div title="MP" style="display:flex;align-items:center;gap:4px;">
                                    <span>💙</span>
                                    <div style="width:72px;height:7px;background:#eee;border-radius:4px;overflow:hidden;">
                                        <div id="hud-mana-bar" style="height:100%;background:#4a90d9;border-radius:4px;transition:width .3s;width:100%;"></div>
                                    </div>
                                    <small id="hud-mana-text" style="color:#4a90d9;font-weight:700;font-size:.75rem;min-width:36px;"></small>
                                </div>
                                <div title="Gold" style="display:flex;align-items:center;gap:3px;">
                                    <span style="display:inline-block;width:13px;height:13px;background:#f0b429;border-radius:50%;border:1.5px solid #c8960c;flex-shrink:0;"></span>
                                    <small id="hud-gold-text" style="color:#f0b429;font-weight:700;font-size:.8rem;min-width:32px;">0</small>
                                </div>
                                <div title="Gems" style="display:flex;align-items:center;gap:3px;">
                                    <span>💎</span>
                                    <small id="hud-gems-text" style="color:#a78bfa;font-weight:700;font-size:.8rem;min-width:16px;">0</small>
                                </div>
                                <small style="color:#667eea;font-size:.75rem;font-weight:700;">Lv<span id="navbar-level">-</span></small>
                                <small id="hud-sleep" style="display:none;" title="Rest mode active">🌙</small>
                                <a id="hud-dead" href="/Economy" style="display:none;color:#e8436a;font-weight:700;font-size:.75rem;text-decoration:none;" title="You died! Click to revive.">💀 Dead!</a>
                            </div>
                        }

                        <!-- RIGHT USER MENU -->
                        <ul class="navbar-nav align-items-center">

                            @* Notification bell *@
                            @if (Context.Session.GetString("Username") != null)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link position-relative px-2" href="#"
                                       data-bs-toggle="dropdown" id="notifBell" title="Notifications">
                                        🔔
                                        <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                                              style="font-size:10px;"></span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" id="notif-dropdown" style="min-width:320px;max-height:400px;overflow-y:auto;">
                                        <li class="dropdown-header d-flex justify-content-between">
                                            <span>Notifications</span>
                                            <a href="#" class="small" onclick="markAllRead(event)">Mark all read</a>
                                        </li>
                                        <li><div id="notif-list" class="px-2 py-1 text-muted small">Loading…</div></li>
                                    </ul>
                                </li>
                            }

                            @if (Context.Session.GetString("Username") != null)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center"
                                       href="#"
                                       data-bs-toggle="dropdown"
                                       style="gap:10px;">
                                        <img src="@(Context.Session.GetString("Avatar") != null
                                                                                                                                                                                               && Context.Session.GetString("Avatar").StartsWith("http")
                                                                                                                                                                                               ? Context.Session.GetString("Avatar")
                                                                                                                                                                                               : Url.Content("~/images/" + (Context.Session.GetString("Avatar") ?? "default.png")))"
                                     width="40" height="40"
                                     class="rounded-circle border"
                                     style="object-fit:cover;" />
                                <span class="fw-semibold d-none d-md-inline">
                                    @Context.Session.GetString("Username")
                                </span>
                            </a>

                                    <ul class="dropdown-menu dropdown-menu-end custom-dropdown">

                                        <!-- PROFILE LINK -->
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                                👤 My Profile
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                                📊 Dashboard
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Dashboard" asp-action="Statistics">
                                                📈 Statistics
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Task" asp-action="Index">
                                                📋 All Tasks
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Dashboard" asp-action="Badges">
                                                🏆 My Badges
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Leaderboard">
                                                🏅 Leaderboard
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                                🔐 Change Password
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-controller="Account"
                                               asp-action="Logout">
                                                🚪 Logout
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                                }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Login">
                                        🔐 Login
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                                        📝 Register
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        @* ===== TOAST DATA TỪ TEMPDATA ===== *@
        @if (TempData["ToastXP"] != null)
        {
            <div id="toast-data-xp" data-value="@TempData["ToastXP"]" style="display:none"></div>
        }
        @if (TempData["ToastBadge"] != null)
        {
            <div id="toast-data-badge" data-value="@TempData["ToastBadge"]" style="display:none"></div>
        }
        @if (TempData["ToastLevel"] != null)
        {
            <div id="toast-data-level" data-value="@TempData["ToastLevel"]" style="display:none"></div>
        }
        @if (TempData["ToastStreak"] != null)
        {
            <div id="toast-data-streak" data-value="@TempData["ToastStreak"]" style="display:none"></div>
        }
        @if (TempData["ToastRebirth"] != null)
        {
            <div id="toast-data-rebirth" data-value="@TempData["ToastRebirth"]" style="display:none"></div>
        }
    }

    <!-- ================= BODY ================= -->
    <div class="@(isFullPage ? "" : "container mt-4")">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    @if (!isFullPage)
    {
        <footer class="border-top mt-5">
            <div class="container text-center py-3 text-muted">
                © 2026 - HabitTracker 🚀 | v1.0
            </div>
        </footer>
    }

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

    <!-- ===== TOAST CONTAINER + SCRIPT ===== -->
    <div id="toast-container"></div>

    <style>
        #toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast-noti {
            min-width: 280px;
            max-width: 340px;
            padding: 14px 18px;
            border-radius: 12px;
            color: white;
            font-size: 0.95rem;
            font-weight: 500;
            box-shadow: 0 8px 24px rgba(0,0,0,0.18);
            display: flex;
            align-items: center;
            gap: 12px;
            opacity: 0;
            transform: translateX(120px);
            transition: opacity 0.35s ease, transform 0.35s ease;
            position: relative;
            overflow: hidden;
        }

            .toast-noti.show {
                opacity: 1;
                transform: translateX(0);
            }

            .toast-noti.hide {
                opacity: 0;
                transform: translateX(120px);
            }

        .toast-xp {
            background: linear-gradient(135deg, #f6a623, #f76b1c);
        }

        .toast-badge {
            background: linear-gradient(135deg, #7b2ff7, #4a90d9);
        }

        .toast-streak {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
        }

        .toast-level {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: #1a1a1a;
        }

        .toast-gold  { background: linear-gradient(135deg, #f0b429, #f76b1c); }
        .toast-hp    { background: linear-gradient(135deg, #e8436a, #c0392b); }
        .toast-crit  { background: linear-gradient(135deg, #ffcc00, #ff6600); color: #1a1a1a; }
        .toast-drop  { background: linear-gradient(135deg, #7b2ff7, #4a90d9); }
        .toast-death   { background: linear-gradient(135deg, #1a1a2e, #c0392b); }
        .toast-rebirth { background: linear-gradient(135deg, #1a1a2e, #7b2ff7); color: white; }
        .success     { background: linear-gradient(135deg, #11998e, #38ef7d); color: #1a1a1a; }
        .danger      { background: linear-gradient(135deg, #e8436a, #c0392b); }
        .info        { background: linear-gradient(135deg, #4a90d9, #667eea); }
        .warning     { background: linear-gradient(135deg, #f0b429, #f76b1c); color: #1a1a1a; }

        .toast-icon {
            font-size: 2rem;
            line-height: 1;
            flex-shrink: 0;
            animation: bounceIcon 0.5s ease;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: rgba(255,255,255,0.5);
            border-radius: 0 0 12px 12px;
            animation: progressBar 3.5s linear forwards;
        }

        @@keyframes bounceIcon {
            0% {
                transform: scale(0.5);
            }

            60% {
                transform: scale(1.3);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes progressBar {
            from {
                width: 100%;
            }

            to {
                width: 0%;
            }
        }
    </style>

    <script>
        function showToast(icon, title, message, type, duration) {
            duration = duration || 3500;
            var container = document.getElementById('toast-container');
            var toast = document.createElement('div');
            toast.className = 'toast-noti ' + type;
            toast.innerHTML =
                '<div class="toast-icon">' + icon + '</div>' +
                '<div>' +
                    '<div style="font-weight:700;font-size:1rem;">' + title + '</div>' +
                    '<div style="font-size:0.85rem;opacity:0.9;">' + message + '</div>' +
                '</div>' +
                '<div class="toast-progress"></div>';

            container.appendChild(toast);

            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    toast.classList.add('show');
                });
            });

            setTimeout(function () {
                toast.classList.remove('show');
                toast.classList.add('hide');
                setTimeout(function () { toast.remove(); }, 400);
            }, duration);
        }

        function refreshHud() {
            $.getJSON('/Economy/GetStats', function(s) {
                if (!s) return;
                document.getElementById('navbar-level').textContent    = s.level;
                var hpPct   = s.maxHp   > 0 ? Math.round(s.hp   / s.maxHp   * 100) : 0;
                var mpPct   = s.maxMana > 0 ? Math.round(s.mana / s.maxMana * 100) : 0;
                document.getElementById('hud-hp-bar').style.width      = hpPct  + '%';
                document.getElementById('hud-mana-bar').style.width    = mpPct  + '%';
                document.getElementById('hud-hp-text').textContent     = Math.round(s.hp)   + '/' + s.maxHp;
                document.getElementById('hud-mana-text').textContent   = Math.round(s.mana) + '/' + s.maxMana;
                document.getElementById('hud-gold-text').textContent   = Math.round(s.gold * 10) / 10;
                document.getElementById('hud-gems-text').textContent   = s.gems ?? 0;
                document.getElementById('hud-sleep').style.display     = s.isSleeping ? 'inline' : 'none';
                document.getElementById('hud-dead').style.display      = s.isDead     ? 'inline' : 'none';
            });
            // Message unread badge
            fetch('/Message/UnreadCount').then(r => r.json()).then(d => {
                var b  = document.getElementById('msg-badge');
                var bd = document.getElementById('msg-badge-dd');
                var show = d.count > 0;
                if (b)  { b.textContent  = d.count; b.classList.toggle('d-none',  !show); }
                if (bd) { bd.textContent = d.count; bd.classList.toggle('d-none', !show); }
            }).catch(() => {});
            // Notification unread badge
            fetch('/api/notification/unread-count').then(r => r.json()).then(d => {
                var b = document.getElementById('notif-badge');
                if (b) { b.textContent = d.count ?? d; b.classList.toggle('d-none', !((d.count ?? d) > 0)); }
            }).catch(() => {});
        }

        // Load notifications into dropdown
        document.getElementById('notifBell')?.addEventListener('show.bs.dropdown', function () {
            fetch('/api/notification?limit=8').then(r => r.json()).then(items => {
                var list = document.getElementById('notif-list');
                if (!list) return;
                if (!items || items.length === 0) { list.textContent = 'No notifications.'; return; }
                list.innerHTML = items.map(n =>
                    `<div class="py-2 border-bottom" style="font-size:.82rem;">
                        <div>${n.icon || 'ℹ️'} <strong>${n.title}</strong></div>
                        ${n.message ? `<div class="text-muted">${n.message}</div>` : ''}
                        ${n.link ? `<a href="${n.link}" class="small">View →</a>` : ''}
                     </div>`
                ).join('');
            }).catch(() => { const l = document.getElementById('notif-list'); if(l) l.textContent='Failed to load.'; });
        });

        async function markAllRead(e) {
            e.preventDefault();
            await fetch('/api/notification/read-all', { method: 'PUT' });
            var b = document.getElementById('notif-badge');
            if (b) { b.textContent = '0'; b.classList.add('d-none'); }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var xp     = document.getElementById('toast-data-xp');
            var badge  = document.getElementById('toast-data-badge');
            var level  = document.getElementById('toast-data-level');
            var streak = document.getElementById('toast-data-streak');

            var rebirth = document.getElementById('toast-data-rebirth');

            if (xp)      showToast('⚡', 'Nhận XP!',      xp.dataset.value,      'toast-xp',      3500);
            if (streak)  setTimeout(function(){ showToast('🔥', 'Streak!',        streak.dataset.value,  'toast-streak',  4000); }, 300);
            if (badge)   setTimeout(function(){ showToast('🏅', 'Huy hiệu mới!', badge.dataset.value,   'toast-badge',   5000); }, 800);
            if (level)   setTimeout(function(){ showToast('⬆️', 'Level Up!',      level.dataset.value,   'toast-level',   5000); }, 1400);
            if (rebirth) setTimeout(function(){ showToast('🔁', 'Reborn!',        rebirth.dataset.value, 'toast-rebirth', 5000); }, 300);

            @if (Context.Session.GetString("Username") != null)
            {
                <text>refreshHud();</text>
            }
        });
    </script>

</body>
</html>
